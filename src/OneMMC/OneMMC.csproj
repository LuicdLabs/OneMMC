<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
        <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
        <RootNamespace>OneMMC</RootNamespace>

        <!-- Dev Only -->
        <ApplicationManifest>app.manifest</ApplicationManifest>
        <Platforms>x64;ARM64</Platforms>
        <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
        <UseWinUI>true</UseWinUI>
        <WinUISDKReferences>false</WinUISDKReferences>

		<!-- Dev Only -->
        <WindowsPackageType>None</WindowsPackageType>
		<!-- <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained> -->

		<EnableMsixTooling>true</EnableMsixTooling>
    </PropertyGroup>
    <ItemGroup>
      <Compile Remove="Views\PolicyPolicies\**" />
      <EmbeddedResource Remove="Views\PolicyPolicies\**" />
      <None Remove="Views\PolicyPolicies\**" />
      <Page Remove="Views\PolicyPolicies\**" />
    </ItemGroup>

      <ItemGroup>
        <Content Include="Assets\SplashScreen.scale-200.png" />
        <Content Include="Assets\LockScreenLogo.scale-200.png" />
        <Content Include="Assets\Square150x150Logo.scale-200.png" />
        <Content Include="Assets\Square44x44Logo.scale-200.png" />
        <Content Include="Assets\Square44x44Logo.targetsize-24_altform-unplated.png" />
        <Content Include="Assets\StoreLogo.png" />
        <Content Include="Assets\Wide310x150Logo.scale-200.png" />
      </ItemGroup>

      <ItemGroup>
        <Content Include="LegalDocs\LicenseTerms.txt">
          <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </Content>
        <Content Include="LegalDocs\ThirdPartyNotices.txt">
          <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </Content>
        <Content Include="LegalDocs\PrivacyStatement.txt">
          <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </Content>
      </ItemGroup>

      <ItemGroup>
        <Manifest Include="$(ApplicationManifest)" />
      </ItemGroup>

      <!--
        Defining the "Msix" ProjectCapability here allows the Single-project MSIX Packaging
        Tools extension to be activated for this project even if the Windows App SDK Nuget
        package has not yet been restored.
      -->
      <ItemGroup Condition="'$(DisableMsixProjectCapabilityAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
        <ProjectCapability Include="Msix" />
      </ItemGroup>
      <!-- Global usings: available in every .cs file without explicit using directives -->
      <ItemGroup>
        <Using Include="OneMMC.Core.Abstractions.Services" />
        <Using Include="OneMMC.Core.Infrastructure.WindowsCapabilities" />
        <Using Include="OneMMC.Services" />
      </ItemGroup>

      <ItemGroup>
        <PackageReference Include="CommunityToolkit.Mvvm" />
        <PackageReference Include="CommunityToolkit.WinUI.Controls.SettingsControls" />
        <PackageReference Include="CommunityToolkit.WinUI.Controls.Sizers" />
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
        <PackageReference Include="Microsoft.Extensions.Logging" />
        <PackageReference Include="Microsoft.Windows.CsWin32" PrivateAssets="all" />
        <PackageReference Include="Microsoft.Windows.SDK.BuildTools" />
        <PackageReference Include="Microsoft.WindowsAppSDK" />
        <PackageReference Include="Serilog" />
        <PackageReference Include="Serilog.Extensions.Logging" />
        <PackageReference Include="Serilog.Sinks.File" />
        <PackageReference Include="System.Drawing.Common" />
        <PackageReference Include="System.IO.FileSystem.AccessControl" />
        <PackageReference Include="System.Windows.Extensions" />
        <!-- Direct reference (Core also references it): WmiLight's build/ props+targets do not flow
             transitively, and the app project needs them for PublishWmiLightStaticallyLinked to fold
             WmiLight.Native.dll into the AOT executable. -->
        <PackageReference Include="WmiLight" />
      </ItemGroup>
      <ItemGroup>
        <ProjectReference Include="..\OneMMC.Core\OneMMC.Core.csproj" />
      </ItemGroup>

      <!-- WmiLight is consumed through the OneMMC.Core class library, so it must be rooted for
           the AOT publish (documented WmiLight requirement for library encapsulation).
           See doc/NativeAot.md ("WMI and CIM"). -->
      <ItemGroup>
        <TrimmerRootAssembly Include="WmiLight" />
      </ItemGroup>
      <ItemGroup>
        <Folder Include="Views\CertificatesCredential\CertLM\" />
        <Folder Include="Views\CertificatesCredential\CertMgr\" />
        <Folder Include="Views\PCManagement\DiskMgmt\Dialogs\" />
        <Folder Include="Views\PCManagement\Eventvwr\Frame\" />
        <Folder Include="Views\PCManagement\FsMgmt\" />
        <Folder Include="Views\PCManagement\DevMgmt\" />
        <Folder Include="Views\PCManagement\LusrMgr\Dialogs\" />
        <Folder Include="Views\PCManagement\PerfMon\" />
        <Folder Include="Views\PCManagement\TaskSchd\Dialogs\" />
        <Folder Include="Views\SystemManagement\ComExp\" />
        <Folder Include="Views\SystemManagement\TPM\" />
        <Folder Include="Views\SystemManagement\WF\Dialogs\" />
        <Folder Include="Views\UserSecurity\SecPol\Dialogs\Policies\" />
      </ItemGroup>
      <ItemGroup>
        <Page Update="Views\Dialogs\WelcomeDialog.xaml">
          <Generator>MSBuild:Compile</Generator>
        </Page>
        <Page Update="Views\UserSecurity\AzMan\AuthStore\Scopes\ScopesPage.xaml">
          <Generator>MSBuild:Compile</Generator>
        </Page>
        <Page Update="Views\UserSecurity\AzMan\Dialogs\AssignItemsDialog.xaml">
          <Generator>MSBuild:Compile</Generator>
        </Page>
        <Page Update="Views\UserSecurity\AzMan\Dialogs\AuthorizationRuleDialog.xaml">
          <Generator>MSBuild:Compile</Generator>
        </Page>
        <Page Update="Views\UserSecurity\AzMan\Dialogs\CreateItemDialog.xaml">
          <Generator>MSBuild:Compile</Generator>
        </Page>
        <Page Update="Views\UserSecurity\AzMan\Dialogs\CreateStoreDialog.xaml">
          <Generator>MSBuild:Compile</Generator>
        </Page>
        <Page Update="Views\UserSecurity\AzMan\Dialogs\EditItemDialog.xaml">
          <Generator>MSBuild:Compile</Generator>
        </Page>
        <Page Update="Views\UserSecurity\AzMan\Dialogs\GroupMembersDialog.xaml">
          <Generator>MSBuild:Compile</Generator>
        </Page>
        <Page Update="Views\UserSecurity\AzMan\Dialogs\OpenStoreDialog.xaml">
          <Generator>MSBuild:Compile</Generator>
        </Page>
        <Page Update="Views\UserSecurity\AzMan\Dialogs\StorePropertiesDialog.xaml">
          <Generator>MSBuild:Compile</Generator>
        </Page>
        <Page Update="Views\UserSecurity\AzMan\Dialogs\RoleAssignmentPropertiesDialog.xaml">
          <Generator>MSBuild:Compile</Generator>
        </Page>
      </ItemGroup>

      <!--
        Defining the "HasPackageAndPublishMenuAddedByProject" property here allows the Solution
        Explorer "Package and Publish" context menu entry to be enabled for this project even if
        the Windows App SDK Nuget package has not yet been restored.
      -->
      <PropertyGroup Condition="'$(DisableHasPackageAndPublishMenuAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
        <HasPackageAndPublishMenu>true</HasPackageAndPublishMenu>
      </PropertyGroup>

      <!-- Publish Properties. Native AOT is the default publish model; see doc/NativeAot.md for
           the developer guidance, current verified state, and historical migration notes.
           PublishAot is set unconditionally so the AOT analyzers and CsWinRT AOT codegen apply
           to every build; native compilation itself still happens only on `dotnet publish`. -->
      <PropertyGroup>
        <PublishAot>true</PublishAot>
        <!-- CsWinRT's AOT optimizer emits unsafe code; Core already allows it, the app must too. -->
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <!-- Fold WmiLight's native shim into the executable instead of shipping WmiLight.Native.dll. -->
        <PublishWmiLightStaticallyLinked>true</PublishWmiLightStaticallyLinked>
      </PropertyGroup>
      <PropertyGroup Condition="'$(Configuration)' == 'Release'">
        <SelfContained>true</SelfContained>
      </PropertyGroup>
      <PropertyGroup>
        <ApplicationIcon>Assets\icon.ico</ApplicationIcon>
        <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
        <PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
      </PropertyGroup>
      <ItemGroup>
        <PRIResource Remove="Views\PolicyPolicies\**" />
      </ItemGroup>
      <ItemGroup>
        <None Include="..\..\LICENSE">
          <Pack>True</Pack>
          <PackagePath>\</PackagePath>
        </None>
      </ItemGroup>
</Project>
