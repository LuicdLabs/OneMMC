<?xml version="1.0" encoding="utf-8" ?>
<Window
	x:Class="OneMMC.MainWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
	xmlns:svc="using:OneMMC.Services"
	Title="OneMMC"
	mc:Ignorable="d">
	<Window.SystemBackdrop>
		<MicaBackdrop />
	</Window.SystemBackdrop>

	<Grid x:Name="RootGrid"
		Loaded="RootGrid_Loaded"
		SizeChanged="RootGrid_SizeChanged">
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="Auto" />
			<ColumnDefinition />
		</Grid.ColumnDefinitions>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
		</Grid.RowDefinitions>
		<Border x:Name="AppTitleBar"
			Grid.Row="0"
			Grid.Column="1"
			Height="48"
			Margin="96,0,144,0"
			VerticalAlignment="Stretch" />
		<!-- <Image
			Width="18"
			VerticalAlignment="Center"
			Source="ms-appx:///Assets/StoreLogo.png" /> -->
		<TextBlock x:Name="AppTitle"
			Grid.Row="0"
			Grid.Column="1"
			Canvas.ZIndex="1"
			Margin="52,0,144,0"
			VerticalAlignment="Center"
			IsHitTestVisible="False"
			MaxLines="1"
			Style="{StaticResource CaptionTextBlockStyle}"
			Text="{x:Bind LocalizedStrings.AppTitle}"
			TextTrimming="CharacterEllipsis"
			TextWrapping="NoWrap" />
		<NavigationView x:Name="NavigationViewControl"
			AutomationProperties.AutomationId="MainNavigationView"
			Grid.Row="0"
			Grid.RowSpan="2"
			Grid.Column="1"
			Canvas.ZIndex="0"
			IsTitleBarAutoPaddingEnabled="True"
			SelectionChanged="NavigationView_SelectionChanged"
			ItemInvoked="NavigationView_ItemInvoked"
			IsBackButtonVisible="Auto"
			BackRequested="NavigationView_BackRequested"
			AlwaysShowHeader="True">
			<NavigationView.Header>
				<BreadcrumbBar
					x:Name="MainBreadcrumb"
					FontSize="26"
					FontWeight="SemiBold"
					ItemClicked="MainBreadcrumb_ItemClicked"
					MaxWidth="1000"
					HorizontalAlignment="Stretch">
					<BreadcrumbBar.Resources>
						<Style x:Key="BreadcrumbBarItemStyle" TargetType="BreadcrumbBarItem">
                            <Setter Property="FontSize" Value="26" />
                            <Setter Property="FontWeight" Value="SemiBold" />
							<Setter Property="Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}" />
						</Style>
					</BreadcrumbBar.Resources>
					<BreadcrumbBar.ItemTemplate>
						<DataTemplate x:Name="BreadcrumbBarItemTemplate">
							<BreadcrumbBarItem Content="{Binding Content}" Style="{StaticResource BreadcrumbBarItemStyle}" />
						</DataTemplate>
					</BreadcrumbBar.ItemTemplate>
				</BreadcrumbBar>
			</NavigationView.Header>
			<NavigationView.Resources>
				<!--  This top margin is the height of the custom titleBar  -->
				<Thickness x:Key="NavigationViewContentMargin">0,48,0,0</Thickness>
				<Thickness x:Key="NavigationViewMinimalContentMargin">0,48,0,0</Thickness>
				<Thickness x:Key="NavigationViewContentGridBorderThickness">0,0,0,0</Thickness>
				<!--  This is the rounded corner on the Top left of the L Pattern  -->
				<CornerRadius x:Key="NavigationViewContentGridCornerRadius">8,0,0,0</CornerRadius>
				<Thickness x:Key="NavigationViewHeaderMargin">56,20,0,0</Thickness>
                <Thickness x:Key="BreadcrumbBarChevronPadding">12,0</Thickness>
            </NavigationView.Resources>
			<NavigationView.MenuItems>
				<NavigationViewItem
					AutomationProperties.AutomationId="Nav_PCManagement"
					Content="{x:Bind LocalizedStrings.Navigation_PC_Management}"
					Tag="PCManagement">
					<NavigationViewItem.Icon>
						<FontIcon Glyph="&#xEBDE;" />
					</NavigationViewItem.Icon>
				</NavigationViewItem>

				<NavigationViewItem
					AutomationProperties.AutomationId="Nav_PolicyPolicies"
					Content="{x:Bind LocalizedStrings.Navigation_Policy_Policies}"
					Tag="PolicyPolicies">
					<NavigationViewItem.Icon>
						<FontIcon Glyph="&#xEA18;" />
					</NavigationViewItem.Icon>
				</NavigationViewItem>

				<NavigationViewItem
					AutomationProperties.AutomationId="Nav_CertificatesCredential"
					Content="{x:Bind LocalizedStrings.Navigation_Certificates_Credential}"
					Tag="CertificatesCredential">
					<NavigationViewItem.Icon>
						<FontIcon Glyph="&#xEB95;" />
					</NavigationViewItem.Icon>
				</NavigationViewItem>

				<NavigationViewItem
					AutomationProperties.AutomationId="Nav_UserSecurity"
					Content="{x:Bind LocalizedStrings.Navigation_User_Security}"
					Tag="UserSecurity">
					<NavigationViewItem.Icon>
						<FontIcon Glyph="&#xE77B;" />
					</NavigationViewItem.Icon>
				</NavigationViewItem>

				<NavigationViewItem
					AutomationProperties.AutomationId="Nav_PrintManagement"
					Content="{x:Bind LocalizedStrings.Navigation_Print_Management}"
					Tag="PrintManagement">
					<NavigationViewItem.Icon>
						<FontIcon Glyph="&#xE749;" />
					</NavigationViewItem.Icon>
				</NavigationViewItem>

				<NavigationViewItem
					AutomationProperties.AutomationId="Nav_SystemManagement"
					Content="{x:Bind LocalizedStrings.Navigation_System_Management}"
					Tag="SystemManagement">
					<NavigationViewItem.Icon>
						<FontIcon Glyph="&#xE770;" />
					</NavigationViewItem.Icon>
				</NavigationViewItem>
			</NavigationView.MenuItems>
			<NavigationView.FooterMenuItems>
				<NavigationViewItem x:Name="RunAsAdminItem"
									AutomationProperties.AutomationId="Nav_RunAsAdmin"
									Content="{x:Bind LocalizedStrings.Common_RunAsAdministrator}"
									Tag="RunAsAdmin"
									SelectsOnInvoked="False">
					<NavigationViewItem.Icon>
						<FontIcon Glyph="&#xE7EF;" />
					</NavigationViewItem.Icon>
				</NavigationViewItem>
			</NavigationView.FooterMenuItems>
            <Frame
				x:Name="contentFrame"
				x:FieldModifier="public"
				AutomationProperties.AutomationId="MainContentFrame"
				CacheSize="0"
				HorizontalAlignment="Stretch"
				MaxWidth="1000" />
		</NavigationView>
	</Grid>
</Window>
