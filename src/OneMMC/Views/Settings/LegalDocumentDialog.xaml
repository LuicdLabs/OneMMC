<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="OneMMC.Views.Settings.LegalDocumentDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:localization="using:OneMMC.Localization"
    Style="{StaticResource DefaultContentDialogStyle}"
    CloseButtonText="{x:Bind LocalizedStrings.Common_Close}">
    <ScrollViewer MaxHeight="500" VerticalScrollBarVisibility="Auto">
        <TextBlock x:Name="ContentTextBlock"
                   TextWrapping="Wrap"
                   IsTextSelectionEnabled="True"
                   Margin="0,8,0,0" />
    </ScrollViewer>
</ContentDialog>
