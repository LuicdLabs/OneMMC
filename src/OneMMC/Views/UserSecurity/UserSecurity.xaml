<?xml version="1.0" encoding="utf-8" ?>
<Page
	x:Class="OneMMC.Views.UserSecurityPage"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:controls="using:Microsoft.UI.Xaml.Controls"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:cwuc="using:CommunityToolkit.WinUI.Controls"
	xmlns:local="using:OneMMC.Models"
	xmlns:localization="using:OneMMC.Localization"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	mc:Ignorable="d">
	<Page.Resources>
	</Page.Resources>

	<ScrollViewer>
		<StackPanel Padding="24,20,24,24" Spacing="20">
			<StackPanel Spacing="4">
				<ItemsControl ItemsSource="{x:Bind SettingsItems}">
					<ItemsControl.ItemsPanel>
						<ItemsPanelTemplate>
							<StackPanel Spacing="4" />
						</ItemsPanelTemplate>
					</ItemsControl.ItemsPanel>
					<ItemsControl.ItemTemplate>
						<DataTemplate x:DataType="local:SettingItem">
							<cwuc:SettingsCard
								Header="{x:Bind Title}"
								Description="{x:Bind Subtitle}"
								IsClickEnabled="True"
								Command="{x:Bind Command}">
								<cwuc:SettingsCard.HeaderIcon>
									<FontIcon Glyph="{x:Bind Glyph}" />
								</cwuc:SettingsCard.HeaderIcon>
							</cwuc:SettingsCard>
						</DataTemplate>
					</ItemsControl.ItemTemplate>
				</ItemsControl>
			</StackPanel>
		</StackPanel>
	</ScrollViewer>
</Page>