<?xml version="1.0" encoding="utf-8" ?>
<!--
    AuthApplicationsPage.xaml
    
    Authorization Application Details Page - Manage application groups, roles, tasks, and operations
-->
<Page
    x:Class="OneMMC.Views.UserSecurity.AzMan.AuthStore.AuthApplications.AuthApplicationsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:localization="using:OneMMC.Localization"
    xmlns:converters="using:OneMMC.Converters"
    xmlns:cwuc="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:OneMMC.Core.Features.UserSecurity.Models.AzMan"
    x:Name="Root"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:StringVisibilityConverter x:Key="StringVisibilityConverter" />
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />  
            <!--  Tab selector + toolbar  -->
            <RowDefinition Height="Auto" />  
            <!--  Status bar  -->
            <RowDefinition Height="*" />     
            <!--  Content area  -->
        </Grid.RowDefinitions>

        <!--  Header area: SelectorBar + Toolbar  -->
        <Grid Grid.Row="0" Padding="24,16,24,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />     
                <!--  SelectorBar  -->
                <ColumnDefinition Width="Auto" />  
                <!--  Toolbar buttons  -->
            </Grid.ColumnDefinitions>

            <!--  Tab selector: Groups & Roles / Definitions  -->
            <SelectorBar x:Name="PageSelector" SelectionChanged="PageSelector_SelectionChanged">
                <SelectorBarItem
                    x:Name="GroupsRolesItem"
                    IsSelected="True"
                    Text="{x:Bind LocalizedStrings.AuthApplicationsPage_Tab_GroupsRoles}" />
                <SelectorBarItem x:Name="DefinitionsItem" Text="{x:Bind LocalizedStrings.AuthApplicationsPage_Tab_Definitions}" />
            </SelectorBar>

            <!--  Toolbar: Action buttons  -->
            <StackPanel
                Grid.Column="1"
                Orientation="Horizontal"
                Spacing="4">
                <Button
                    Padding="12,8"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="OnRefreshClick">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="14" Glyph="&#xE72C;" />
                        <TextBlock VerticalAlignment="Center" Text="{x:Bind LocalizedStrings.Common_Refresh}" />
                    </StackPanel>
                </Button>

                <Button
                    Padding="8"
                    Background="Transparent"
                    BorderThickness="0">
                    <FontIcon FontSize="16" Glyph="&#xE712;" />
                    <Button.Flyout>
                        <MenuFlyout Placement="Bottom">
                            <MenuFlyoutItem Click="OnPropertiesClick" Text="{x:Bind LocalizedStrings.AuthApplicationsPage_Properties}">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE946;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem Click="OnDeleteClick" Text="{x:Bind LocalizedStrings.AuthApplicationsPage_DeleteApplication}">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE74D;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem Click="OnHelpClick" Text="{x:Bind LocalizedStrings.Common_Help}">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE897;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
            </StackPanel>
        </Grid>

        <!--  Status bar  -->
        <InfoBar
            x:Name="StatusInfoBar"
            Grid.Row="1"
            Margin="24,0"
            IsOpen="False" />

        <!--  Loading indicator  -->
        <ProgressRing
            x:Name="LoadingRing"
            Grid.Row="2"
            Width="48"
            Height="48"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            IsActive="False" />

        <!--  Content area  -->
        <ScrollViewer Grid.Row="2">
            <Grid Padding="24,8,24,24">

                <!--  Groups & Roles View  -->
                <StackPanel
                    x:Name="GroupsRolesPanel"
                    Spacing="8"
                    Visibility="Visible">

                    <!--  Groups  -->
                    <cwuc:SettingsExpander IsExpanded="True" ItemsSource="{x:Bind _viewModel.FilteredGroups, Mode=OneWay}">
                        <cwuc:SettingsExpander.Header>
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <FontIcon FontSize="20" Glyph="&#xE902;" />
                                <TextBlock VerticalAlignment="Center" Text="{x:Bind LocalizedStrings.Common_Groups}" />
                                <TextBlock
                                    Margin="8,0,0,0"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{x:Bind _viewModel.GroupCountText, Mode=OneWay}" />
                            </StackPanel>
                        </cwuc:SettingsExpander.Header>

                        <cwuc:SettingsExpander.Content>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <AutoSuggestBox
                                    x:Name="GroupSearchBox"
                                    Width="200"
                                    PlaceholderText="{x:Bind LocalizedStrings.Common_SearchPlaceholder}"
                                    QueryIcon="Find"
                                    TextChanged="OnGroupSearchTextChanged" />
                                <Button Padding="12,6" Click="OnAddGroupClick">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon FontSize="12" Glyph="&#xE710;" />
                                        <TextBlock VerticalAlignment="Center" Text="{x:Bind LocalizedStrings.Common_AddButton}" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </cwuc:SettingsExpander.Content>

                        <cwuc:SettingsExpander.ItemTemplate>
                            <DataTemplate x:DataType="models:AzApplicationGroupInfo">
                                <cwuc:SettingsCard Padding="16,12">
                                    <cwuc:SettingsCard.Header>
                                        <StackPanel Orientation="Horizontal" Spacing="12">
                                            <FontIcon
                                                FontSize="20"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Glyph="&#xE902;" />
                                            <StackPanel>
                                                <TextBlock Text="{x:Bind Name}" />
                                                <TextBlock
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Style="{StaticResource CaptionTextBlockStyle}"
                                                    Text="{x:Bind GroupTypeDisplayText}" />
                                                <TextBlock
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Style="{StaticResource CaptionTextBlockStyle}"
                                                    Text="{x:Bind Description}"
                                                    TextTrimming="CharacterEllipsis"
                                                    Visibility="{x:Bind Description, Converter={StaticResource StringVisibilityConverter}}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </cwuc:SettingsCard.Header>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button
                                            Padding="8"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Click="OnEditGroupClick"
                                            Tag="{x:Bind}"
                                            ToolTipService.ToolTip="{x:Bind localization:LocalizedStrings.Instance.Common_EditTooltip}">
                                            <FontIcon FontSize="16" Glyph="&#xE70F;" />
                                        </Button>
                                        <Button
                                            Padding="8"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Click="OnDeleteGroupClick"
                                            Tag="{x:Bind}"
                                            ToolTipService.ToolTip="{x:Bind localization:LocalizedStrings.Instance.Common_DeleteTooltip}">
                                            <FontIcon FontSize="16" Glyph="&#xE74D;" />
                                        </Button>
                                    </StackPanel>
                                </cwuc:SettingsCard>
                            </DataTemplate>
                        </cwuc:SettingsExpander.ItemTemplate>
                    </cwuc:SettingsExpander>

                    <!--  Role Assignments  -->
                    <cwuc:SettingsExpander IsExpanded="True" ItemsSource="{x:Bind _viewModel.FilteredRoleAssignments, Mode=OneWay}">
                        <cwuc:SettingsExpander.Header>
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <FontIcon FontSize="20" Glyph="&#xE77B;" />
                                <TextBlock VerticalAlignment="Center" Text="{x:Bind LocalizedStrings.AuthApplicationsPage_RoleAssignmentsHeader}" />
                                <TextBlock
                                    Margin="8,0,0,0"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{x:Bind _viewModel.RoleAssignmentCountText, Mode=OneWay}" />
                            </StackPanel>
                        </cwuc:SettingsExpander.Header>

                        <cwuc:SettingsExpander.Content>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <AutoSuggestBox
                                    x:Name="RoleAssignmentSearchBox"
                                    Width="200"
                                    PlaceholderText="{x:Bind LocalizedStrings.Common_SearchPlaceholder}"
                                    QueryIcon="Find"
                                    TextChanged="OnRoleAssignmentSearchTextChanged" />
                                <Button Padding="12,6" Click="OnAddRoleAssignmentClick">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon FontSize="12" Glyph="&#xE710;" />
                                        <TextBlock VerticalAlignment="Center" Text="{x:Bind LocalizedStrings.Common_AddButton}" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </cwuc:SettingsExpander.Content>

                        <cwuc:SettingsExpander.ItemTemplate>
                            <DataTemplate x:DataType="models:AzRoleAssignmentInfo">
                                <cwuc:SettingsCard
                                    Padding="16,12"
                                    Description="{x:Bind Description}"
                                    Header="{x:Bind Name}">
                                    <cwuc:SettingsCard.HeaderIcon>
                                        <FontIcon FontSize="16" Glyph="&#xE77B;" />
                                    </cwuc:SettingsCard.HeaderIcon>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button
                                            Padding="8"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Click="OnEditRoleAssignmentClick"
                                            Tag="{x:Bind}"
                                            ToolTipService.ToolTip="{x:Bind localization:LocalizedStrings.Instance.Common_EditTooltip}">
                                            <FontIcon FontSize="16" Glyph="&#xE70F;" />
                                        </Button>
                                        <Button
                                            Padding="8"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Click="OnDeleteRoleAssignmentClick"
                                            Tag="{x:Bind}"
                                            ToolTipService.ToolTip="{x:Bind localization:LocalizedStrings.Instance.Common_DeleteTooltip}">
                                            <FontIcon FontSize="16" Glyph="&#xE74D;" />
                                        </Button>
                                    </StackPanel>
                                </cwuc:SettingsCard>
                            </DataTemplate>
                        </cwuc:SettingsExpander.ItemTemplate>
                    </cwuc:SettingsExpander>

                    <!--  Scopes  -->
                    <cwuc:SettingsExpander IsExpanded="True" ItemsSource="{x:Bind _viewModel.FilteredScopes, Mode=OneWay}">
                        <cwuc:SettingsExpander.Header>
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <FontIcon FontSize="20" Glyph="&#xE8B7;" />
                                <TextBlock VerticalAlignment="Center" Text="{x:Bind LocalizedStrings.AuthApplicationsPage_ScopesHeader}" />
                                <TextBlock
                                    Margin="8,0,0,0"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{x:Bind _viewModel.ScopeCountText, Mode=OneWay}" />
                            </StackPanel>
                        </cwuc:SettingsExpander.Header>

                        <cwuc:SettingsExpander.Content>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <AutoSuggestBox
                                    x:Name="ScopeSearchBox"
                                    Width="200"
                                    PlaceholderText="{x:Bind LocalizedStrings.Common_SearchPlaceholder}"
                                    QueryIcon="Find"
                                    TextChanged="OnScopeSearchTextChanged" />
                                <Button Padding="12,6" Click="OnAddScopeClick">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon FontSize="12" Glyph="&#xE710;" />
                                        <TextBlock VerticalAlignment="Center" Text="{x:Bind LocalizedStrings.Common_AddButton}" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </cwuc:SettingsExpander.Content>

                        <cwuc:SettingsExpander.ItemTemplate>
                            <DataTemplate x:DataType="models:AzScopeInfo">
                                <cwuc:SettingsCard
                                    Padding="16,12"
                                    Click="OnScopeCardClick"
                                    IsClickEnabled="True"
                                    Tag="{x:Bind}">
                                    <cwuc:SettingsCard.Header>
                                        <StackPanel Orientation="Horizontal" Spacing="12">
                                            <FontIcon
                                                FontSize="20"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Glyph="&#xE8B7;" />
                                            <StackPanel>
                                                <TextBlock Text="{x:Bind Name}" />
                                                <TextBlock
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Style="{StaticResource CaptionTextBlockStyle}"
                                                    Text="{x:Bind Description}"
                                                    TextTrimming="CharacterEllipsis"
                                                    Visibility="{x:Bind Description, Converter={StaticResource StringVisibilityConverter}}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </cwuc:SettingsCard.Header>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button
                                            Padding="8"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Click="OnEditScopeClick"
                                            Tag="{x:Bind}"
                                            ToolTipService.ToolTip="{x:Bind localization:LocalizedStrings.Instance.AuthApplicationsPage_ScopePropertiesTooltip}">
                                            <FontIcon FontSize="16" Glyph="&#xE946;" />
                                        </Button>
                                        <Button
                                            Padding="8"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Click="OnDeleteScopeClick"
                                            Tag="{x:Bind}"
                                            ToolTipService.ToolTip="{x:Bind localization:LocalizedStrings.Instance.Common_DeleteTooltip}">
                                            <FontIcon FontSize="16" Glyph="&#xE74D;" />
                                        </Button>
                                    </StackPanel>
                                </cwuc:SettingsCard>
                            </DataTemplate>
                        </cwuc:SettingsExpander.ItemTemplate>
                    </cwuc:SettingsExpander>
                </StackPanel>

                <!--  Definitions View  -->
                <StackPanel
                    x:Name="DefinitionsPanel"
                    Spacing="8"
                    Visibility="Collapsed">

                    <!--  Role Definitions  -->
                    <cwuc:SettingsExpander IsExpanded="True" ItemsSource="{x:Bind _viewModel.FilteredRoleDefinitions, Mode=OneWay}">
                        <cwuc:SettingsExpander.Header>
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <FontIcon FontSize="20" Glyph="&#xE716;" />
                                <TextBlock VerticalAlignment="Center" Text="{x:Bind LocalizedStrings.AuthApplicationsPage_RolesHeader}" />
                                <TextBlock
                                    Margin="8,0,0,0"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{x:Bind _viewModel.RoleDefinitionCountText, Mode=OneWay}" />
                            </StackPanel>
                        </cwuc:SettingsExpander.Header>

                        <cwuc:SettingsExpander.Content>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <AutoSuggestBox
                                    x:Name="RoleSearchBox"
                                    Width="200"
                                    PlaceholderText="{x:Bind LocalizedStrings.Common_SearchPlaceholder}"
                                    QueryIcon="Find"
                                    TextChanged="OnRoleSearchTextChanged" />
                                <Button Padding="12,6" Click="OnAddRoleClick">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon FontSize="12" Glyph="&#xE710;" />
                                        <TextBlock VerticalAlignment="Center" Text="{x:Bind LocalizedStrings.Common_AddButton}" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </cwuc:SettingsExpander.Content>

                        <cwuc:SettingsExpander.ItemTemplate>
                            <DataTemplate x:DataType="models:AzRoleDefinitionInfo">
                                <cwuc:SettingsCard
                                    Padding="16,12"
                                    Description="{x:Bind Description}"
                                    Header="{x:Bind Name}">
                                    <cwuc:SettingsCard.HeaderIcon>
                                        <FontIcon FontSize="16" Glyph="&#xE716;" />
                                    </cwuc:SettingsCard.HeaderIcon>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button
                                            Padding="8"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Click="OnEditRoleDefinitionClick"
                                            Tag="{x:Bind}"
                                            ToolTipService.ToolTip="{x:Bind localization:LocalizedStrings.Instance.Common_EditTooltip}">
                                            <FontIcon FontSize="16" Glyph="&#xE70F;" />
                                        </Button>
                                        <Button
                                            Padding="8"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Click="OnDeleteRoleDefinitionClick"
                                            Tag="{x:Bind}"
                                            ToolTipService.ToolTip="{x:Bind localization:LocalizedStrings.Instance.Common_DeleteTooltip}">
                                            <FontIcon FontSize="16" Glyph="&#xE74D;" />
                                        </Button>
                                    </StackPanel>
                                </cwuc:SettingsCard>
                            </DataTemplate>
                        </cwuc:SettingsExpander.ItemTemplate>
                    </cwuc:SettingsExpander>

                    <!--  Tasks  -->
                    <cwuc:SettingsExpander IsExpanded="True" ItemsSource="{x:Bind _viewModel.FilteredTasks, Mode=OneWay}">
                        <cwuc:SettingsExpander.Header>
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <FontIcon FontSize="20" Glyph="&#xE9D5;" />
                                <TextBlock VerticalAlignment="Center" Text="{x:Bind LocalizedStrings.Common_Tasks}" />
                                <TextBlock
                                    Margin="8,0,0,0"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{x:Bind _viewModel.TaskCountText, Mode=OneWay}" />
                            </StackPanel>
                        </cwuc:SettingsExpander.Header>

                        <cwuc:SettingsExpander.Content>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <AutoSuggestBox
                                    x:Name="TaskSearchBox"
                                    Width="200"
                                    PlaceholderText="{x:Bind LocalizedStrings.Common_SearchPlaceholder}"
                                    QueryIcon="Find"
                                    TextChanged="OnTaskSearchTextChanged" />
                                <Button Padding="12,6" Click="OnAddTaskClick">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon FontSize="12" Glyph="&#xE710;" />
                                        <TextBlock VerticalAlignment="Center" Text="{x:Bind LocalizedStrings.Common_AddButton}" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </cwuc:SettingsExpander.Content>

                        <cwuc:SettingsExpander.ItemTemplate>
                            <DataTemplate x:DataType="models:AzTaskInfo">
                                <cwuc:SettingsCard
                                    Padding="16,12"
                                    Description="{x:Bind Description}"
                                    Header="{x:Bind Name}">
                                    <cwuc:SettingsCard.HeaderIcon>
                                        <FontIcon FontSize="16" Glyph="&#xE9D5;" />
                                    </cwuc:SettingsCard.HeaderIcon>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button
                                            Padding="8"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Click="OnEditTaskClick"
                                            Tag="{x:Bind}"
                                            ToolTipService.ToolTip="{x:Bind localization:LocalizedStrings.Instance.Common_EditTooltip}">
                                            <FontIcon FontSize="16" Glyph="&#xE70F;" />
                                        </Button>
                                        <Button
                                            Padding="8"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Click="OnDeleteTaskClick"
                                            Tag="{x:Bind}"
                                            ToolTipService.ToolTip="{x:Bind localization:LocalizedStrings.Instance.Common_DeleteTooltip}">
                                            <FontIcon FontSize="16" Glyph="&#xE74D;" />
                                        </Button>
                                    </StackPanel>
                                </cwuc:SettingsCard>
                            </DataTemplate>
                        </cwuc:SettingsExpander.ItemTemplate>
                    </cwuc:SettingsExpander>

                    <!--  Operations  -->
                    <cwuc:SettingsExpander IsExpanded="True" ItemsSource="{x:Bind _viewModel.FilteredOperations, Mode=OneWay}">
                        <cwuc:SettingsExpander.Header>
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <FontIcon FontSize="20" Glyph="&#xE713;" />
                                <TextBlock VerticalAlignment="Center" Text="{x:Bind LocalizedStrings.Common_Operations}" />
                                <TextBlock
                                    Margin="8,0,0,0"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{x:Bind _viewModel.OperationCountText, Mode=OneWay}" />
                            </StackPanel>
                        </cwuc:SettingsExpander.Header>

                        <cwuc:SettingsExpander.Content>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <AutoSuggestBox
                                    x:Name="OperationSearchBox"
                                    Width="200"
                                    PlaceholderText="{x:Bind LocalizedStrings.Common_SearchPlaceholder}"
                                    QueryIcon="Find"
                                    TextChanged="OnOperationSearchTextChanged" />
                                <Button Padding="12,6" Click="OnAddOperationClick">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon FontSize="12" Glyph="&#xE710;" />
                                        <TextBlock VerticalAlignment="Center" Text="{x:Bind LocalizedStrings.Common_AddButton}" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </cwuc:SettingsExpander.Content>

                        <cwuc:SettingsExpander.ItemTemplate>
                            <DataTemplate x:DataType="models:AzOperationInfo">
                                <cwuc:SettingsCard Padding="16,12">
                                    <cwuc:SettingsCard.Header>
                                        <StackPanel Orientation="Horizontal" Spacing="12">
                                            <FontIcon
                                                FontSize="20"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Glyph="&#xE713;" />
                                            <StackPanel>
                                                <TextBlock Text="{x:Bind Name}" />
                                                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}">
                                                    <Run Text="{x:Bind localization:LocalizedStrings.Instance.AuthApplicationsPage_OperationIdLabel}" />
                                                    <Run Text="{x:Bind OperationId}" />
                                                </TextBlock>
                                                <TextBlock
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Style="{StaticResource CaptionTextBlockStyle}"
                                                    Text="{x:Bind Description}"
                                                    TextTrimming="CharacterEllipsis"
                                                    Visibility="{x:Bind Description, Converter={StaticResource StringVisibilityConverter}}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </cwuc:SettingsCard.Header>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button
                                            Padding="8"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Click="OnEditOperationClick"
                                            Tag="{x:Bind}"
                                            ToolTipService.ToolTip="{x:Bind localization:LocalizedStrings.Instance.Common_EditTooltip}">
                                            <FontIcon FontSize="16" Glyph="&#xE70F;" />
                                        </Button>
                                        <Button
                                            Padding="8"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Click="OnDeleteOperationClick"
                                            Tag="{x:Bind}"
                                            ToolTipService.ToolTip="{x:Bind localization:LocalizedStrings.Instance.Common_DeleteTooltip}">
                                            <FontIcon FontSize="16" Glyph="&#xE74D;" />
                                        </Button>
                                    </StackPanel>
                                </cwuc:SettingsCard>
                            </DataTemplate>
                        </cwuc:SettingsExpander.ItemTemplate>
                    </cwuc:SettingsExpander>
                </StackPanel>

            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
