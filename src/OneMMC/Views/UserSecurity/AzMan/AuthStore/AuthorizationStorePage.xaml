<?xml version="1.0" encoding="utf-8" ?>
<!--
    AuthorizationStorePage.xaml
    
    Authorization Store Page - Display applications and groups within the store
    
    Features:
    - Display application list (expandable)
    - Display store-level group list (expandable)
    - Provide search, add, edit, delete functionality
    - Click application to navigate to AuthApplicationsPage
-->
<Page
    x:Class="OneMMC.Views.UserSecurity.AzMan.AuthStore.AuthorizationStorePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:localization="using:OneMMC.Localization"
    xmlns:converters="using:OneMMC.Converters"
    xmlns:cwuc="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:OneMMC.Core.Features.UserSecurity.Models.AzMan"
    x:Name="Root"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:StringVisibilityConverter x:Key="StringVisibilityConverter" />
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />  
            <!--  Toolbar  -->
            <RowDefinition Height="Auto" />  
            <!--  Status message  -->
            <RowDefinition Height="*" />     
            <!--  Content area  -->
        </Grid.RowDefinitions>

        <!--  Toolbar  -->
        <Grid Grid.Row="0" Padding="24,16,24,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!--  Store information  -->
            <StackPanel
                Grid.Column="0"
                Orientation="Horizontal"
                Spacing="12">
                <FontIcon FontSize="20" Glyph="&#xE8B7;" />
                <TextBlock
                    x:Name="StoreNameText"
                    VerticalAlignment="Center"
                    Style="{StaticResource SubtitleTextBlockStyle}"
                    Text="{x:Bind LocalizedStrings.AuthorizationStorePage_StoreNamePlaceholder}" />
                <Border
                    Padding="8,4"
                    VerticalAlignment="Center"
                    Background="{ThemeResource SystemFillColorNeutralBackgroundBrush}"
                    CornerRadius="4">
                    <TextBlock
                        x:Name="StoreTypeText"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="{x:Bind LocalizedStrings.AuthorizationStorePage_StoreType_Default}" />
                </Border>
            </StackPanel>

            <!--  Action buttons  -->
            <StackPanel
                Grid.Column="1"
                Orientation="Horizontal"
                Spacing="4">
                <Button
                    Padding="12,8"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="OnRefreshClick">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="14" Glyph="&#xE72C;" />
                        <TextBlock VerticalAlignment="Center" Text="{x:Bind LocalizedStrings.Common_Refresh}" />
                    </StackPanel>
                </Button>

                <Button
                    Padding="8"
                    Background="Transparent"
                    BorderThickness="0">
                    <FontIcon FontSize="16" Glyph="&#xE712;" />
                    <Button.Flyout>
                        <MenuFlyout Placement="Bottom">
                            <MenuFlyoutItem Click="OnPropertiesClick" Text="{x:Bind LocalizedStrings.AuthorizationStorePage_Properties}">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE946;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Click="OnDeleteClick" Text="{x:Bind LocalizedStrings.AuthorizationStorePage_DeleteStore}">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE74D;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem Click="OnHelpClick" Text="{x:Bind LocalizedStrings.Common_Help}">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE897;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
            </StackPanel>
        </Grid>

        <!--  Status message  -->
        <InfoBar
            x:Name="StatusInfoBar"
            Grid.Row="1"
            Margin="24,0,24,8"
            IsClosable="True"
            IsOpen="False" />

        <!--  Content area  -->
        <Grid Grid.Row="2">
            <!--  Loading indicator  -->
            <ProgressRing
                x:Name="LoadingRing"
                Width="48"
                Height="48"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                IsActive="False" />

            <ScrollViewer>
                <StackPanel Padding="24,0,24,24" Spacing="8">

                    <!--  Applications area  -->
                    <cwuc:SettingsExpander IsExpanded="False" ItemsSource="{x:Bind _viewModel.FilteredApplications, Mode=OneWay}">
                        <cwuc:SettingsExpander.Header>
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <FontIcon FontSize="20" Glyph="&#xE7EE;" />
                                <TextBlock VerticalAlignment="Center" Text="{x:Bind LocalizedStrings.AuthorizationStorePage_ApplicationsHeader}" />
                                <TextBlock
                                    Margin="8,0,0,0"
                                    VerticalAlignment="Center"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{x:Bind _viewModel.ApplicationCountText, Mode=OneWay}" />
                            </StackPanel>
                        </cwuc:SettingsExpander.Header>

                        <cwuc:SettingsExpander.Content>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <AutoSuggestBox
                                    x:Name="ApplicationSearchBox"
                                    Width="200"
                                    PlaceholderText="{x:Bind LocalizedStrings.Common_SearchPlaceholder}"
                                    QueryIcon="Find"
                                    TextChanged="OnApplicationSearchTextChanged" />

                                <Button Padding="12,6" Click="OnAddApplicationClick">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon FontSize="12" Glyph="&#xE710;" />
                                        <TextBlock VerticalAlignment="Center" Text="{x:Bind LocalizedStrings.Common_AddButton}" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </cwuc:SettingsExpander.Content>

                        <cwuc:SettingsExpander.ItemTemplate>
                            <DataTemplate x:DataType="models:AzApplicationInfo">
                                <cwuc:SettingsCard
                                    Click="OnApplicationClick"
                                    Description="{x:Bind Description}"
                                    Header="{x:Bind Name}"
                                    IsClickEnabled="True"
                                    Tag="{x:Bind}">
                                    <cwuc:SettingsCard.HeaderIcon>
                                        <FontIcon FontSize="16" Glyph="&#xE7EE;" />
                                    </cwuc:SettingsCard.HeaderIcon>

                                    <Button
                                        Padding="8"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Click="OnDeleteApplicationClick"
                                        Tag="{x:Bind}"
                                        ToolTipService.ToolTip="{x:Bind localization:LocalizedStrings.Instance.AuthorizationStorePage_DeleteApplicationTooltip}">
                                        <FontIcon FontSize="14" Glyph="&#xE74D;" />
                                    </Button>
                                </cwuc:SettingsCard>
                            </DataTemplate>
                        </cwuc:SettingsExpander.ItemTemplate>
                    </cwuc:SettingsExpander>

                    <!--  Groups area  -->
                    <cwuc:SettingsExpander
                        Margin="0,8,0,0"
                        IsExpanded="False"
                        ItemsSource="{x:Bind _viewModel.FilteredGroups, Mode=OneWay}">
                        <cwuc:SettingsExpander.Header>
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <FontIcon FontSize="20" Glyph="&#xE902;" />
                                <TextBlock VerticalAlignment="Center" Text="{x:Bind LocalizedStrings.AuthorizationStorePage_GroupsHeader}" />
                                <TextBlock
                                    Margin="8,0,0,0"
                                    VerticalAlignment="Center"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{x:Bind _viewModel.GroupCountText, Mode=OneWay}" />
                            </StackPanel>
                        </cwuc:SettingsExpander.Header>

                        <cwuc:SettingsExpander.Content>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <AutoSuggestBox
                                    x:Name="GroupSearchBox"
                                    Width="200"
                                    PlaceholderText="{x:Bind LocalizedStrings.Common_SearchPlaceholder}"
                                    QueryIcon="Find"
                                    TextChanged="OnGroupSearchTextChanged" />

                                <Button Padding="12,6" Click="OnAddGroupClick">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon FontSize="12" Glyph="&#xE710;" />
                                        <TextBlock VerticalAlignment="Center" Text="{x:Bind LocalizedStrings.Common_AddButton}" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </cwuc:SettingsExpander.Content>

                        <cwuc:SettingsExpander.ItemTemplate>
                            <DataTemplate x:DataType="models:AzApplicationGroupInfo">
                                <cwuc:SettingsCard Padding="16,12">
                                    <cwuc:SettingsCard.Header>
                                        <StackPanel Orientation="Horizontal" Spacing="12">
                                            <FontIcon
                                                VerticalAlignment="Center"
                                                FontSize="20"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Glyph="&#xE902;" />
                                            <StackPanel>
                                                <TextBlock VerticalAlignment="Center" Text="{x:Bind Name}" />
                                                <TextBlock
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Style="{StaticResource CaptionTextBlockStyle}"
                                                    Text="{x:Bind GroupTypeDisplayText}" />
                                                <TextBlock
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Style="{StaticResource CaptionTextBlockStyle}"
                                                    Text="{x:Bind Description}"
                                                    TextTrimming="CharacterEllipsis"
                                                    Visibility="{x:Bind Description, Converter={StaticResource StringVisibilityConverter}}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </cwuc:SettingsCard.Header>

                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button
                                            Padding="8"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Click="OnEditGroupClick"
                                            Tag="{x:Bind}"
                                            ToolTipService.ToolTip="{x:Bind localization:LocalizedStrings.Instance.AuthorizationStorePage_EditGroupTooltip}">
                                            <FontIcon FontSize="16" Glyph="&#xE70F;" />
                                        </Button>
                                        <Button
                                            Padding="8"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Click="OnDeleteGroupClick"
                                            Tag="{x:Bind}"
                                            ToolTipService.ToolTip="{x:Bind localization:LocalizedStrings.Instance.AuthorizationStorePage_DeleteGroupTooltip}">
                                            <FontIcon FontSize="16" Glyph="&#xE74D;" />
                                        </Button>
                                    </StackPanel>
                                </cwuc:SettingsCard>
                            </DataTemplate>
                        </cwuc:SettingsExpander.ItemTemplate>
                    </cwuc:SettingsExpander>

                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
