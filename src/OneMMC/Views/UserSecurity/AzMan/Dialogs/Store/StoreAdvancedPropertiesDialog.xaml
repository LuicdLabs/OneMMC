<?xml version="1.0" encoding="utf-8" ?>
<!--
    StoreAdvancedPropertiesDialog.xaml
    
    Store Advanced Properties Dialog - For editing advanced store settings
-->
<ContentDialog
    x:Class="OneMMC.Views.UserSecurity.AzMan.Dialogs.StoreAdvancedPropertiesDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    mc:Ignorable="d"
    Title="{x:Bind LocalizedStrings.StoreAdvancedPropertiesDialog_Title}"
    PrimaryButtonText="{x:Bind LocalizedStrings.Common_SaveButton}"
    CloseButtonText="{x:Bind LocalizedStrings.Common_CancelButton}"
    DefaultButton="Primary"
    PrimaryButtonClick="OnPrimaryButtonClick">

    <StackPanel Spacing="16" MinWidth="400">
        <!-- Error message -->
        <InfoBar x:Name="ErrorInfoBar" 
                 IsOpen="False" 
                 Severity="Error" 
                 Title="{x:Bind LocalizedStrings.Common_ErrorTitle}"
                 IsClosable="True" />

        <!-- Timeout settings -->
        <StackPanel Spacing="8">
            <TextBlock Text="{x:Bind LocalizedStrings.StoreAdvancedPropertiesDialog_TimeoutSettings_Header}" FontWeight="SemiBold" />
            
            <NumberBox x:Name="DomainTimeoutNumberBox"
                       Header="{x:Bind LocalizedStrings.StoreAdvancedPropertiesDialog_DomainTimeout_Header}"
                       Minimum="1000"
                       Maximum="300000"
                       SpinButtonPlacementMode="Compact"
                       SmallChange="1000"
                       LargeChange="5000"
                       PlaceholderText="{x:Bind LocalizedStrings.StoreAdvancedPropertiesDialog_DomainTimeout_Placeholder}" />
            
            <TextBlock Text="{x:Bind LocalizedStrings.StoreAdvancedPropertiesDialog_DomainTimeout_Description}"
                       FontSize="12"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       TextWrapping="Wrap" />
            
            <NumberBox x:Name="ScriptEngineTimeoutNumberBox"
                       Header="{x:Bind LocalizedStrings.StoreAdvancedPropertiesDialog_ScriptTimeout_Header}"
                       Minimum="1000"
                       Maximum="600000"
                       SpinButtonPlacementMode="Compact"
                       SmallChange="1000"
                       LargeChange="5000"
                       PlaceholderText="{x:Bind LocalizedStrings.StoreAdvancedPropertiesDialog_ScriptTimeout_Placeholder}" />
            
            <TextBlock Text="{x:Bind LocalizedStrings.StoreAdvancedPropertiesDialog_ScriptTimeout_Description}"
                       FontSize="12"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       TextWrapping="Wrap" />
        </StackPanel>

        <!-- Script engine settings -->
        <StackPanel Spacing="8">
            <TextBlock Text="{x:Bind LocalizedStrings.StoreAdvancedPropertiesDialog_ScriptEngineSettings_Header}" FontWeight="SemiBold" />
            
            <NumberBox x:Name="MaxScriptEnginesNumberBox"
                       Header="{x:Bind LocalizedStrings.StoreAdvancedPropertiesDialog_MaxScriptEngines_Header}"
                       Minimum="1"
                       Maximum="1000"
                       SpinButtonPlacementMode="Compact"
                       SmallChange="10"
                       LargeChange="50"
                       PlaceholderText="{x:Bind LocalizedStrings.StoreAdvancedPropertiesDialog_MaxScriptEngines_Placeholder}" />
            
            <TextBlock Text="{x:Bind LocalizedStrings.StoreAdvancedPropertiesDialog_MaxScriptEngines_Description}"
                       FontSize="12"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       TextWrapping="Wrap" />
        </StackPanel>

        <!-- Target machine (read-only info) -->
        <StackPanel Spacing="8">
            <TextBlock Text="{x:Bind LocalizedStrings.StoreAdvancedPropertiesDialog_TargetMachine_Header}" FontWeight="SemiBold" />
            
            <TextBox x:Name="TargetMachineTextBox"
                     Header="{x:Bind LocalizedStrings.StoreAdvancedPropertiesDialog_TargetMachine_NameHeader}"
                     IsReadOnly="True"
                     PlaceholderText="{x:Bind LocalizedStrings.StoreAdvancedPropertiesDialog_TargetMachine_Placeholder}" />
        </StackPanel>

        <!-- Reset to defaults -->
        <Button x:Name="ResetButton" 
            Content="{x:Bind LocalizedStrings.StoreAdvancedPropertiesDialog_ResetButton}" 
                Click="OnResetClick"
                HorizontalAlignment="Left" />
    </StackPanel>
</ContentDialog>
