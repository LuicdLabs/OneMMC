<?xml version="1.0" encoding="utf-8" ?>
<!--
    CreateStoreDialog.xaml
    
    Create New Authorization Store Dialog
    Supports three store types: XML file, Active Directory, SQL Server
-->
<ContentDialog
    x:Class="OneMMC.Views.UserSecurity.AzMan.Dialogs.CreateStoreDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:models="using:OneMMC.Core.Features.PCManagement.Models.LusrMgr"
    xmlns:localization="using:OneMMC.Localization"
    mc:Ignorable="d"
    Title="{x:Bind LocalizedStrings.CreateStoreDialog_Title}"
    PrimaryButtonText="{x:Bind LocalizedStrings.Common_CreateButton}"
    CloseButtonText="{x:Bind LocalizedStrings.Common_CancelButton}"
    DefaultButton="Primary"
    PrimaryButtonClick="OnPrimaryButtonClick">
    <ContentDialog.Resources>
        <localization:LocalizedStrings x:Key="LocalizedStrings" />
    </ContentDialog.Resources>

    <StackPanel Spacing="16" MinWidth="450" MaxWidth="560">
        <TextBlock
            Text="{x:Bind LocalizedStrings.CreateStoreDialog_Subtitle}"
            Style="{StaticResource BodyTextBlockStyle}"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

        <!-- Store type selection -->
        <StackPanel Spacing="8">
            <TextBlock Text="{x:Bind LocalizedStrings.CreateStoreDialog_StoreType_Label}" Style="{StaticResource BodyStrongTextBlockStyle}" />
            <ComboBox x:Name="StoreTypeComboBox" 
                      HorizontalAlignment="Stretch"
                      SelectionChanged="OnStoreTypeChanged">
                <ComboBoxItem Content="{x:Bind LocalizedStrings.CreateStoreDialog_StoreType_Xml}" Tag="Xml" IsSelected="True" />
                <ComboBoxItem Content="{x:Bind LocalizedStrings.CreateStoreDialog_StoreType_ActiveDirectory}" Tag="ActiveDirectory" />
                <ComboBoxItem Content="{x:Bind LocalizedStrings.CreateStoreDialog_StoreType_SqlServer}" Tag="SqlServer" />
            </ComboBox>
        </StackPanel>

        <!-- XML file path -->
        <StackPanel x:Name="XmlPathPanel" Spacing="8">
            <TextBlock Text="{x:Bind LocalizedStrings.CreateStoreDialog_XmlPath_Label}" Style="{StaticResource BodyStrongTextBlockStyle}" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="XmlPathTextBox" 
                         PlaceholderText="{x:Bind LocalizedStrings.CreateStoreDialog_XmlPath_Placeholder}"
                         Grid.Column="0" />
                <Button Content="{x:Bind LocalizedStrings.CreateStoreDialog_Browse_Button}" 
                        Grid.Column="1" 
                        Margin="8,0,0,0"
                        Click="OnBrowseClick" />
            </Grid>
        </StackPanel>

        <!-- Active Directory path -->
        <StackPanel x:Name="AdPathPanel" Spacing="8" Visibility="Collapsed">
            <TextBlock Text="{x:Bind LocalizedStrings.CreateStoreDialog_AdPath_Label}" Style="{StaticResource BodyStrongTextBlockStyle}" />
            <TextBox x:Name="AdPathTextBox" 
                     PlaceholderText="{x:Bind LocalizedStrings.CreateStoreDialog_AdPath_Placeholder}" />
            <TextBlock Text="{x:Bind LocalizedStrings.CreateStoreDialog_AdPath_Example}" 
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <!-- SQL Server connection string -->
        <StackPanel x:Name="SqlPathPanel" Spacing="8" Visibility="Collapsed">
            <TextBlock Text="{x:Bind LocalizedStrings.CreateStoreDialog_Sql_Label}" Style="{StaticResource BodyStrongTextBlockStyle}" />
            <TextBox x:Name="SqlServerTextBox" 
                     PlaceholderText="{x:Bind LocalizedStrings.CreateStoreDialog_Sql_Server_Placeholder}" />
            <TextBox x:Name="SqlDatabaseTextBox" 
                     PlaceholderText="{x:Bind LocalizedStrings.CreateStoreDialog_Sql_Database_Placeholder}" />
            <TextBox x:Name="SqlStoreNameTextBox" 
                     PlaceholderText="{x:Bind LocalizedStrings.CreateStoreDialog_Sql_Store_Placeholder}" />
            <TextBlock Text="{x:Bind LocalizedStrings.CreateStoreDialog_Sql_Format}" 
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <!-- Description -->
        <StackPanel Spacing="8">
            <TextBlock Text="{x:Bind LocalizedStrings.CreateStoreDialog_Description_Label}" Style="{StaticResource BodyStrongTextBlockStyle}" />
            <TextBox x:Name="DescriptionTextBox" 
                     PlaceholderText="{x:Bind LocalizedStrings.CreateStoreDialog_Description_Placeholder}"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     Height="80" />
        </StackPanel>

        <!-- Error message -->
        <InfoBar x:Name="ErrorInfoBar"
                 IsOpen="False"
                 Severity="Error"
                 Title="{x:Bind LocalizedStrings.Common_ErrorTitle}" />
    </StackPanel>
</ContentDialog>
