<?xml version="1.0" encoding="utf-8" ?>
<!--
    PolicyUsersDialog.xaml
    
    Policy Users Dialog - For managing Policy Administrators, Readers, and Delegated Users
-->
<ContentDialog
    x:Class="OneMMC.Views.UserSecurity.AzMan.Dialogs.PolicyUsersDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    mc:Ignorable="d"
    Title="{x:Bind LocalizedStrings.PolicyUsersDialog_Title}"
    CloseButtonText="{x:Bind LocalizedStrings.Common_CloseButton}"
    DefaultButton="Close">

    <Grid MinWidth="500" MinHeight="400" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Error/Info message -->
        <InfoBar x:Name="MessageInfoBar" 
                 Grid.Row="0"
                 IsOpen="False" 
                 Severity="Informational" 
                 Title="{x:Bind LocalizedStrings.Common_InformationTitle}"
                 IsClosable="True" />

        <!-- Tab selection -->
        <NavigationView x:Name="PolicyTypeNav"
                        Grid.Row="1"
                        PaneDisplayMode="Top"
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="False"
                        SelectionChanged="OnPolicyTypeChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="{x:Bind LocalizedStrings.PolicyUsersDialog_Tab_Administrators}" Tag="Administrators">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE7EE;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="{x:Bind LocalizedStrings.PolicyUsersDialog_Tab_Readers}" Tag="Readers">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8F6;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="{x:Bind LocalizedStrings.PolicyUsersDialog_Tab_Delegated}" Tag="Delegated">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE716;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
        </NavigationView>

        <!-- User list -->
        <Border Grid.Row="2" 
                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" 
                BorderThickness="1" 
                CornerRadius="4">
            <Grid>
                <ListView x:Name="UsersListView"
                          SelectionMode="Single"
                          Padding="4">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="8,4" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Grid.Column="0" Glyph="&#xE77B;" FontSize="16" />
                                <TextBlock Grid.Column="1" Text="{Binding}" VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <!-- Empty state -->
                <StackPanel x:Name="EmptyStatePanel"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Visibility="Collapsed">
                    <FontIcon Glyph="&#xE716;" FontSize="48" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="{x:Bind LocalizedStrings.PolicyUsersDialog_EmptyState}" 
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               HorizontalAlignment="Center"
                               Margin="0,8,0,0" />
                </StackPanel>

                <!-- Loading indicator -->
                <ProgressRing x:Name="LoadingRing"
                              IsActive="False"
                              Width="32"
                              Height="32"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- Action buttons -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button x:Name="AddButton" 
                    Content="{x:Bind LocalizedStrings.Common_AddButtonEllipsis}" 
                    Click="OnAddClick"
                    Style="{StaticResource AccentButtonStyle}">
                <Button.KeyboardAccelerators>
                    <KeyboardAccelerator Modifiers="Control" Key="N" />
                </Button.KeyboardAccelerators>
            </Button>
            <Button x:Name="RemoveButton" 
                    Content="{x:Bind LocalizedStrings.Common_RemoveButton}" 
                    Click="OnRemoveClick"
                    IsEnabled="False">
                <Button.KeyboardAccelerators>
                    <KeyboardAccelerator Key="Delete" />
                </Button.KeyboardAccelerators>
            </Button>
        </StackPanel>
    </Grid>
</ContentDialog>
