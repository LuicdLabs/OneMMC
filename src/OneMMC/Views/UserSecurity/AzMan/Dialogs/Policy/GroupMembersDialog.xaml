<?xml version="1.0" encoding="utf-8" ?>
<!--
    GroupMembersDialog.xaml

    Group Members Management Dialog - Manage group members and non-members
-->
<ContentDialog
    x:Class="OneMMC.Views.UserSecurity.AzMan.Dialogs.GroupMembersDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    mc:Ignorable="d"
    Title="{x:Bind LocalizedStrings.GroupMembersDialog_Title}"
    PrimaryButtonText="{x:Bind LocalizedStrings.Common_SaveButton}"
    CloseButtonText="{x:Bind LocalizedStrings.Common_CancelButton}"
    DefaultButton="Primary"
    PrimaryButtonClick="OnPrimaryButtonClick">

    <Grid MinWidth="700" MinHeight="460">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <InfoBar x:Name="ErrorInfoBar"
                 Grid.Row="0"
                 IsOpen="False"
                 Severity="Error"
                 Title="{x:Bind LocalizedStrings.Common_ErrorTitle}"
                 IsClosable="True"
                 Margin="0,0,0,12" />

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <SelectorBar x:Name="GroupMembersSelectorBar" SelectionChanged="GroupMembersSelectorBar_SelectionChanged">
                <SelectorBarItem x:Name="GeneralTabItem" IsSelected="True" Tag="General" Text="{x:Bind LocalizedStrings.GroupMembersDialog_Tab_General}" />
                <SelectorBarItem x:Name="QueryTabItem" Tag="Query" Text="{x:Bind LocalizedStrings.GroupMembersDialog_Tab_Query}" />
                <SelectorBarItem x:Name="MembersTabItem" Tag="Members" Text="{x:Bind LocalizedStrings.GroupMembersDialog_Tab_Members}" />
                <SelectorBarItem x:Name="ExclusionsTabItem" Tag="Exclusions" Text="{x:Bind LocalizedStrings.GroupMembersDialog_Tab_Exclusions}" />
            </SelectorBar>

            <Grid Grid.Row="1" Margin="0,12,0,0">
                <ScrollViewer x:Name="GeneralPanel" Visibility="Visible">
                    <StackPanel Spacing="12" Padding="0,0,0,4">
                        <TextBox x:Name="GroupNameTextBox" Header="{x:Bind LocalizedStrings.GroupMembersDialog_Name_Header}" IsReadOnly="True" />
                        <TextBox x:Name="GroupDescriptionTextBox" Header="{x:Bind LocalizedStrings.GroupMembersDialog_Description_Header}" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" MaxHeight="110" />
                        <TextBox x:Name="GroupTypeTextBox" Header="{x:Bind LocalizedStrings.GroupMembersDialog_GroupType_Header}" IsReadOnly="True" />
                        <Button x:Name="EditBusinessRuleScriptButton"
                                Visibility="Collapsed"
                                Click="OnEditBusinessRuleScriptClick"
                                HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE70F;" FontSize="12" />
                                <TextBlock Text="{x:Bind LocalizedStrings.GroupMembersDialog_BusinessRuleScript_Title}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer x:Name="QueryPanel" Visibility="Collapsed">
                    <StackPanel Spacing="8">
                        <TextBox x:Name="LdapQueryTextBox" Header="{x:Bind LocalizedStrings.GroupMembersDialog_LdapQuery_Header}" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="180" />
                    </StackPanel>
                </ScrollViewer>

                <Grid x:Name="MembersPanel" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="{x:Bind LocalizedStrings.GroupMembersDialog_WindowsMembers_Header}" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
                            <Button x:Name="AddMemberButton" Click="OnAddMemberClick">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE710;" FontSize="12" />
                                    <TextBlock Text="{x:Bind LocalizedStrings.Common_AddButtonEllipsis}" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="RemoveMemberButton" Click="OnRemoveMemberClick">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE74D;" FontSize="12" />
                                    <TextBlock Text="{x:Bind LocalizedStrings.Common_RemoveButton}" />
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <ListView x:Name="MembersListView"
                                  Grid.Row="2"
                                  SelectionMode="Extended"
                                  BorderThickness="1"
                                  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                  CornerRadius="4" />
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,8,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="{x:Bind LocalizedStrings.GroupMembersDialog_AppGroupMembers_Header}" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
                            <Button Click="OnAddAppMemberClick">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE710;" FontSize="12" />
                                    <TextBlock Text="{x:Bind LocalizedStrings.Common_AddButtonEllipsis}" />
                                </StackPanel>
                            </Button>
                            <Button Click="OnRemoveAppMemberClick">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE74D;" FontSize="12" />
                                    <TextBlock Text="{x:Bind LocalizedStrings.Common_RemoveButton}" />
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <ListView x:Name="AppMemberLinksListView"
                                  Grid.Row="2"
                                  SelectionMode="Extended"
                                  BorderThickness="1"
                                  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                  CornerRadius="4" />
                    </Grid>
                </Grid>

                <Grid x:Name="ExclusionsPanel" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="{x:Bind LocalizedStrings.GroupMembersDialog_WindowsExclusions_Header}" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
                            <Button x:Name="AddNonMemberButton" Click="OnAddNonMemberClick">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE710;" FontSize="12" />
                                    <TextBlock Text="{x:Bind LocalizedStrings.Common_AddButtonEllipsis}" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="RemoveNonMemberButton" Click="OnRemoveNonMemberClick">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE74D;" FontSize="12" />
                                    <TextBlock Text="{x:Bind LocalizedStrings.Common_RemoveButton}" />
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <ListView x:Name="NonMembersListView"
                                  Grid.Row="2"
                                  SelectionMode="Extended"
                                  BorderThickness="1"
                                  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                  CornerRadius="4" />
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,8,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="{x:Bind LocalizedStrings.GroupMembersDialog_AppGroupExclusions_Header}" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
                            <Button Click="OnAddAppNonMemberClick">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE710;" FontSize="12" />
                                    <TextBlock Text="{x:Bind LocalizedStrings.Common_AddButtonEllipsis}" />
                                </StackPanel>
                            </Button>
                            <Button Click="OnRemoveAppNonMemberClick">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE74D;" FontSize="12" />
                                    <TextBlock Text="{x:Bind LocalizedStrings.Common_RemoveButton}" />
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <ListView x:Name="AppNonMemberLinksListView"
                                  Grid.Row="2"
                                  SelectionMode="Extended"
                                  BorderThickness="1"
                                  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                  CornerRadius="4" />
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</ContentDialog>
