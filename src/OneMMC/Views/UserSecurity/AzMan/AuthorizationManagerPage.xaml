<?xml version="1.0" encoding="utf-8" ?>
<!--
    AuthorizationManagerPage.xaml
    
    Authorization Manager Main Page - Display all authorization stores
    
    Features:
    - Display authorization store list (supports XML, AD, SQL Server)
    - Provide search, add, and open store functionality
    - Click store to navigate to AuthorizationStorePage
    
    Navigation hierarchy: UserSecurity → AuthorizationManager → AuthorizationStore → AuthApplications
-->
<Page
    x:Class="OneMMC.Views.UserSecurity.AzMan.AuthorizationManagerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:azman="using:OneMMC.Core.Features.UserSecurity.Models.AzMan"
    xmlns:cwuc="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    x:Name="Root"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />  
            <!--  Toolbar area  -->
            <RowDefinition Height="Auto" />  
            <!--  Deprecate message  -->
            <RowDefinition Height="Auto" />  
            <!--  Status message  -->
            <RowDefinition Height="*" />     
            <!--  Content area  -->
        </Grid.RowDefinitions>

        <!--  Toolbar: Search box, store count, action buttons  -->
        <Grid Grid.Row="0" Padding="24,16,24,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <!--  Search box  -->
                <ColumnDefinition Width="Auto" />
                <!--  Store count  -->
                <ColumnDefinition Width="*" />
                <!--  Flexible space  -->
                <ColumnDefinition Width="Auto" />
                <!--  Action buttons  -->
            </Grid.ColumnDefinitions>

            <!--  Search box: Filter authorization stores  -->
            <AutoSuggestBox
                x:Name="SearchBox"
                Grid.Column="0"
                Width="200"
                PlaceholderText="{x:Bind LocalizedStrings.AuthorizationManagerPage_SearchPlaceholder}"
                QueryIcon="Find"
                TextChanged="OnSearchTextChanged" />

            <!--  Store count  -->
            <TextBlock
                x:Name="StoreCountTextBlock"
                Grid.Column="1"
                Margin="16,0,0,0"
                VerticalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="{x:Bind LocalizedStrings.AuthorizationManagerPage_StoreCount_Default}" />

            <!--  Action buttons area  -->
            <StackPanel
                Grid.Column="3"
                Orientation="Horizontal"
                Spacing="4">

                <!--  New button: Create new authorization store  -->
                <Button
                    Padding="12,8"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="OnAddClick"
                    ToolTipService.ToolTip="{x:Bind LocalizedStrings.AuthorizationManagerPage_NewTooltip}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="14" Glyph="&#xE710;" />
                        <TextBlock VerticalAlignment="Center" Text="{x:Bind LocalizedStrings.AuthorizationManagerPage_NewButton}" />
                    </StackPanel>
                </Button>

                <!--  Open button: Open existing authorization store  -->
                <Button
                    Padding="12,8"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="OnOpenClick"
                    ToolTipService.ToolTip="{x:Bind LocalizedStrings.AuthorizationManagerPage_OpenTooltip}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="14" Glyph="&#xE8E5;" />
                        <TextBlock VerticalAlignment="Center" Text="{x:Bind LocalizedStrings.Common_OpenButton}" />
                    </StackPanel>
                </Button>

                <!--  More options button  -->
                <Button
                    Padding="8"
                    Background="Transparent"
                    BorderThickness="0"
                    ToolTipService.ToolTip="{x:Bind LocalizedStrings.Common_MoreOptionsTooltip}">
                    <FontIcon FontSize="16" Glyph="&#xE712;" />
                    <Button.Flyout>
                        <MenuFlyout Placement="Bottom">
                            <MenuFlyoutItem
                                Click="OnRefreshClick"
                                Icon="Refresh"
                                Text="{x:Bind LocalizedStrings.AuthorizationManagerPage_RefreshAll}" />
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem Click="OnHelpClick" Text="{x:Bind LocalizedStrings.Common_Help}">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE897;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
            </StackPanel>
        </Grid>

        <!--  Information block  -->
        <InfoBar
            Title="{x:Bind LocalizedStrings.AuthorizationManagerPage_Deprecation_Title}"
            Grid.Row="1"
            Margin="24,0,24,8"
            IsClosable="False"
            IsOpen="True"
            Message="{x:Bind LocalizedStrings.AuthorizationManagerPage_Deprecation_Message}"
            Severity="Informational">
            <InfoBar.ActionButton>
                <HyperlinkButton Content="{x:Bind LocalizedStrings.Common_LearnMore}" NavigateUri="https://learn.microsoft.com/en-us/entra/identity/role-based-access-control/custom-overview" />
            </InfoBar.ActionButton>
        </InfoBar>

        <!--  Status message  -->
        <InfoBar
            x:Name="StatusInfoBar"
            Grid.Row="2"
            Margin="24,0,24,8"
            IsClosable="True"
            IsOpen="False" />

        <!--  Content area: Authorization store list  -->
        <Grid Grid.Row="3">
            <!--  Loading indicator  -->
            <ProgressRing
                x:Name="LoadingRing"
                Width="48"
                Height="48"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                IsActive="False" />

            <!--  Empty state prompt  -->
            <StackPanel
                x:Name="EmptyStatePanel"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="16"
                Visibility="Collapsed">
                <FontIcon
                    FontSize="48"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Glyph="&#xE8B7;" />
                <TextBlock
                    HorizontalAlignment="Center"
                    Style="{StaticResource SubtitleTextBlockStyle}"
                    Text="{x:Bind LocalizedStrings.AuthorizationManagerPage_EmptyTitle}" />
                <TextBlock
                    HorizontalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{x:Bind LocalizedStrings.AuthorizationManagerPage_EmptySubtitle}" />
            </StackPanel>

            <!--  Store list  -->
            <ScrollViewer x:Name="StoreListScrollViewer">
                <ItemsRepeater x:Name="StoreItemsRepeater" Margin="24,0,24,24">
                    <ItemsRepeater.Layout>
                        <StackLayout Spacing="2" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="azman:AzAuthorizationStoreInfo">
                            <cwuc:SettingsCard
                                Click="OnStoreClick"
                                Description="{x:Bind Description}"
                                Header="{x:Bind Name}"
                                IsClickEnabled="True"
                                Tag="{x:Bind}">
                                <cwuc:SettingsCard.HeaderIcon>
                                    <FontIcon Glyph="&#xE8B7;" />
                                </cwuc:SettingsCard.HeaderIcon>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <!--  Store type label  -->
                                    <Border
                                        Padding="8,4"
                                        Background="{ThemeResource SystemFillColorNeutralBackgroundBrush}"
                                        CornerRadius="4">
                                        <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind StoreType}" />
                                    </Border>
                                    <!--  Close button  -->
                                    <Button
                                        Padding="8"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Click="OnCloseStoreClick"
                                        Tag="{x:Bind}"
                                        ToolTipService.ToolTip="{Binding ElementName=Root, Path=LocalizedStrings.AuthorizationManagerPage_CloseStoreTooltip}">
                                        <FontIcon FontSize="14" Glyph="&#xE8BB;" />
                                    </Button>
                                </StackPanel>
                            </cwuc:SettingsCard>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
