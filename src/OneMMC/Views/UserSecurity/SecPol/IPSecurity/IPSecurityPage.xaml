<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="OneMMC.Views.IPSecurityPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ipsec="using:OneMMC.Core.Features.UserSecurity.Models.SecPol.IPSecurity"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <CommandBar
            Grid.Row="0"
            AutomationProperties.AutomationId="IPSecurityCommandBar"
            DefaultLabelPosition="Right">
            <AppBarButton
                AutomationProperties.AutomationId="IPSecurityNewButton"
                Click="NewItemButton_Click"
                Icon="Add"
                IsEnabled="{x:Bind ViewModel.CanCreateItem, Mode=OneWay}"
                Label="{x:Bind LocalizedStrings.IPSec_Command_New}" />
            <AppBarButton
                AutomationProperties.AutomationId="IPSecurityEditButton"
                Click="EditItemButton_Click"
                Icon="Edit"
                IsEnabled="{x:Bind ViewModel.CanEditSelectedItem, Mode=OneWay}"
                Label="{x:Bind LocalizedStrings.IPSec_Command_Edit}" />
            <AppBarButton
                AutomationProperties.AutomationId="IPSecurityDeleteButton"
                Click="DeleteItemButton_Click"
                Icon="Delete"
                IsEnabled="{x:Bind ViewModel.CanDeleteSelectedItem, Mode=OneWay}"
                Label="{x:Bind LocalizedStrings.IPSec_Command_Delete}" />
            <AppBarSeparator />
            <AppBarButton
                AutomationProperties.AutomationId="IPSecurityAssignButton"
                Click="AssignPolicyButton_Click"
                IsEnabled="{x:Bind ViewModel.CanAssignSelectedPolicy, Mode=OneWay}"
                Label="{x:Bind LocalizedStrings.IPSec_Command_Assign}">
                <AppBarButton.Icon>
                    <FontIcon Glyph="&#xE73E;" />
                </AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton
                AutomationProperties.AutomationId="IPSecurityUnassignButton"
                Click="UnassignPolicyButton_Click"
                IsEnabled="{x:Bind ViewModel.CanUnassignSelectedPolicy, Mode=OneWay}"
                Label="{x:Bind LocalizedStrings.IPSec_Command_Unassign}">
                <AppBarButton.Icon>
                    <FontIcon Glyph="&#xE711;" />
                </AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton
                AutomationProperties.AutomationId="IPSecurityManageRulesButton"
                Click="ManageRulesButton_Click"
                Icon="Bullets"
                IsEnabled="{x:Bind ViewModel.CanManageSelectedPolicyRules, Mode=OneWay}"
                Label="{x:Bind LocalizedStrings.IPSec_Command_ManageRules}" />
            <AppBarSeparator />
            <AppBarButton
                AutomationProperties.AutomationId="IPSecurityManageFiltersActionsButton"
                Click="ManageFiltersActionsButton_Click"
                Icon="List"
                Label="{x:Bind LocalizedStrings.IPSec_Command_ManageFiltersActions}" />
            <AppBarButton
                AutomationProperties.AutomationId="IPSecurityViewDetailsButton"
                Click="ViewDetailsButton_Click"
                IsEnabled="{x:Bind ViewModel.CanViewSelectedPolicyDetails, Mode=OneWay}"
                Label="{x:Bind LocalizedStrings.IPSec_Command_ViewDetails}">
                <AppBarButton.Icon>
                    <FontIcon Glyph="&#xE8A5;" />
                </AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton
                AutomationProperties.AutomationId="IPSecurityRefreshButton"
                Click="RefreshButton_Click"
                Icon="Refresh"
                Label="{x:Bind LocalizedStrings.Common_Refresh}" />
        </CommandBar>

        <InfoBar
            x:Name="ErrorInfoBar"
            Title="{x:Bind LocalizedStrings.Common_ErrorTitle}"
            Grid.Row="1"
            Margin="24,0,24,12"
            IsClosable="True"
            IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
            Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
            Severity="Error" />

        <TextBlock
            Grid.Row="2"
            Margin="24,0,24,12"
            Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
            Style="{StaticResource CaptionTextBlockStyle}"
            Text="{x:Bind LocalizedStrings.IPSec_PageDescription}"
            TextWrapping="Wrap" />

        <Grid Grid.Row="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <AutoSuggestBox
                x:Name="SearchBox"
                AutomationProperties.AutomationId="IPSecuritySearchBox"
                MaxWidth="320"
                Margin="16,0,16,8"
                HorizontalAlignment="Right"
                PlaceholderText="{x:Bind LocalizedStrings.Common_SearchPlaceholder}"
                QueryIcon="Find"
                TextChanged="SearchBox_TextChanged" />

            <Grid
                Grid.Row="1"
                Margin="16,0,16,0"
                ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="2*" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    FontWeight="SemiBold"
                    Text="{x:Bind LocalizedStrings.IPSec_Column_Name}"
                    TextWrapping="WrapWholeWords" />
                <TextBlock
                    Grid.Column="1"
                    FontWeight="SemiBold"
                    Text="{x:Bind LocalizedStrings.IPSec_Column_Description}"
                    TextWrapping="WrapWholeWords" />
                <TextBlock
                    Grid.Column="2"
                    FontWeight="SemiBold"
                    Text="{x:Bind LocalizedStrings.IPSec_Column_PolicyAssigned}"
                    TextWrapping="WrapWholeWords" />
                <TextBlock
                    Grid.Column="3"
                    FontWeight="SemiBold"
                    Text="{x:Bind LocalizedStrings.IPSec_Column_LastModified}"
                    TextWrapping="WrapWholeWords" />
            </Grid>

            <ListView
                x:Name="PolicyListView"
                AutomationProperties.AutomationId="IPSecurityItemsList"
                Grid.Row="2"
                Padding="4,8,12,12"
                DoubleTapped="PolicyListView_DoubleTapped"
                ItemsSource="{x:Bind ViewModel.Items, Mode=OneWay}"
                SelectedItem="{x:Bind ViewModel.SelectedPolicy, Mode=TwoWay}"
                SelectionMode="Single">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="ipsec:IPSecurityPolicyRow">
                        <Grid MinHeight="48" ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="3*" />
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="2*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                VerticalAlignment="Center"
                                Text="{x:Bind Name}"
                                TextTrimming="CharacterEllipsis"
                                TextWrapping="NoWrap"
                                ToolTipService.ToolTip="{x:Bind Name}" />
                            <TextBlock
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                                Text="{x:Bind Description}"
                                TextTrimming="CharacterEllipsis"
                                TextWrapping="NoWrap"
                                ToolTipService.ToolTip="{x:Bind Description}" />
                            <TextBlock
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                Text="{x:Bind PolicyAssigned}"
                                TextTrimming="CharacterEllipsis"
                                TextWrapping="NoWrap"
                                ToolTipService.ToolTip="{x:Bind PolicyAssigned}" />
                            <TextBlock
                                Grid.Column="3"
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                                Text="{x:Bind LastModified}"
                                TextTrimming="CharacterEllipsis"
                                TextWrapping="NoWrap"
                                ToolTipService.ToolTip="{x:Bind LastModified}" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <StackPanel
                Grid.Row="2"
                MaxWidth="420"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="12"
                Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <FontIcon
                    HorizontalAlignment="Center"
                    FontSize="32"
                    Glyph="&#xE946;" />
                <TextBlock
                    HorizontalAlignment="Center"
                    Text="{x:Bind ViewModel.EmptyMessage, Mode=OneWay}"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
            </StackPanel>

            <ProgressRing
                Grid.RowSpan="3"
                Width="50"
                Height="50"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />
        </Grid>
    </Grid>
</Page>
