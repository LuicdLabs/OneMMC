<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="OneMMC.Views.UserSecurity.SecPol.IPSecurity.Manage.IPSecurityManageListsActionsControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:OneMMC.Views.UserSecurity.SecPol.IPSecurity.Manage"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <muxc:SelectorBar
            x:Name="SectionSelectorBar"
            Margin="4,0,4,8"
            AutomationProperties.AutomationId="IPSecurityManageSelectorBar"
            SelectionChanged="SectionSelectorBar_SelectionChanged">
            <muxc:SelectorBarItem
                x:Name="FilterListsTab"
                Tag="Lists"
                Text="{x:Bind LocalizedStrings.IPSec_Section_FilterLists}" />
            <muxc:SelectorBarItem
                x:Name="FilterActionsTab"
                Tag="Actions"
                Text="{x:Bind LocalizedStrings.IPSec_Section_FilterActions}" />
        </muxc:SelectorBar>

        <CommandBar
            Grid.Row="1"
            AutomationProperties.AutomationId="IPSecurityManageCommandBar"
            Background="Transparent"
            DefaultLabelPosition="Right">
            <AppBarButton
                x:Name="AddButton"
                AutomationProperties.AutomationId="IPSecurityManageAddButton"
                Click="AddButton_Click"
                Icon="Add"
                Label="{x:Bind LocalizedStrings.IPSec_Command_New}" />
            <AppBarButton
                x:Name="EditButton"
                AutomationProperties.AutomationId="IPSecurityManageEditButton"
                Click="EditButton_Click"
                Icon="Edit"
                Label="{x:Bind LocalizedStrings.IPSec_Command_Edit}" />
            <AppBarButton
                x:Name="DeleteButton"
                AutomationProperties.AutomationId="IPSecurityManageDeleteButton"
                Click="DeleteButton_Click"
                Icon="Delete"
                Label="{x:Bind LocalizedStrings.IPSec_Command_Delete}" />
        </CommandBar>

        <InfoBar
            x:Name="ErrorInfoBar"
            Grid.Row="2"
            Margin="4,0,4,12"
            IsClosable="True"
            IsOpen="False"
            Severity="Error"
            Title="{x:Bind LocalizedStrings.Common_ErrorTitle}" />

        <Grid
            Grid.Row="3"
            Margin="12,0,20,4"
            ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="3*" />
            </Grid.ColumnDefinitions>
            <TextBlock
                FontWeight="SemiBold"
                Text="{x:Bind LocalizedStrings.IPSec_Column_Name}"
                TextWrapping="WrapWholeWords" />
            <TextBlock
                Grid.Column="1"
                FontWeight="SemiBold"
                Text="{x:Bind LocalizedStrings.IPSec_Column_Description}"
                TextWrapping="WrapWholeWords" />
        </Grid>

        <ListView
            x:Name="ItemsListView"
            Grid.Row="4"
            Padding="0,4,8,8"
            AutomationProperties.AutomationId="IPSecurityManageList"
            DoubleTapped="ItemsListView_DoubleTapped"
            SelectionChanged="ItemsListView_SelectionChanged"
            SelectionMode="Single">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="local:IPSecurityManageListItem">
                    <Grid MinHeight="48" ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="3*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            VerticalAlignment="Center"
                            Text="{x:Bind Name}"
                            TextTrimming="CharacterEllipsis"
                            ToolTipService.ToolTip="{x:Bind Name}" />
                        <TextBlock
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                            Text="{x:Bind Description}"
                            TextTrimming="CharacterEllipsis"
                            ToolTipService.ToolTip="{x:Bind Description}" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <ProgressRing
            x:Name="BusyProgressRing"
            Grid.RowSpan="5"
            Width="52"
            Height="52"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            IsActive="False"
            Visibility="Collapsed" />
    </Grid>
</UserControl>
