<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="OneMMC.Views.UserSecurity.SecPol.IPSecurity.Manage.IPSecurityManageListsActionsControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:OneMMC.Views.UserSecurity.SecPol.IPSecurity.Manage">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///Views/UserSecurity/SecPol/IPSecurity/IPSecurityEditorResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <!--
        SelectorBar chooses the collection, one button row acts on it, and each row shows the name
        with its description underneath. Two columns of trimmed text needed a header row to be
        readable; a two-line row does not, so the header is gone.
    -->
    <Grid MinWidth="680" RowSpacing="4">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <SelectorBar
            x:Name="SectionSelectorBar"
            Grid.Row="0"
            AutomationProperties.AutomationId="IPSecurityManageSelectorBar"
            SelectionChanged="SectionSelectorBar_SelectionChanged">
            <SelectorBarItem
                x:Name="FilterListsTab"
                Tag="Lists"
                Text="{x:Bind LocalizedStrings.IPSec_Section_FilterLists}" />
            <SelectorBarItem
                x:Name="FilterActionsTab"
                Tag="Actions"
                Text="{x:Bind LocalizedStrings.IPSec_Section_FilterActions}" />
        </SelectorBar>

        <StackPanel
            Grid.Row="1"
            Margin="0,8,0,0"
            Orientation="Horizontal"
            Spacing="8">
            <Button
                x:Name="AddButton"
                AutomationProperties.AutomationId="IPSecurityManageAddButton"
                Click="AddButton_Click"
                Style="{StaticResource AccentButtonStyle}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon FontSize="14" Glyph="&#xE710;" />
                    <TextBlock Text="{x:Bind LocalizedStrings.IPSec_Command_New}" />
                </StackPanel>
            </Button>
            <Button
                x:Name="EditButton"
                AutomationProperties.AutomationId="IPSecurityManageEditButton"
                Click="EditButton_Click">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon FontSize="14" Glyph="&#xE70F;" />
                    <TextBlock Text="{x:Bind LocalizedStrings.IPSec_Command_Edit}" />
                </StackPanel>
            </Button>
            <Button
                x:Name="DeleteButton"
                AutomationProperties.AutomationId="IPSecurityManageDeleteButton"
                Click="DeleteButton_Click">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon FontSize="14" Glyph="&#xE74D;" />
                    <TextBlock Text="{x:Bind LocalizedStrings.IPSec_Command_Delete}" />
                </StackPanel>
            </Button>
        </StackPanel>

        <InfoBar
            x:Name="ErrorInfoBar"
            Grid.Row="2"
            IsClosable="True"
            IsOpen="False"
            Severity="Error"
            Title="{x:Bind LocalizedStrings.Common_ErrorTitle}" />

        <Grid Grid.Row="3">
            <ListView
                x:Name="ItemsListView"
                AutomationProperties.AutomationId="IPSecurityManageItemsList"
                DoubleTapped="ItemsListView_DoubleTapped"
                SelectionChanged="ItemsListView_SelectionChanged"
                SelectionMode="Single">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Margin" Value="0,0,0,4" />
                        <Setter Property="MinHeight" Value="60" />
                        <Setter Property="Padding" Value="0" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:IPSecurityManageListItem">
                        <Grid Padding="14,10" ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon
                                VerticalAlignment="Center"
                                FontSize="18"
                                Foreground="{ThemeResource AccentTextFillColorSecondaryBrush}"
                                Glyph="&#xE71C;" />
                            <StackPanel
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Spacing="2">
                                <TextBlock
                                    Style="{StaticResource BodyStrongTextBlockStyle}"
                                    Text="{x:Bind Name}"
                                    TextTrimming="CharacterEllipsis"
                                    ToolTipService.ToolTip="{x:Bind Name}" />
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="{x:Bind Description}"
                                    TextTrimming="CharacterEllipsis"
                                    ToolTipService.ToolTip="{x:Bind Description}" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <TextBlock
                x:Name="EmptyItemsText"
                VerticalAlignment="Center"
                Style="{StaticResource EditorEmptyStateTextStyle}"
                Text="{x:Bind LocalizedStrings.IPSec_Empty_FilterLists}" />

            <ProgressRing
                x:Name="BusyProgressRing"
                Width="44"
                Height="44"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                IsActive="False"
                Visibility="Collapsed" />
        </Grid>
    </Grid>
</UserControl>
