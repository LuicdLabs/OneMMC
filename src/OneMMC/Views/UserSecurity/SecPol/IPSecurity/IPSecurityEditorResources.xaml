<?xml version="1.0" encoding="utf-8" ?>
<!--
    Shared visual language for every IP Security editor and manager surface.
    Keeping the rhythm (bounded measure, 4px card gap, section header spacing) in one place is what
    makes the separate dialogs read as one Fluent design rather than a set of unrelated forms.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--  Scroll host for dialog content: vertical only, no horizontal clipping of cards.  -->
    <Style x:Key="EditorScrollViewerStyle" TargetType="ScrollViewer">
        <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="Padding" Value="0,0,2,0" />
    </Style>

    <!--  Card stack: Windows 11 Settings uses a 4px gap between cards inside a group.  -->
    <Style x:Key="EditorRootPanelStyle" TargetType="StackPanel">
        <Setter Property="Spacing" Value="4" />
        <Setter Property="MinWidth" Value="560" />
        <Setter Property="MaxWidth" Value="720" />
    </Style>

    <!--  Group heading: body-strong per the Win11 type ramp, with breathing room above.  -->
    <Style x:Key="EditorSectionHeaderStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
        <Setter Property="Margin" Value="1,12,0,4" />
    </Style>

    <!--  Secondary caption used under a group heading or beside a list.  -->
    <Style x:Key="EditorSectionCaptionStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        <Setter Property="Margin" Value="1,0,0,4" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!--  Card-shaped surface for embedded lists so they match SettingsCard geometry.  -->
    <Style x:Key="EditorListSurfaceStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}" />
        <Setter Property="Padding" Value="4" />
    </Style>

    <!--  Compact status pill for boolean-ish values in list rows.  -->
    <Style x:Key="StatusPillBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="10,3" />
    </Style>

    <!--  Row of list commands sitting under an embedded list.  -->
    <Style x:Key="EditorListCommandBarStyle" TargetType="StackPanel">
        <Setter Property="Orientation" Value="Horizontal" />
        <Setter Property="Spacing" Value="8" />
        <Setter Property="Margin" Value="0,8,0,0" />
    </Style>

    <!--  Empty-state block shown inside an embedded list surface.  -->
    <Style x:Key="EditorEmptyStateTextStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="Margin" Value="12,20" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
</ResourceDictionary>
