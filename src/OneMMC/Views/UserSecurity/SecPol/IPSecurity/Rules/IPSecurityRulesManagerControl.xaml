<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="OneMMC.Views.UserSecurity.SecPol.IPSecurity.Rules.IPSecurityRulesManagerControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:OneMMC.Views.UserSecurity.SecPol.IPSecurity.Rules">

    <!--  One button row acts on the list; each rule row shows its name and references.  -->
    <Grid MinWidth="720" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel
            Grid.Row="0"
            Orientation="Horizontal"
            Spacing="8">
            <Button
                x:Name="AddRuleButton"
                AutomationProperties.AutomationId="IPSecurityAddRuleButton"
                Click="AddRuleButton_Click"
                Content="{x:Bind LocalizedStrings.IPSec_Command_AddRule}"
                Style="{StaticResource AccentButtonStyle}" />
            <Button
                x:Name="EditRuleButton"
                AutomationProperties.AutomationId="IPSecurityEditRuleButton"
                Click="EditRuleButton_Click"
                Content="{x:Bind LocalizedStrings.IPSec_Command_EditRule}" />
            <Button
                x:Name="DeleteRuleButton"
                AutomationProperties.AutomationId="IPSecurityDeleteRuleButton"
                Click="DeleteRuleButton_Click"
                Content="{x:Bind LocalizedStrings.IPSec_Command_DeleteRule}" />
        </StackPanel>

        <InfoBar
            x:Name="ErrorInfoBar"
            Grid.Row="1"
            IsClosable="True"
            IsOpen="False"
            Severity="Error"
            Title="{x:Bind LocalizedStrings.Common_ErrorTitle}" />

        <Grid Grid.Row="2">
            <ListView
                x:Name="RulesListView"
                AutomationProperties.AutomationId="IPSecurityRulesList"
                DoubleTapped="RulesListView_DoubleTapped"
                SelectionChanged="RulesListView_SelectionChanged"
                SelectionMode="Single">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:IPSecurityRuleListItem">
                        <StackPanel Spacing="2">
                            <TextBlock
                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                Text="{x:Bind Name}"
                                TextTrimming="CharacterEllipsis"
                                ToolTipService.ToolTip="{x:Bind Description}" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="{x:Bind FilterListName}"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="{x:Bind FilterActionName}"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="{x:Bind ConnectionTypeDisplay}"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <TextBlock
                x:Name="EmptyRulesText"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="{x:Bind LocalizedStrings.IPSec_Editor_NoRules}"
                TextAlignment="Center"
                TextWrapping="Wrap" />

            <ProgressRing
                x:Name="BusyProgressRing"
                Width="40"
                Height="40"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                IsActive="False" />
        </Grid>
    </Grid>
</UserControl>
