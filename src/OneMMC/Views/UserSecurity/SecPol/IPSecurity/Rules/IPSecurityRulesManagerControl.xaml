<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="OneMMC.Views.UserSecurity.SecPol.IPSecurity.Rules.IPSecurityRulesManagerControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:OneMMC.Views.UserSecurity.SecPol.IPSecurity.Rules">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///Views/UserSecurity/SecPol/IPSecurity/IPSecurityEditorResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <!--
        Each rule row carries its own facts as labelled chips instead of relying on a header row the
        dialog cannot keep aligned while resizing. That removes the header row and keeps the list
        legible at any width.
    -->
    <Grid MinWidth="720" RowSpacing="4">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel
            Grid.Row="0"
            Orientation="Horizontal"
            Spacing="8">
            <Button
                x:Name="AddRuleButton"
                AutomationProperties.AutomationId="IPSecurityAddRuleButton"
                Click="AddRuleButton_Click"
                Style="{StaticResource AccentButtonStyle}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon FontSize="14" Glyph="&#xE710;" />
                    <TextBlock Text="{x:Bind LocalizedStrings.IPSec_Command_AddRule}" />
                </StackPanel>
            </Button>
            <Button
                x:Name="EditRuleButton"
                AutomationProperties.AutomationId="IPSecurityEditRuleButton"
                Click="EditRuleButton_Click">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon FontSize="14" Glyph="&#xE70F;" />
                    <TextBlock Text="{x:Bind LocalizedStrings.IPSec_Command_EditRule}" />
                </StackPanel>
            </Button>
            <Button
                x:Name="DeleteRuleButton"
                AutomationProperties.AutomationId="IPSecurityDeleteRuleButton"
                Click="DeleteRuleButton_Click">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon FontSize="14" Glyph="&#xE74D;" />
                    <TextBlock Text="{x:Bind LocalizedStrings.IPSec_Command_DeleteRule}" />
                </StackPanel>
            </Button>
        </StackPanel>

        <InfoBar
            x:Name="ErrorInfoBar"
            Grid.Row="1"
            IsClosable="True"
            IsOpen="False"
            Severity="Error"
            Title="{x:Bind LocalizedStrings.Common_ErrorTitle}" />

        <Grid Grid.Row="2">
            <ListView
                x:Name="RulesListView"
                AutomationProperties.AutomationId="IPSecurityRulesList"
                DoubleTapped="RulesListView_DoubleTapped"
                SelectionChanged="RulesListView_SelectionChanged"
                SelectionMode="Single">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Margin" Value="0,0,0,4" />
                        <Setter Property="MinHeight" Value="64" />
                        <Setter Property="Padding" Value="0" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:IPSecurityRuleListItem">
                        <Grid Padding="14,10" ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon
                                VerticalAlignment="Center"
                                FontSize="18"
                                Foreground="{ThemeResource AccentTextFillColorSecondaryBrush}"
                                Glyph="&#xE8AF;" />
                            <StackPanel
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Spacing="4">
                                <TextBlock
                                    Style="{StaticResource BodyStrongTextBlockStyle}"
                                    Text="{x:Bind Name}"
                                    TextTrimming="CharacterEllipsis"
                                    ToolTipService.ToolTip="{x:Bind Description}" />
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Border Style="{StaticResource StatusPillBorderStyle}">
                                        <TextBlock
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Text="{x:Bind FilterListName}"
                                            TextTrimming="CharacterEllipsis" />
                                    </Border>
                                    <Border Style="{StaticResource StatusPillBorderStyle}">
                                        <TextBlock
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Text="{x:Bind FilterActionName}"
                                            TextTrimming="CharacterEllipsis" />
                                    </Border>
                                    <Border Style="{StaticResource StatusPillBorderStyle}">
                                        <TextBlock
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Text="{x:Bind ConnectionTypeDisplay}"
                                            TextTrimming="CharacterEllipsis" />
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                            <Border
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                Style="{StaticResource StatusPillBorderStyle}">
                                <TextBlock
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="{x:Bind ActiveDisplay}" />
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <TextBlock
                x:Name="EmptyRulesText"
                VerticalAlignment="Center"
                Style="{StaticResource EditorEmptyStateTextStyle}"
                Text="{x:Bind LocalizedStrings.IPSec_Editor_NoRules}" />

            <ProgressRing
                x:Name="BusyProgressRing"
                Width="40"
                Height="40"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                IsActive="False" />
        </Grid>
    </Grid>
</UserControl>
