<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="OneMMC.Views.UserSecurity.SecPol.IPSecurity.Editors.IPSecurityPolicyEditorControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:editors="using:OneMMC.Views.UserSecurity.SecPol.IPSecurity.Editors"
    xmlns:cwuc="using:CommunityToolkit.WinUI.Controls">

    <ScrollViewer
        HorizontalScrollBarVisibility="Disabled"
        VerticalScrollBarVisibility="Auto">
        <StackPanel MinWidth="560" Spacing="4">
            <InfoBar
                x:Name="ValidationInfoBar"
                Margin="0,0,0,8"
                IsClosable="True"
                IsOpen="False"
                Severity="Error" />

            <cwuc:SettingsCard Header="{x:Bind LocalizedStrings.IPSec_Column_Name}">
                <TextBox
                    x:Name="NameTextBox"
                    MinWidth="260"
                    AutomationProperties.Name="{x:Bind LocalizedStrings.IPSec_Column_Name}" />
            </cwuc:SettingsCard>

            <cwuc:SettingsCard
                ContentAlignment="Vertical"
                Header="{x:Bind LocalizedStrings.IPSec_Column_Description}">
                <TextBox
                    x:Name="DescriptionTextBox"
                    AcceptsReturn="True"
                    AutomationProperties.Name="{x:Bind LocalizedStrings.IPSec_Column_Description}"
                    MaxHeight="120"
                    TextWrapping="Wrap" />
            </cwuc:SettingsCard>

            <cwuc:SettingsCard Header="{x:Bind LocalizedStrings.IPSec_Editor_Assigned}">
                <ToggleSwitch
                    x:Name="AssignedToggleSwitch"
                    AutomationProperties.Name="{x:Bind LocalizedStrings.IPSec_Editor_Assigned}"
                    OffContent="{x:Bind LocalizedStrings.IPSec_Value_No}"
                    OnContent="{x:Bind LocalizedStrings.IPSec_Value_Yes}" />
            </cwuc:SettingsCard>

            <cwuc:SettingsCard Header="{x:Bind LocalizedStrings.IPSec_Editor_DefaultResponseRule}">
                <ToggleSwitch
                    x:Name="DefaultResponseRuleToggleSwitch"
                    AutomationProperties.Name="{x:Bind LocalizedStrings.IPSec_Editor_DefaultResponseRule}"
                    OffContent="{x:Bind LocalizedStrings.IPSec_Value_No}"
                    OnContent="{x:Bind LocalizedStrings.IPSec_Value_Yes}" />
            </cwuc:SettingsCard>

            <cwuc:SettingsCard Header="{x:Bind LocalizedStrings.IPSec_Editor_MasterPfs}">
                <ToggleSwitch
                    x:Name="MasterPfsToggleSwitch"
                    AutomationProperties.Name="{x:Bind LocalizedStrings.IPSec_Editor_MasterPfs}"
                    OffContent="{x:Bind LocalizedStrings.IPSec_Value_No}"
                    OnContent="{x:Bind LocalizedStrings.IPSec_Value_Yes}"
                    Toggled="MasterPfsToggleSwitch_Toggled" />
            </cwuc:SettingsCard>

            <cwuc:SettingsCard Header="{x:Bind LocalizedStrings.IPSec_Editor_QuickModeSessions}">
                <NumberBox
                    x:Name="QuickModeSessionsNumberBox"
                    Width="160"
                    Maximum="2147483647"
                    Minimum="1"
                    SpinButtonPlacementMode="Compact" />
            </cwuc:SettingsCard>

            <cwuc:SettingsCard Header="{x:Bind LocalizedStrings.IPSec_Editor_MainModeLifetime}">
                <NumberBox
                    x:Name="MainModeLifetimeNumberBox"
                    Width="160"
                    Maximum="2147483647"
                    Minimum="1"
                    SpinButtonPlacementMode="Compact" />
            </cwuc:SettingsCard>

            <cwuc:SettingsCard Header="{x:Bind LocalizedStrings.IPSec_Editor_PollingInterval}">
                <NumberBox
                    x:Name="PollingIntervalNumberBox"
                    Width="160"
                    Maximum="2147483647"
                    Minimum="1"
                    SpinButtonPlacementMode="Compact" />
            </cwuc:SettingsCard>

            <editors:IPSecuritySecurityMethodsEditorControl
                x:Name="MainModeMethodsEditor"
                Margin="0,12,0,0"
                Header="{x:Bind LocalizedStrings.IPSec_Editor_MainModeMethods, Mode=OneTime}"
                MethodMode="MainMode" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
