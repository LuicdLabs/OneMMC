<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="OneMMC.Views.UserSecurity.SecPol.IPSecurity.Editors.IPSecurityFilterListEditorControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cwuc="using:CommunityToolkit.WinUI.Controls"
    xmlns:local="using:OneMMC.Views.UserSecurity.SecPol.IPSecurity.Editors">

    <Grid MinWidth="560" RowSpacing="4">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <InfoBar
            x:Name="ValidationInfoBar"
            Grid.Row="0"
            IsClosable="True"
            IsOpen="False"
            Severity="Error" />

        <cwuc:SettingsCard Grid.Row="1" Header="{x:Bind LocalizedStrings.IPSec_Column_Name}">
            <TextBox
                x:Name="NameTextBox"
                MinWidth="260"
                AutomationProperties.Name="{x:Bind LocalizedStrings.IPSec_Column_Name}" />
        </cwuc:SettingsCard>

        <cwuc:SettingsCard
            Grid.Row="2"
            ContentAlignment="Vertical"
            Header="{x:Bind LocalizedStrings.IPSec_Column_Description}">
            <TextBox
                x:Name="DescriptionTextBox"
                AcceptsReturn="True"
                AutomationProperties.Name="{x:Bind LocalizedStrings.IPSec_Column_Description}"
                MaxHeight="100"
                TextWrapping="Wrap" />
        </cwuc:SettingsCard>

        <!--  Filters section: section heading with an inline toolbar on the same line.  -->
        <Grid
            Grid.Row="3"
            Margin="0,12,0,4"
            ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                VerticalAlignment="Center"
                Style="{StaticResource SubtitleTextBlockStyle}"
                Text="{x:Bind LocalizedStrings.IPSec_Editor_Filters}" />
            <CommandBar
                Grid.Column="1"
                Background="Transparent"
                DefaultLabelPosition="Right"
                OverflowButtonVisibility="Collapsed">
                <AppBarButton
                    Click="AddFilterButton_Click"
                    Icon="Add"
                    Label="{x:Bind LocalizedStrings.Common_AddButton}" />
                <AppBarButton
                    Click="EditFilterButton_Click"
                    Icon="Edit"
                    Label="{x:Bind LocalizedStrings.Common_EditButton}" />
                <AppBarButton
                    Click="DeleteFilterButton_Click"
                    Icon="Delete"
                    Label="{x:Bind LocalizedStrings.Common_DeleteButton}" />
            </CommandBar>
        </Grid>

        <!--  Filter list: matches the manage-dialog list styling (leading filter icon + summary).  -->
        <Border
            Grid.Row="4"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8"
            MinHeight="260">
            <ListView
                x:Name="FiltersListView"
                AutomationProperties.Name="{x:Bind LocalizedStrings.IPSec_Editor_Filters}"
                ItemsSource="{x:Bind FilterItems}"
                SelectionMode="Single">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Margin" Value="0" />
                        <Setter Property="MinHeight" Value="0" />
                        <Setter Property="Padding" Value="0" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:IPSecurityFilterEditorItem">
                        <Grid Padding="12,10,12,10" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon
                                FontSize="16"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Glyph="&#xE71C;"
                                VerticalAlignment="Center" />
                            <TextBlock
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Style="{StaticResource BodyTextBlockStyle}"
                                Text="{x:Bind Summary}"
                                TextWrapping="WrapWholeWords" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>
    </Grid>
</UserControl>
