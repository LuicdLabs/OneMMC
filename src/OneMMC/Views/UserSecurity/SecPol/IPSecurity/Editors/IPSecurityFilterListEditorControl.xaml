<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="OneMMC.Views.UserSecurity.SecPol.IPSecurity.Editors.IPSecurityFilterListEditorControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:OneMMC.Views.UserSecurity.SecPol.IPSecurity.Editors">

    <!--
        The filter collection is the point of this dialog, so it gets the growing row and a
        height-constrained list; name and description stay fixed above it.
    -->
    <Grid MinWidth="560" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <InfoBar
            x:Name="ValidationInfoBar"
            Grid.Row="0"
            IsClosable="True"
            IsOpen="False"
            Severity="Error" />

        <Grid Grid.Row="1" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBox
                x:Name="NameTextBox"
                AutomationProperties.Name="{x:Bind LocalizedStrings.IPSec_Column_Name}"
                Header="{x:Bind LocalizedStrings.IPSec_Column_Name}" />
            <TextBox
                x:Name="DescriptionTextBox"
                Grid.Column="1"
                AutomationProperties.Name="{x:Bind LocalizedStrings.IPSec_Column_Description}"
                Header="{x:Bind LocalizedStrings.IPSec_Column_Description}" />
        </Grid>

        <TextBlock
            Grid.Row="2"
            Margin="0,8,0,0"
            FontWeight="SemiBold"
            Text="{x:Bind LocalizedStrings.IPSec_Editor_Filters}" />

        <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8">
            <Button
                x:Name="AddFilterButton"
                Click="AddFilterButton_Click"
                Content="{x:Bind LocalizedStrings.Common_AddButton}" />
            <Button
                x:Name="EditFilterButton"
                Click="EditFilterButton_Click"
                Content="{x:Bind LocalizedStrings.Common_EditButton}" />
            <Button
                x:Name="DeleteFilterButton"
                Click="DeleteFilterButton_Click"
                Content="{x:Bind LocalizedStrings.Common_DeleteButton}" />
        </StackPanel>

        <Grid Grid.Row="4">
            <ListView
                x:Name="FiltersListView"
                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                BorderThickness="1"
                MinHeight="220"
                AutomationProperties.Name="{x:Bind LocalizedStrings.IPSec_Editor_Filters}"
                ItemsSource="{x:Bind FilterItems}"
                SelectionMode="Single">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:IPSecurityFilterEditorItem">
                        <TextBlock
                            Style="{StaticResource BodyTextBlockStyle}"
                            Text="{x:Bind Summary}"
                            TextWrapping="WrapWholeWords" />
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <!--  Visibility is driven from code-behind so the collection needs no wrapper view model.  -->
            <TextBlock
                x:Name="EmptyFiltersText"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="{x:Bind LocalizedStrings.IPSec_Editor_NoFilters}"
                TextAlignment="Center"
                TextWrapping="Wrap" />
        </Grid>
    </Grid>
</UserControl>
