<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="OneMMC.Views.UserSecurity.SecPol.IPSecurity.Editors.IPSecurityFilterActionEditorControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cwuc="using:CommunityToolkit.WinUI.Controls"
    xmlns:editors="using:OneMMC.Views.UserSecurity.SecPol.IPSecurity.Editors">

    <ScrollViewer
        HorizontalScrollBarVisibility="Disabled"
        VerticalScrollBarVisibility="Auto">
        <StackPanel MinWidth="560" Spacing="4">
            <InfoBar
                x:Name="ValidationInfoBar"
                Margin="0,0,0,8"
                IsClosable="True"
                IsOpen="False"
                Severity="Error" />

            <cwuc:SettingsCard Header="{x:Bind LocalizedStrings.IPSec_Column_Name}">
                <TextBox
                    x:Name="NameTextBox"
                    MinWidth="260"
                    AutomationProperties.Name="{x:Bind LocalizedStrings.IPSec_Column_Name}" />
            </cwuc:SettingsCard>

            <cwuc:SettingsCard
                ContentAlignment="Vertical"
                Header="{x:Bind LocalizedStrings.IPSec_Column_Description}">
                <TextBox
                    x:Name="DescriptionTextBox"
                    AcceptsReturn="True"
                    AutomationProperties.Name="{x:Bind LocalizedStrings.IPSec_Column_Description}"
                    MaxHeight="120"
                    TextWrapping="Wrap" />
            </cwuc:SettingsCard>

            <cwuc:SettingsCard Header="{x:Bind LocalizedStrings.IPSec_Editor_FilterAction}">
                <ComboBox
                    x:Name="ActionComboBox"
                    MinWidth="220"
                    SelectionChanged="ActionComboBox_SelectionChanged">
                    <ComboBoxItem
                        Content="{x:Bind LocalizedStrings.IPSec_FilterAction_Permit}"
                        Tag="Permit" />
                    <ComboBoxItem
                        Content="{x:Bind LocalizedStrings.IPSec_FilterAction_Block}"
                        Tag="Block" />
                    <ComboBoxItem
                        Content="{x:Bind LocalizedStrings.IPSec_FilterAction_Negotiate}"
                        Tag="Negotiate" />
                </ComboBox>
            </cwuc:SettingsCard>

            <cwuc:SettingsCard Header="{x:Bind LocalizedStrings.IPSec_Editor_QuickModePfs}">
                <ToggleSwitch
                    x:Name="QuickModePfsToggleSwitch"
                    AutomationProperties.Name="{x:Bind LocalizedStrings.IPSec_Editor_QuickModePfs}"
                    OffContent="{x:Bind LocalizedStrings.IPSec_Value_No}"
                    OnContent="{x:Bind LocalizedStrings.IPSec_Value_Yes}" />
            </cwuc:SettingsCard>

            <cwuc:SettingsCard Header="{x:Bind LocalizedStrings.IPSec_Editor_AcceptUnsecuredInbound}">
                <ToggleSwitch
                    x:Name="AcceptUnsecuredInboundToggleSwitch"
                    AutomationProperties.Name="{x:Bind LocalizedStrings.IPSec_Editor_AcceptUnsecuredInbound}"
                    OffContent="{x:Bind LocalizedStrings.IPSec_Value_No}"
                    OnContent="{x:Bind LocalizedStrings.IPSec_Value_Yes}" />
            </cwuc:SettingsCard>

            <cwuc:SettingsCard Header="{x:Bind LocalizedStrings.IPSec_Editor_AllowUnsecuredFallback}">
                <ToggleSwitch
                    x:Name="AllowUnsecuredFallbackToggleSwitch"
                    AutomationProperties.Name="{x:Bind LocalizedStrings.IPSec_Editor_AllowUnsecuredFallback}"
                    OffContent="{x:Bind LocalizedStrings.IPSec_Value_No}"
                    OnContent="{x:Bind LocalizedStrings.IPSec_Value_Yes}" />
            </cwuc:SettingsCard>

            <editors:IPSecuritySecurityMethodsEditorControl
                x:Name="QuickModeMethodsEditor"
                Margin="0,12,0,0"
                Header="{x:Bind LocalizedStrings.IPSec_Editor_QuickModeMethods, Mode=OneTime}"
                MethodMode="QuickMode" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
