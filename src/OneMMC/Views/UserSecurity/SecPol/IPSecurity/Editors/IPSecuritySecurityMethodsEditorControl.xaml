<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="OneMMC.Views.UserSecurity.SecPol.IPSecurity.Editors.IPSecuritySecurityMethodsEditorControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--  Layered group surface so the nested editor reads as one unit inside its parent form.  -->
    <Border
        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
        BorderThickness="1"
        CornerRadius="8"
        Padding="16">
        <StackPanel Spacing="12">
            <StackPanel Spacing="2">
                <TextBlock
                    x:Name="HeaderTextBlock"
                    Style="{StaticResource SubtitleTextBlockStyle}"
                    TextWrapping="Wrap" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{x:Bind LocalizedStrings.IPSec_Editor_MethodsHelp}"
                    TextWrapping="Wrap" />
            </StackPanel>

            <ListView
                x:Name="MethodsListView"
                AutomationProperties.Name="{x:Bind Header, Mode=OneTime}"
                ItemsSource="{x:Bind Methods}"
                MaxHeight="160"
                MinHeight="96"
                SelectionChanged="MethodsListView_SelectionChanged"
                SelectionMode="Single">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="MinHeight" Value="0" />
                        <Setter Property="Padding" Value="0" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                        <Grid Padding="12,8,12,8" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon
                                FontSize="14"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Glyph="&#xE72E;" />
                            <TextBlock
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                FontFamily="Consolas"
                                Style="{StaticResource BodyTextBlockStyle}"
                                Text="{x:Bind}"
                                TextWrapping="WrapWholeWords" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <CommandBar
                Background="Transparent"
                DefaultLabelPosition="Right"
                OverflowButtonVisibility="Collapsed">
                <AppBarButton
                    x:Name="MoveUpButton"
                    Click="MoveUpButton_Click"
                    Label="{x:Bind LocalizedStrings.IPSec_Editor_MoveUp}">
                    <AppBarButton.Icon>
                        <FontIcon Glyph="&#xE70E;" />
                    </AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton
                    x:Name="MoveDownButton"
                    Click="MoveDownButton_Click"
                    Label="{x:Bind LocalizedStrings.IPSec_Editor_MoveDown}">
                    <AppBarButton.Icon>
                        <FontIcon Glyph="&#xE70D;" />
                    </AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton
                    x:Name="DeleteButton"
                    Click="DeleteButton_Click"
                    Label="{x:Bind LocalizedStrings.Common_DeleteButton}">
                    <AppBarButton.Icon>
                        <SymbolIcon Symbol="Delete" />
                    </AppBarButton.Icon>
                </AppBarButton>
            </CommandBar>

            <Grid
                x:Name="MainModePanel"
                ColumnSpacing="12"
                RowSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <ComboBox
                    x:Name="MainEncryptionComboBox"
                    HorizontalAlignment="Stretch"
                    Header="{x:Bind LocalizedStrings.IPSec_Editor_EncryptionAlgorithm}" />
                <ComboBox
                    x:Name="MainHashComboBox"
                    Grid.Column="1"
                    HorizontalAlignment="Stretch"
                    Header="{x:Bind LocalizedStrings.IPSec_Editor_HashAlgorithm}" />
                <ComboBox
                    x:Name="DiffieHellmanGroupComboBox"
                    Grid.Column="2"
                    HorizontalAlignment="Stretch"
                    Header="{x:Bind LocalizedStrings.IPSec_Editor_DiffieHellmanGroup}" />
            </Grid>

            <Grid
                x:Name="QuickModePanel"
                ColumnSpacing="12"
                RowSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ComboBox
                    x:Name="QuickMethodTypeComboBox"
                    HorizontalAlignment="Stretch"
                    Header="{x:Bind LocalizedStrings.IPSec_Editor_SecurityMethodType}"
                    SelectionChanged="QuickMethodTypeComboBox_SelectionChanged" />
                <ComboBox
                    x:Name="EspEncryptionComboBox"
                    Grid.Column="1"
                    HorizontalAlignment="Stretch"
                    Header="{x:Bind LocalizedStrings.IPSec_Editor_EspEncryption}" />
                <ComboBox
                    x:Name="EspAuthenticationComboBox"
                    Grid.Row="1"
                    HorizontalAlignment="Stretch"
                    Header="{x:Bind LocalizedStrings.IPSec_Editor_EspAuthentication}" />
                <ComboBox
                    x:Name="AhHashComboBox"
                    Grid.Row="1"
                    Grid.Column="1"
                    HorizontalAlignment="Stretch"
                    Header="{x:Bind LocalizedStrings.IPSec_Editor_AhHash}" />
                <NumberBox
                    x:Name="LifetimeKilobytesNumberBox"
                    Grid.Row="2"
                    HorizontalAlignment="Stretch"
                    Header="{x:Bind LocalizedStrings.IPSec_Editor_LifetimeKilobytes}"
                    Minimum="1"
                    SpinButtonPlacementMode="Compact" />
                <NumberBox
                    x:Name="LifetimeSecondsNumberBox"
                    Grid.Row="2"
                    Grid.Column="1"
                    HorizontalAlignment="Stretch"
                    Header="{x:Bind LocalizedStrings.IPSec_Editor_LifetimeSeconds}"
                    Minimum="1"
                    SpinButtonPlacementMode="Compact" />
            </Grid>

            <Button
                Click="AddMethodButton_Click"
                HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon FontSize="14" Glyph="&#xE710;" />
                    <TextBlock Text="{x:Bind LocalizedStrings.IPSec_Editor_AddSecurityMethod}" />
                </StackPanel>
            </Button>
        </StackPanel>
    </Border>
</UserControl>
