<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="OneMMC.Views.NetworkIconDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    CloseButtonText="{x:Bind LocalizedStrings.Common_CancelButton}"
    DefaultButton="Primary"
    PrimaryButtonText="{x:Bind LocalizedStrings.Common_OKButton}">

    <StackPanel MinWidth="440" Spacing="16">
        <TextBlock
            Style="{StaticResource SubtitleTextBlockStyle}"
            Text="{x:Bind LocalizedStrings.NetworkListManager_NetworkIconDialog_Title}"
            TextWrapping="Wrap" />

        <TextBlock
            Text="{x:Bind LocalizedStrings.NetworkListManager_NetworkIconDialog_Description}"
            TextWrapping="Wrap" />

        <StackPanel Spacing="8">
            <TextBlock
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="{x:Bind LocalizedStrings.NetworkListManager_NetworkIconDialog_GroupTitle}" />
            <Border
                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="4"
                Padding="12">
                <StackPanel Spacing="10">
                    <RadioButton
                        x:Name="NotConfiguredRadioButton"
                        Checked="SelectionRadioButton_Checked"
                        Content="{x:Bind LocalizedStrings.Policy_State_NotConfigured}"
                        GroupName="NetworkIconMode" />
                    <RadioButton
                        x:Name="IconRadioButton"
                        Checked="SelectionRadioButton_Checked"
                        Content="{x:Bind LocalizedStrings.NetworkListManager_Icon_Option}"
                        GroupName="NetworkIconMode" />
                    <StackPanel
                        x:Name="IconConfigurationPanel"
                        Margin="28,0,0,0"
                        Spacing="10"
                        Visibility="Collapsed">
                        <TextBlock
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{x:Bind LocalizedStrings.NetworkListManager_NetworkIconDialog_PreviewLabel}" />
                        <Border
                            Width="64"
                            Height="64"
                            Background="{ThemeResource LayerFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="8">
                            <Grid>
                                <Image
                                    x:Name="IconPreviewImage"
                                    Stretch="Uniform" />
                                <TextBlock
                                    x:Name="IconPreviewPlaceholderText"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="{x:Bind LocalizedStrings.Policy_State_NotConfigured}" />
                            </Grid>
                        </Border>
                        <Button
                            x:Name="ChangeIconButton"
                            Click="ChangeIconButton_Click"
                            Content="{x:Bind LocalizedStrings.NetworkListManager_ChangeIconButton}"
                            HorizontalAlignment="Left"
                            Width="140" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </StackPanel>
</ContentDialog>
