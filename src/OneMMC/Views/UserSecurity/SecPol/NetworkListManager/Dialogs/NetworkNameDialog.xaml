<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="OneMMC.Views.NetworkNameDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    CloseButtonText="{x:Bind LocalizedStrings.Common_CancelButton}"
    DefaultButton="Primary"
    PrimaryButtonText="{x:Bind LocalizedStrings.Common_OKButton}">

    <StackPanel MinWidth="420" Spacing="16">
        <TextBlock
            Style="{StaticResource SubtitleTextBlockStyle}"
            Text="{x:Bind LocalizedStrings.NetworkListManager_NetworkNameDialog_Title}"
            TextWrapping="Wrap" />

        <TextBlock
            Text="{x:Bind LocalizedStrings.NetworkListManager_NetworkNameDialog_Description}"
            TextWrapping="Wrap" />

        <StackPanel Spacing="8">
            <TextBlock
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="{x:Bind LocalizedStrings.NetworkListManager_NetworkNameDialog_GroupTitle}" />
            <Border
                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="4"
                Padding="12">
                <StackPanel Spacing="8">
                    <RadioButton
                        x:Name="NotConfiguredRadioButton"
                        Checked="SelectionRadioButton_Checked"
                        Content="{x:Bind LocalizedStrings.Policy_State_NotConfigured}"
                        GroupName="NetworkNameMode" />
                    <RadioButton
                        x:Name="NameRadioButton"
                        Checked="SelectionRadioButton_Checked"
                        Content="{x:Bind LocalizedStrings.NetworkListManager_Name_Option}"
                        GroupName="NetworkNameMode" />
                    <TextBox
                        x:Name="NetworkNameTextBox"
                        Margin="28,0,0,0"
                        PlaceholderText="{x:Bind LocalizedStrings.NetworkListManager_NetworkNameDialog_Placeholder}"
                        TextChanged="NetworkNameTextBox_TextChanged"
                        Visibility="Collapsed" />
                </StackPanel>
            </Border>
        </StackPanel>
    </StackPanel>
</ContentDialog>
