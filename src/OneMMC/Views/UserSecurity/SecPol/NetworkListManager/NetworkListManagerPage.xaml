<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="OneMMC.Views.NetworkListManagerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:oneMmcControls="using:OneMMC.Controls"
    xmlns:converters="using:OneMMC.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:localization="using:OneMMC.Localization"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:OneMMC.Core.Features.UserSecurity.ViewModels.SecPol.NetworkListManager"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <CommandBar Grid.Row="0" DefaultLabelPosition="Right">
            <AppBarButton
                Click="RefreshButton_Click"
                Icon="Refresh"
                Label="{x:Bind LocalizedStrings.Common_Refresh}" />
        </CommandBar>

        <InfoBar
            x:Name="ErrorInfoBar"
            Title="{x:Bind LocalizedStrings.Common_ErrorTitle}"
            Grid.Row="1"
            Margin="24,0,24,12"
            IsClosable="True"
            IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
            Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
            Severity="Error" />

        <AutoSuggestBox
            x:Name="SearchBox"
            Grid.Row="2"
            Margin="24,0,24,8"
            PlaceholderText="{x:Bind LocalizedStrings.Common_SearchPlaceholder}"
            QueryIcon="Find"
            TextChanged="SearchBox_TextChanged" />

        <Grid Grid.Row="3">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsRepeater
                    ItemsSource="{x:Bind ViewModel.Nodes, Mode=OneWay}">
                    <ItemsRepeater.Layout>
                        <oneMmcControls:StableStackLayout x:Name="PolicyGroupsLayout" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="vm:NetworkListPolicyNodeViewModel">
                            <oneMmcControls:StableSettingsExpander
                                Margin="24,0,24,4"
                                Description="{x:Bind Description}"
                                Header="{x:Bind DisplayName}"
                                IsExpanded="True">
                                <oneMmcControls:StableSettingsExpander.HeaderIcon>
                                    <FontIcon Glyph="{x:Bind HeaderGlyph}" />
                                </oneMmcControls:StableSettingsExpander.HeaderIcon>
                                <oneMmcControls:StableSettingsExpander.Items>
                                    <controls:SettingsCard
                                        Header="{x:Bind localization:LocalizedStrings.Instance.NetworkListManager_NetworkName_Header}"
                                        HeaderIcon="{x:Null}"
                                        Visibility="{x:Bind IsIdentifiedNetwork, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}">
                                        <StackPanel HorizontalAlignment="Left" Spacing="8">
                                            <Button
                                                Click="NetworkNameConfigure_Click"
                                                Content="{x:Bind localization:LocalizedStrings.Instance.NetworkListManager_ConfigureButton}"
                                                DataContext="{x:Bind}"
                                                Width="120" />
                                            <TextBlock
                                                Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                Text="{x:Bind NetworkNameSummary}" />
                                        </StackPanel>
                                    </controls:SettingsCard>

                                    <controls:SettingsCard
                                        Header="{x:Bind localization:LocalizedStrings.Instance.NetworkListManager_NetworkNameUserPermissions_Header}"
                                        HeaderIcon="{x:Null}"
                                        Visibility="{x:Bind IsIdentifiedNetwork, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}">
                                        <ComboBox
                                            MinWidth="220"
                                            DataContext="{x:Bind}"
                                            SelectedIndex="{x:Bind NamePermissionIndex, Mode=TwoWay}"
                                            SelectionChanged="PolicyComboBox_SelectionChanged"
                                            Tag="NamePermission">
                                            <ComboBoxItem Content="{x:Bind localization:LocalizedStrings.Instance.Policy_State_NotConfigured}" />
                                            <ComboBoxItem Content="{x:Bind localization:LocalizedStrings.Instance.NetworkListManager_UserCanChangeName}" />
                                            <ComboBoxItem Content="{x:Bind localization:LocalizedStrings.Instance.NetworkListManager_UserCannotChangeName}" />
                                        </ComboBox>
                                    </controls:SettingsCard>

                                    <controls:SettingsCard
                                        Header="{x:Bind localization:LocalizedStrings.Instance.NetworkListManager_NetworkIcon_Header}"
                                        HeaderIcon="{x:Null}"
                                        Visibility="{x:Bind IsIdentifiedNetwork, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}">
                                        <StackPanel HorizontalAlignment="Left" Spacing="8">
                                            <Button
                                                Click="NetworkIconConfigure_Click"
                                                Content="{x:Bind localization:LocalizedStrings.Instance.NetworkListManager_ConfigureButton}"
                                                DataContext="{x:Bind}"
                                                Width="120" />
                                            <TextBlock
                                                Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                Text="{x:Bind NetworkIconSummary}" />
                                        </StackPanel>
                                    </controls:SettingsCard>

                                    <controls:SettingsCard
                                        Header="{x:Bind localization:LocalizedStrings.Instance.NetworkListManager_NetworkIconUserPermissions_Header}"
                                        HeaderIcon="{x:Null}"
                                        Visibility="{x:Bind IsIdentifiedNetwork, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}">
                                        <ComboBox
                                            MinWidth="220"
                                            DataContext="{x:Bind}"
                                            SelectedIndex="{x:Bind IconPermissionIndex, Mode=TwoWay}"
                                            SelectionChanged="PolicyComboBox_SelectionChanged"
                                            Tag="IconPermission">
                                            <ComboBoxItem Content="{x:Bind localization:LocalizedStrings.Instance.Policy_State_NotConfigured}" />
                                            <ComboBoxItem Content="{x:Bind localization:LocalizedStrings.Instance.NetworkListManager_UserCanChangeIcon}" />
                                            <ComboBoxItem Content="{x:Bind localization:LocalizedStrings.Instance.NetworkListManager_UserCannotChangeIcon}" />
                                        </ComboBox>
                                    </controls:SettingsCard>

                                    <controls:SettingsCard
                                        Header="{x:Bind localization:LocalizedStrings.Instance.NetworkListManager_NetworkLocationType_Header}"
                                        HeaderIcon="{x:Null}"
                                        Visibility="{x:Bind ShowsLocationType, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}">
                                        <ComboBox
                                            MinWidth="220"
                                            DataContext="{x:Bind}"
                                            SelectedIndex="{x:Bind LocationTypeIndex, Mode=TwoWay}"
                                            SelectionChanged="PolicyComboBox_SelectionChanged"
                                            Tag="LocationType">
                                            <ComboBoxItem Content="{x:Bind localization:LocalizedStrings.Instance.Policy_State_NotConfigured}" />
                                            <ComboBoxItem Content="{x:Bind localization:LocalizedStrings.Instance.NetworkListManager_Private_Option}" />
                                            <ComboBoxItem Content="{x:Bind localization:LocalizedStrings.Instance.NetworkListManager_Public_Option}" />
                                        </ComboBox>
                                    </controls:SettingsCard>

                                    <controls:SettingsCard
                                        Header="{x:Bind localization:LocalizedStrings.Instance.NetworkListManager_NetworkLocationTypeUserPermissions_Header}"
                                        HeaderIcon="{x:Null}"
                                        Visibility="{x:Bind ShowsLocationPermission, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}">
                                        <ComboBox
                                            MinWidth="220"
                                            DataContext="{x:Bind}"
                                            SelectedIndex="{x:Bind LocationPermissionIndex, Mode=TwoWay}"
                                            SelectionChanged="PolicyComboBox_SelectionChanged"
                                            Tag="LocationPermission">
                                            <ComboBoxItem Content="{x:Bind localization:LocalizedStrings.Instance.Policy_State_NotConfigured}" />
                                            <ComboBoxItem Content="{x:Bind localization:LocalizedStrings.Instance.NetworkListManager_UserCanChangeLocation}" />
                                            <ComboBoxItem Content="{x:Bind localization:LocalizedStrings.Instance.NetworkListManager_UserCannotChangeLocation}" />
                                        </ComboBox>
                                    </controls:SettingsCard>

                                    <controls:SettingsCard
                                        Header="{x:Bind localization:LocalizedStrings.Instance.NetworkListManager_AllNetworksName_Header}"
                                        HeaderIcon="{x:Null}"
                                        Visibility="{x:Bind IsAllNetworks, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}">
                                        <ComboBox
                                            MinWidth="220"
                                            DataContext="{x:Bind}"
                                            SelectedIndex="{x:Bind NamePermissionIndex, Mode=TwoWay}"
                                            SelectionChanged="PolicyComboBox_SelectionChanged"
                                            Tag="NamePermission">
                                            <ComboBoxItem Content="{x:Bind localization:LocalizedStrings.Instance.Policy_State_NotConfigured}" />
                                            <ComboBoxItem Content="{x:Bind localization:LocalizedStrings.Instance.NetworkListManager_UserCanChangeName}" />
                                            <ComboBoxItem Content="{x:Bind localization:LocalizedStrings.Instance.NetworkListManager_UserCannotChangeName}" />
                                        </ComboBox>
                                    </controls:SettingsCard>

                                    <controls:SettingsCard
                                        Header="{x:Bind localization:LocalizedStrings.Instance.NetworkListManager_AllNetworksLocation_Header}"
                                        HeaderIcon="{x:Null}"
                                        Visibility="{x:Bind IsAllNetworks, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}">
                                        <ComboBox
                                            MinWidth="220"
                                            DataContext="{x:Bind}"
                                            SelectedIndex="{x:Bind LocationPermissionIndex, Mode=TwoWay}"
                                            SelectionChanged="PolicyComboBox_SelectionChanged"
                                            Tag="LocationPermission">
                                            <ComboBoxItem Content="{x:Bind localization:LocalizedStrings.Instance.Policy_State_NotConfigured}" />
                                            <ComboBoxItem Content="{x:Bind localization:LocalizedStrings.Instance.NetworkListManager_UserCanChangeLocation}" />
                                            <ComboBoxItem Content="{x:Bind localization:LocalizedStrings.Instance.NetworkListManager_UserCannotChangeLocation}" />
                                        </ComboBox>
                                    </controls:SettingsCard>

                                    <controls:SettingsCard
                                        Header="{x:Bind localization:LocalizedStrings.Instance.NetworkListManager_AllNetworksIcon_Header}"
                                        HeaderIcon="{x:Null}"
                                        Visibility="{x:Bind IsAllNetworks, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}">
                                        <ComboBox
                                            MinWidth="220"
                                            DataContext="{x:Bind}"
                                            SelectedIndex="{x:Bind IconPermissionIndex, Mode=TwoWay}"
                                            SelectionChanged="PolicyComboBox_SelectionChanged"
                                            Tag="IconPermission">
                                            <ComboBoxItem Content="{x:Bind localization:LocalizedStrings.Instance.Policy_State_NotConfigured}" />
                                            <ComboBoxItem Content="{x:Bind localization:LocalizedStrings.Instance.NetworkListManager_UserCanChangeIcon}" />
                                            <ComboBoxItem Content="{x:Bind localization:LocalizedStrings.Instance.NetworkListManager_UserCannotChangeIcon}" />
                                        </ComboBox>
                                    </controls:SettingsCard>
                                </oneMmcControls:StableSettingsExpander.Items>
                            </oneMmcControls:StableSettingsExpander>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </ScrollViewer>

            <ProgressRing
                Width="48"
                Height="48"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />
        </Grid>
    </Grid>
</Page>
