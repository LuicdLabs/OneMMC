<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="OneMMC.Views.EfsPropertiesControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="using:CommunityToolkit.WinUI"
    mc:Ignorable="d">

    <Grid
        MinWidth="640"
        MinHeight="480"
        RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <SelectorBar x:Name="EfsSelectorBar" SelectionChanged="EfsSelectorBar_SelectionChanged">
            <SelectorBarItem
                x:Name="GeneralTabItem"
                IsSelected="True"
                Tag="General"
                Text="{x:Bind LocalizedStrings.PKP_Efs_Tab_General}" />
            <SelectorBarItem
                x:Name="CertificatesTabItem"
                Tag="Certificates"
                Text="{x:Bind LocalizedStrings.PKP_Efs_Tab_Certificates}" />
            <SelectorBarItem
                x:Name="CacheTabItem"
                Tag="Cache"
                Text="{x:Bind LocalizedStrings.PKP_Efs_Tab_Cache}" />
        </SelectorBar>

        <ScrollViewer
            Grid.Row="1"
            HorizontalScrollMode="Disabled"
            VerticalScrollBarVisibility="Auto">
            <Grid>
                <!--  General  -->
                <StackPanel x:Name="GeneralPanel" Spacing="16">
                    <RadioButtons Header="{x:Bind LocalizedStrings.PKP_Efs_FileEncryption}">
                        <RadioButton
                            x:Name="FileEncryptionNotDefinedRadioButton"
                            Checked="FileEncryptionRadioButton_Checked"
                            Content="{x:Bind LocalizedStrings.PKP_Efs_FileEncryption_NotDefined}" />
                        <RadioButton
                            x:Name="FileEncryptionAllowRadioButton"
                            Checked="FileEncryptionRadioButton_Checked"
                            Content="{x:Bind LocalizedStrings.PKP_Efs_FileEncryption_Allow}" />
                        <RadioButton
                            x:Name="FileEncryptionDontAllowRadioButton"
                            Checked="FileEncryptionRadioButton_Checked"
                            Content="{x:Bind LocalizedStrings.PKP_Efs_FileEncryption_DontAllow}" />
                    </RadioButtons>

                    <RadioButtons Header="{x:Bind LocalizedStrings.PKP_Efs_EllipticCurveCryptography}">
                        <RadioButton
                            x:Name="EccAllowRadioButton"
                            Content="{x:Bind LocalizedStrings.PKP_Efs_Ecc_Allow}" />
                        <RadioButton
                            x:Name="EccRequireRadioButton"
                            Content="{x:Bind LocalizedStrings.PKP_Efs_Ecc_Require}" />
                        <RadioButton
                            x:Name="EccDontAllowRadioButton"
                            Content="{x:Bind LocalizedStrings.PKP_Efs_Ecc_DontAllow}" />
                    </RadioButtons>

                    <StackPanel Spacing="4">
                        <TextBlock
                            Margin="0,0,0,4"
                            Style="{StaticResource BodyStrongTextBlockStyle}"
                            Text="{x:Bind LocalizedStrings.PKP_Efs_Options}"
                            TextWrapping="Wrap" />
                        <controls:SettingsCard Header="{x:Bind LocalizedStrings.PKP_Efs_EncryptDocumentsFolder}">
                            <ToggleSwitch x:Name="EncryptDocumentsFolderToggle" />
                        </controls:SettingsCard>
                        <controls:SettingsCard Header="{x:Bind LocalizedStrings.PKP_Efs_RequireSmartCard}">
                            <ToggleSwitch x:Name="RequireSmartCardToggle" />
                        </controls:SettingsCard>
                        <controls:SettingsCard Header="{x:Bind LocalizedStrings.PKP_Efs_CreateSmartCardUserKey}">
                            <ToggleSwitch x:Name="CreateSmartCardUserKeyToggle" />
                        </controls:SettingsCard>
                        <controls:SettingsCard Header="{x:Bind LocalizedStrings.PKP_Efs_KeyBackupNotifications}">
                            <ToggleSwitch x:Name="KeyBackupNotificationsToggle" />
                        </controls:SettingsCard>
                    </StackPanel>
                </StackPanel>

                <!--  Certificates  -->
                <StackPanel
                    x:Name="CertificatesPanel"
                    Spacing="4"
                    Visibility="Collapsed">
                    <controls:SettingsCard
                        Header="{x:Bind LocalizedStrings.PKP_Efs_TemplateName}"
                        HeaderIcon="{ui:FontIcon Glyph=&#xE8A5;}">
                        <TextBox x:Name="TemplateNameTextBox" MinWidth="220" />
                    </controls:SettingsCard>
                    <controls:SettingsCard Header="{x:Bind LocalizedStrings.PKP_Efs_RsaKeySize}">
                        <ComboBox x:Name="RsaKeySizeComboBox" MinWidth="160" />
                    </controls:SettingsCard>
                    <controls:SettingsCard Header="{x:Bind LocalizedStrings.PKP_Efs_EccKeySize}">
                        <ComboBox x:Name="EccKeySizeComboBox" MinWidth="160" />
                    </controls:SettingsCard>
                    <TextBlock
                        Margin="0,12,0,4"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Text="{x:Bind LocalizedStrings.PKP_Efs_SelfSignedCertificates}"
                        TextWrapping="Wrap" />
                    <controls:SettingsCard Header="{x:Bind LocalizedStrings.PKP_Efs_AllowSelfSigned}">
                        <ToggleSwitch x:Name="AllowSelfSignedToggle" />
                    </controls:SettingsCard>
                </StackPanel>

                <!--  Cache  -->
                <StackPanel
                    x:Name="CachePanel"
                    Spacing="4"
                    Visibility="Collapsed">
                    <controls:SettingsCard
                        Header="{x:Bind LocalizedStrings.PKP_Efs_ClearCacheOnTimeout}"
                        HeaderIcon="{ui:FontIcon Glyph=&#xE823;}">
                        <ToggleSwitch x:Name="ClearCacheOnTimeoutToggle" Toggled="ClearCacheOnTimeoutToggle_Toggled" />
                    </controls:SettingsCard>
                    <controls:SettingsCard Header="{x:Bind LocalizedStrings.PKP_Efs_CacheTimeout}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <NumberBox
                                x:Name="CacheTimeoutNumberBox"
                                MinWidth="160"
                                Maximum="10080"
                                Minimum="5"
                                SpinButtonPlacementMode="Inline" />
                            <TextBlock
                                VerticalAlignment="Center"
                                Text="{x:Bind LocalizedStrings.PKP_Efs_Minutes}" />
                        </StackPanel>
                    </controls:SettingsCard>
                    <controls:SettingsCard Header="{x:Bind LocalizedStrings.PKP_Efs_ClearCacheOnLock}">
                        <ToggleSwitch x:Name="ClearCacheOnLockToggle" />
                    </controls:SettingsCard>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
