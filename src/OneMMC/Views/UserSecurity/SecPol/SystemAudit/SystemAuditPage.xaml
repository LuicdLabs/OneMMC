<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="OneMMC.Views.SystemAuditPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:converters="using:OneMMC.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:localization="using:OneMMC.Localization"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:OneMMC.Core.Features.UserSecurity.Models.SecPol.SystemAudit"
    mc:Ignorable="d">

    <Page.Resources>
        <localization:LocalizedStrings x:Key="LocalizedStrings" />
        <converters:NullToBoolConverter x:Key="NullToBoolConverter" />
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  Command Bar  -->
        <CommandBar Grid.Row="0" DefaultLabelPosition="Right">
            <AppBarButton
                Click="EditButton_Click"
                Icon="Edit"
                IsEnabled="{x:Bind ViewModel.SelectedSubcategory, Mode=OneWay, Converter={StaticResource NullToBoolConverter}}"
                Label="{x:Bind LocalizedStrings.Common_EditButton}" />
            <AppBarButton
                Click="RefreshButton_Click"
                Icon="Refresh"
                Label="{x:Bind LocalizedStrings.Common_Refresh}" />
            <AppBarButton Icon="More">
                <AppBarButton.Flyout>
                    <MenuFlyout>
                        <MenuFlyoutItem Click="ExportButton_Click" Text="{x:Bind LocalizedStrings.SecPol_ExportButton}">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xEDE1;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                    </MenuFlyout>
                </AppBarButton.Flyout>
            </AppBarButton>
        </CommandBar>

        <!--  Error InfoBar  -->
        <InfoBar
            x:Name="ErrorInfoBar"
            Title="{x:Bind LocalizedStrings.Common_ErrorTitle}"
            Grid.Row="1"
            Margin="24,0,24,12"
            IsClosable="True"
            IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
            Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
            Severity="Error" />

        <!--  Main Content  -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" MinWidth="200" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="300" />
            </Grid.ColumnDefinitions>

            <!--  Category Tree  -->
            <TreeView
                x:Name="CategoryTree"
                AllowDrop="False"
                CanDragItems="False"
                CanReorderItems="False"
                ItemInvoked="CategoryTree_ItemInvoked"
                ItemsSource="{x:Bind ViewModel.Categories, Mode=OneWay}"
                SelectionMode="Single">
                <TreeView.ItemTemplate>
                    <DataTemplate x:DataType="models:AuditCategoryItem">
                        <Grid Height="36">
                            <TextBlock VerticalAlignment="Center" Text="{x:Bind DisplayName}" />
                        </Grid>
                    </DataTemplate>
                </TreeView.ItemTemplate>
            </TreeView>

            <controls:GridSplitter
                Grid.Column="1"
                Width="12"
                ResizeBehavior="BasedOnAlignment"
                ResizeDirection="Columns" />

            <!--  Subcategories List  -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <AutoSuggestBox
                    x:Name="SearchBox"
                    Grid.Row="0"
                    Margin="12,8,12,4"
                    PlaceholderText="{x:Bind LocalizedStrings.Common_SearchPlaceholder}"
                    QueryIcon="Find"
                    TextChanged="SearchBox_TextChanged" />

                <!--  Subcategories List  -->
                <ListView
                    x:Name="SubcategoriesList"
                    Grid.Row="1"
                    Padding="12,8,12,12"
                    DoubleTapped="SubcategoriesList_DoubleTapped"
                    ItemsSource="{x:Bind ViewModel.CurrentSubcategories, Mode=OneWay}"
                    SelectedItem="{x:Bind ViewModel.SelectedSubcategory, Mode=TwoWay}"
                    SelectionMode="Single">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:AuditSubcategoryValue">
                            <Grid
                                Padding="0,8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock
                                    Grid.Row="0"
                                    Text="{x:Bind DisplayName}"
                                    TextWrapping="Wrap"
                                    FontWeight="SemiBold" />

                                <TextBlock
                                    Grid.Row="1"
                                    Margin="0,4,0,0"
                                    Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                                    Text="{x:Bind DisplaySetting}"
                                    FontSize="12" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <!--  Loading Indicator  -->
                <ProgressRing
                    Grid.Row="1"
                    Width="50"
                    Height="50"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />
            </Grid>
        </Grid>
    </Grid>
</Page>
