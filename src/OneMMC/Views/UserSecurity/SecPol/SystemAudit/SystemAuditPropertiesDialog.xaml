<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="OneMMC.Views.SystemAuditPropertiesDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:localization="using:OneMMC.Localization"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    Style="{StaticResource DefaultContentDialogStyle}"
    Title=""
    PrimaryButtonText="{x:Bind LocalizedStrings.Common_OKButton}"
    PrimaryButtonStyle="{StaticResource AccentButtonStyle}"
    CloseButtonText="{x:Bind LocalizedStrings.Common_CancelButton}"
    DefaultButton="Primary"
    mc:Ignorable="d">

    <ContentDialog.Resources>
        <localization:LocalizedStrings x:Key="LocalizedStrings" />
    </ContentDialog.Resources>

    <Grid MinWidth="430" MinHeight="470">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <muxc:SelectorBar
            x:Name="PropertiesSelectorBar"
            Grid.Row="0"
            Margin="0,0,0,8"
            SelectionChanged="PropertiesSelectorBar_SelectionChanged">
            <muxc:SelectorBarItem
                IsSelected="True"
                Tag="Policy"
                Text="{x:Bind LocalizedStrings.SecPol_Header_Policy}" />
            <muxc:SelectorBarItem Tag="Explain" Text="{x:Bind LocalizedStrings.SecPol_Tab_Explain}" />
        </muxc:SelectorBar>

        <Grid Grid.Row="1">
            <Border
                Padding="18"
                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                BorderThickness="1">
                <Grid>

                    <!--  Policy tab: wrapped in a ScrollViewer so content is reachable when the dialog is small  -->
                    <ScrollViewer
                        x:Name="PolicyScrollViewer"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto"
                        PointerWheelChanged="ScrollViewer_PointerWheelChanged">
                        <Grid x:Name="PolicyPanel">

                            <!--  Standard audit policy subcategory  -->
                            <Grid x:Name="AuditPolicyPanel">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <StackPanel
                                    Grid.Row="0"
                                    Margin="0,0,0,38"
                                    Orientation="Horizontal"
                                    Spacing="16">
                                    <Grid Width="40" Height="40">
                                        <FontIcon
                                            FontSize="30"
                                            Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                                            Glyph="&#xE7C3;" />
                                        <FontIcon
                                            Margin="19,19,0,0"
                                            FontSize="15"
                                            Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                            Glyph="&#xE72E;" />
                                    </Grid>
                                    <TextBlock
                                        x:Name="PolicyNameText"
                                        VerticalAlignment="Center"
                                        TextWrapping="Wrap" />
                                </StackPanel>

                                <StackPanel Grid.Row="1" Spacing="8">
                                    <CheckBox
                                        x:Name="ConfigureAuditEventsCheckBox"
                                        Checked="ConfigureAuditEventsCheckBox_Changed"
                                        Content="{x:Bind LocalizedStrings.SecPol_SystemAudit_ConfigureAuditEvents}"
                                        Unchecked="ConfigureAuditEventsCheckBox_Changed" />
                                    <StackPanel
                                        x:Name="AuditEventsPanel"
                                        Margin="24,0,0,0"
                                        Spacing="2">
                                        <CheckBox
                                            x:Name="SuccessCheckBox"
                                            Content="{x:Bind LocalizedStrings.SecPol_AuditSuccess}" />
                                        <CheckBox
                                            x:Name="FailureCheckBox"
                                            Content="{x:Bind LocalizedStrings.SecPol_AuditFailure}" />
                                    </StackPanel>
                                </StackPanel>
                            </Grid>

                            <!--  Global Object Access Auditing policy  -->
                            <StackPanel
                                x:Name="GlobalObjectAccessPanel"
                                Spacing="20"
                                Visibility="Collapsed">
                                <TextBlock
                                    x:Name="GlobalObjectAccessPromptText"
                                    Margin="0,22,0,0"
                                    TextWrapping="Wrap" />
                                <StackPanel Margin="18,0,0,0" Spacing="10">
                                    <CheckBox
                                        x:Name="DefineGlobalPolicyCheckBox"
                                        Checked="DefineGlobalPolicyCheckBox_Changed"
                                        Content="{x:Bind LocalizedStrings.SecPol_DefineThisPolicy}"
                                        Unchecked="DefineGlobalPolicyCheckBox_Changed" />
                                    <Button
                                        x:Name="ConfigureGlobalPolicyButton"
                                        Margin="19,0,0,0"
                                        Click="ConfigureGlobalPolicyButton_Click"
                                        Content="{x:Bind LocalizedStrings.SecPol_SystemAudit_ConfigureButton}"
                                        IsEnabled="False" />
                                </StackPanel>
                            </StackPanel>

                        </Grid>
                    </ScrollViewer>

                    <!--  Explain tab: ScrollViewer needed because explain text can be lengthy  -->
                    <ScrollViewer
                        x:Name="ExplainScrollViewer"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto"
                        Visibility="Collapsed"
                        PointerWheelChanged="ScrollViewer_PointerWheelChanged">
                        <TextBlock
                            x:Name="ExplainText"
                            IsTextSelectionEnabled="True"
                            TextWrapping="WrapWholeWords" />
                    </ScrollViewer>

                </Grid>
            </Border>
        </Grid>
    </Grid>
</ContentDialog>
