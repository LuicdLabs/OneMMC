<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="OneMMC.Views.SoftwareRestrictionPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:converters="using:OneMMC.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:OneMMC.Localization"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:srp="using:OneMMC.Core.Features.UserSecurity.Models.SecPol.SoftwareRestriction"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <CommandBar Grid.Row="0" DefaultLabelPosition="Right">
            <AppBarButton
                Click="RefreshButton_Click"
                Icon="Refresh"
                Label="{x:Bind LocalizedStrings.Common_Refresh}" />
            <AppBarButton
                Click="DeletePolicyButton_Click"
                Icon="Delete"
                IsEnabled="{x:Bind ViewModel.IsConfigured, Mode=OneWay}"
                Label="{x:Bind LocalizedStrings.SRP_Command_DeletePolicy}" />
        </CommandBar>

        <StackPanel
            Grid.Row="1"
            Margin="24,0,24,4"
            Spacing="4">
            <InfoBar
                x:Name="DeprecationInfoBar"
                Title="{x:Bind LocalizedStrings.SRP_Deprecation_Title}"
                IsClosable="True"
                IsOpen="{x:Bind ViewModel.ShowsDeprecationWarning}"
                Message="{x:Bind LocalizedStrings.SRP_Deprecation_Message}"
                Severity="Warning" />
            <InfoBar
                x:Name="ErrorInfoBar"
                Title="{x:Bind LocalizedStrings.Common_ErrorTitle}"
                IsClosable="True"
                IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                Severity="Error" />
            <InfoBar
                x:Name="StatusInfoBar"
                Title="{x:Bind ViewModel.StatusTitle, Mode=OneWay}"
                IsClosable="True"
                IsOpen="{x:Bind ViewModel.HasStatus, Mode=TwoWay}"
                Message="{x:Bind ViewModel.StatusDetail}"
                Severity="Success" />
        </StackPanel>

        <muxc:SelectorBar
            x:Name="SectionSelectorBar"
            Grid.Row="2"
            Margin="20,0,24,4"
            SelectionChanged="SectionSelectorBar_SelectionChanged"
            Visibility="{x:Bind ViewModel.IsConfigured, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}">
            <muxc:SelectorBarItem
                x:Name="SecurityLevelsSelectorItem"
                Tag="SecurityLevels"
                Text="{x:Bind LocalizedStrings.SRP_Section_SecurityLevels}" />
            <muxc:SelectorBarItem Tag="AdditionalRules" Text="{x:Bind LocalizedStrings.SRP_Section_AdditionalRules}" />
            <muxc:SelectorBarItem Tag="Enforcement" Text="{x:Bind LocalizedStrings.SRP_Section_Enforcement}" />
            <muxc:SelectorBarItem Tag="DesignatedFileTypes" Text="{x:Bind LocalizedStrings.SRP_Section_DesignatedFileTypes}" />
            <muxc:SelectorBarItem Tag="TrustedPublishers" Text="{x:Bind LocalizedStrings.SRP_Section_TrustedPublishers}" />
        </muxc:SelectorBar>

        <Grid Grid.Row="3">

            <!--  Not-configured empty state  -->
            <StackPanel
                MaxWidth="480"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="12"
                Visibility="{x:Bind ViewModel.ShowsEmptyState, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}">
                <FontIcon
                    HorizontalAlignment="Center"
                    FontSize="48"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Glyph="&#xEB05;" />
                <TextBlock
                    HorizontalAlignment="Center"
                    Style="{StaticResource SubtitleTextBlockStyle}"
                    Text="{x:Bind LocalizedStrings.SRP_NoPolicyDefined}"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
                <TextBlock
                    HorizontalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{x:Bind LocalizedStrings.SRP_NoPolicyDefined_Description}"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
                <Button
                    Margin="0,8,0,0"
                    HorizontalAlignment="Center"
                    Click="CreatePolicyButton_Click"
                    Content="{x:Bind LocalizedStrings.SRP_Command_NewPolicy}"
                    Style="{StaticResource AccentButtonStyle}" />
            </StackPanel>

            <!--  Security Levels  -->
            <ScrollViewer x:Name="SecurityLevelsPanel" Visibility="Collapsed">
                <StackPanel Padding="24,4,24,24" Spacing="4">
                    <TextBlock
                        Margin="0,0,0,8"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="{x:Bind LocalizedStrings.SRP_Help_SecurityLevels}"
                        TextWrapping="Wrap" />
                    <ItemsControl ItemsSource="{x:Bind ViewModel.SecurityLevelItems, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="srp:SoftwareRestrictionSecurityLevelItem">
                                <controls:SettingsCard
                                    Margin="0,0,0,4"
                                    Description="{x:Bind Description}"
                                    Header="{x:Bind DisplayName}">
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <Border
                                            Padding="10,4"
                                            VerticalAlignment="Center"
                                            Background="{ThemeResource AccentFillColorDefaultBrush}"
                                            CornerRadius="10"
                                            Visibility="{x:Bind IsDefault, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <TextBlock
                                                Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                Text="{x:Bind local:LocalizedStrings.Instance.SRP_DefaultMarker}" />
                                        </Border>
                                        <Button
                                            Click="SetDefaultSecurityLevelButton_Click"
                                            Content="{x:Bind local:LocalizedStrings.Instance.SRP_Command_SetAsDefault}"
                                            Visibility="{x:Bind CanSetAsDefault, Converter={StaticResource BoolToVisibilityConverter}}" />
                                    </StackPanel>
                                </controls:SettingsCard>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <!--  Additional Rules  -->
            <Grid x:Name="AdditionalRulesPanel" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid
                    Grid.Row="0"
                    Margin="24,4,24,8"
                    ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <DropDownButton Content="{x:Bind LocalizedStrings.SRP_Command_NewRule}">
                        <DropDownButton.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedLeft">
                                <MenuFlyoutItem Click="NewPathRule_Click" Text="{x:Bind LocalizedStrings.SRP_Command_NewPathRule}" />
                                <MenuFlyoutItem Click="NewHashRule_Click" Text="{x:Bind LocalizedStrings.SRP_Command_NewHashRule}" />
                                <MenuFlyoutItem Click="NewCertificateRule_Click" Text="{x:Bind LocalizedStrings.SRP_Command_NewCertificateRule}" />
                                <MenuFlyoutItem Click="NewNetworkZoneRule_Click" Text="{x:Bind LocalizedStrings.SRP_Command_NewNetworkZoneRule}" />
                            </MenuFlyout>
                        </DropDownButton.Flyout>
                    </DropDownButton>
                    <Button
                        Grid.Column="1"
                        Click="EditRuleButton_Click"
                        Content="{x:Bind LocalizedStrings.Common_EditButton}"
                        IsEnabled="{x:Bind ViewModel.CanEditSelectedRule, Mode=OneWay}" />
                    <Button
                        Grid.Column="2"
                        Click="DeleteRuleButton_Click"
                        Content="{x:Bind LocalizedStrings.Common_DeleteButton}"
                        IsEnabled="{x:Bind ViewModel.CanDeleteSelectedRule, Mode=OneWay}" />
                    <AutoSuggestBox
                        x:Name="RuleSearchBox"
                        Grid.Column="3"
                        MaxWidth="360"
                        HorizontalAlignment="Right"
                        PlaceholderText="{x:Bind LocalizedStrings.SRP_Rules_SearchPlaceholder}"
                        QueryIcon="Find"
                        TextChanged="RuleSearchBox_TextChanged" />
                </Grid>

                <TextBlock
                    Grid.Row="1"
                    Margin="24,0,24,8"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{x:Bind LocalizedStrings.SRP_Rules_PrecedenceHint}"
                    TextWrapping="Wrap" />

                <Grid
                    Grid.Row="2"
                    Margin="40,0,40,0"
                    ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2.6*" />
                        <ColumnDefinition Width="1.4*" />
                        <ColumnDefinition Width="1.2*" />
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="1.6*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        FontWeight="SemiBold"
                        Text="{x:Bind LocalizedStrings.SRP_ListHeader_Name}"
                        TextWrapping="WrapWholeWords" />
                    <TextBlock
                        Grid.Column="1"
                        FontWeight="SemiBold"
                        Text="{x:Bind LocalizedStrings.SRP_ListHeader_Type}"
                        TextWrapping="WrapWholeWords" />
                    <TextBlock
                        Grid.Column="2"
                        FontWeight="SemiBold"
                        Text="{x:Bind LocalizedStrings.SRP_ListHeader_SecurityLevel}"
                        TextWrapping="WrapWholeWords" />
                    <TextBlock
                        Grid.Column="3"
                        FontWeight="SemiBold"
                        Text="{x:Bind LocalizedStrings.SRP_ListHeader_Description}"
                        TextWrapping="WrapWholeWords" />
                    <TextBlock
                        Grid.Column="4"
                        FontWeight="SemiBold"
                        Text="{x:Bind LocalizedStrings.SRP_ListHeader_LastModified}"
                        TextWrapping="WrapWholeWords" />
                </Grid>

                <ListView
                    x:Name="RulesListView"
                    Grid.Row="3"
                    Padding="24,4,24,24"
                    DoubleTapped="RulesListView_DoubleTapped"
                    ItemsSource="{x:Bind ViewModel.FilteredRules, Mode=OneWay}"
                    SelectedItem="{x:Bind ViewModel.SelectedRule, Mode=TwoWay}"
                    SelectionMode="Single">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="srp:SoftwareRestrictionRule">
                            <Grid MinHeight="44" ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2.6*" />
                                    <ColumnDefinition Width="1.4*" />
                                    <ColumnDefinition Width="1.2*" />
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="1.6*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Text="{x:Bind DisplayValue}"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="NoWrap"
                                    ToolTipService.ToolTip="{x:Bind DisplayValue}" />
                                <TextBlock
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{x:Bind KindDisplayName}"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="NoWrap"
                                    ToolTipService.ToolTip="{x:Bind KindDisplayName}" />
                                <TextBlock
                                    Grid.Column="2"
                                    VerticalAlignment="Center"
                                    Text="{x:Bind SecurityLevelDisplayName}"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="NoWrap"
                                    ToolTipService.ToolTip="{x:Bind SecurityLevelDisplayName}" />
                                <TextBlock
                                    Grid.Column="3"
                                    VerticalAlignment="Center"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{x:Bind Description}"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="NoWrap"
                                    ToolTipService.ToolTip="{x:Bind Description}" />
                                <TextBlock
                                    Grid.Column="4"
                                    VerticalAlignment="Center"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{x:Bind LastModifiedDisplay}"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="NoWrap"
                                    ToolTipService.ToolTip="{x:Bind LastModifiedDisplay}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <TextBlock
                    Grid.Row="3"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{x:Bind LocalizedStrings.SRP_NoAdditionalRules}"
                    Visibility="{x:Bind ViewModel.HasNoRules, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}" />
            </Grid>

            <!--  Enforcement  -->
            <ScrollViewer x:Name="EnforcementPanel" Visibility="Collapsed">
                <StackPanel Padding="24,4,24,24" Spacing="4">
                    <controls:SettingsCard Description="{x:Bind LocalizedStrings.SRP_Enforcement_DefaultSecurityLevel_Description}" Header="{x:Bind LocalizedStrings.SRP_Enforcement_DefaultSecurityLevel}">
                        <ComboBox
                            x:Name="DefaultLevelComboBox"
                            MinWidth="220"
                            SelectedIndex="{x:Bind ViewModel.DefaultSecurityLevelIndex, Mode=OneWay}"
                            SelectionChanged="DefaultLevelComboBox_SelectionChanged">
                            <ComboBoxItem Content="{x:Bind LocalizedStrings.SRP_SecurityLevel_Disallowed}" />
                            <ComboBoxItem Content="{x:Bind LocalizedStrings.SRP_SecurityLevel_BasicUser}" />
                            <ComboBoxItem Content="{x:Bind LocalizedStrings.SRP_SecurityLevel_Unrestricted}" />
                        </ComboBox>
                    </controls:SettingsCard>

                    <controls:SettingsCard Description="{x:Bind LocalizedStrings.SRP_Enforcement_FileScope_Description}" Header="{x:Bind LocalizedStrings.SRP_Enforcement_FileScope}">
                        <ComboBox
                            x:Name="FileScopeComboBox"
                            MinWidth="220"
                            SelectedIndex="{x:Bind ViewModel.FileScopeIndex, Mode=OneWay}"
                            SelectionChanged="FileScopeComboBox_SelectionChanged">
                            <ComboBoxItem Content="{x:Bind LocalizedStrings.SRP_FileScope_ExecutableFilesOnly}" />
                            <ComboBoxItem Content="{x:Bind LocalizedStrings.SRP_FileScope_AllSoftwareFiles}" />
                        </ComboBox>
                    </controls:SettingsCard>

                    <controls:SettingsCard Description="{x:Bind LocalizedStrings.SRP_Enforcement_UserScope_Description}" Header="{x:Bind LocalizedStrings.SRP_Enforcement_UserScope}">
                        <ComboBox
                            x:Name="UserScopeComboBox"
                            MinWidth="220"
                            SelectedIndex="{x:Bind ViewModel.UserScopeIndex, Mode=OneWay}"
                            SelectionChanged="UserScopeComboBox_SelectionChanged">
                            <ComboBoxItem Content="{x:Bind LocalizedStrings.SRP_UserScope_AllUsers}" />
                            <ComboBoxItem Content="{x:Bind LocalizedStrings.SRP_UserScope_AllExceptAdministrators}" />
                        </ComboBox>
                    </controls:SettingsCard>

                    <controls:SettingsCard Description="{x:Bind LocalizedStrings.SRP_Enforcement_CertificateRules_Description}" Header="{x:Bind LocalizedStrings.SRP_Enforcement_CertificateRules}">
                        <ToggleSwitch
                            x:Name="CertificateRulesToggle"
                            IsOn="{x:Bind ViewModel.CertificateRulesEnabled, Mode=OneWay}"
                            Toggled="CertificateRulesToggle_Toggled" />
                    </controls:SettingsCard>
                </StackPanel>
            </ScrollViewer>

            <!--  Designated File Types  -->
            <Grid x:Name="DesignatedFileTypesPanel" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock
                    Grid.Row="0"
                    Margin="24,4,24,8"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{x:Bind LocalizedStrings.SRP_Help_DesignatedFileTypes_AddRemove}"
                    TextWrapping="Wrap" />

                <StackPanel
                    Grid.Row="1"
                    Margin="24,0,24,12"
                    Orientation="Horizontal"
                    Spacing="8">
                    <TextBox
                        x:Name="NewFileTypeTextBox"
                        MinWidth="160"
                        MaxLength="32"
                        PlaceholderText="{x:Bind LocalizedStrings.SRP_Field_FileExtension}"
                        Text="{x:Bind ViewModel.NewFileTypeExtension, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <Button
                        Click="AddFileTypeButton_Click"
                        Content="{x:Bind LocalizedStrings.Common_AddButton}"
                        IsEnabled="{x:Bind ViewModel.CanAddFileType, Mode=OneWay}"
                        Style="{StaticResource AccentButtonStyle}" />
                </StackPanel>

                <Grid
                    Grid.Row="2"
                    Margin="40,0,40,0"
                    ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" MinWidth="48" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        FontWeight="SemiBold"
                        Text="{x:Bind LocalizedStrings.SRP_ListHeader_Extension}"
                        TextWrapping="WrapWholeWords" />
                    <TextBlock
                        Grid.Column="1"
                        FontWeight="SemiBold"
                        Text="{x:Bind LocalizedStrings.SRP_ListHeader_FileType}"
                        TextWrapping="WrapWholeWords" />
                </Grid>

                <ListView
                    Grid.Row="3"
                    Padding="24,4,24,24"
                    ItemsSource="{x:Bind ViewModel.FileTypeItems, Mode=OneWay}"
                    SelectionMode="None">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="srp:SoftwareRestrictionFileTypeItem">
                            <Grid MinHeight="40" ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" MinWidth="48" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Text="{x:Bind Extension}"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="NoWrap" />
                                <TextBlock
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{x:Bind FileTypeDisplay}"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="NoWrap"
                                    ToolTipService.ToolTip="{x:Bind FileTypeDisplay}" />
                                <Button
                                    Grid.Column="2"
                                    Padding="6"
                                    VerticalAlignment="Center"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Click="RemoveFileTypeButton_Click"
                                    ToolTipService.ToolTip="{x:Bind local:LocalizedStrings.Instance.Common_RemoveButton}">
                                    <FontIcon FontSize="14" Glyph="&#xE74D;" />
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>

            <!--  Trusted Publishers  -->
            <ScrollViewer x:Name="TrustedPublishersPanel" Visibility="Collapsed">
                <StackPanel Padding="24,4,24,24" Spacing="4">
                    <TextBlock
                        Margin="0,0,0,8"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="{x:Bind LocalizedStrings.SRP_Help_TrustedPublishers}"
                        TextWrapping="Wrap" />

                    <controls:SettingsCard Header="{x:Bind LocalizedStrings.SRP_TrustedPublishers_DefineSettings}">
                        <ToggleSwitch
                            x:Name="TrustedPublishersDefinedToggle"
                            IsOn="{x:Bind ViewModel.TrustedPublishersDefined, Mode=OneWay}"
                            Toggled="TrustedPublishersDefinedToggle_Toggled" />
                    </controls:SettingsCard>

                    <controls:SettingsCard
                        Header="{x:Bind LocalizedStrings.SRP_TrustedPublishers_Management}"
                        IsEnabled="{x:Bind ViewModel.TrustedPublishersDefined, Mode=OneWay}">
                        <ComboBox
                            x:Name="PublisherScopeComboBox"
                            MinWidth="260"
                            SelectedIndex="{x:Bind ViewModel.PublisherScopeIndex, Mode=OneWay}"
                            SelectionChanged="PublisherScopeComboBox_SelectionChanged">
                            <ComboBoxItem Content="{x:Bind LocalizedStrings.SRP_PublisherScope_EndUsers}" />
                            <ComboBoxItem Content="{x:Bind LocalizedStrings.SRP_PublisherScope_LocalAdministrators}" />
                            <ComboBoxItem Content="{x:Bind LocalizedStrings.SRP_PublisherScope_EnterpriseAdministrators}" IsEnabled="False" />
                        </ComboBox>
                    </controls:SettingsCard>

                    <controls:SettingsExpander
                        Header="{x:Bind LocalizedStrings.SRP_TrustedPublishers_AdditionalChecks}"
                        IsEnabled="{x:Bind ViewModel.TrustedPublishersDefined, Mode=OneWay}"
                        IsExpanded="True">
                        <controls:SettingsExpander.Items>
                            <controls:SettingsCard Description="{x:Bind LocalizedStrings.SRP_TrustedPublishers_PublisherRevocation_Option}" Header="{x:Bind LocalizedStrings.SRP_TrustedPublishers_PublisherRevocation}">
                                <ToggleSwitch
                                    x:Name="PublisherRevocationToggle"
                                    IsOn="{x:Bind ViewModel.CheckPublisherRevocation, Mode=OneWay}"
                                    Toggled="PublisherRevocationToggle_Toggled" />
                            </controls:SettingsCard>
                            <controls:SettingsCard Description="{x:Bind LocalizedStrings.SRP_TrustedPublishers_TimestampRevocation_Option}" Header="{x:Bind LocalizedStrings.SRP_TrustedPublishers_TimestampRevocation}">
                                <ToggleSwitch
                                    x:Name="TimestampRevocationToggle"
                                    IsOn="{x:Bind ViewModel.CheckTimestampRevocation, Mode=OneWay}"
                                    Toggled="TimestampRevocationToggle_Toggled" />
                            </controls:SettingsCard>
                        </controls:SettingsExpander.Items>
                    </controls:SettingsExpander>
                </StackPanel>
            </ScrollViewer>

            <ProgressRing
                Width="50"
                Height="50"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />
        </Grid>
    </Grid>
</Page>
