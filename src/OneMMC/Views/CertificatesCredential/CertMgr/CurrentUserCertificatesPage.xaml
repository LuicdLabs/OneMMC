<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="OneMMC.Views.CurrentUserCertificatesPage"
    x:Name="PageRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:localization="using:OneMMC.Localization"
    xmlns:certModels="using:OneMMC.Core.Features.Certificates.Models"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:converters="using:OneMMC.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <Style x:Key="CertificateIconButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="MinWidth" Value="36" />
            <Setter Property="Padding" Value="8" />
        </Style>
        <Style x:Key="CertificateMenuFlyoutPresenterStyle" TargetType="MenuFlyoutPresenter">
            <Setter Property="MinWidth" Value="120" />
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Padding="24,16,24,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <AutoSuggestBox
                x:Name="SearchBox"
                Width="300"
                MaxHeight="35"
                HorizontalAlignment="Left"
                PlaceholderText="{x:Bind LocalizedStrings.Common_SearchPlaceholder}"
                QueryIcon="Find"
                TextChanged="SearchBox_TextChanged" />

            <CommandBar
                Grid.Column="1"
                Background="Transparent"
                DefaultLabelPosition="Right">
                <AppBarElementContainer Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                    <ProgressRing
                        Width="20"
                        Height="20"
                        IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />
                </AppBarElementContainer>
                <AppBarButton
                    Click="RefreshAllButton_Click"
                    Icon="Refresh"
                    Label="{x:Bind LocalizedStrings.Common_Refresh}" />
                <AppBarSeparator />
                <AppBarButton
                    AutomationProperties.Name="{x:Bind LocalizedStrings.Certificates_MoreButton}"
                    Click="StoreOperationsButton_Click"
                    Icon="More"
                    ToolTipService.ToolTip="{x:Bind LocalizedStrings.Certificates_MoreButton}" />
            </CommandBar>
        </Grid>

        <InfoBar
            x:Name="ErrorInfoBar"
            Grid.Row="1"
            Margin="24,0,24,12"
            IsClosable="True"
            IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
            Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
            Severity="Error"
            Title="{x:Bind LocalizedStrings.Common_ErrorTitle}" />

        <ScrollViewer Grid.Row="2" Padding="24,12,24,24">
            <ItemsControl ItemsSource="{x:Bind ViewModel.Stores, Mode=OneWay}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Spacing="8" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="certModels:CertificateStoreNode">
                        <controls:SettingsExpander
                            Header="{x:Bind DisplayName}"
                            IsExpanded="{x:Bind IsExpanded, Mode=TwoWay}"
                            ItemsSource="{x:Bind Rows}">
                            <controls:SettingsExpander.ItemTemplate>
                                <DataTemplate x:DataType="certModels:CertificateDisplayRow">
                                    <controls:SettingsCard
                                        DoubleTapped="EntryContainer_DoubleTapped"
                                        Padding="16,8"
                                        Tag="{x:Bind Entry}">
                                        <controls:SettingsCard.Header>
                                            <Grid>
                                                <TextBlock
                                                    Margin="0,4"
                                                    FontWeight="SemiBold"
                                                    Text="{x:Bind PrimaryText}"
                                                    Visibility="{x:Bind IsSection, Mode=OneTime, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                <StackPanel Visibility="{x:Bind IsEntry, Mode=OneTime, Converter={StaticResource BoolToVisibilityConverter}}">
                                                    <TextBlock Text="{x:Bind PrimaryText}" TextWrapping="WrapWholeWords" />
                                                    <TextBlock
                                                        FontSize="12"
                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                        Text="{x:Bind SecondaryText}"
                                                        TextWrapping="WrapWholeWords" />
                                                </StackPanel>
                                            </Grid>
                                        </controls:SettingsCard.Header>

                                        <StackPanel
                                            Orientation="Horizontal"
                                            Spacing="8"
                                            Visibility="{x:Bind IsEntry, Mode=OneTime, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <Button
                                                AutomationProperties.Name="{x:Bind localization:LocalizedStrings.Instance.Common_OpenButton}"
                                                Click="OpenEntryButton_Click"
                                                Style="{StaticResource CertificateIconButtonStyle}"
                                                Tag="{x:Bind Entry}"
                                                ToolTipService.ToolTip="{x:Bind localization:LocalizedStrings.Instance.Common_OpenButton}">
                                                <FontIcon FontSize="16" Glyph="&#xE7B3;" />
                                            </Button>
                                            <Button
                                                AutomationProperties.Name="{x:Bind localization:LocalizedStrings.Instance.Certificates_MoreButton}"
                                                Style="{StaticResource CertificateIconButtonStyle}"
                                                ToolTipService.ToolTip="{x:Bind localization:LocalizedStrings.Instance.Certificates_MoreButton}">
                                                <Button.Flyout>
                                                    <MenuFlyout
                                                        MenuFlyoutPresenterStyle="{StaticResource CertificateMenuFlyoutPresenterStyle}"
                                                        Placement="BottomEdgeAlignedRight">
                                                        <MenuFlyoutItem
                                                            Click="PropertiesMenuItem_Click"
                                                            Tag="{x:Bind Entry}"
                                                            Text="{x:Bind localization:LocalizedStrings.Instance.Certificates_PropertiesCommand}" />
                                                        <MenuFlyoutItem
                                                            Click="DeleteMenuItem_Click"
                                                            Tag="{x:Bind Entry}"
                                                            Text="{x:Bind localization:LocalizedStrings.Instance.Common_DeleteButton}" />
                                                    </MenuFlyout>
                                                </Button.Flyout>
                                                <FontIcon FontSize="16" Glyph="&#xE712;" />
                                            </Button>
                                        </StackPanel>
                                    </controls:SettingsCard>
                                </DataTemplate>
                            </controls:SettingsExpander.ItemTemplate>
                        </controls:SettingsExpander>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Page>
