<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="OneMMC.Views.DiskMgmt.RemoveDriveLetterDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:core="using:OneMMC.Core.Features.PCManagement.Models.DiskMgmt"
    xmlns:localization="using:OneMMC.Localization"
    mc:Ignorable="d"
    Title="{x:Bind LocalizedStrings.DiskMgmt_RemoveDriveLetterTitle}"
    PrimaryButtonText="{x:Bind LocalizedStrings.Common_RemoveButton}"
    CloseButtonText="{x:Bind LocalizedStrings.Common_CancelButton}"
    DefaultButton="Close"
    Style="{StaticResource DefaultContentDialogStyle}">

    <ContentDialog.Resources>
    </ContentDialog.Resources>

    <StackPanel Spacing="16" MinWidth="350">
        <TextBlock 
            x:Name="MessageTextBlock"
            TextWrapping="Wrap" />
    </StackPanel>
</ContentDialog>
