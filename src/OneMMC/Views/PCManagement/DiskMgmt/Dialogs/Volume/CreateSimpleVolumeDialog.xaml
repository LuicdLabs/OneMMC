<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="OneMMC.Views.DiskMgmt.CreateSimpleVolumeDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:local="using:OneMMC.Views.DiskMgmt"
    xmlns:core="using:OneMMC.Core.Features.PCManagement.Models.DiskMgmt"
    xmlns:localization="using:OneMMC.Localization"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    CloseButtonText="{x:Bind LocalizedStrings.Common_CancelButton}"
    PrimaryButtonText="{x:Bind LocalizedStrings.Common_CreateButton}"
    DefaultButton="Primary"
    Style="{StaticResource DefaultContentDialogStyle}">

    <ContentDialog.Resources>
    </ContentDialog.Resources>

    <Grid MinWidth="450" MinHeight="400">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock
            Grid.Row="0"
            Margin="0,0,0,12"
            Style="{StaticResource SubtitleTextBlockStyle}"
            Text="{x:Bind LocalizedStrings.DiskMgmt_CreateSimpleVolumeTitle}"
            TextWrapping="Wrap" />

        <!-- Content -->
        <ScrollViewer Grid.Row="1">
            <StackPanel Spacing="12">
                <TextBlock Text="{x:Bind LocalizedStrings.DiskMgmt_Disk}" FontWeight="SemiBold" />
                <TextBlock x:Name="DiskInfoTextBlock" />

                <TextBlock Text="{x:Bind LocalizedStrings.DiskMgmt_VolumeSizeMB}" FontWeight="SemiBold" />
                <NumberBox x:Name="VolumeSizeNumberBox" Minimum="1" SpinButtonPlacementMode="Inline" />
                <TextBlock x:Name="MaxSizeTextBlock" FontSize="12" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" />

                <TextBlock Text="{x:Bind LocalizedStrings.DiskMgmt_DriveLetter}" FontWeight="SemiBold" />
                <ComboBox x:Name="DriveLetterComboBox" MinWidth="200" />

                <TextBlock Text="{x:Bind LocalizedStrings.DiskMgmt_VolumeLabel}" FontWeight="SemiBold" />
                <TextBox x:Name="VolumeLabelTextBox" MaxLength="32" Text="{x:Bind LocalizedStrings.DiskMgmt_NewVolume}" />

                <TextBlock Text="{x:Bind LocalizedStrings.DiskMgmt_FileSystem}" FontWeight="SemiBold" />
                <ComboBox x:Name="FileSystemComboBox" SelectedIndex="0">
                    <ComboBoxItem Content="NTFS" />
                    <ComboBoxItem Content="FAT32" />
                    <ComboBoxItem Content="exFAT" />
                </ComboBox>

                <CheckBox x:Name="QuickFormatCheckBox" Content="{x:Bind LocalizedStrings.DiskMgmt_PerformQuickFormat}" IsChecked="True" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</ContentDialog>
