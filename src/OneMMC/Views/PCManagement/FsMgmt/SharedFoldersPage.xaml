<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="OneMMC.Views.SharedFoldersPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:localization="using:OneMMC.Localization"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:converters="using:OneMMC.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:OneMMC.Core.Features.PCManagement.Models.FsMgmt"
    x:Name="PageRoot"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <converters:CollectionEmptyToVisibilityConverter x:Key="CollectionEmptyToVisibilityConverter" />
        <converters:StringVisibilityConverter x:Key="StringVisibilityConverter" />
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid
            Grid.Row="0"
            Margin="24,18,24,12"
            ColumnDefinitions="Auto,*,Auto">
            <AutoSuggestBox
                x:Name="SearchBox"
                Width="360"
                PlaceholderText="{x:Bind LocalizedStrings.FsMgmt_Page_SearchPlaceholder}"
                QueryIcon="Find"
                TextChanged="SearchBox_TextChanged" />

            <StackPanel
                Grid.Column="2"
                Orientation="Horizontal"
                Spacing="8">
                <Button
                    Click="Refresh_Click"
                    Style="{StaticResource SubtleButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE72C;" />
                        <TextBlock Text="{x:Bind LocalizedStrings.Common_Refresh}" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource SubtleButtonStyle}">
                    <FontIcon Glyph="&#xE712;" />
                    <Button.Flyout>
                        <MenuFlyout />
                    </Button.Flyout>
                </Button>
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="2">
            <StackPanel Padding="24,0,24,24" Spacing="4">

                <!--  Shares  -->
                <controls:SettingsExpander
                    HorizontalAlignment="Stretch"
                    Header="{x:Bind LocalizedStrings.FsMgmt_Shares_Header}"
                    IsExpanded="True"
                    ItemsSource="{x:Bind ViewModel.Shares, Mode=OneWay}">
                    <controls:SettingsExpander.HeaderIcon>
                        <FontIcon FontSize="16" Glyph="&#xEC25;" />
                    </controls:SettingsExpander.HeaderIcon>
                    <controls:SettingsExpander.Description>
                        <TextBlock Text="{x:Bind ViewModel.SharesDescription, Mode=OneWay}" />
                    </controls:SettingsExpander.Description>

                    <Button
                        Click="AddShare_Click"
                        Content="{x:Bind LocalizedStrings.Common_AddButton}"
                        MinWidth="110" />

                    <controls:SettingsExpander.ItemTemplate>
                        <DataTemplate x:DataType="models:SharedFolderShare">
                            <controls:SettingsCard>
                                <controls:SettingsCard.Header>
                                    <StackPanel Spacing="2">
                                        <TextBlock
                                            FontWeight="SemiBold"
                                            Text="{x:Bind Name}" />
                                        <TextBlock
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Text="{x:Bind Description}"
                                            TextTrimming="CharacterEllipsis"
                                            Visibility="{x:Bind Description, Converter={StaticResource StringVisibilityConverter}}" />
                                        <TextBlock
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Text="{x:Bind DetailsLine}"
                                            TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </controls:SettingsCard.Header>
                                <controls:SettingsCard.Content>
                                    <Button
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Tag="{x:Bind}">
                                        <FontIcon FontSize="16" Glyph="&#xE712;" />
                                        <Button.Flyout>
                                            <MenuFlyout>
                                                <MenuFlyoutItem
                                                    Click="OpenShare_Click"
                                                    Tag="{x:Bind}"
                                                    Text="{x:Bind localization:LocalizedStrings.Instance.FsMgmt_Open}" />
                                                <MenuFlyoutItem
                                                    Click="StopSharing_Click"
                                                    Tag="{x:Bind}"
                                                    Text="{x:Bind localization:LocalizedStrings.Instance.FsMgmt_StopSharing}" />
                                                <MenuFlyoutItem
                                                    Click="ShareProperties_Click"
                                                    Tag="{x:Bind}"
                                                    Text="{x:Bind localization:LocalizedStrings.Instance.FsMgmt_Properties}" />
                                            </MenuFlyout>
                                        </Button.Flyout>
                                    </Button>
                                </controls:SettingsCard.Content>
                            </controls:SettingsCard>
                        </DataTemplate>
                    </controls:SettingsExpander.ItemTemplate>
                </controls:SettingsExpander>

                <!--  Sessions  -->
                <controls:SettingsExpander
                    HorizontalAlignment="Stretch"
                    Header="{x:Bind LocalizedStrings.FsMgmt_Sessions_Header}"
                    IsExpanded="True"
                    ItemsSource="{x:Bind ViewModel.Sessions, Mode=OneWay}">
                    <controls:SettingsExpander.HeaderIcon>
                        <FontIcon FontSize="16" Glyph="&#xE7EE;" />
                    </controls:SettingsExpander.HeaderIcon>
                    <controls:SettingsExpander.Description>
                        <TextBlock Text="{x:Bind ViewModel.SessionsDescription, Mode=OneWay}" />
                    </controls:SettingsExpander.Description>

                    <Button
                        Background="Transparent"
                        BorderThickness="0">
                        <FontIcon FontSize="16" Glyph="&#xE712;" />
                        <Button.Flyout>
                            <MenuFlyout>
                                <MenuFlyoutItem
                                    Click="DisconnectAllSessions_Click"
                                    IsEnabled="{x:Bind ViewModel.HasSessions, Mode=OneWay}"
                                    Text="{x:Bind LocalizedStrings.FsMgmt_DisconnectAllSessions}" />
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>

                    <controls:SettingsExpander.ItemTemplate>
                        <DataTemplate x:DataType="models:SharedFolderSession">
                            <controls:SettingsCard>
                                <controls:SettingsCard.Header>
                                    <StackPanel Spacing="2">
                                        <TextBlock
                                            FontWeight="SemiBold"
                                            Text="{x:Bind UserName}" />
                                        <TextBlock
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Text="{x:Bind ClientName}"
                                            TextTrimming="CharacterEllipsis" />
                                        <TextBlock
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Text="{x:Bind DetailsLine}"
                                            TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </controls:SettingsCard.Header>
                                <controls:SettingsCard.Content>
                                    <Button
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Click="DisconnectSession_Click"
                                        Tag="{x:Bind}">
                                        <FontIcon FontSize="16" Glyph="&#xE74D;" />
                                    </Button>
                                </controls:SettingsCard.Content>
                            </controls:SettingsCard>
                        </DataTemplate>
                    </controls:SettingsExpander.ItemTemplate>
                </controls:SettingsExpander>

                <!--  Open Files  -->
                <controls:SettingsExpander
                    HorizontalAlignment="Stretch"
                    Header="{x:Bind LocalizedStrings.FsMgmt_OpenFiles_Header}"
                    IsExpanded="True"
                    ItemsSource="{x:Bind ViewModel.OpenFiles, Mode=OneWay}">
                    <controls:SettingsExpander.HeaderIcon>
                        <FontIcon FontSize="16" Glyph="&#xE838;" />
                    </controls:SettingsExpander.HeaderIcon>
                    <controls:SettingsExpander.Description>
                        <TextBlock Text="{x:Bind ViewModel.OpenFilesDescription, Mode=OneWay}" />
                    </controls:SettingsExpander.Description>

                    <Button
                        Background="Transparent"
                        BorderThickness="0">
                        <FontIcon FontSize="16" Glyph="&#xE712;" />
                        <Button.Flyout>
                            <MenuFlyout>
                                <MenuFlyoutItem
                                    Click="CloseAllOpenFiles_Click"
                                    IsEnabled="{x:Bind ViewModel.HasOpenFiles, Mode=OneWay}"
                                    Text="{x:Bind LocalizedStrings.FsMgmt_CloseAllOpenFiles}" />
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>

                    <controls:SettingsExpander.ItemTemplate>
                        <DataTemplate x:DataType="models:SharedFolderOpenFile">
                            <controls:SettingsCard>
                                <controls:SettingsCard.Header>
                                    <StackPanel Spacing="2">
                                        <TextBlock
                                            FontWeight="SemiBold"
                                            Text="{x:Bind Path}" />
                                        <TextBlock
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Text="{x:Bind UserName}"
                                            TextTrimming="CharacterEllipsis" />
                                        <TextBlock
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Text="{x:Bind DetailsLine}"
                                            TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </controls:SettingsCard.Header>
                                <controls:SettingsCard.Content>
                                    <Button
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Click="CloseOpenFile_Click"
                                        Tag="{x:Bind}">
                                        <FontIcon FontSize="16" Glyph="&#xE74D;" />
                                    </Button>
                                </controls:SettingsCard.Content>
                            </controls:SettingsCard>
                        </DataTemplate>
                    </controls:SettingsExpander.ItemTemplate>
                </controls:SettingsExpander>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
