<?xml version="1.0" encoding="utf-8" ?>
<!--
    NewEventFilterContent — body of the "New Event Filter" editor reached from
    NewTriggerDialog ("On an event" > Custom > "New Event Filter..."). It is hosted as the
    Content of a ModalDialogWindow (a real top-level Window), because a ContentDialog cannot
    open a second ContentDialog on the same window. The hosting window supplies the OK / Cancel
    buttons, so this UserControl only provides the filter form.

    The Filter and XML tabs mirror the Windows Event Viewer / Task Scheduler event filter. Rather than
    cloning the cramped Win32 layout, the multi-select pickers (Event logs / Event sources / Keywords)
    are Fluent DropDownButtons that open a checkbox flyout, and the Logged picker opens the Custom Range
    dialog. BuildQuery() turns the Filter-tab fields into an Event Log QueryList (via EventXPathBuilder)
    — or returns the hand-written query from the XML tab — for use as IEventTrigger.Subscription.
-->
<UserControl
	x:Class="OneMMC.Views.PCManagement.NewEventFilterContent"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:local="using:OneMMC.Views.PCManagement"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	mc:Ignorable="d">

	<UserControl.Resources>
		<!--  Fixed-width inline label so the form fields align under one another.  -->
		<Style x:Key="InlineLabelStyle" TargetType="TextBlock">
			<Setter Property="VerticalAlignment" Value="Center" />
			<Setter Property="Width" Value="96" />
		</Style>
		<!--  Secondary (hint) text for the helper / instruction lines.  -->
		<Style x:Key="SecondaryTextStyle" TargetType="TextBlock">
			<Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
			<Setter Property="TextWrapping" Value="Wrap" />
		</Style>
		<!--  Consistent width/alignment for the three multi-select drop-down pickers.  -->
		<Style x:Key="PickerDropDownStyle" TargetType="DropDownButton">
			<Setter Property="Width" Value="320" />
			<Setter Property="HorizontalContentAlignment" Value="Stretch" />
		</Style>

		<DataTemplate x:Key="CheckableItemTemplate" x:DataType="local:CheckableItem">
			<CheckBox Content="{x:Bind Name}" IsChecked="{x:Bind IsChecked, Mode=TwoWay}" />
		</DataTemplate>
	</UserControl.Resources>

	<Grid MinWidth="460">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
		</Grid.RowDefinitions>

		<!--  Filter / XML tabs (SelectorBar per project convention, not Pivot/TabControl).  -->
		<SelectorBar
			x:Name="FilterXmlSelector"
			Grid.Row="0"
			SelectionChanged="FilterXmlSelector_SelectionChanged">
			<SelectorBarItem x:Name="FilterTabItem" Text="{x:Bind LocalizedStrings.TaskSchd_Filter_FilterTab}" />
			<SelectorBarItem x:Name="XmlTabItem" Text="{x:Bind LocalizedStrings.TaskSchd_Filter_XmlTab}" />
		</SelectorBar>

		<ScrollViewer
			Grid.Row="1"
			Margin="0,8,0,0"
			VerticalScrollBarVisibility="Auto">
			<Grid>
				<!--  ================================ Filter tab ================================  -->
				<StackPanel x:Name="FilterTabPanel" Spacing="14">
					<StackPanel Orientation="Horizontal" Spacing="8">
						<TextBlock Style="{StaticResource InlineLabelStyle}" Text="{x:Bind LocalizedStrings.TaskSchd_Filter_Logged}" />
						<ComboBox
							x:Name="LoggedCombo"
							Width="316"
							SelectedIndex="0"
							SelectionChanged="LoggedCombo_SelectionChanged">
							<ComboBoxItem Content="{x:Bind LocalizedStrings.TaskSchd_Filter_AnyTime}" />
							<ComboBoxItem Content="{x:Bind LocalizedStrings.TaskSchd_Filter_LastHour}" />
							<ComboBoxItem Content="{x:Bind LocalizedStrings.TaskSchd_Filter_Last12Hours}" />
							<ComboBoxItem Content="{x:Bind LocalizedStrings.TaskSchd_Filter_Last24Hours}" />
							<ComboBoxItem Content="{x:Bind LocalizedStrings.TaskSchd_Filter_Last7Days}" />
							<ComboBoxItem Content="{x:Bind LocalizedStrings.TaskSchd_Filter_Last30Days}" />
							<ComboBoxItem x:Name="CustomRangeActionItem" Content="{x:Bind LocalizedStrings.TaskSchd_Filter_CustomRange}" />
						</ComboBox>
					</StackPanel>

					<!--  Event level is multi-select, so checkboxes (none checked = all levels).  -->
					<StackPanel Orientation="Horizontal" Spacing="8">
						<TextBlock Style="{StaticResource InlineLabelStyle}" Text="{x:Bind LocalizedStrings.TaskSchd_Filter_EventLevel}" />
						<StackPanel Orientation="Horizontal" Spacing="16">
							<CheckBox x:Name="CriticalCheck" Content="{x:Bind LocalizedStrings.EventViewer_Level_Critical}" />
							<CheckBox x:Name="WarningCheck" Content="{x:Bind LocalizedStrings.EventViewer_Level_Warning}" />
							<CheckBox x:Name="VerboseCheck" Content="{x:Bind LocalizedStrings.EventViewer_Level_Verbose}" />
						</StackPanel>
					</StackPanel>
					<StackPanel
						Margin="104,-4,0,0"
						Orientation="Horizontal"
						Spacing="16">
						<CheckBox x:Name="ErrorCheck" Content="{x:Bind LocalizedStrings.EventViewer_Level_Error}" />
						<CheckBox x:Name="InfoCheck" Content="{x:Bind LocalizedStrings.EventViewer_Level_Information}" />
					</StackPanel>

					<StackPanel Orientation="Horizontal" Spacing="8">
						<RadioButton
							x:Name="ByLogRadio"
							GroupName="EventScope"
							Checked="EventScopeRadio_Checked"
							Content="{x:Bind LocalizedStrings.TaskSchd_Filter_ByLog}"
							Width="96" />
						<TextBlock Style="{StaticResource InlineLabelStyle}" Text="{x:Bind LocalizedStrings.TaskSchd_Filter_EventLogs}" />
						<DropDownButton x:Name="EventLogsDropDown" Style="{StaticResource PickerDropDownStyle}">
							<TextBlock
								x:Name="EventLogsSummary"
								Text="{x:Bind LocalizedStrings.TaskSchd_Filter_SelectEventLogs}"
								TextTrimming="CharacterEllipsis" />
							<DropDownButton.Flyout>
								<Flyout Closed="EventLogsFlyout_Closed" Placement="Bottom">
									<TreeView
										x:Name="EventLogsTree"
										Width="360"
										Height="320"
										Collapsed="EventLogsTree_Collapsed"
										Expanding="EventLogsTree_Expanding"
										SelectionChanged="EventLogsTree_SelectionChanged"
										SelectionMode="Multiple" />
								</Flyout>
							</DropDownButton.Flyout>
						</DropDownButton>
					</StackPanel>

					<StackPanel Orientation="Horizontal" Spacing="8">
						<RadioButton
							x:Name="BySourceRadio"
							GroupName="EventScope"
							Checked="EventScopeRadio_Checked"
							Content="{x:Bind LocalizedStrings.TaskSchd_Filter_BySource}"
							Width="96" />
						<TextBlock Style="{StaticResource InlineLabelStyle}" Text="{x:Bind LocalizedStrings.TaskSchd_Filter_EventSources}" />
						<DropDownButton x:Name="EventSourcesDropDown" Style="{StaticResource PickerDropDownStyle}">
							<TextBlock
								x:Name="EventSourcesSummary"
								Text=""
								TextTrimming="CharacterEllipsis" />
							<DropDownButton.Flyout>
								<Flyout Closed="EventSourcesFlyout_Closed" Placement="Bottom">
									<ListView
										x:Name="EventSourcesList"
										Width="320"
										Height="320"
										ItemTemplate="{StaticResource CheckableItemTemplate}"
										SelectionMode="None" />
								</Flyout>
							</DropDownButton.Flyout>
						</DropDownButton>
					</StackPanel>

					<TextBlock Style="{StaticResource SecondaryTextStyle}" Text="{x:Bind LocalizedStrings.TaskSchd_Filter_EventIdsHint}" />
					<TextBox
						x:Name="EventIdsBox"
						IsEnabled="False"
						PlaceholderText="{x:Bind LocalizedStrings.TaskSchd_Filter_AllEventIds}" />

					<StackPanel Orientation="Horizontal" Spacing="8">
						<TextBlock Style="{StaticResource InlineLabelStyle}" Text="{x:Bind LocalizedStrings.TaskSchd_Filter_TaskCategory}" />
						<ComboBox
							x:Name="TaskCategoryCombo"
							Width="316"
							IsEditable="True"
							IsEnabled="False" />
					</StackPanel>

					<StackPanel Orientation="Horizontal" Spacing="8">
						<TextBlock Style="{StaticResource InlineLabelStyle}" Text="{x:Bind LocalizedStrings.TaskSchd_Filter_Keywords}" />
						<DropDownButton
							x:Name="KeywordsDropDown"
							IsEnabled="False"
							Style="{StaticResource PickerDropDownStyle}">
							<TextBlock
								x:Name="KeywordsSummary"
								Text=""
								TextTrimming="CharacterEllipsis" />
							<DropDownButton.Flyout>
								<Flyout Closed="KeywordsFlyout_Closed" Placement="Bottom">
									<ListView
										x:Name="KeywordsList"
										Width="320"
										Height="296"
										ItemTemplate="{StaticResource CheckableItemTemplate}"
										SelectionMode="None" />
								</Flyout>
							</DropDownButton.Flyout>
						</DropDownButton>
					</StackPanel>

					<StackPanel Orientation="Horizontal" Spacing="8">
						<TextBlock Style="{StaticResource InlineLabelStyle}" Text="{x:Bind LocalizedStrings.TaskSchd_Filter_User}" />
						<TextBox
							x:Name="FilterUserBox"
							Width="316"
							IsEnabled="False"
							PlaceholderText="{x:Bind LocalizedStrings.TaskSchd_Filter_AllUsers}" />
					</StackPanel>
					<StackPanel Orientation="Horizontal" Spacing="8">
						<TextBlock Style="{StaticResource InlineLabelStyle}" Text="{x:Bind LocalizedStrings.TaskSchd_Filter_Computers}" />
						<TextBox
							x:Name="FilterComputerBox"
							Width="316"
							IsEnabled="False"
							PlaceholderText="{x:Bind LocalizedStrings.TaskSchd_Filter_AllComputers}" />
					</StackPanel>

					<Button
						x:Name="ClearFilterButton"
						HorizontalAlignment="Right"
						Click="ClearFilter_Click"
						Content="{x:Bind LocalizedStrings.Common_ClearButton}" />
				</StackPanel>

				<!--  ================================= XML tab =================================  -->
				<StackPanel
					x:Name="XmlTabPanel"
					Spacing="12"
					Visibility="Collapsed">
					<TextBlock Style="{StaticResource SecondaryTextStyle}" Text="{x:Bind LocalizedStrings.TaskSchd_Filter_XmlHint}" />
					<!--  Read-only until "Edit query manually" is checked; then it holds a hand-written XPath query.  -->
					<TextBox
						x:Name="XmlQueryBox"
						Height="320"
						AcceptsReturn="True"
						FontFamily="Consolas"
						IsReadOnly="True"
						IsSpellCheckEnabled="False"
						TextChanged="XmlQueryBox_TextChanged"
						TextWrapping="Wrap" />
					<CheckBox
						x:Name="EditQueryManuallyCheckBox"
						Checked="OnEditQueryManuallyChanged"
						Content="{x:Bind LocalizedStrings.TaskSchd_Filter_EditQueryManually}"
						Unchecked="OnEditQueryManuallyChanged" />
				</StackPanel>
			</Grid>
		</ScrollViewer>
	</Grid>
</UserControl>
