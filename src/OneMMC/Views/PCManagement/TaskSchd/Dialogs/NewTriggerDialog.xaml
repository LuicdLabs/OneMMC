<?xml version="1.0" encoding="utf-8" ?>
<!--
    NewTriggerDialog — UI prototype for the "New Trigger" / "Edit Trigger" editor of a modern
    taskschd.msc replacement. Opened from TaskPropertiesPage's Triggers > "New" command (create
    mode, Title = "Create a New Trigger") and from each trigger row's Edit button (edit mode,
    Title = "Edit Trigger"). The mode is chosen by the constructor parameter, not in XAML.

    Mirrors the legacy Win32 "New Trigger" dialog (Begin the task -> per-type Settings + a shared
    Advanced settings block) using native WinUI controls. The code-behind builds the matching
    TriggerModel (one of the 11 trigger types) on OK and returns it via ResultTrigger.

    Layout fidelity notes (verified against doc/NewTriggerDialog/*.png):
      * "Begin the task" picks the trigger type; the matching Settings panel is revealed and the
        rest stay collapsed (BeginTaskComboBox_SelectionChanged in the code-behind).
      * Advanced settings is shared by every trigger. Which rows apply depends on the type:
          - On a schedule  -> "Delay task for up to (random delay)" (RandomDelay) + Expire, and
            NO Activate row (its StartBoundary is the Settings > Start field).
          - Every other type -> fixed "Delay task for" (Delay) + Activate (StartBoundary) + Expire.
          - On idle -> the "Delay task for" row is greyed (IIdleTrigger exposes no delay).
      * "On an event > Custom > New Event Filter..." opens NewEventFilterContent in a separate
        ModalDialogWindow. A ContentDialog cannot open a second ContentDialog on the same window
        (it throws), and ModalDialogWindow is a real top-level Window, so it can stack over this
        open dialog the way the legacy modal "New Event Filter" dialog does.

    TODO(TaskScheduler): replace this prototype with a real editor:
      * Build the matching ITrigger (ITimeTrigger / IDailyTrigger / IWeeklyTrigger / IMonthlyTrigger
        / IMonthlyDOWTrigger / ILogonTrigger / IBootTrigger / IIdleTrigger / IEventTrigger /
        IRegistrationTrigger / ISessionStateChangeTrigger) via the Task Scheduler 2.0 COM API and
        add it to the task's ITriggerCollection. Map the Advanced rows to the shared ITrigger
        members: Delay/RandomDelay, Repetition.Interval/Duration/StopAtDurationEnd,
        ExecutionTimeLimit (Stop-if-longer), StartBoundary (Activate/Start), EndBoundary (Expire),
        Enabled. Combo display strings map to ISO-8601 durations (e.g. "1 hour" -> PT1H).
      * Move every user-facing string below to ResourceKeys / .resw (en-US, zh-TW) and bind via
        x:Uid / LocalizedStrings, as required by the project conventions.
      * Enforce the validation rules documented in the code-behind (duration > interval, Expire
        after Activate, "Specific user" requires a resolved account, etc.).
-->
<ContentDialog
	x:Class="OneMMC.Views.PCManagement.NewTriggerDialog"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	Title="Create a New Trigger"
	CloseButtonText="Cancel"
	DefaultButton="Primary"
	PrimaryButtonText="OK"
	Style="{StaticResource DefaultContentDialogStyle}"
	mc:Ignorable="d">

	<ContentDialog.Resources>
		<!--  Bold section header ("Settings", "Advanced settings").  -->
		<Style
			x:Key="SectionHeaderStyle"
			BasedOn="{StaticResource BodyStrongTextBlockStyle}"
			TargetType="TextBlock">
			<Setter Property="Margin" Value="0,6,0,0" />
		</Style>
		<!--  Fixed-width inline label so beside-field labels (Start:, Recur every:, …) align.  -->
		<Style x:Key="InlineLabelStyle" TargetType="TextBlock">
			<Setter Property="VerticalAlignment" Value="Center" />
			<Setter Property="Width" Value="92" />
		</Style>
		<!--  Secondary (hint) text for the "no settings" / idle / helper messages.  -->
		<Style x:Key="SecondaryTextStyle" TargetType="TextBlock">
			<Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
			<Setter Property="TextWrapping" Value="Wrap" />
		</Style>
	</ContentDialog.Resources>

	<Grid MinWidth="540" MaxWidth="600">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
		</Grid.RowDefinitions>

		<!--  Trigger type selector. Kept outside the scroll region so it is always reachable.  -->
		<StackPanel
			Grid.Row="0"
			Orientation="Horizontal"
			Spacing="8">
			<TextBlock
				VerticalAlignment="Center"
				Width="100"
				Text="Begin the task:" />
			<ComboBox
				x:Name="BeginTaskComboBox"
				Width="340"
				SelectionChanged="BeginTaskComboBox_SelectionChanged">
				<!--  Index order must stay in sync with the switch in BeginTaskComboBox_SelectionChanged.  -->
				<ComboBoxItem Content="On a schedule" />
				<ComboBoxItem Content="At log on" />
				<ComboBoxItem Content="At startup" />
				<ComboBoxItem Content="On idle" />
				<ComboBoxItem Content="On an event" />
				<ComboBoxItem Content="At task creation/modification" />
				<ComboBoxItem Content="On connection to user session" />
				<ComboBoxItem Content="On disconnect from user session" />
				<ComboBoxItem Content="On workstation lock" />
				<ComboBoxItem Content="On workstation unlock" />
			</ComboBox>
		</StackPanel>

		<ScrollViewer
			Grid.Row="1"
			MaxHeight="480"
			Margin="0,12,0,0"
			VerticalScrollBarVisibility="Auto">
			<StackPanel Spacing="12">

				<!--  ============================ Settings ============================  -->
				<TextBlock Style="{StaticResource SectionHeaderStyle}" Text="Settings" />

				<!--  On a schedule: One time / Daily / Weekly / Monthly + Start + recurrence detail.  -->
				<StackPanel
					x:Name="SchedulePanel"
					Spacing="12"
					Visibility="Collapsed">
					<RadioButtons
						x:Name="ScheduleKindRadios"
						MaxColumns="4"
						SelectionChanged="ScheduleKind_SelectionChanged">
						<x:String>One time</x:String>
						<x:String>Daily</x:String>
						<x:String>Weekly</x:String>
						<x:String>Monthly</x:String>
					</RadioButtons>

					<!--  Start = the trigger StartBoundary; shared by all four schedule kinds.  -->
					<StackPanel Orientation="Horizontal" Spacing="8">
						<TextBlock Style="{StaticResource InlineLabelStyle}" Text="Start:" />
						<CalendarDatePicker x:Name="ScheduleStartDate" PlaceholderText="Pick a date" />
						<TimePicker x:Name="ScheduleStartTime" ClockIdentifier="24HourClock" />
					</StackPanel>
					<CheckBox x:Name="ScheduleStartSync" Content="Synchronize across time zones" />

					<!--  Daily detail: recur every N days.  -->
					<StackPanel
						x:Name="ScheduleDailyDetail"
						Orientation="Horizontal"
						Spacing="8"
						Visibility="Collapsed">
						<TextBlock Style="{StaticResource InlineLabelStyle}" Text="Recur every:" />
						<NumberBox
							x:Name="DailyRecurBox"
							Width="120"
							Minimum="1"
							SpinButtonPlacementMode="Compact"
							Value="1" />
						<TextBlock VerticalAlignment="Center" Text="days" />
					</StackPanel>

					<!--  Weekly detail: recur every N weeks + day-of-week checkboxes.  -->
					<StackPanel
						x:Name="ScheduleWeeklyDetail"
						Spacing="10"
						Visibility="Collapsed">
						<StackPanel Orientation="Horizontal" Spacing="8">
							<TextBlock Style="{StaticResource InlineLabelStyle}" Text="Recur every:" />
							<NumberBox
								x:Name="WeeklyRecurBox"
								Width="120"
								Minimum="1"
								SpinButtonPlacementMode="Compact"
								Value="1" />
							<TextBlock VerticalAlignment="Center" Text="weeks on:" />
						</StackPanel>
						<!--  Days of the week, 4 per row (TODO(TaskScheduler): bind to IWeeklyTrigger.DaysOfWeek bitmask).  -->
						<Grid ColumnSpacing="16" RowSpacing="8">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*" />
								<ColumnDefinition Width="*" />
								<ColumnDefinition Width="*" />
								<ColumnDefinition Width="*" />
							</Grid.ColumnDefinitions>
							<Grid.RowDefinitions>
								<RowDefinition Height="Auto" />
								<RowDefinition Height="Auto" />
							</Grid.RowDefinitions>
							<CheckBox
								x:Name="SundayCheck"
								Grid.Row="0"
								Grid.Column="0"
								Content="Sunday" />
							<CheckBox
								x:Name="MondayCheck"
								Grid.Row="0"
								Grid.Column="1"
								Content="Monday" />
							<CheckBox
								x:Name="TuesdayCheck"
								Grid.Row="0"
								Grid.Column="2"
								Content="Tuesday" />
							<CheckBox
								x:Name="WednesdayCheck"
								Grid.Row="0"
								Grid.Column="3"
								Content="Wednesday" />
							<CheckBox
								x:Name="ThursdayCheck"
								Grid.Row="1"
								Grid.Column="0"
								Content="Thursday" />
							<CheckBox
								x:Name="FridayCheck"
								Grid.Row="1"
								Grid.Column="1"
								Content="Friday" />
							<CheckBox
								x:Name="SaturdayCheck"
								Grid.Row="1"
								Grid.Column="2"
								Content="Saturday" />
						</Grid>
					</StackPanel>

					<!--  Monthly detail: months + (Days | On) schedule.  -->
					<StackPanel
						x:Name="ScheduleMonthlyDetail"
						Spacing="10"
						Visibility="Collapsed">
						<!--
							Months / Days are multi-select. WinUI has no multi-select ComboBox, so the idiomatic
							pattern (already used by CreateTaskDialog) is a DropDownButton whose Flyout hosts a
							ListView/GridView in Multiple selection mode (which renders selection checkmarks).
							TODO(TaskScheduler): reflect the chosen items back into the button's Content.
						-->
						<StackPanel Orientation="Horizontal" Spacing="8">
							<TextBlock Style="{StaticResource InlineLabelStyle}" Text="Months:" />
							<DropDownButton Content="Select months">
								<DropDownButton.Flyout>
									<Flyout>
										<ListView
											x:Name="MonthsListView"
											Width="220"
											MaxHeight="260"
											ItemsSource="{x:Bind Months}"
											SelectionMode="Multiple" />
									</Flyout>
								</DropDownButton.Flyout>
							</DropDownButton>
						</StackPanel>

						<!--  Choose between specific days of the month (IMonthlyTrigger) or an ordinal weekday (IMonthlyDOWTrigger).  -->
						<RadioButtons
							x:Name="MonthlyScheduleMode"
							MaxColumns="2"
							SelectionChanged="MonthlyScheduleMode_SelectionChanged">
							<x:String>Days</x:String>
							<x:String>On</x:String>
						</RadioButtons>

						<StackPanel Orientation="Horizontal" Spacing="8">
							<TextBlock Style="{StaticResource InlineLabelStyle}" Text="Days:" />
							<DropDownButton x:Name="MonthlyDaysDropDown" Content="Select days">
								<DropDownButton.Flyout>
									<Flyout>
										<GridView
											x:Name="MonthDaysGridView"
											Width="300"
											MaxHeight="240"
											ItemsSource="{x:Bind MonthDays}"
											SelectionMode="Multiple" />
									</Flyout>
								</DropDownButton.Flyout>
							</DropDownButton>
						</StackPanel>

						<StackPanel Orientation="Horizontal" Spacing="8">
							<TextBlock Style="{StaticResource InlineLabelStyle}" Text="On:" />
							<!--
								Simplified to single-select ComboBoxes for the prototype; the real dialog lets you
								pick multiple occurrences and weekdays. TODO(TaskScheduler): make these multi-select
								(IMonthlyDOWTrigger.WeeksOfMonth + DaysOfWeek bitmasks).
							-->
							<ComboBox
								x:Name="MonthlyOccurrenceCombo"
								Width="140"
								PlaceholderText="Occurrence">
								<ComboBoxItem Content="First" />
								<ComboBoxItem Content="Second" />
								<ComboBoxItem Content="Third" />
								<ComboBoxItem Content="Fourth" />
								<ComboBoxItem Content="Last" />
							</ComboBox>
							<ComboBox
								x:Name="MonthlyWeekdayCombo"
								Width="150"
								PlaceholderText="Day of week">
								<ComboBoxItem Content="Sunday" />
								<ComboBoxItem Content="Monday" />
								<ComboBoxItem Content="Tuesday" />
								<ComboBoxItem Content="Wednesday" />
								<ComboBoxItem Content="Thursday" />
								<ComboBoxItem Content="Friday" />
								<ComboBoxItem Content="Saturday" />
							</ComboBox>
						</StackPanel>
					</StackPanel>
				</StackPanel>

				<!--
					Shared user panel for "At log on", "On workstation lock", "On workstation unlock".
					All three expose the same Any-user / Specific-user choice (ILogonTrigger.UserId /
					ISessionStateChangeTrigger.UserId). Only one trigger is shown at a time, so a single
					reusable panel is sufficient for the prototype.
				-->
				<StackPanel
					x:Name="UserPanel"
					Spacing="10"
					Visibility="Collapsed">
					<RadioButtons x:Name="UserModeRadios" SelectionChanged="UserMode_SelectionChanged">
						<x:String>Any user</x:String>
						<x:String>Specific user:</x:String>
					</RadioButtons>
					<StackPanel Orientation="Horizontal" Spacing="12">
						<TextBlock
							x:Name="UserAccountText"
							VerticalAlignment="Center"
							Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
						<!--  Change User... is enabled only while "Specific user" is selected (managed in code-behind).  -->
						<Button
							x:Name="ChangeUserButton"
							Click="ChangeUser_Click"
							Content="Change User..." />
					</StackPanel>
				</StackPanel>

				<!--  Shared "no additional settings" panel for "At startup" and "At task creation/modification".  -->
				<StackPanel x:Name="NoSettingsPanel" Visibility="Collapsed">
					<TextBlock Style="{StaticResource SecondaryTextStyle}" Text="No additional settings required." />
				</StackPanel>

				<!--  On idle: the idle conditions live on the Conditions page, not here.  -->
				<StackPanel x:Name="IdlePanel" Visibility="Collapsed">
					<TextBlock Style="{StaticResource SecondaryTextStyle}" Text="To change idle conditions, use the Conditions page in the Create Task or task Properties sheet." />
				</StackPanel>

				<!--  On an event: Basic (Log/Source/Event ID) or Custom (opens the New Event Filter modal).  -->
				<StackPanel
					x:Name="EventPanel"
					Spacing="10"
					Visibility="Collapsed">
					<RadioButtons
						x:Name="EventModeRadios"
						MaxColumns="2"
						SelectionChanged="EventMode_SelectionChanged">
						<x:String>Basic</x:String>
						<x:String>Custom</x:String>
					</RadioButtons>

					<StackPanel x:Name="BasicEventSubPanel" Spacing="10">
						<StackPanel Orientation="Horizontal" Spacing="8">
							<TextBlock Style="{StaticResource InlineLabelStyle}" Text="Log:" />
							<!--  Items populated in code-behind from the real event-log channels (EventLogSession.GetLogNames).  -->
							<ComboBox
								x:Name="EventLogCombo"
								Width="320"
								IsEditable="True"
								PlaceholderText="Select a log"
								SelectionChanged="EventLogCombo_SelectionChanged" />
						</StackPanel>
						<StackPanel Orientation="Horizontal" Spacing="8">
							<TextBlock Style="{StaticResource InlineLabelStyle}" Text="Source:" />
							<!--  Items populated in code-behind: the providers for the selected log (or all providers).  -->
							<ComboBox
								x:Name="EventSourceCombo"
								Width="320"
								IsEditable="True"
								PlaceholderText="Select a source" />
						</StackPanel>
						<StackPanel Orientation="Horizontal" Spacing="8">
							<TextBlock Style="{StaticResource InlineLabelStyle}" Text="Event ID:" />
							<TextBox
								x:Name="EventIdBox"
								Width="160"
								PlaceholderText="e.g. 127" />
						</StackPanel>
					</StackPanel>

					<StackPanel x:Name="CustomEventSubPanel" Visibility="Collapsed">
						<!--  Opens NewEventFilterContent in a ModalDialogWindow (see NewEventFilter_Click).
						      Content is set in code (New/Edit Event Filter…) via UpdateEventFilterButtonLabel.  -->
						<Button
							x:Name="NewEventFilterButton"
							Click="NewEventFilter_Click" />
					</StackPanel>
				</StackPanel>

				<!--
					Shared panel for "On connection to user session" and "On disconnect from user session":
					Any/Specific user + Connection from remote/local computer. The remote/local radio selects
					the ISessionStateChangeTrigger.StateChange value (CONSOLE = local, REMOTE = remote).
				-->
				<StackPanel
					x:Name="SessionConnPanel"
					Spacing="10"
					Visibility="Collapsed">
					<RadioButtons x:Name="SessionUserModeRadios" SelectionChanged="SessionUserMode_SelectionChanged">
						<x:String>Any user</x:String>
						<x:String>Specific user:</x:String>
					</RadioButtons>
					<StackPanel Orientation="Horizontal" Spacing="12">
						<TextBlock
							x:Name="SessionAccountText"
							VerticalAlignment="Center"
							Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
						<Button
							x:Name="SessionChangeUserButton"
							Click="ChangeUser_Click"
							Content="Change User..." />
					</StackPanel>
					<RadioButtons x:Name="ConnectionSourceRadios">
						<x:String>Connection from remote computer</x:String>
						<x:String>Connection from local computer</x:String>
					</RadioButtons>
				</StackPanel>

				<!--  ====================  ADVANCED SETTINGS  ====================  -->
				<TextBlock Style="{StaticResource SectionHeaderStyle}" Text="Advanced settings" />

				<!--
					Delay row. The label and default change with the trigger type and the whole row is
					greyed for "On idle" (see BeginTaskComboBox_SelectionChanged):
					  * On a schedule -> "Delay task for up to (random delay):" default 1 hour (RandomDelay)
					  * Every other type -> "Delay task for:" default 15 minutes (Delay)
					  * On idle -> disabled (IIdleTrigger has neither Delay nor RandomDelay)
					The combo is editable so a custom ISO-8601 duration can be typed.
				-->
				<StackPanel Orientation="Horizontal" Spacing="8">
					<CheckBox
						x:Name="DelayCheckBox"
						MinWidth="250"
						Checked="OnDelayChanged"
						Content="Delay task for:"
						Unchecked="OnDelayChanged" />
					<ComboBox
						x:Name="DelayCombo"
						MinWidth="170"
						IsEditable="True">
						<ComboBoxItem Content="15 minutes" />
						<ComboBoxItem Content="30 minutes" />
						<ComboBoxItem Content="1 hour" />
						<ComboBoxItem Content="12 hours" />
						<ComboBoxItem Content="1 day" />
					</ComboBox>
				</StackPanel>

				<!--  Repeat task every: interval + duration + "stop all" (interval/duration/stop-all enabled only when checked).  -->
				<StackPanel Spacing="8">
					<StackPanel Orientation="Horizontal" Spacing="8">
						<CheckBox
							x:Name="RepeatCheckBox"
							Checked="OnRepeatChanged"
							Content="Repeat task every:"
							Unchecked="OnRepeatChanged" />
						<ComboBox
							x:Name="RepeatEveryCombo"
							MinWidth="150"
							IsEditable="True"
							Text="1 hour">
							<ComboBoxItem Content="5 minutes" />
							<ComboBoxItem Content="10 minutes" />
							<ComboBoxItem Content="15 minutes" />
							<ComboBoxItem Content="30 minutes" />
							<ComboBoxItem Content="1 hour" />
						</ComboBox>
					</StackPanel>
					<StackPanel
						Margin="28,0,0,0"
						Orientation="Horizontal"
						Spacing="8">
						<TextBlock VerticalAlignment="Center" Text="for a duration of:" />
						<ComboBox
							x:Name="DurationCombo"
							MinWidth="150"
							IsEditable="True"
							Text="1 day">
							<ComboBoxItem Content="15 minutes" />
							<ComboBoxItem Content="30 minutes" />
							<ComboBoxItem Content="1 hour" />
							<ComboBoxItem Content="12 hours" />
							<ComboBoxItem Content="1 day" />
							<!--  Indefinitely maps to an empty Repetition.Duration.  -->
							<ComboBoxItem Content="Indefinitely" />
						</ComboBox>
					</StackPanel>
					<CheckBox
						x:Name="StopAllCheckBox"
						Margin="28,0,0,0"
						Content="Stop all running tasks at end of repetition duration" />
				</StackPanel>

				<!--  Stop the trigger's task if it runs longer than (trigger-level ExecutionTimeLimit).  -->
				<StackPanel Orientation="Horizontal" Spacing="8">
					<CheckBox
						x:Name="StopIfLongerCheckBox"
						MinWidth="250"
						Checked="OnStopIfLongerChanged"
						Content="Stop task if it runs longer than:"
						Unchecked="OnStopIfLongerChanged" />
					<ComboBox
						x:Name="StopIfLongerCombo"
						MinWidth="170"
						IsEditable="True"
						Text="3 days">
						<ComboBoxItem Content="30 minutes" />
						<ComboBoxItem Content="1 hour" />
						<ComboBoxItem Content="2 hours" />
						<ComboBoxItem Content="4 hours" />
						<ComboBoxItem Content="8 hours" />
						<ComboBoxItem Content="12 hours" />
						<ComboBoxItem Content="1 day" />
						<ComboBoxItem Content="3 days" />
					</ComboBox>
				</StackPanel>

				<!--  Activate = StartBoundary. Collapsed for "On a schedule" (Start is in Settings).  -->
				<StackPanel x:Name="ActivatePanel" Spacing="8">
					<StackPanel Orientation="Horizontal" Spacing="8">
						<CheckBox
							x:Name="ActivateCheckBox"
							MinWidth="92"
							Checked="OnActivateChanged"
							Content="Activate:"
							Unchecked="OnActivateChanged" />
						<CalendarDatePicker x:Name="ActivateDate" PlaceholderText="Pick a date" />
						<TimePicker x:Name="ActivateTime" ClockIdentifier="24HourClock" />
					</StackPanel>
					<CheckBox
						x:Name="ActivateSyncCheckBox"
						Margin="28,0,0,0"
						Content="Synchronize across time zones" />
				</StackPanel>

				<!--  Expire = EndBoundary.  -->
				<StackPanel Spacing="8">
					<StackPanel Orientation="Horizontal" Spacing="8">
						<CheckBox
							x:Name="ExpireCheckBox"
							MinWidth="92"
							Checked="OnExpireChanged"
							Content="Expire:"
							Unchecked="OnExpireChanged" />
						<CalendarDatePicker x:Name="ExpireDate" PlaceholderText="Pick a date" />
						<TimePicker x:Name="ExpireTime" ClockIdentifier="24HourClock" />
					</StackPanel>
					<CheckBox
						x:Name="ExpireSyncCheckBox"
						Margin="28,0,0,0"
						Content="Synchronize across time zones" />
				</StackPanel>

				<!--  Trigger Enabled. Defaults to checked (every other Advanced checkbox defaults unchecked).  -->
				<CheckBox
					x:Name="EnabledCheckBox"
					Content="Enabled"
					IsChecked="True" />
			</StackPanel>
		</ScrollViewer>
	</Grid>
</ContentDialog>
