<?xml version="1.0" encoding="utf-8" ?>
<!--
    CreateTaskDialog — UI prototype for the "Create a Task" flow of a modern taskschd.msc
    replacement. Opened from TaskSchedulerPage's "Create Task" command.

    Streamlined create flow: collects a name/description, one trigger and one action, and builds a
    CreateTaskResult that TaskSchedulerPage registers via ITaskSchedulerService. The full per-tab
    editor (all triggers/actions/conditions/settings) lives on the task Properties page.

    Note: the schedule date/time pickers are visual here; schedule triggers default their
    StartBoundary to "now" and are refined on the Properties page. The Months/Days multi-selects
    are likewise refined there.
-->
<ContentDialog
	x:Class="OneMMC.Views.PCManagement.CreateTaskDialog"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	DefaultButton="Primary"
	Style="{StaticResource DefaultContentDialogStyle}"
	mc:Ignorable="d">

	<ContentDialog.Resources>
		<!--  Bold section header ("Task Information", "Trigger", "Action").  -->
		<Style
			x:Key="SectionHeaderStyle"
			BasedOn="{StaticResource BodyStrongTextBlockStyle}"
			TargetType="TextBlock">
			<Setter Property="Margin" Value="0,6,0,0" />
		</Style>
		<!--  Fixed-width inline label so beside-field labels (Start:, Recur every:, …) align.  -->
		<Style x:Key="InlineLabelStyle" TargetType="TextBlock">
			<Setter Property="VerticalAlignment" Value="Center" />
			<Setter Property="Width" Value="92" />
		</Style>
	</ContentDialog.Resources>

	<Grid MinWidth="480" MaxWidth="560">
		<ScrollViewer MaxHeight="540" VerticalScrollBarVisibility="Auto">
			<StackPanel Padding="2" Spacing="14">

				<!--  Validation feedback (e.g. missing task name). Shown by the Closing handler.  -->
				<InfoBar
					x:Name="ValidationInfoBar"
					IsClosable="True"
					IsOpen="False"
					Severity="Error" />

				<!--  ============================ Task Information ============================  -->
				<TextBlock Style="{StaticResource SectionHeaderStyle}" Text="{x:Bind LocalizedStrings.TaskSchd_Create_TaskInformation}" />

				<StackPanel Spacing="4">
					<TextBlock Text="{x:Bind LocalizedStrings.TaskSchd_General_Name}" />
					<TextBox x:Name="NameBox" PlaceholderText="{x:Bind LocalizedStrings.TaskSchd_Create_NamePlaceholder}" />
				</StackPanel>

				<StackPanel Spacing="4">
					<TextBlock Text="{x:Bind LocalizedStrings.TaskSchd_General_Description}" />
					<TextBox
						x:Name="DescriptionBox"
						AcceptsReturn="True"
						MaxHeight="80"
						TextWrapping="Wrap" />
				</StackPanel>

				<!--  ================================ Trigger ================================  -->
				<TextBlock Style="{StaticResource SectionHeaderStyle}" Text="{x:Bind LocalizedStrings.TaskSchd_Create_Trigger}" />
				<TextBlock Text="{x:Bind LocalizedStrings.TaskSchd_Create_TriggerPrompt}" />

				<!--
					Trigger kind. The selected index drives which settings panel below is visible
					(see TriggerComboBox_SelectionChanged in the code-behind). Keep this item order
					in sync with that switch.
				-->
				<ComboBox
					x:Name="TriggerComboBox"
					HorizontalAlignment="Stretch"
					SelectionChanged="TriggerComboBox_SelectionChanged">
					<ComboBoxItem Content="{x:Bind LocalizedStrings.TaskSchd_Schedule_Daily}" />
					<ComboBoxItem Content="{x:Bind LocalizedStrings.TaskSchd_Schedule_Weekly}" />
					<ComboBoxItem Content="{x:Bind LocalizedStrings.TaskSchd_Schedule_Monthly}" />
					<ComboBoxItem Content="{x:Bind LocalizedStrings.TaskSchd_Schedule_OneTime}" />
					<ComboBoxItem Content="{x:Bind LocalizedStrings.TaskSchd_Create_WhenComputerStarts}" />
					<ComboBoxItem Content="{x:Bind LocalizedStrings.TaskSchd_Create_WhenILogOn}" />
					<ComboBoxItem Content="{x:Bind LocalizedStrings.TaskSchd_Create_WhenEventLogged}" />
				</ComboBox>

				<!--  Daily: start date/time + recur-every-N-days.  -->
				<StackPanel
					x:Name="DailyPanel"
					Spacing="10"
					Visibility="Collapsed">
					<!--
						Start date/time + time-zone synchronization. This same block is repeated by the
						Weekly / Monthly / One time panels because all four are time-based triggers; a real
						implementation would share a single ITrigger.StartBoundary editor here.
					-->
					<StackPanel Orientation="Horizontal" Spacing="8">
						<TextBlock Style="{StaticResource InlineLabelStyle}" Text="{x:Bind LocalizedStrings.TaskSchd_Trigger_StartLabel}" />
						<CalendarDatePicker PlaceholderText="{x:Bind LocalizedStrings.TaskSchd_PickDatePlaceholder}" />
						<TimePicker />
					</StackPanel>
					<CheckBox Content="{x:Bind LocalizedStrings.TaskSchd_Trigger_SyncTimeZones}" />
					<StackPanel Orientation="Horizontal" Spacing="8">
						<TextBlock Style="{StaticResource InlineLabelStyle}" Text="{x:Bind LocalizedStrings.TaskSchd_Trigger_RecurEvery}" />
						<NumberBox
							Width="120"
							Minimum="1"
							SpinButtonPlacementMode="Compact"
							Value="1" />
						<TextBlock VerticalAlignment="Center" Text="{x:Bind LocalizedStrings.TaskSchd_Trigger_DaysSuffix}" />
					</StackPanel>
				</StackPanel>

				<!--  Weekly: start + recur-every-N-weeks + day-of-week checkboxes.  -->
				<StackPanel
					x:Name="WeeklyPanel"
					Spacing="10"
					Visibility="Collapsed">
					<StackPanel Orientation="Horizontal" Spacing="8">
						<TextBlock Style="{StaticResource InlineLabelStyle}" Text="{x:Bind LocalizedStrings.TaskSchd_Trigger_StartLabel}" />
						<CalendarDatePicker PlaceholderText="{x:Bind LocalizedStrings.TaskSchd_PickDatePlaceholder}" />
						<TimePicker />
					</StackPanel>
					<CheckBox Content="{x:Bind LocalizedStrings.TaskSchd_Trigger_SyncTimeZones}" />
					<StackPanel Orientation="Horizontal" Spacing="8">
						<TextBlock Style="{StaticResource InlineLabelStyle}" Text="{x:Bind LocalizedStrings.TaskSchd_Trigger_RecurEvery}" />
						<NumberBox
							Width="120"
							Minimum="1"
							SpinButtonPlacementMode="Compact"
							Value="1" />
						<TextBlock VerticalAlignment="Center" Text="{x:Bind LocalizedStrings.TaskSchd_Trigger_WeeksOnSuffix}" />
					</StackPanel>
					<!--  Days of the week, 4 per row.  -->
					<Grid ColumnSpacing="16" RowSpacing="8">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="*" />
						</Grid.ColumnDefinitions>
						<Grid.RowDefinitions>
							<RowDefinition Height="Auto" />
							<RowDefinition Height="Auto" />
						</Grid.RowDefinitions>
						<CheckBox
							Grid.Row="0"
							Grid.Column="0"
							Content="{x:Bind LocalizedStrings.TaskSchd_Day_Sunday}" />
						<CheckBox
							Grid.Row="0"
							Grid.Column="1"
							Content="{x:Bind LocalizedStrings.TaskSchd_Day_Monday}" />
						<CheckBox
							Grid.Row="0"
							Grid.Column="2"
							Content="{x:Bind LocalizedStrings.TaskSchd_Day_Tuesday}" />
						<CheckBox
							Grid.Row="0"
							Grid.Column="3"
							Content="{x:Bind LocalizedStrings.TaskSchd_Day_Wednesday}" />
						<CheckBox
							Grid.Row="1"
							Grid.Column="0"
							Content="{x:Bind LocalizedStrings.TaskSchd_Day_Thursday}" />
						<CheckBox
							Grid.Row="1"
							Grid.Column="1"
							Content="{x:Bind LocalizedStrings.TaskSchd_Day_Friday}" />
						<CheckBox
							Grid.Row="1"
							Grid.Column="2"
							Content="{x:Bind LocalizedStrings.TaskSchd_Day_Saturday}" />
					</Grid>
				</StackPanel>

				<!--  Monthly: start + month selection + (Days | On) schedule.  -->
				<StackPanel
					x:Name="MonthlyPanel"
					Spacing="10"
					Visibility="Collapsed">
					<StackPanel Orientation="Horizontal" Spacing="8">
						<TextBlock Style="{StaticResource InlineLabelStyle}" Text="{x:Bind LocalizedStrings.TaskSchd_Trigger_StartLabel}" />
						<CalendarDatePicker PlaceholderText="{x:Bind LocalizedStrings.TaskSchd_PickDatePlaceholder}" />
						<TimePicker />
					</StackPanel>
					<CheckBox Content="{x:Bind LocalizedStrings.TaskSchd_Trigger_SyncTimeZones}" />

					<!--
						Months / Days are multi-select. WinUI has no multi-select ComboBox, so the idiomatic
						pattern is a DropDownButton whose Flyout hosts a ListView/GridView in Multiple
						selection mode (which renders selection checkmarks). TODO(TaskScheduler): reflect the
						chosen items back into the button's Content.
					-->
					<StackPanel Orientation="Horizontal" Spacing="8">
						<TextBlock Style="{StaticResource InlineLabelStyle}" Text="{x:Bind LocalizedStrings.TaskSchd_Trigger_MonthsLabel}" />
						<DropDownButton Content="{x:Bind LocalizedStrings.TaskSchd_Trigger_SelectMonths}">
							<DropDownButton.Flyout>
								<Flyout>
									<ListView
										Width="220"
										MaxHeight="260"
										ItemsSource="{x:Bind Months}"
										SelectionMode="Multiple" />
								</Flyout>
							</DropDownButton.Flyout>
						</DropDownButton>
					</StackPanel>

					<!--  Choose between specific days of the month or an ordinal weekday ("On").  -->
					<RadioButtons
						x:Name="MonthlyScheduleMode"
						MaxColumns="2"
						SelectionChanged="MonthlyScheduleMode_SelectionChanged">
						<RadioButton Content="{x:Bind LocalizedStrings.TaskSchd_Trigger_MonthlyDays}" />
						<RadioButton Content="{x:Bind LocalizedStrings.TaskSchd_Trigger_MonthlyOn}" />
					</RadioButtons>

					<StackPanel Orientation="Horizontal" Spacing="8">
						<TextBlock Style="{StaticResource InlineLabelStyle}" Text="{x:Bind LocalizedStrings.TaskSchd_Trigger_DaysLabel}" />
						<DropDownButton x:Name="MonthlyDaysDropDown" Content="{x:Bind LocalizedStrings.TaskSchd_Trigger_SelectDays}">
							<DropDownButton.Flyout>
								<Flyout>
									<GridView
										Width="300"
										MaxHeight="240"
										ItemsSource="{x:Bind MonthDays}"
										SelectionMode="Multiple" />
								</Flyout>
							</DropDownButton.Flyout>
						</DropDownButton>
					</StackPanel>

					<StackPanel Orientation="Horizontal" Spacing="8">
						<TextBlock Style="{StaticResource InlineLabelStyle}" Text="{x:Bind LocalizedStrings.TaskSchd_Trigger_OnLabel}" />
						<!--
							Simplified to single-select ComboBoxes for the prototype; the real dialog lets you
							pick multiple occurrences and weekdays. TODO(TaskScheduler): make these multi-select.
						-->
						<ComboBox
							x:Name="MonthlyOccurrenceCombo"
							Width="140"
							PlaceholderText="{x:Bind LocalizedStrings.TaskSchd_Trigger_OccurrencePlaceholder}">
							<ComboBoxItem Content="{x:Bind LocalizedStrings.TaskSchd_Week_First}" />
							<ComboBoxItem Content="{x:Bind LocalizedStrings.TaskSchd_Week_Second}" />
							<ComboBoxItem Content="{x:Bind LocalizedStrings.TaskSchd_Week_Third}" />
							<ComboBoxItem Content="{x:Bind LocalizedStrings.TaskSchd_Week_Fourth}" />
							<ComboBoxItem Content="{x:Bind LocalizedStrings.TaskSchd_Week_Last}" />
						</ComboBox>
						<ComboBox
							x:Name="MonthlyWeekdayCombo"
							Width="150"
							PlaceholderText="{x:Bind LocalizedStrings.TaskSchd_Trigger_DayOfWeekPlaceholder}">
							<ComboBoxItem Content="{x:Bind LocalizedStrings.TaskSchd_Day_Sunday}" />
							<ComboBoxItem Content="{x:Bind LocalizedStrings.TaskSchd_Day_Monday}" />
							<ComboBoxItem Content="{x:Bind LocalizedStrings.TaskSchd_Day_Tuesday}" />
							<ComboBoxItem Content="{x:Bind LocalizedStrings.TaskSchd_Day_Wednesday}" />
							<ComboBoxItem Content="{x:Bind LocalizedStrings.TaskSchd_Day_Thursday}" />
							<ComboBoxItem Content="{x:Bind LocalizedStrings.TaskSchd_Day_Friday}" />
							<ComboBoxItem Content="{x:Bind LocalizedStrings.TaskSchd_Day_Saturday}" />
						</ComboBox>
					</StackPanel>
				</StackPanel>

				<!--  One time: start date/time only.  -->
				<StackPanel
					x:Name="OneTimePanel"
					Spacing="10"
					Visibility="Collapsed">
					<StackPanel Orientation="Horizontal" Spacing="8">
						<TextBlock Style="{StaticResource InlineLabelStyle}" Text="{x:Bind LocalizedStrings.TaskSchd_Trigger_StartLabel}" />
						<CalendarDatePicker PlaceholderText="{x:Bind LocalizedStrings.TaskSchd_PickDatePlaceholder}" />
						<TimePicker />
					</StackPanel>
					<CheckBox Content="{x:Bind LocalizedStrings.TaskSchd_Trigger_SyncTimeZones}" />
				</StackPanel>

				<!--  Shown for "When the computer starts" and "When I log on": no extra settings.  -->
				<StackPanel x:Name="TriggerNoSettingsPanel" Visibility="Collapsed">
					<TextBlock
						Foreground="{ThemeResource TextFillColorSecondaryBrush}"
						Text="{x:Bind LocalizedStrings.TaskSchd_Create_NoTriggerSettings}"
						TextWrapping="Wrap" />
				</StackPanel>

				<!--  When a specific event is logged: pick log, source and event id.  -->
				<StackPanel
					x:Name="EventPanel"
					Spacing="10"
					Visibility="Collapsed">
					<StackPanel Orientation="Horizontal" Spacing="8">
						<TextBlock Style="{StaticResource InlineLabelStyle}" Text="{x:Bind LocalizedStrings.TaskSchd_Event_LogLabel}" />
						<!--  Items populated in code-behind from the real event-log channels (EventLogSession.GetLogNames).  -->
						<ComboBox
							x:Name="EventLogCombo"
							Width="320"
							IsEditable="True"
							PlaceholderText="{x:Bind LocalizedStrings.TaskSchd_Event_SelectLog}"
							SelectionChanged="EventLogCombo_SelectionChanged" />
					</StackPanel>
					<StackPanel Orientation="Horizontal" Spacing="8">
						<TextBlock Style="{StaticResource InlineLabelStyle}" Text="{x:Bind LocalizedStrings.TaskSchd_Event_SourceLabel}" />
						<!--  Items populated in code-behind: the providers for the selected log (or all providers).  -->
						<ComboBox
							x:Name="EventSourceCombo"
							Width="320"
							IsEditable="True"
							PlaceholderText="{x:Bind LocalizedStrings.TaskSchd_Event_SelectSource}" />
					</StackPanel>
					<StackPanel Orientation="Horizontal" Spacing="8">
						<TextBlock Style="{StaticResource InlineLabelStyle}" Text="{x:Bind LocalizedStrings.TaskSchd_Event_EventIdLabel}" />
						<TextBox
							x:Name="EventIdBox"
							Width="160"
							PlaceholderText="{x:Bind LocalizedStrings.TaskSchd_Event_EventIdPlaceholder}" />
					</StackPanel>
				</StackPanel>

				<!--  ================================= Action ================================  -->
				<TextBlock Style="{StaticResource SectionHeaderStyle}" Text="{x:Bind LocalizedStrings.TaskSchd_Create_Action}" />
				<TextBlock Text="{x:Bind LocalizedStrings.TaskSchd_Create_ActionPrompt}" />

				<!--
					Action kind. The selected index drives which settings panel below is visible
					(see ActionComboBox_SelectionChanged in the code-behind). Keep this item order
					in sync with that switch.
				-->
				<ComboBox
					x:Name="ActionComboBox"
					HorizontalAlignment="Stretch"
					SelectionChanged="ActionComboBox_SelectionChanged">
					<ComboBoxItem Content="{x:Bind LocalizedStrings.TaskSchd_Action_StartProgram}" />
					<ComboBoxItem Content="{x:Bind LocalizedStrings.TaskSchd_Action_SendEmail}" />
					<ComboBoxItem Content="{x:Bind LocalizedStrings.TaskSchd_Action_DisplayMessage}" />
				</ComboBox>

				<!--  Start a program: program/script (+ Browse), arguments, start-in folder.  -->
				<StackPanel
					x:Name="StartProgramPanel"
					Spacing="10"
					Visibility="Collapsed">
					<StackPanel Spacing="4">
						<TextBlock Text="{x:Bind LocalizedStrings.TaskSchd_Action_ProgramScript}" />
						<Grid ColumnSpacing="8">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*" />
								<ColumnDefinition Width="Auto" />
							</Grid.ColumnDefinitions>
							<TextBox
								x:Name="ProgramScriptBox"
								Grid.Column="0"
								PlaceholderText="{x:Bind LocalizedStrings.TaskSchd_Action_ProgramPlaceholder}" />
							<Button
								Grid.Column="1"
								Click="BrowseProgram_Click"
								Content="{x:Bind LocalizedStrings.TaskSchd_Action_Browse}" />
						</Grid>
					</StackPanel>
					<StackPanel Spacing="4">
						<TextBlock Text="{x:Bind LocalizedStrings.TaskSchd_Action_AddArguments}" />
						<TextBox x:Name="ArgumentsBox" />
					</StackPanel>
					<StackPanel Spacing="4">
						<TextBlock Text="{x:Bind LocalizedStrings.TaskSchd_Action_StartIn}" />
						<TextBox x:Name="StartInBox" />
					</StackPanel>
				</StackPanel>

				<!--  Send an e-mail (deprecated): legacy SMTP fields kept for parity with taskschd.msc.  -->
				<StackPanel
					x:Name="SendEmailPanel"
					Spacing="10"
					Visibility="Collapsed">
					<StackPanel Spacing="4">
						<TextBlock Text="{x:Bind LocalizedStrings.TaskSchd_Action_EmailFrom}" />
						<TextBox x:Name="EmailFromBox" />
					</StackPanel>
					<StackPanel Spacing="4">
						<TextBlock Text="{x:Bind LocalizedStrings.TaskSchd_Action_EmailTo}" />
						<TextBox x:Name="EmailToBox" />
					</StackPanel>
					<StackPanel Spacing="4">
						<TextBlock Text="{x:Bind LocalizedStrings.TaskSchd_Action_EmailSubject}" />
						<TextBox x:Name="EmailSubjectBox" />
					</StackPanel>
					<StackPanel Spacing="4">
						<TextBlock Text="{x:Bind LocalizedStrings.TaskSchd_Action_EmailText}" />
						<TextBox
							x:Name="EmailTextBox"
							AcceptsReturn="True"
							MaxHeight="100"
							TextWrapping="Wrap" />
					</StackPanel>
					<StackPanel Spacing="4">
						<TextBlock Text="{x:Bind LocalizedStrings.TaskSchd_Action_EmailAttachment}" />
						<Grid ColumnSpacing="8">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*" />
								<ColumnDefinition Width="Auto" />
							</Grid.ColumnDefinitions>
							<TextBox x:Name="EmailAttachmentBox" Grid.Column="0" />
							<Button
								Grid.Column="1"
								Click="BrowseAttachment_Click"
								Content="{x:Bind LocalizedStrings.TaskSchd_Action_Browse}" />
						</Grid>
					</StackPanel>
					<StackPanel Spacing="4">
						<TextBlock Text="{x:Bind LocalizedStrings.TaskSchd_Action_EmailServer}" />
						<TextBox x:Name="EmailSmtpBox" />
					</StackPanel>
				</StackPanel>

				<!--  Display a message (deprecated): title + message shown in a desktop message box.  -->
				<StackPanel
					x:Name="DisplayMessagePanel"
					Spacing="10"
					Visibility="Collapsed">
					<StackPanel Spacing="4">
						<TextBlock Text="{x:Bind LocalizedStrings.TaskSchd_Action_MessageTitle}" />
						<TextBox x:Name="MessageTitleBox" />
					</StackPanel>
					<StackPanel Spacing="4">
						<TextBlock Text="{x:Bind LocalizedStrings.TaskSchd_Action_MessageBody}" />
						<TextBox
							x:Name="MessageBodyBox"
							AcceptsReturn="True"
							MaxHeight="140"
							TextWrapping="Wrap" />
					</StackPanel>
				</StackPanel>

			</StackPanel>
		</ScrollViewer>
	</Grid>
</ContentDialog>
