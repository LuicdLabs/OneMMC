<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="OneMMC.Views.ServicesDetailsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    CloseButtonText="{x:Bind LocalizedStrings.Common_CancelButton}"
    DefaultButton="Primary"
    PrimaryButtonClick="ContentDialog_PrimaryButtonClick"
    PrimaryButtonText="{x:Bind LocalizedStrings.Common_OKButton}"
    Style="{StaticResource DefaultContentDialogStyle}"
    mc:Ignorable="d">

    <Grid MinHeight="500">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  Header  -->
        <TextBlock
            x:Name="ServiceTitle"
            Grid.Row="0"
            Margin="0,0,0,12"
            Style="{StaticResource SubtitleTextBlockStyle}"
            TextWrapping="Wrap" />

        <!--  SelectorBar  -->
        <muxc:SelectorBar
            x:Name="ServiceDetailsSelectorBar"
            Grid.Row="1"
            Margin="0,0,0,12"
            SelectionChanged="ServiceDetailsSelectorBar_SelectionChanged">
            <muxc:SelectorBarItem Tag="General" Text="{x:Bind LocalizedStrings.Service_General}" />
            <muxc:SelectorBarItem Tag="LogOn" Text="{x:Bind LocalizedStrings.Service_LogOn}" />
            <muxc:SelectorBarItem Tag="Recovery" Text="{x:Bind LocalizedStrings.Service_Recovery}" />
            <muxc:SelectorBarItem Tag="Dependencies" Text="{x:Bind LocalizedStrings.Service_Dependencies}" />
        </muxc:SelectorBar>

        <!--  Content  -->
        <Grid Grid.Row="2">
            <!--  General Page  -->
            <ScrollViewer x:Name="GeneralPage" Visibility="Visible">
                <StackPanel Padding="0,0,12,0" Spacing="12">
                    <TextBlock FontWeight="SemiBold" Text="{x:Bind LocalizedStrings.Service_Name}" />
                    <TextBlock x:Name="ServiceNameText" TextWrapping="Wrap" />
                    <TextBlock FontWeight="SemiBold" Text="{x:Bind LocalizedStrings.Service_DisplayName}" />
                    <TextBlock x:Name="DisplayNameText" TextWrapping="Wrap" />
                    <TextBlock FontWeight="SemiBold" Text="{x:Bind LocalizedStrings.Service_Description}" />
                    <TextBlock
                        x:Name="DescriptionText"
                        IsTextSelectionEnabled="True"
                        TextWrapping="Wrap" />
                    <TextBlock FontWeight="SemiBold" Text="{x:Bind LocalizedStrings.Service_Status}" />
                    <TextBlock x:Name="StatusText" />
                    <TextBlock FontWeight="SemiBold" Text="{x:Bind LocalizedStrings.Service_StartupType}" />
                    <ComboBox x:Name="StartupTypeBox" MinWidth="200">
                        <ComboBoxItem Content="{x:Bind LocalizedStrings.Service_Startup_Auto}" Tag="Auto" />
                        <ComboBoxItem Content="{x:Bind LocalizedStrings.Service_Startup_AutoDelayed}" Tag="Automatic (Delayed Start)" />
                        <ComboBoxItem Content="{x:Bind LocalizedStrings.Service_Startup_Manual}" Tag="Manual" />
                        <ComboBoxItem Content="{x:Bind LocalizedStrings.Common_Disabled}" Tag="Disabled" />
                    </ComboBox>
                    <Button Click="SaveStartupType_Click" Content="{x:Bind LocalizedStrings.Service_SaveStartupType}" />
                </StackPanel>
            </ScrollViewer>

            <!--  LogOn Page  -->
            <ScrollViewer
                x:Name="LogOnPage"
                HorizontalScrollBarVisibility="Disabled"
                Visibility="Collapsed">
                <StackPanel Padding="0,0,12,0" Spacing="12">
                    <TextBlock FontWeight="SemiBold" Text="{x:Bind LocalizedStrings.Service_LogOn_Account}" />
                    <RadioButton
                        x:Name="LocalSystemRadio"
                        Content="{x:Bind LocalizedStrings.Service_LogOn_LocalSystem}"
                        GroupName="LogOn"
                        IsChecked="True" />
                    <RadioButton
                        x:Name="ThisAccountRadio"
                        Margin="0,8,0,0"
                        Content="{x:Bind LocalizedStrings.Service_LogOn_ThisAccount}"
                        GroupName="LogOn" />
                    <!--  This Account Box  -->
                    <Border
                        Margin="0,8,0,0"
                        Padding="12"
                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                        CornerRadius="4">
                        <StackPanel Spacing="12">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBox
                                    x:Name="AccountBox"
                                    Width="320"
                                    Header="{x:Bind LocalizedStrings.Service_AccountName_Header}"
                                    IsEnabled="{x:Bind ThisAccountRadio.IsChecked, Converter={StaticResource NullableBoolToBoolConverter}, Mode=OneWay}"
                                    PlaceholderText="{x:Bind LocalizedStrings.Service_Account_Placeholder}" />
                                <Button
                                    x:Name="BrowseAccountButton"
                                    VerticalAlignment="Bottom"
                                    Click="BrowseAccount_Click"
                                    Content="{x:Bind LocalizedStrings.Common_BrowseButton}"
                                    IsEnabled="{x:Bind ThisAccountRadio.IsChecked, Converter={StaticResource NullableBoolToBoolConverter}, Mode=OneWay}" />
                            </StackPanel>
                            <PasswordBox
                                x:Name="PasswordBox"
                                Header="{x:Bind LocalizedStrings.Service_Password_Header}"
                                IsEnabled="{x:Bind ThisAccountRadio.IsChecked, Converter={StaticResource NullableBoolToBoolConverter}, Mode=OneWay}"
                                PlaceholderText="{x:Bind LocalizedStrings.Service_Password_Placeholder}" />
                        </StackPanel>
                    </Border>
                    <Button
                        Margin="0,12,0,0"
                        Click="ApplyLogOn_Click"
                        Content="{x:Bind LocalizedStrings.Service_ApplyLogOn}" />
                    <InfoBar
                        Margin="0,12,0,0"
                        IsClosable="False"
                        IsOpen="True"
                        Message="{x:Bind LocalizedStrings.Service_Info_LogonChangeMessage}"
                        Severity="Informational" />
                </StackPanel>
            </ScrollViewer>

            <!--  Recovery Page  -->
            <ScrollViewer
                x:Name="RecoveryPage"
                HorizontalScrollBarVisibility="Disabled"
                Visibility="Collapsed">
                <StackPanel Padding="0,0,12,0" Spacing="12">
                    <TextBlock
                        Margin="0,0,0,12"
                        FontSize="14"
                        Text="{x:Bind LocalizedStrings.Service_Recovery_SelectResponse}"
                        TextWrapping="Wrap" />
                    <ComboBox
                        x:Name="FirstFailureBox"
                        MinWidth="350"
                        Header="{x:Bind LocalizedStrings.Service_Recovery_FirstFailure}"
                        SelectedValuePath="Tag">
                        <ComboBoxItem Content="{x:Bind LocalizedStrings.Service_Recovery_TakeNoAction}" Tag="none" />
                        <ComboBoxItem Content="{x:Bind LocalizedStrings.Service_Recovery_RestartService}" Tag="restart" />
                        <ComboBoxItem Content="{x:Bind LocalizedStrings.Service_Recovery_RunProgram}" Tag="run" />
                        <ComboBoxItem Content="{x:Bind LocalizedStrings.Service_Recovery_RestartComputer}" Tag="reboot" />
                    </ComboBox>
                    <ComboBox
                        x:Name="SecondFailureBox"
                        MinWidth="350"
                        Header="{x:Bind LocalizedStrings.Service_Recovery_SecondFailure}"
                        SelectedValuePath="Tag">
                        <ComboBoxItem Content="{x:Bind LocalizedStrings.Service_Recovery_TakeNoAction}" Tag="none" />
                        <ComboBoxItem Content="{x:Bind LocalizedStrings.Service_Recovery_RestartService}" Tag="restart" />
                        <ComboBoxItem Content="{x:Bind LocalizedStrings.Service_Recovery_RunProgram}" Tag="run" />
                        <ComboBoxItem Content="{x:Bind LocalizedStrings.Service_Recovery_RestartComputer}" Tag="reboot" />
                    </ComboBox>
                    <ComboBox
                        x:Name="SubsequentFailureBox"
                        MinWidth="350"
                        Header="{x:Bind LocalizedStrings.Service_Recovery_SubsequentFailure}"
                        SelectedValuePath="Tag">
                        <ComboBoxItem Content="{x:Bind LocalizedStrings.Service_Recovery_TakeNoAction}" Tag="none" />
                        <ComboBoxItem Content="{x:Bind LocalizedStrings.Service_Recovery_RestartService}" Tag="restart" />
                        <ComboBoxItem Content="{x:Bind LocalizedStrings.Service_Recovery_RunProgram}" Tag="run" />
                        <ComboBoxItem Content="{x:Bind LocalizedStrings.Service_Recovery_RestartComputer}" Tag="reboot" />
                    </ComboBox>
                    <NumberBox
                        x:Name="ResetFailCountBox"
                        MinWidth="350"
                        Margin="0,12,0,0"
                        Header="{x:Bind LocalizedStrings.Service_Recovery_ResetFailCountHeader}"
                        Maximum="999"
                        Minimum="0"
                        SpinButtonPlacementMode="Inline" />
                    <Button
                        Margin="0,12,0,0"
                        Click="ApplyRecovery_Click"
                        Content="{x:Bind LocalizedStrings.Service_ApplyRecovery}" />
                </StackPanel>
            </ScrollViewer>

            <!--  Dependencies Page  -->
            <ScrollViewer
                x:Name="DependenciesPage"
                HorizontalScrollBarVisibility="Disabled"
                Visibility="Collapsed">
                <StackPanel Padding="0,0,12,0" Spacing="12">
                    <TextBlock
                        Margin="0,0,0,8"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="{x:Bind LocalizedStrings.Service_Dependencies_DependsOn}" />
                    <TextBlock
                        Margin="0,0,0,8"
                        FontSize="12"
                        Opacity="0.7"
                        Text="{x:Bind LocalizedStrings.Service_Dependencies_FollowingCannotRunText}"
                        TextWrapping="Wrap" />
                    <Border
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="4">
                        <ListView
                            MinHeight="120"
                            MaxHeight="180"
                            ItemsSource="{x:Bind _service.Dependencies, Mode=OneWay}">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Padding="8,4" Text="{Binding}" />
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Border>
                    <TextBlock
                        Margin="0,0,0,8"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="{x:Bind LocalizedStrings.Service_Dependents_DependsOn}" />
                    <TextBlock
                        Margin="0,0,0,8"
                        FontSize="12"
                        Opacity="0.7"
                        Text="{x:Bind LocalizedStrings.Service_Dependents_FollowingCannotRunText}"
                        TextWrapping="Wrap" />
                    <Border
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="4">
                        <ListView
                            MinHeight="120"
                            MaxHeight="180"
                            ItemsSource="{x:Bind _service.Dependents, Mode=OneWay}">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Padding="8,4" Text="{Binding}" />
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</ContentDialog>