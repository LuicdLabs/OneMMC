<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="OneMMC.Views.EventViewerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:converters="using:OneMMC.Converters"
    xmlns:ctl="using:OneMMC.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:OneMMC.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:OneMMC.Core.Features.PCManagement.Models.EventViewer"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <converters:NullToBoolConverter x:Key="NullToBoolConverter" />
        <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
        <converters:LevelToColorConverter x:Key="LevelToColorConverter" />
        <Style x:Key="SecondaryTextBlockStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  CommandBar  -->
        <CommandBar Grid.Row="0" DefaultLabelPosition="Right">
            <AppBarButton
                Command="{x:Bind ViewModel.RefreshCommand}"
                Icon="Refresh"
                IsEnabled="{x:Bind ViewModel.SelectedLogName, Converter={StaticResource NullToBoolConverter}, Mode=OneWay}"
                Label="{x:Bind LocalizedStrings.Common_Refresh}" />
            <AppBarButton Icon="More">
                <AppBarButton.Flyout>
                    <MenuFlyout>
                        <MenuFlyoutItem
                            Click="ClearLogButton_Click"
                            IsEnabled="{x:Bind ViewModel.SelectedLogName, Converter={StaticResource NullToBoolConverter}, Mode=OneWay}"
                            Text="{x:Bind LocalizedStrings.EventViewer_ClearLog}">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE74D;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem
                            Click="ExportLogButton_Click"
                            IsEnabled="{x:Bind ViewModel.SelectedLogName, Converter={StaticResource NullToBoolConverter}, Mode=OneWay}"
                            Text="{x:Bind LocalizedStrings.EventViewer_ExportLog}">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE78C;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem
                            Click="LogPropertiesButton_Click"
                            IsEnabled="{x:Bind ViewModel.SelectedLogName, Converter={StaticResource NullToBoolConverter}, Mode=OneWay}"
                            Text="{x:Bind LocalizedStrings.EventViewer_LogProperties}">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE946;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem
                            Click="OpenLegacyEventViewer_Click"
                            Text="{x:Bind LocalizedStrings.EventViewer_OpenLegacy}" />
                    </MenuFlyout>
                </AppBarButton.Flyout>
            </AppBarButton>
        </CommandBar>

        <!--  Main Content Grid  -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" MinWidth="200" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="300" />
            </Grid.ColumnDefinitions>

            <!--  Left Panel: TreeView  -->
            <Border
                Grid.Column="0"
                BorderBrush="Transparent"
                BorderThickness="0,0,1,0">
                <TreeView
                    x:Name="EventLogTreeView"
                    AllowDrop="False"
                    CanDrag="False"
                    CanReorderItems="False"
                    ItemInvoked="EventLogTreeView_ItemInvoked"
                    SelectionMode="Single">
                    <TreeView.ItemContainerStyle>
                        <Style TargetType="TreeViewItem">
                            <Setter Property="MinHeight" Value="36" />
                        </Style>
                    </TreeView.ItemContainerStyle>
                </TreeView>
            </Border>

            <!--  GridSplitter  -->
            <ctl:AotGridSplitter
                Grid.Column="1"
                Width="12"
                ResizeBehavior="BasedOnAlignment"
                ResizeDirection="Columns" />

            <!--  Right Panel: Events List and Details  -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="2*" MinHeight="150" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="1*" MinHeight="150" />
                </Grid.RowDefinitions>

                <!--  Events ListView Area  -->
                <Grid Grid.Row="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!--  Filter bar  -->
                    <Grid Grid.Row="0" Margin="12,8,12,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <AutoSuggestBox
                            Grid.Column="0"
                            PlaceholderText="{x:Bind LocalizedStrings.EventViewer_SearchPlaceholder}"
                            QueryIcon="Find"
                            Text="{x:Bind ViewModel.FilterText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <ComboBox
                            x:Name="LevelFilterCombo"
                            Grid.Column="1"
                            Width="150"
                            Margin="8,0,0,0"
                            SelectionChanged="LevelFilterCombo_SelectionChanged" />
                    </Grid>

                    <!--  Events ListView  -->
                    <ListView
                        x:Name="EventsListView"
                        Grid.Row="1"
                        Margin="12,0,12,0"
                        ItemsSource="{x:Bind ViewModel.Events, Mode=OneWay}"
                        SelectedItem="{x:Bind ViewModel.SelectedEvent, Mode=TwoWay}"
                        SelectionMode="Single"
                        Loaded="EventsListView_Loaded">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:EventLogEntry">
                                <Grid Padding="4,6" ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!--  Level indicator  -->
                                    <Border
                                        Grid.Column="0"
                                        Width="4"
                                        Height="36"
                                        VerticalAlignment="Center"
                                        Background="{x:Bind Level, Converter={StaticResource LevelToColorConverter}}"
                                        CornerRadius="2" />

                                    <!--  Event content  -->
                                    <StackPanel Grid.Column="1" Spacing="2">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock
                                                Grid.Column="0"
                                                FontWeight="SemiBold"
                                                Text="{x:Bind LocalizedLevel}" />
                                            <TextBlock
                                                Grid.Column="1"
                                                HorizontalAlignment="Right"
                                                FontSize="12"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Text="{x:Bind TimeCreated}" />
                                        </Grid>
                                        <TextBlock
                                            FontSize="12"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="{x:Bind SummaryLine}"
                                            TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>


                    <!--  Loading overlay  -->
                    <ProgressRing
                        Grid.Row="1"
                        Width="40"
                        Height="40"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />
                </Grid>

                <!--  GridSplitter  -->
                <ctl:AotGridSplitter
                    Grid.Row="1"
                    Height="12"
                    HorizontalAlignment="Stretch"
                    ResizeBehavior="BasedOnAlignment"
                    ResizeDirection="Rows" />

                <!--  Details Panel  -->
                <Grid Grid.Row="2" Margin="12,0,12,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!--  SelectorBar for Tabs  -->
                    <SelectorBar
                        x:Name="DetailsSelectorBar"
                        Grid.Row="0"
                        Margin="0,8,0,8"
                        SelectionChanged="DetailsSelectorBar_SelectionChanged">
                        <SelectorBarItem IsSelected="True" Text="{x:Bind LocalizedStrings.EventViewer_Tab_General}" />
                        <SelectorBarItem Text="{x:Bind LocalizedStrings.EventViewer_Tab_Details}" />
                    </SelectorBar>

                    <!--  Detail Content Frame  -->
                    <Frame
                        x:Name="DetailContentFrame"
                        Grid.Row="1"
                        IsNavigationStackEnabled="False"
                        Visibility="{x:Bind ViewModel.SelectedEvent, Converter={StaticResource NullToVisibilityConverter}, Mode=OneWay}" />
                </Grid>
            </Grid>
        </Grid>

        <!--  Status Bar  -->
        <Grid Grid.Row="2" Padding="12,4,12,4">
            <TextBlock
                FontSize="12"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" />
        </Grid>
    </Grid>
</Page>
