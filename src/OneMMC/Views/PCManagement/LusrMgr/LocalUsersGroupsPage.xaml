<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="OneMMC.Views.LusrMgr.LocalUsersGroupsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:OneMMC.Views.LusrMgr"
    xmlns:localization="using:OneMMC.Localization"
    xmlns:lusrmgr="using:OneMMC.Core.Features.PCManagement.Models.LusrMgr"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:OneMMC.Core.Features.PCManagement.Models.LusrMgr"
    xmlns:muxc="using:CommunityToolkit.WinUI.Controls"
    x:Name="PageRoot"
    mc:Ignorable="d">
    <Page.Resources>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  Toolbar  -->
        <Grid Grid.Row="0" Padding="24,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
        </Grid>

        <!--  Content  -->
        <ScrollViewer Grid.Row="1">
            <StackPanel Spacing="4">
                <muxc:SettingsExpander
                    HorizontalAlignment="Stretch"
                    Header="{x:Bind LocalizedStrings.LusrMgr_Users}"
                    IsExpanded="False"
                    ItemsSource="{x:Bind ViewModel.Users, Mode=OneWay}">
                    <muxc:SettingsExpander.HeaderIcon>
                        <FontIcon FontSize="16" Glyph="&#xE77B;" />
                    </muxc:SettingsExpander.HeaderIcon>
                    <muxc:SettingsExpander.Description>
                        <TextBlock>
                            <Run Text="{x:Bind ViewModel.UserCount, Mode=OneWay}" />
                            <Run Text="{x:Bind LocalizedStrings.LusrMgr_Items}" />
                        </TextBlock>
                    </muxc:SettingsExpander.Description>

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <AutoSuggestBox PlaceholderText="{x:Bind LocalizedStrings.LusrMgr_SearchUsers}" Text="{x:Bind ViewModel.UserSearchText, Mode=TwoWay}" />
                        <Button Command="{x:Bind ViewModel.AddUserCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon FontSize="12" Glyph="&#xE710;" />
                                <TextBlock Text="{x:Bind LocalizedStrings.LusrMgr_AddUser_Button}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <muxc:SettingsExpander.ItemTemplate>
                        <DataTemplate x:DataType="lusrmgr:LocalUser">
                            <muxc:SettingsCard Padding="24,0,24,0">
                                <muxc:SettingsCard.Header>
                                    <StackPanel
                                        VerticalAlignment="Center"
                                        Orientation="Horizontal"
                                        Spacing="12">
                                        <FontIcon
                                            VerticalAlignment="Center"
                                            FontSize="20"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Glyph="&#xE77B;" />
                                        <StackPanel>
                                            <TextBlock VerticalAlignment="Center" Text="{x:Bind DisplayName}" />
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                Text="{x:Bind Description}"
                                                TextTrimming="CharacterEllipsis"
                                                TextWrapping="NoWrap" />
                                        </StackPanel>
                                    </StackPanel>
                                </muxc:SettingsCard.Header>
                                <muxc:SettingsCard.Content>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Orientation="Horizontal"
                                            Spacing="8">
                                            <Button
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Click="EditUserButton_Click"
                                                Tag="{x:Bind}">
                                                <FontIcon FontSize="16" Glyph="&#xE70F;" />
                                            </Button>
                                            <Button
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Click="DeleteUserButton_Click"
                                                Tag="{x:Bind}">
                                                <FontIcon FontSize="16" Glyph="&#xE74D;" />
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </muxc:SettingsCard.Content>
                            </muxc:SettingsCard>
                        </DataTemplate>
                    </muxc:SettingsExpander.ItemTemplate>
                </muxc:SettingsExpander>

                <muxc:SettingsExpander
                    HorizontalAlignment="Stretch"
                    Header="{x:Bind LocalizedStrings.Common_Groups}"
                    IsExpanded="False"
                    ItemsSource="{x:Bind ViewModel.Groups, Mode=OneWay}">
                    <muxc:SettingsExpander.HeaderIcon>
                        <FontIcon FontSize="16" Glyph="&#xE716;" />
                    </muxc:SettingsExpander.HeaderIcon>
                    <muxc:SettingsExpander.Description>
                        <TextBlock>
                            <Run Text="{x:Bind ViewModel.GroupCount, Mode=OneWay}" />
                            <Run Text="{x:Bind LocalizedStrings.LusrMgr_Items}" />
                        </TextBlock>
                    </muxc:SettingsExpander.Description>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <AutoSuggestBox PlaceholderText="{x:Bind LocalizedStrings.LusrMgr_SearchGroups}" Text="{x:Bind ViewModel.GroupSearchText, Mode=TwoWay}" />
                        <Button Command="{x:Bind ViewModel.AddGroupCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon FontSize="12" Glyph="&#xE710;" />
                                <TextBlock Text="{x:Bind LocalizedStrings.LusrMgr_AddGroup_Button}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <muxc:SettingsExpander.ItemTemplate>
                        <DataTemplate x:DataType="lusrmgr:LocalGroup">
                            <muxc:SettingsCard Padding="24,0,24,0">
                                <muxc:SettingsCard.Header>
                                    <StackPanel
                                        VerticalAlignment="Center"
                                        Orientation="Horizontal"
                                        Spacing="12">
                                        <FontIcon
                                            FontSize="20"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Glyph="&#xE716;" />
                                        <StackPanel>
                                            <TextBlock VerticalAlignment="Center" Text="{x:Bind Name}" />
                                            <TextBlock
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                Text="{x:Bind Description}"
                                                TextTrimming="CharacterEllipsis"
                                                TextWrapping="NoWrap" />
                                        </StackPanel>
                                    </StackPanel>
                                </muxc:SettingsCard.Header>
                                <muxc:SettingsCard.Content>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Orientation="Horizontal"
                                            Spacing="8">
                                            <Button
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Click="EditGroupButton_Click"
                                                Tag="{x:Bind}">
                                                <FontIcon FontSize="16" Glyph="&#xE70F;" />
                                            </Button>
                                            <Button
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Click="DeleteGroupButton_Click"
                                                Tag="{x:Bind}">
                                                <FontIcon FontSize="16" Glyph="&#xE74D;" />
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </muxc:SettingsCard.Content>
                            </muxc:SettingsCard>
                        </DataTemplate>
                    </muxc:SettingsExpander.ItemTemplate>

                </muxc:SettingsExpander>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
