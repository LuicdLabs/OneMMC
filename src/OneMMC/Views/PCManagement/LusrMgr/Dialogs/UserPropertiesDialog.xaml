<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="OneMMC.Views.LusrMgr.UserPropertiesDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:OneMMC.Core.Features.PCManagement.Models.LusrMgr"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    mc:Ignorable="d"
    CloseButtonText="{x:Bind LocalizedStrings.Common_CancelButton}"
    PrimaryButtonText="{x:Bind LocalizedStrings.Common_OKButton}"
    DefaultButton="Primary"
    Style="{StaticResource DefaultContentDialogStyle}">

    <Grid MinWidth="495" MinHeight="500">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock
            x:Name="UserTitle"
            Grid.Row="0"
            Margin="0,0,0,12"
            Style="{StaticResource SubtitleTextBlockStyle}"
            TextWrapping="Wrap" />

        <!-- SelectorBar -->
        <muxc:SelectorBar
            x:Name="UserPropertiesSelectorBar"
            Grid.Row="1"
            Margin="0,0,0,12"
            SelectionChanged="UserPropertiesSelectorBar_SelectionChanged">
            <muxc:SelectorBarItem Tag="General" Text="{x:Bind LocalizedStrings.LusrMgr_UserProperties_General}" />
            <muxc:SelectorBarItem Tag="MemberOf" Text="{x:Bind LocalizedStrings.LusrMgr_UserProperties_MemberOf}" />
        </muxc:SelectorBar>

        <!-- Content -->
        <Grid Grid.Row="2">
            <!-- General Page -->
            <ScrollViewer x:Name="GeneralPage" Visibility="Visible">
                <StackPanel Spacing="12">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <FontIcon Glyph="&#xE77B;" FontSize="48" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="UserNameTitle" FontSize="20" FontWeight="SemiBold"/>
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Text="{x:Bind LocalizedStrings.LusrMgr_UserProperties_FullName}" FontWeight="SemiBold" />
                    <TextBox x:Name="FullNameBox" />

                    <TextBlock Text="{x:Bind LocalizedStrings.LusrMgr_UserProperties_Description}" FontWeight="SemiBold" />
                    <TextBox x:Name="DescriptionBox" />

                    <StackPanel Spacing="8" Margin="0,12,0,0">
                        <CheckBox x:Name="UserMustChangePasswordCheck" Content="{x:Bind LocalizedStrings.LusrMgr_UserProperties_UserMustChangePassword}" Checked="OnPasswordOptionChanged" Unchecked="OnPasswordOptionChanged"/>
                        <CheckBox x:Name="UserCannotChangePasswordCheck" Content="{x:Bind LocalizedStrings.LusrMgr_UserProperties_UserCannotChangePassword}" Checked="OnPasswordOptionChanged" Unchecked="OnPasswordOptionChanged"/>
                        <CheckBox x:Name="PasswordNeverExpiresCheck" Content="{x:Bind LocalizedStrings.LusrMgr_UserProperties_PasswordNeverExpires}" Checked="OnPasswordOptionChanged" Unchecked="OnPasswordOptionChanged"/>
                        <CheckBox x:Name="AccountDisabledCheck" Content="{x:Bind LocalizedStrings.LusrMgr_UserProperties_AccountDisabled}"/>
                        <CheckBox x:Name="AccountLockedOutCheck" Content="{x:Bind LocalizedStrings.LusrMgr_UserProperties_AccountLockedOut}" IsEnabled="False"/>
                    </StackPanel>
                    <!-- Warning/info area for password option conflicts -->
                    <muxc:InfoBar x:Name="PasswordConflictInfo" Margin="0,4,0,0" IsOpen="False" IsClosable="True" Severity="Warning">
                        <muxc:InfoBar.Content>
                            <TextBlock Text="{x:Bind LocalizedStrings.LusrMgr_UserProperties_PasswordConflict}" TextWrapping="Wrap"/>
                        </muxc:InfoBar.Content>
                    </muxc:InfoBar>
                </StackPanel>
            </ScrollViewer>

            <!-- Member Of Page -->
            <ScrollViewer x:Name="MemberOfPage" Visibility="Collapsed">
                <StackPanel Spacing="12">
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4">
                        <ListView x:Name="MemberOfList" MinHeight="120" MaxHeight="180">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE716;" FontSize="16" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        <TextBlock Text="{x:Bind}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Border>

                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                        <Button Content="{x:Bind LocalizedStrings.Common_AddButton}" Click="OnAddGroupClick"/>
                        <Button Content="{x:Bind LocalizedStrings.Common_RemoveButton}" Click="OnRemoveGroupClick"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</ContentDialog>
