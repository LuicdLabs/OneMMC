<Page
    x:Class="OneMMC.Views.PolicyManagement.GpEdit.GroupPolicyEditorPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:ctl="using:OneMMC.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:OneMMC.Core.Features.PolicyManagement.ViewModels.GpEdit"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  CommandBar  -->
        <CommandBar Grid.Row="0" DefaultLabelPosition="Right">
            <AppBarButton
                Click="EditButton_Click"
                Icon="Edit"
                IsEnabled="{x:Bind ViewModel.SelectedPolicy, Mode=OneWay, Converter={StaticResource NullToBoolConverter}}"
                Label="{x:Bind LocalizedStrings.Common_EditButton}" />
            <AppBarButton
                Click="RefreshButton_Click"
                Icon="Refresh"
                Label="{x:Bind LocalizedStrings.Common_Refresh}" />
        </CommandBar>

        <!--  Windows Edition Warning  -->
        <InfoBar
            x:Name="EditionWarningBar"
            Title="{x:Bind LocalizedStrings.GroupPolicy_WindowsEditionNotice_Title}"
            Grid.Row="2"
            Margin="24,0,24,12"
            IsClosable="True"
            IsOpen="{x:Bind ViewModel.WindowsEditionWarning, Mode=OneWay, Converter={StaticResource StringToBoolConverter}}"
            Message="{x:Bind ViewModel.WindowsEditionWarning, Mode=OneWay}"
            Severity="Warning" />

        <!--  Main Content  -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" MinWidth="200" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="300" />
            </Grid.ColumnDefinitions>

            <!--  Tree View  -->
            <TreeView
                x:Name="PolicyTree"
                AllowDrop="False"
                CanDragItems="False"
                CanReorderItems="False"
                Collapsed="PolicyTree_Collapsed"
                Expanding="PolicyTree_Expanding"
                ItemInvoked="PolicyTree_ItemInvoked"
                SelectionMode="Single">
                <TreeView.ItemTemplate>
                    <DataTemplate x:DataType="TreeViewNode">
                        <Grid Height="30">
                            <TextBlock VerticalAlignment="Center" Text="{x:Bind ((vm:GroupPolicyTreeItem)Content).Name}" />
                        </Grid>
                    </DataTemplate>
                </TreeView.ItemTemplate>
            </TreeView>

            <ctl:AotGridSplitter
                Grid.Column="1"
                Width="12"
                ResizeBehavior="BasedOnAlignment"
                ResizeDirection="Columns" />

            <!--  Policy Search Box  -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <AutoSuggestBox
                    x:Name="PolicySearchBox"
                    Grid.Row="0"
                    Margin="12,8,12,4"
                    PlaceholderText="{x:Bind LocalizedStrings.Common_SearchPlaceholder}"
                    QueryIcon="Find"
                    TextChanged="PolicySearchBox_TextChanged" />

                <!--  Policies List  -->
                <ListView
                    x:Name="PoliciesListView"
                    Grid.Row="1"
                    Padding="12"
                    DoubleTapped="PoliciesListView_DoubleTapped"
                    ItemsSource="{x:Bind ViewModel.CurrentPolicies, Mode=OneWay}"
                    SelectedItem="{x:Bind ViewModel.SelectedPolicy, Mode=TwoWay}"
                    SelectionMode="Single">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:PolicyListItem">
                            <StackPanel Margin="0,8" Spacing="4">
                                <TextBlock Text="{x:Bind DisplayName}" TextWrapping="Wrap" />
                                <TextBlock
                                    Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="{x:Bind StateString, Mode=OneWay}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>

            <!--  Loading Indicator  -->
            <ProgressRing
                Grid.Column="2"
                Width="50"
                Height="50"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />
        </Grid>
    </Grid>
</Page>

