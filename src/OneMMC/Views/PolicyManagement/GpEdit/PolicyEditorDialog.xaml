<ContentDialog
    x:Class="OneMMC.Views.PolicyManagement.GpEdit.PolicyEditorDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    CloseButtonText="{x:Bind LocalizedStrings.Common_CancelButton}"
    DefaultButton="Primary"
    PrimaryButtonClick="ContentDialog_PrimaryButtonClick"
    PrimaryButtonText="{x:Bind LocalizedStrings.Common_OKButton}"
    Style="{StaticResource DefaultContentDialogStyle}"
    mc:Ignorable="d">

    <Grid MinWidth="500" MinHeight="400">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Header  -->
        <TextBlock
            x:Name="PolicyTitle"
            Grid.Row="0"
            Margin="0,0,0,12"
            Style="{StaticResource SubtitleTextBlockStyle}"
            TextWrapping="Wrap" />

        <!--  Hive Info  -->
        <StackPanel
            Grid.Row="1"
            Margin="0,0,0,8"
            Spacing="4">
            <TextBlock
                x:Name="HiveInfoText"
                FontSize="13"
                Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" />
        </StackPanel>

        <!--  Controls (policy state)  -->
        <StackPanel
            Grid.Row="2"
            Margin="0,0,0,12"
            Orientation="Horizontal"
            Spacing="8">
            <TextBlock
                Margin="0,0,8,0"
                VerticalAlignment="Center"
                Text="{x:Bind LocalizedStrings.Policy_State_Label}" />
            <ComboBox
                x:Name="StateCombo"
                Width="220"
                SelectionChanged="StateCombo_SelectionChanged">
                <ComboBoxItem Content="{x:Bind LocalizedStrings.Policy_State_NotConfigured}" Tag="NotConfigured" />
                <ComboBoxItem Content="{x:Bind LocalizedStrings.Common_Enabled}" Tag="Enabled" />
                <ComboBoxItem Content="{x:Bind LocalizedStrings.Common_Disabled}" Tag="Disabled" />
            </ComboBox>
        </StackPanel>

        <Grid Grid.Row="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!--  SelectorBar for switching between General and Explain  -->
            <muxc:SelectorBar
                x:Name="PolicySelectorBar"
                Grid.Row="0"
                Margin="0,0,0,12"
                SelectionChanged="PolicySelectorBar_SelectionChanged">
                <muxc:SelectorBarItem
                    IsSelected="True"
                    Tag="General"
                    Text="{x:Bind LocalizedStrings.Policy_Selector_General}" />
                <muxc:SelectorBarItem Tag="Explain" Text="{x:Bind LocalizedStrings.Policy_Selector_Explain}" />
            </muxc:SelectorBar>

            <!--  Content area: General and Explain panels, switch visibility in code-behind  -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <Grid x:Name="PolicyContentGrid">
                    <!--  General Panel  -->
                    <StackPanel
                        x:Name="GeneralPanel"
                        Padding="0"
                        Visibility="Visible">
                        <Border
                            Margin="0,0,0,8"
                            Padding="8"
                            BorderBrush="{ThemeResource SystemControlForegroundBaseLowBrush}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <TextBlock
                                    Margin="0,0,0,8"
                                    FontWeight="SemiBold"
                                    Text="{x:Bind LocalizedStrings.Policy_Options_Title}" />
                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                    <StackPanel x:Name="OptionsPanel" Spacing="8">
                                        <TextBlock
                                            x:Name="NoOptionsText"
                                            Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                                            Text="{x:Bind LocalizedStrings.Policy_NoOptionsText}"
                                            Visibility="Collapsed" />
                                    </StackPanel>
                                </ScrollViewer>
                            </Grid>
                        </Border>

                        <TextBlock
                            x:Name="ValidationErrorText"
                            Margin="0,12,0,0"
                            FontSize="13"
                            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                            TextWrapping="Wrap"
                            Visibility="Collapsed" />
                    </StackPanel>

                    <!--  Explain Panel  -->
                    <StackPanel
                        x:Name="ExplainPanel"
                        Padding="0"
                        Visibility="Collapsed">
                        <Border Padding="8" BorderBrush="{ThemeResource SystemControlForegroundBaseLowBrush}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                    <TextBlock
                                        x:Name="ExplainText"
                                        IsTextSelectionEnabled="True"
                                        TextWrapping="Wrap" />
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Grid>

        <!--  Supported On  -->
        <TextBlock
            x:Name="SupportedOnText"
            Grid.Row="5"
            Margin="0,12,0,0"
            FontSize="12"
            Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" />

        <!--  Validation Errors  -->
        <StackPanel
            x:Name="ValidationErrorsPanel"
            Grid.Row="5"
            Margin="0,8,0,0"
            Visibility="Collapsed">
            <TextBlock Foreground="{ThemeResource SystemFillColorCautionBrush}" Text="{x:Bind LocalizedStrings.Policy_ValidationErrors_Header}" />
            <ItemsControl x:Name="ValidationErrorsList" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" />
        </StackPanel>

    </Grid>
</ContentDialog>

