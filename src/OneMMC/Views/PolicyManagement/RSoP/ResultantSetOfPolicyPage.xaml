<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="OneMMC.Views.ResultantSetOfPolicyPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:OneMMC.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:OneMMC.Core.Features.PolicyManagement.ViewModels.RSoP"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  CommandBar  -->
        <CommandBar Grid.Row="0" DefaultLabelPosition="Right">
            <AppBarButton
                Click="ViewDetailsButton_Click"
                Icon="View"
                IsEnabled="{x:Bind ViewModel.SelectedPolicy, Mode=OneWay, Converter={StaticResource NullToBoolConverter}}"
                Label="{x:Bind LocalizedStrings.Common_ViewDetails}" />
            <AppBarButton
                Click="RefreshButton_Click"
                Icon="Refresh"
                Label="{x:Bind LocalizedStrings.Common_Refresh}" />
            <CommandBar.Content>
                <StackPanel
                    Margin="12,0,0,0"
                    Orientation="Horizontal"
                    Spacing="8">
                    <TextBlock
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" />
                </StackPanel>
            </CommandBar.Content>
        </CommandBar>

        <!--  Error Bar  -->
        <InfoBar
            x:Name="ErrorMessageBar"
            Title="{x:Bind LocalizedStrings.RSoP_ErrorTitle}"
            Grid.Row="1"
            Margin="24,0,24,12"
            IsClosable="True"
            IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
            Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
            Severity="Error" />

        <!--  Main Content  -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" MinWidth="200" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="300" />
            </Grid.ColumnDefinitions>

            <!--  Tree View  -->
            <TreeView
                x:Name="PolicyTree"
                AllowDrop="False"
                CanDragItems="False"
                CanReorderItems="False"
                ItemInvoked="PolicyTree_ItemInvoked"
                SelectionMode="Single">
                <TreeView.ItemTemplate>
                    <DataTemplate>
                        <Grid Height="30">
                            <TextBlock VerticalAlignment="Center" Text="{Binding Content.Name}" />
                        </Grid>
                    </DataTemplate>
                </TreeView.ItemTemplate>
            </TreeView>

            <controls:GridSplitter
                Grid.Column="1"
                Width="12"
                ResizeBehavior="BasedOnAlignment"
                ResizeDirection="Columns" />

            <!--  Right Panel  -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!--  Search Bar  -->
                <AutoSuggestBox
                    x:Name="PolicySearchBox"
                    Grid.Row="0"
                    Margin="12,8,12,4"
                    PlaceholderText="{x:Bind LocalizedStrings.Common_SearchPlaceholder}"
                    QueryIcon="Find"
                    TextChanged="PolicySearchBox_TextChanged" />

                <!--  Stats Bar  -->
                <TextBlock
                    Grid.Row="1"
                    Margin="16,4,12,4"
                    Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{x:Bind GetStatsText(ViewModel.ConfiguredPoliciesCount), Mode=OneWay}" />

                <!--  Policies List (only configured policies)  -->
                <ListView
                    x:Name="PoliciesListView"
                    Grid.Row="2"
                    Padding="12"
                    DoubleTapped="PoliciesListView_DoubleTapped"
                    ItemsSource="{x:Bind ViewModel.CurrentPolicies, Mode=OneWay}"
                    SelectedItem="{x:Bind ViewModel.SelectedPolicy, Mode=TwoWay}"
                    SelectionMode="Single">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:RSoPPolicyItem">
                            <StackPanel Margin="0,8" Spacing="4">
                                <TextBlock Text="{x:Bind DisplayName}" TextWrapping="Wrap" />
                                <TextBlock
                                    Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="{x:Bind StateString}"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="{x:Bind SourceGPO}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>

            <!--  Loading Indicator  -->
            <ProgressRing
                Grid.Column="2"
                Width="50"
                Height="50"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />
        </Grid>
    </Grid>
</Page>
