<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="OneMMC.Views.PolicyDetailsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:vm="using:OneMMC.Core.Features.PolicyManagement.ViewModels.RSoP"
    mc:Ignorable="d"
    Title="{x:Bind ViewModel.Title, Mode=OneWay}"
    CloseButtonText="{x:Bind LocalizedStrings.Common_CloseButton, Mode=OneTime}"
    Style="{StaticResource DefaultContentDialogStyle}"
    MinWidth="500"
    MinHeight="400">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- SelectorBar -->
        <muxc:SelectorBar
            x:Name="DetailSelectorBar"
            Grid.Row="0"
            Margin="0,0,0,12"
            SelectionChanged="DetailSelectorBar_SelectionChanged">
            <muxc:SelectorBarItem 
                x:Name="GeneralTabItem" 
                Tag="General"
                Text="{x:Bind LocalizedStrings.RSoP_DetailTab_General, Mode=OneTime}" />
            <muxc:SelectorBarItem 
                x:Name="RegistryTabItem" 
                Tag="Registry"
                Text="{x:Bind LocalizedStrings.RSoP_DetailTab_Registry, Mode=OneTime}" />
            <muxc:SelectorBarItem 
                x:Name="ExplainTabItem" 
                Tag="Explain"
                Text="{x:Bind LocalizedStrings.RSoP_DetailTab_Explain, Mode=OneTime}"
                Visibility="{x:Bind ViewModel.HasDescription, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
        </muxc:SelectorBar>

        <!-- Content -->
        <Grid Grid.Row="1">
            <!-- General Tab -->
            <ScrollViewer x:Name="GeneralPage" Visibility="Visible">
                <StackPanel Spacing="12" Padding="0,0,12,0">
                    <!-- State -->
                    <StackPanel Spacing="2">
                        <TextBlock
                            Text="{x:Bind ViewModel.StateLabel, Mode=OneWay}"
                            FontWeight="SemiBold"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" />
                        <TextBlock
                            Text="{x:Bind ViewModel.StateValue, Mode=OneWay}"
                            TextWrapping="Wrap"
                            IsTextSelectionEnabled="True" />
                    </StackPanel>

                    <!-- Source GPO -->
                    <StackPanel Spacing="2">
                        <TextBlock
                            Text="{x:Bind ViewModel.SourceGpoLabel, Mode=OneWay}"
                            FontWeight="SemiBold"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" />
                        <TextBlock
                            Text="{x:Bind ViewModel.SourceGpoValue, Mode=OneWay}"
                            TextWrapping="Wrap"
                            IsTextSelectionEnabled="True" />
                    </StackPanel>

                    <!-- Category -->
                    <StackPanel Spacing="2">
                        <TextBlock
                            Text="{x:Bind ViewModel.CategoryLabel, Mode=OneWay}"
                            FontWeight="SemiBold"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" />
                        <TextBlock
                            Text="{x:Bind ViewModel.CategoryValue, Mode=OneWay}"
                            TextWrapping="Wrap"
                            IsTextSelectionEnabled="True" />
                    </StackPanel>

                    <!-- Supported On -->
                    <StackPanel 
                        Spacing="2"
                        Visibility="{x:Bind ViewModel.HasSupportedOn, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock
                            Text="{x:Bind ViewModel.SupportedOnLabel, Mode=OneWay}"
                            FontWeight="SemiBold"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" />
                        <TextBlock
                            Text="{x:Bind ViewModel.SupportedOnValue, Mode=OneWay}"
                            TextWrapping="Wrap"
                            IsTextSelectionEnabled="True" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- Registry Tab -->
            <ScrollViewer x:Name="RegistryPage" Visibility="Collapsed">
                <StackPanel Spacing="12" Padding="0,0,12,0">
                    <!-- Registry Key -->
                    <StackPanel Spacing="2">
                        <TextBlock
                            Text="{x:Bind ViewModel.RegistryKeyLabel, Mode=OneWay}"
                            FontWeight="SemiBold"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" />
                        <TextBlock
                            Text="{x:Bind ViewModel.RegistryKeyValue, Mode=OneWay}"
                            TextWrapping="Wrap"
                            IsTextSelectionEnabled="True" />
                    </StackPanel>

                    <!-- Registry Value -->
                    <StackPanel 
                        Spacing="2"
                        Visibility="{x:Bind ViewModel.HasRegistryValue, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock
                            Text="{x:Bind ViewModel.RegistryValueLabel, Mode=OneWay}"
                            FontWeight="SemiBold"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" />
                        <TextBlock
                            Text="{x:Bind ViewModel.RegistryValueValue, Mode=OneWay}"
                            TextWrapping="Wrap"
                            IsTextSelectionEnabled="True" />
                    </StackPanel>

                    <!-- Options -->
                    <StackPanel 
                        Spacing="8"
                        Visibility="{x:Bind ViewModel.HasOptions, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock
                            Text="{x:Bind ViewModel.OptionsTitle, Mode=OneWay}"
                            FontWeight="SemiBold"
                            Margin="0,8,0,0" />
                        
                        <ItemsControl ItemsSource="{x:Bind ViewModel.Options, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:PolicyOptionItem">
                                    <StackPanel Spacing="2" Margin="0,0,0,8">
                                        <TextBlock
                                            Text="{x:Bind Name}"
                                            FontWeight="SemiBold"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" />
                                        <TextBlock
                                            Text="{x:Bind Value}"
                                            TextWrapping="Wrap"
                                            IsTextSelectionEnabled="True" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- Explain Tab -->
            <ScrollViewer x:Name="ExplainPage" Visibility="Collapsed">
                <StackPanel Padding="0,0,12,0">
                    <TextBlock
                        Text="{x:Bind ViewModel.Description, Mode=OneWay}"
                        TextWrapping="Wrap"
                        IsTextSelectionEnabled="True" />
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</ContentDialog>
