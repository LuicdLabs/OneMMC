<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="OneMMC.Views.WindowsFirewallPropertiesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:OneMMC.Localization"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:oneMmcControls="using:OneMMC.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="using:CommunityToolkit.WinUI"
    mc:Ignorable="d">

    <Page.Resources>
    </Page.Resources>

    <ScrollViewer>
        <StackPanel Padding="24,16,24,24" Spacing="12">
            <TextBlock
                FontSize="14"
                FontWeight="SemiBold"
                Text="{x:Bind local:LocalizedStrings.Instance.WF_WindowsFirewallProperties_Profiles}" />

            <oneMmcControls:StableSettingsExpander
                Header="{x:Bind local:LocalizedStrings.Instance.WF_Profile_Domain}"
                HeaderIcon="{ui:FontIcon Glyph=&#xEDA3;}"
                IsExpanded="True">

                <ToggleSwitch
                    x:Name="DomainProfileToggleSwitch"
                    Grid.Column="1"
                    IsOn="True"
                    OffContent="{x:Bind local:LocalizedStrings.Instance.WF_State_Off}"
                    OnContent="{x:Bind local:LocalizedStrings.Instance.WF_State_On}"
                    Toggled="DomainProfileToggleSwitch_Toggled" />

                <oneMmcControls:StableSettingsExpander.Items>
                    <controls:SettingsCard Header="{x:Bind local:LocalizedStrings.Instance.WF_WindowsFirewallProperties_InboundConnections}">
                        <ComboBox
                            x:Name="DomainInboundComboBox"
                            MinWidth="160"
                            SelectedIndex="0"
                            SelectionChanged="ProfileActionComboBox_SelectionChanged"
                            Tag="Domain:Inbound">
                            <ComboBoxItem Content="{x:Bind local:LocalizedStrings.Instance.WF_WindowsFirewallProperties_BlockDefault}" Tag="Block (default)" />
                            <ComboBoxItem Content="{x:Bind local:LocalizedStrings.Instance.WF_WindowsFirewallProperties_BlockAllConnections}" Tag="Block all connections" />
                            <ComboBoxItem Content="{x:Bind local:LocalizedStrings.Instance.WF_Action_Allow}" Tag="Allow" />
                        </ComboBox>
                    </controls:SettingsCard>

                    <controls:SettingsCard Header="{x:Bind local:LocalizedStrings.Instance.WF_WindowsFirewallProperties_OutboundConnections}">
                        <ComboBox
                            x:Name="DomainOutboundComboBox"
                            MinWidth="160"
                            SelectedIndex="0"
                            SelectionChanged="ProfileActionComboBox_SelectionChanged"
                            Tag="Domain:Outbound">
                            <ComboBoxItem Content="{x:Bind local:LocalizedStrings.Instance.WF_WindowsFirewallProperties_AllowDefault}" Tag="Allow (default)" />
                            <ComboBoxItem Content="{x:Bind local:LocalizedStrings.Instance.WF_Action_Block}" Tag="Block" />
                        </ComboBox>
                    </controls:SettingsCard>

                    <controls:SettingsCard Header="{x:Bind local:LocalizedStrings.Instance.WF_WindowsFirewallProperties_ProtectedNetworkConnections}">
                        <Button
                            x:Name="DomainProtectedNetworkButton"
                            MinWidth="110"
                            Click="ProtectedNetworkCustomizeButton_Click"
                            Content="{x:Bind local:LocalizedStrings.Instance.WF_Button_Customize}"
                            Tag="Domain" />
                    </controls:SettingsCard>

                    <controls:SettingsCard Header="{x:Bind local:LocalizedStrings.Instance.WF_WindowsFirewallProperties_SpecifySettingsThatControlWindowsDefenderFirewallBehavior}">
                        <Button
                            x:Name="DomainBehaviorButton"
                            MinWidth="110"
                            Click="FirewallBehaviorSpecifyButton_Click"
                            Content="{x:Bind local:LocalizedStrings.Instance.WF_Button_Specify}"
                            Tag="Domain" />
                    </controls:SettingsCard>

                    <controls:SettingsCard Header="{x:Bind local:LocalizedStrings.Instance.WF_WindowsFirewallProperties_SpecifyLoggingSettingsForTroubleshooting}">
                        <Button
                            x:Name="DomainLoggingButton"
                            MinWidth="110"
                            Click="LoggingSpecifyButton_Click"
                            Content="{x:Bind local:LocalizedStrings.Instance.WF_Button_Specify}"
                            Tag="Domain" />
                    </controls:SettingsCard>
                </oneMmcControls:StableSettingsExpander.Items>
            </oneMmcControls:StableSettingsExpander>

            <oneMmcControls:StableSettingsExpander
                Header="{x:Bind local:LocalizedStrings.Instance.WF_Profile_Private}"
                HeaderIcon="{ui:FontIcon Glyph=&#xE72E;}"
                IsExpanded="True">

                <ToggleSwitch
                    x:Name="PrivateProfileToggleSwitch"
                    Grid.Column="1"
                    IsOn="True"
                    OffContent="{x:Bind local:LocalizedStrings.Instance.WF_State_Off}"
                    OnContent="{x:Bind local:LocalizedStrings.Instance.WF_State_On}"
                    Toggled="PrivateProfileToggleSwitch_Toggled" />

                <oneMmcControls:StableSettingsExpander.Items>
                    <controls:SettingsCard Header="{x:Bind local:LocalizedStrings.Instance.WF_WindowsFirewallProperties_InboundConnections}">
                        <ComboBox
                            x:Name="PrivateInboundComboBox"
                            MinWidth="160"
                            SelectedIndex="0"
                            SelectionChanged="ProfileActionComboBox_SelectionChanged"
                            Tag="Private:Inbound">
                            <ComboBoxItem Content="{x:Bind local:LocalizedStrings.Instance.WF_WindowsFirewallProperties_BlockDefault}" Tag="Block (default)" />
                            <ComboBoxItem Content="{x:Bind local:LocalizedStrings.Instance.WF_WindowsFirewallProperties_BlockAllConnections}" Tag="Block all connections" />
                            <ComboBoxItem Content="{x:Bind local:LocalizedStrings.Instance.WF_Action_Allow}" Tag="Allow" />
                        </ComboBox>
                    </controls:SettingsCard>

                    <controls:SettingsCard Header="{x:Bind local:LocalizedStrings.Instance.WF_WindowsFirewallProperties_OutboundConnections}">
                        <ComboBox
                            x:Name="PrivateOutboundComboBox"
                            MinWidth="160"
                            SelectedIndex="0"
                            SelectionChanged="ProfileActionComboBox_SelectionChanged"
                            Tag="Private:Outbound">
                            <ComboBoxItem Content="{x:Bind local:LocalizedStrings.Instance.WF_WindowsFirewallProperties_AllowDefault}" Tag="Allow (default)" />
                            <ComboBoxItem Content="{x:Bind local:LocalizedStrings.Instance.WF_Action_Block}" Tag="Block" />
                        </ComboBox>
                    </controls:SettingsCard>

                    <controls:SettingsCard Header="{x:Bind local:LocalizedStrings.Instance.WF_WindowsFirewallProperties_ProtectedNetworkConnections}">
                        <Button
                            x:Name="PrivateProtectedNetworkButton"
                            MinWidth="110"
                            Click="ProtectedNetworkCustomizeButton_Click"
                            Content="{x:Bind local:LocalizedStrings.Instance.WF_Button_Customize}"
                            Tag="Private" />
                    </controls:SettingsCard>

                    <controls:SettingsCard Header="{x:Bind local:LocalizedStrings.Instance.WF_WindowsFirewallProperties_SpecifySettingsThatControlWindowsDefenderFirewallBehavior}">
                        <Button
                            x:Name="PrivateBehaviorButton"
                            MinWidth="110"
                            Click="FirewallBehaviorSpecifyButton_Click"
                            Content="{x:Bind local:LocalizedStrings.Instance.WF_Button_Specify}"
                            Tag="Private" />
                    </controls:SettingsCard>

                    <controls:SettingsCard Header="{x:Bind local:LocalizedStrings.Instance.WF_WindowsFirewallProperties_SpecifyLoggingSettingsForTroubleshooting}">
                        <Button
                            x:Name="PrivateLoggingButton"
                            MinWidth="110"
                            Click="LoggingSpecifyButton_Click"
                            Content="{x:Bind local:LocalizedStrings.Instance.WF_Button_Specify}"
                            Tag="Private" />
                    </controls:SettingsCard>
                </oneMmcControls:StableSettingsExpander.Items>
            </oneMmcControls:StableSettingsExpander>

            <oneMmcControls:StableSettingsExpander
                Header="{x:Bind local:LocalizedStrings.Instance.WF_Profile_Public}"
                HeaderIcon="{ui:FontIcon Glyph=&#xE909;}"
                IsExpanded="True">

                <ToggleSwitch
                    x:Name="PublicProfileToggleSwitch"
                    Grid.Column="1"
                    IsOn="True"
                    OffContent="{x:Bind local:LocalizedStrings.Instance.WF_State_Off}"
                    OnContent="{x:Bind local:LocalizedStrings.Instance.WF_State_On}"
                    Toggled="PublicProfileToggleSwitch_Toggled" />

                <oneMmcControls:StableSettingsExpander.Items>
                    <controls:SettingsCard Header="{x:Bind local:LocalizedStrings.Instance.WF_WindowsFirewallProperties_InboundConnections}">
                        <ComboBox
                            x:Name="PublicInboundComboBox"
                            MinWidth="160"
                            SelectedIndex="0"
                            SelectionChanged="ProfileActionComboBox_SelectionChanged"
                            Tag="Public:Inbound">
                            <ComboBoxItem Content="{x:Bind local:LocalizedStrings.Instance.WF_WindowsFirewallProperties_BlockDefault}" Tag="Block (default)" />
                            <ComboBoxItem Content="{x:Bind local:LocalizedStrings.Instance.WF_WindowsFirewallProperties_BlockAllConnections}" Tag="Block all connections" />
                            <ComboBoxItem Content="{x:Bind local:LocalizedStrings.Instance.WF_Action_Allow}" Tag="Allow" />
                        </ComboBox>
                    </controls:SettingsCard>

                    <controls:SettingsCard Header="{x:Bind local:LocalizedStrings.Instance.WF_WindowsFirewallProperties_OutboundConnections}">
                        <ComboBox
                            x:Name="PublicOutboundComboBox"
                            MinWidth="160"
                            SelectedIndex="0"
                            SelectionChanged="ProfileActionComboBox_SelectionChanged"
                            Tag="Public:Outbound">
                            <ComboBoxItem Content="{x:Bind local:LocalizedStrings.Instance.WF_WindowsFirewallProperties_AllowDefault}" Tag="Allow (default)" />
                            <ComboBoxItem Content="{x:Bind local:LocalizedStrings.Instance.WF_Action_Block}" Tag="Block" />
                        </ComboBox>
                    </controls:SettingsCard>

                    <controls:SettingsCard Header="{x:Bind local:LocalizedStrings.Instance.WF_WindowsFirewallProperties_ProtectedNetworkConnections}">
                        <Button
                            x:Name="PublicProtectedNetworkButton"
                            MinWidth="110"
                            Click="ProtectedNetworkCustomizeButton_Click"
                            Content="{x:Bind local:LocalizedStrings.Instance.WF_Button_Customize}"
                            Tag="Public" />
                    </controls:SettingsCard>

                    <controls:SettingsCard Header="{x:Bind local:LocalizedStrings.Instance.WF_WindowsFirewallProperties_SpecifySettingsThatControlWindowsDefenderFirewallBehavior}">
                        <Button
                            x:Name="PublicBehaviorButton"
                            MinWidth="110"
                            Click="FirewallBehaviorSpecifyButton_Click"
                            Content="{x:Bind local:LocalizedStrings.Instance.WF_Button_Specify}"
                            Tag="Public" />
                    </controls:SettingsCard>

                    <controls:SettingsCard Header="{x:Bind local:LocalizedStrings.Instance.WF_WindowsFirewallProperties_SpecifyLoggingSettingsForTroubleshooting}">
                        <Button
                            x:Name="PublicLoggingButton"
                            MinWidth="110"
                            Click="LoggingSpecifyButton_Click"
                            Content="{x:Bind local:LocalizedStrings.Instance.WF_Button_Specify}"
                            Tag="Public" />
                    </controls:SettingsCard>
                </oneMmcControls:StableSettingsExpander.Items>
            </oneMmcControls:StableSettingsExpander>

            <TextBlock
                Margin="0,8,0,0"
                FontSize="14"
                FontWeight="SemiBold"
                Text="{x:Bind local:LocalizedStrings.Instance.WF_WindowsFirewallProperties_IPsecSettings}" />

            <controls:SettingsCard
                Description="{x:Bind local:LocalizedStrings.Instance.WF_FirewallProperties_IpsecDefaultsDescription}"
                Header="{x:Bind local:LocalizedStrings.Instance.WF_WindowsFirewallProperties_IPsecDefaults}"
                HeaderIcon="{ui:FontIcon Glyph=&#xF003;}">
                <Button
                    x:Name="CustomizeIpsecDefaultsButton"
                    MinWidth="110"
                    Click="CustomizeIpsecDefaultsButton_Click"
                    Content="{x:Bind local:LocalizedStrings.Instance.WF_Button_Customize}" />
            </controls:SettingsCard>

            <oneMmcControls:StableSettingsExpander
                Description="{x:Bind local:LocalizedStrings.Instance.WF_FirewallProperties_IcmpExemptionsDescription}"
                Header="{x:Bind local:LocalizedStrings.Instance.WF_WindowsFirewallProperties_IPsecExemptions}"
                HeaderIcon="{ui:FontIcon Glyph=&#xE9D5;}"
                IsExpanded="True">

                <oneMmcControls:StableSettingsExpander.Items>
                    <controls:SettingsCard Header="{x:Bind local:LocalizedStrings.Instance.WF_WindowsFirewallProperties_ExemptICMPFromIPsec}">
                        <ComboBox
                            x:Name="IcmpExemptionComboBox"
                            MinWidth="160"
                            SelectedIndex="1"
                            SelectionChanged="IcmpExemptionComboBox_SelectionChanged">
                            <ComboBoxItem Content="{x:Bind local:LocalizedStrings.Instance.WF_Common_Yes}" Tag="Yes" />
                            <ComboBoxItem Content="{x:Bind local:LocalizedStrings.Instance.WF_Common_NoDefault}" Tag="No (default)" />
                        </ComboBox>
                    </controls:SettingsCard>
                </oneMmcControls:StableSettingsExpander.Items>
            </oneMmcControls:StableSettingsExpander>

            <oneMmcControls:StableSettingsExpander
                Description="{x:Bind local:LocalizedStrings.Instance.WF_FirewallProperties_TunnelAuthorizationDescription}"
                Header="{x:Bind local:LocalizedStrings.Instance.WF_Common_IPsecTunnelAuthorization}"
                HeaderIcon="{ui:FontIcon Glyph=&#xF32A;}"
                IsExpanded="True">

                <oneMmcControls:StableSettingsExpander.Items>
                    <controls:SettingsCard
                        x:Name="TunnelAuthorizationSettingsCard"
                        Header="{x:Bind local:LocalizedStrings.Instance.WF_Common_IPsecTunnelAuthorization}">
                        <Button
                            x:Name="CustomizeTunnelAuthorizationButton"
                            MinWidth="110"
                            Click="TunnelAuthorizationCustomizeButton_Click"
                            Content="{x:Bind local:LocalizedStrings.Instance.WF_Button_Customize}" />
                    </controls:SettingsCard>
                </oneMmcControls:StableSettingsExpander.Items>
            </oneMmcControls:StableSettingsExpander>
        </StackPanel>
    </ScrollViewer>
</Page>
