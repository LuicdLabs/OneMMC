<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="OneMMC.Views.FirewallRuleInfoPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:OneMMC.Localization"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:converters="using:OneMMC.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <converters:StringVisibilityConverter x:Key="StringVisibilityConverter" />
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  Predefined rule notice  -->
        <InfoBar
            x:Name="PredefinedRuleInfoBar"
            Grid.Row="0"
            IsClosable="False"
            IsOpen="False"
            Severity="Informational" />

        <!--  CommandBar  -->
        <CommandBar
            Grid.Row="1"
            HorizontalAlignment="Right"
            Background="Transparent"
            DefaultLabelPosition="Right">
            <AppBarButton
                x:Name="ApplyButton"
                Click="ApplyButton_Click"
                Icon="Save"
                Label="{x:Bind LocalizedStrings.WF_Rule_Apply}" />
            <AppBarButton x:Name="DisableButton" Click="DisableButton_Click">
                <AppBarButton.Icon>
                    <FontIcon Glyph="&#xE71A;" />
                </AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton Icon="More">
                <AppBarButton.Flyout>
                    <MenuFlyout>
                        <MenuFlyoutItem
                            x:Name="DeleteMenuItem"
                            Click="DeleteMenuItem_Click"
                            Text="{x:Bind LocalizedStrings.WF_DeleteRule}">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE74D;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                    </MenuFlyout>
                </AppBarButton.Flyout>
            </AppBarButton>
        </CommandBar>

        <!--  Content  -->
        <ScrollViewer x:Name="RuleEditorScrollViewer" Grid.Row="2">
            <StackPanel Padding="16,4,16,24" Spacing="4">

                <!--  ── General ──  -->
                <controls:SettingsCard Header="{x:Bind LocalizedStrings.WF_Section_General}">
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE713;" />
                    </controls:SettingsCard.HeaderIcon>
                    <controls:SettingsCard.Description>
                        <StackPanel Spacing="4">
                            <TextBlock
                                Text="{x:Bind Rule.DisplayName, Mode=OneWay}"
                                TextWrapping="WrapWholeWords" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind Rule.Description, Mode=OneWay}"
                                TextWrapping="WrapWholeWords"
                                Visibility="{x:Bind Rule.Description, Converter={StaticResource StringVisibilityConverter}, Mode=OneWay}" />
                        </StackPanel>
                    </controls:SettingsCard.Description>
                    <Button
                        MinWidth="120"
                        Click="GeneralEditButton_Click"
                        Content="{x:Bind LocalizedStrings.Common_EditButton}" />
                </controls:SettingsCard>

                <!--  ── Action ──  -->
                <controls:SettingsExpander
                    x:Name="ActionExpander"
                    Margin="0,4,0,0"
                    IsExpanded="True">
                    <controls:SettingsExpander.Header>
                        <TextBlock Text="{x:Bind LocalizedStrings.WF_Section_Action}" />
                    </controls:SettingsExpander.Header>
                    <controls:SettingsExpander.HeaderIcon>
                        <FontIcon Glyph="&#xE9F5;" />
                    </controls:SettingsExpander.HeaderIcon>
                    <controls:SettingsExpander.Items>
                        <controls:SettingsCard Header="{x:Bind LocalizedStrings.WF_Action_ConnectionAction}">
                            <ComboBox
                                x:Name="ConnectionActionBox"
                                MinWidth="260"
                                SelectionChanged="ConnectionActionBox_SelectionChanged">
                                <ComboBoxItem Content="{x:Bind LocalizedStrings.WF_Action_Allow}" Tag="Allow" />
                                <ComboBoxItem Content="{x:Bind LocalizedStrings.WF_Action_AllowIfSecure}" Tag="AllowIfSecure" />
                                <ComboBoxItem Content="{x:Bind LocalizedStrings.WF_Action_Block}" Tag="Block" />
                            </ComboBox>
                        </controls:SettingsCard>
                        <controls:SettingsCard
                            x:Name="CustomizeAllowSecureCard"
                            Header="{x:Bind LocalizedStrings.WF_Action_CustomizeAllowSecure}"
                            Visibility="Collapsed">
                            <Button
                                MinWidth="120"
                                Click="CustomizeAllowSecureButton_Click"
                                Content="{x:Bind LocalizedStrings.WF_Button_Customize}" />
                        </controls:SettingsCard>
                    </controls:SettingsExpander.Items>
                </controls:SettingsExpander>

                <!--  ── Programs & Services ──  -->
                <TextBlock
                    x:Name="ProgramsServicesLabel"
                    Margin="4,12,0,4"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Text="{x:Bind LocalizedStrings.WF_Section_ProgramsServices}" />

                <controls:SettingsExpander x:Name="ProgramsServicesExpander1" IsExpanded="True">
                    <controls:SettingsExpander.Header>
                        <TextBlock Text="{x:Bind LocalizedStrings.WF_ProgramsServices_SpecifiedConditions}" />
                    </controls:SettingsExpander.Header>
                    <controls:SettingsExpander.HeaderIcon>
                        <FontIcon Glyph="&#xEB3B;" />
                    </controls:SettingsExpander.HeaderIcon>
                    <controls:SettingsExpander.Items>
                        <controls:SettingsCard Header="{x:Bind LocalizedStrings.WF_Field_Program}">
                            <controls:SettingsCard.Description>
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{x:Bind Rule.Program, Mode=OneWay}"
                                    Visibility="{x:Bind Rule.Program, Converter={StaticResource StringVisibilityConverter}, Mode=OneWay}" />
                            </controls:SettingsCard.Description>
                            <ComboBox
                                x:Name="ProgramComboBox"
                                MinWidth="400"
                                SelectionChanged="ProgramComboBox_SelectionChanged">
                                <ComboBoxItem Content="{x:Bind LocalizedStrings.WF_Program_AllPrograms}" Tag="All" />
                                <ComboBoxItem Content="{x:Bind LocalizedStrings.WF_Program_ThisProgram}" Tag="This" />
                            </ComboBox>
                        </controls:SettingsCard>
                        <controls:SettingsCard
                            x:Name="ProgramPathCard"
                            Header="{x:Bind LocalizedStrings.WF_Field_Program}"
                            Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBox
                                    x:Name="ProgramPathBox"
                                    MinWidth="273"
                                    MaxWidth="273"
                                    PlaceholderText="{x:Bind LocalizedStrings.WF_Program_PathPlaceholder}"
                                    Text="{x:Bind Rule.Program, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <Button
                                    x:Name="ProgramBrowseButton"
                                    MinWidth="120"
                                    Click="ProgramBrowseButton_Click"
                                    Content="{x:Bind LocalizedStrings.WF_Program_Browse}" />
                            </StackPanel>
                        </controls:SettingsCard>
                        <controls:SettingsCard Header="{x:Bind LocalizedStrings.WF_Field_Compartments}">
                            <ComboBox
                                x:Name="CompartmentsBox"
                                MinWidth="400"
                                SelectionChanged="CompartmentsBox_SelectionChanged">
                                <ComboBoxItem Content="{x:Bind LocalizedStrings.WF_Compartments_All}" Tag="All" />
                                <ComboBoxItem Content="{x:Bind LocalizedStrings.WF_Compartments_This}" Tag="This" />
                            </ComboBox>
                        </controls:SettingsCard>
                        <controls:SettingsCard
                            x:Name="CompartmentInputCard"
                            Header="{x:Bind LocalizedStrings.WF_Field_Compartments}"
                            Visibility="Collapsed">
                            <TextBox
                                x:Name="CompartmentInputBox"
                                MinWidth="400"
                                Text="{x:Bind Rule.Compartments, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </controls:SettingsCard>
                    </controls:SettingsExpander.Items>
                </controls:SettingsExpander>

                <controls:SettingsExpander
                    x:Name="ProgramsServicesExpander2"
                    Margin="0,4,0,0"
                    IsExpanded="True">
                    <controls:SettingsExpander.Header>
                        <TextBlock Text="{x:Bind LocalizedStrings.WF_ProgramsServices_RuleApplies}" />
                    </controls:SettingsExpander.Header>
                    <controls:SettingsExpander.HeaderIcon>
                        <FontIcon Glyph="&#xEA86;" />
                    </controls:SettingsExpander.HeaderIcon>
                    <controls:SettingsExpander.Items>
                        <controls:SettingsCard Header="{x:Bind LocalizedStrings.WF_Field_ApplicationPackages}">
                            <Button
                                MinWidth="120"
                                Click="ApplicationPackagesButton_Click"
                                Content="{x:Bind LocalizedStrings.WF_Button_Specify}" />
                        </controls:SettingsCard>
                        <controls:SettingsCard Header="{x:Bind LocalizedStrings.WF_Field_Services}">
                            <Button
                                MinWidth="120"
                                Click="ServicesButton_Click"
                                Content="{x:Bind LocalizedStrings.WF_Button_Specify}" />
                        </controls:SettingsCard>
                    </controls:SettingsExpander.Items>
                </controls:SettingsExpander>

                <!--  ── Remote Computers (Inbound + Outbound) / Remote Endpoints (Connection Security) ──  -->
                <TextBlock
                    x:Name="RemoteComputersLabel"
                    Margin="4,12,0,4"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Text="{x:Bind LocalizedStrings.WF_Section_RemoteComputers}" />

                <!--  Standard rules: Manage Authorized computers  -->
                <controls:SettingsCard x:Name="RemoteComputersCard" Header="{x:Bind LocalizedStrings.WF_RemoteComputers_Manage}">
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE7F4;" />
                    </controls:SettingsCard.HeaderIcon>
                    <Button
                        MinWidth="120"
                        Click="RemoteComputersManageButton_Click"
                        Content="{x:Bind LocalizedStrings.WF_Button_Manage}" />
                </controls:SettingsCard>

                <!--  Connection Security Rules: Manage remote endpoints  -->
                <controls:SettingsCard
                    x:Name="CsrRemoteEndpointsCard"
                    Header="{x:Bind LocalizedStrings.WF_CSR_RemoteEndpoints_Manage}"
                    Visibility="Collapsed">
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE7F4;" />
                    </controls:SettingsCard.HeaderIcon>
                    <Button
                        MinWidth="120"
                        Click="CsrRemoteEndpointsManageButton_Click"
                        Content="{x:Bind LocalizedStrings.WF_Button_Manage}" />
                </controls:SettingsCard>

                <!--  ── Protocols and ports ──  -->
                <TextBlock
                    x:Name="ProtocolsPortsLabel"
                    Margin="4,12,0,4"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Text="{x:Bind LocalizedStrings.WF_Section_ProtocolsPorts}" />

                <!--  Standard rules: Protocols and ports  -->
                <controls:SettingsExpander x:Name="StandardProtocolsExpander" IsExpanded="True">
                    <controls:SettingsExpander.Header>
                        <TextBlock Text="{x:Bind LocalizedStrings.WF_Section_ProtocolsPorts}" />
                    </controls:SettingsExpander.Header>
                    <controls:SettingsExpander.HeaderIcon>
                        <FontIcon Glyph="&#xE839;" />
                    </controls:SettingsExpander.HeaderIcon>
                    <controls:SettingsExpander.Items>
                        <controls:SettingsCard Header="{x:Bind LocalizedStrings.WF_Protocol_Type}">
                            <ComboBox
                                x:Name="ProtocolTypeBox"
                                MinWidth="160"
                                SelectionChanged="ProtocolTypeBox_SelectionChanged">
                                <ComboBoxItem Content="{x:Bind local:LocalizedStrings.Instance.WF_Common_Any}" Tag="Any" />
                                <ComboBoxItem Content="{x:Bind local:LocalizedStrings.Instance.WF_Common_Custom}" Tag="Custom" />
                                <ComboBoxItem Content="{x:Bind local:LocalizedStrings.Instance.WF_FirewallRuleInfo_HOPOPT0}" Tag="HOPOPT" />
                                <ComboBoxItem Content="{x:Bind local:LocalizedStrings.Instance.WF_FirewallRuleInfo_ICMPv41}" Tag="ICMPv4" />
                                <ComboBoxItem Content="{x:Bind local:LocalizedStrings.Instance.WF_FirewallRuleInfo_IGMP2}" Tag="IGMP" />
                                <ComboBoxItem Content="{x:Bind local:LocalizedStrings.Instance.WF_FirewallRuleInfo_TCP6}" Tag="TCP" />
                                <ComboBoxItem Content="{x:Bind local:LocalizedStrings.Instance.WF_FirewallRuleInfo_UDP17}" Tag="UDP" />
                                <ComboBoxItem Content="{x:Bind local:LocalizedStrings.Instance.WF_FirewallRuleInfo_IPv641}" Tag="IPv6" />
                                <ComboBoxItem Content="{x:Bind local:LocalizedStrings.Instance.WF_FirewallRuleInfo_IPv6Route43}" Tag="IPv6Route" />
                                <ComboBoxItem Content="{x:Bind local:LocalizedStrings.Instance.WF_FirewallRuleInfo_IPv6Frag44}" Tag="IPv6Frag" />
                                <ComboBoxItem Content="{x:Bind local:LocalizedStrings.Instance.WF_FirewallRuleInfo_GRE47}" Tag="GRE" />
                                <ComboBoxItem Content="{x:Bind local:LocalizedStrings.Instance.WF_FirewallRuleInfo_ICMPv658}" Tag="ICMPv6" />
                                <ComboBoxItem Content="{x:Bind local:LocalizedStrings.Instance.WF_FirewallRuleInfo_IPv6NoNxt59}" Tag="IPv6NoNxt" />
                                <ComboBoxItem Content="{x:Bind local:LocalizedStrings.Instance.WF_FirewallRuleInfo_IPv6Opts60}" Tag="IPv6Opts" />
                                <ComboBoxItem Content="{x:Bind local:LocalizedStrings.Instance.WF_FirewallRuleInfo_VRRP112}" Tag="VRRP" />
                                <ComboBoxItem Content="{x:Bind local:LocalizedStrings.Instance.WF_FirewallRuleInfo_PGM113}" Tag="PGM" />
                                <ComboBoxItem Content="{x:Bind local:LocalizedStrings.Instance.WF_FirewallRuleInfo_L2TP115}" Tag="L2TP" />
                            </ComboBox>
                        </controls:SettingsCard>
                        <controls:SettingsCard Header="{x:Bind LocalizedStrings.WF_Protocol_Number}">
                            <NumberBox
                                x:Name="ProtocolNumberBox"
                                MinWidth="160"
                                IsEnabled="False"
                                Maximum="256"
                                Minimum="0"
                                ValueChanged="ProtocolNumberBox_ValueChanged"
                                Value="{x:Bind Rule.ProtocolNumber, Mode=OneWay}" />
                        </controls:SettingsCard>
                        <controls:SettingsCard Header="{x:Bind LocalizedStrings.WF_Field_LocalPort}">
                            <ComboBox
                                x:Name="LocalPortOptionBox"
                                MinWidth="160"
                                SelectionChanged="LocalPortOptionBox_SelectionChanged">
                                <ComboBoxItem Content="{x:Bind LocalizedStrings.WF_Port_AllPorts}" Tag="AllPorts" />
                                <ComboBoxItem Content="{x:Bind LocalizedStrings.WF_Port_SpecificPorts}" Tag="SpecificPorts" />
                            </ComboBox>
                        </controls:SettingsCard>
                        <controls:SettingsCard
                            x:Name="LocalPortInputCard"
                            Header="{x:Bind LocalizedStrings.WF_Port_InputLocalPort}"
                            Visibility="Collapsed">
                            <TextBox
                                x:Name="LocalPortInputBox"
                                MinWidth="160"
                                PlaceholderText="{x:Bind local:LocalizedStrings.Instance.WF_FirewallRuleInfo_EG8044380808090}"
                                Text="{x:Bind Rule.LocalPort, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </controls:SettingsCard>
                        <controls:SettingsCard Header="{x:Bind LocalizedStrings.WF_Field_RemotePort}">
                            <ComboBox
                                x:Name="RemotePortOptionBox"
                                MinWidth="160"
                                SelectionChanged="RemotePortOptionBox_SelectionChanged">
                                <ComboBoxItem Content="{x:Bind LocalizedStrings.WF_Port_AllPorts}" Tag="AllPorts" />
                                <ComboBoxItem Content="{x:Bind LocalizedStrings.WF_Port_SpecificPorts}" Tag="SpecificPorts" />
                            </ComboBox>
                        </controls:SettingsCard>
                        <controls:SettingsCard
                            x:Name="RemotePortInputCard"
                            Header="{x:Bind LocalizedStrings.WF_Port_InputRemotePort}"
                            Visibility="Collapsed">
                            <TextBox
                                x:Name="RemotePortInputBox"
                                MinWidth="160"
                                PlaceholderText="{x:Bind local:LocalizedStrings.Instance.WF_FirewallRuleInfo_EG80443}"
                                Text="{x:Bind Rule.RemotePort, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </controls:SettingsCard>
                        <controls:SettingsCard Header="{x:Bind LocalizedStrings.WF_Protocol_ICMP}">
                            <Button
                                x:Name="ICMPCustomizeButton"
                                MinWidth="120"
                                Click="ICMPCustomizeButton_Click"
                                Content="{x:Bind LocalizedStrings.WF_Button_Customize}"
                                IsEnabled="False" />
                        </controls:SettingsCard>
                    </controls:SettingsExpander.Items>
                </controls:SettingsExpander>

                <!--  Connection Security Rules: Protocols and ports (Endpoint 1/2 ports, no ICMP)  -->
                <controls:SettingsExpander
                    x:Name="CsrProtocolsExpander"
                    IsExpanded="True"
                    Visibility="Collapsed">
                    <controls:SettingsExpander.Header>
                        <TextBlock Text="{x:Bind LocalizedStrings.WF_Section_ProtocolsPorts}" />
                    </controls:SettingsExpander.Header>
                    <controls:SettingsExpander.HeaderIcon>
                        <FontIcon Glyph="&#xE839;" />
                    </controls:SettingsExpander.HeaderIcon>
                    <controls:SettingsExpander.Items>
                        <controls:SettingsCard Header="{x:Bind LocalizedStrings.WF_Protocol_Type}">
                            <ComboBox
                                x:Name="CsrProtocolTypeBox"
                                MinWidth="200"
                                SelectionChanged="CsrProtocolTypeBox_SelectionChanged">
                                <ComboBoxItem Content="{x:Bind local:LocalizedStrings.Instance.WF_Common_Any}" Tag="256" />
                                <ComboBoxItem Content="{x:Bind local:LocalizedStrings.Instance.WF_Common_Custom}" Tag="-1" />
                                <ComboBoxItem Content="{x:Bind local:LocalizedStrings.Instance.WF_FirewallRuleInfo_HOPOPT0}" Tag="0" />
                                <ComboBoxItem Content="{x:Bind local:LocalizedStrings.Instance.WF_FirewallRuleInfo_ICMPv41}" Tag="1" />
                                <ComboBoxItem Content="{x:Bind local:LocalizedStrings.Instance.WF_FirewallRuleInfo_IGMP2}" Tag="2" />
                                <ComboBoxItem Content="{x:Bind local:LocalizedStrings.Instance.WF_FirewallRuleInfo_TCP6}" Tag="6" />
                                <ComboBoxItem Content="{x:Bind local:LocalizedStrings.Instance.WF_FirewallRuleInfo_UDP17}" Tag="17" />
                                <ComboBoxItem Content="{x:Bind local:LocalizedStrings.Instance.WF_FirewallRuleInfo_IPv641}" Tag="41" />
                                <ComboBoxItem Content="{x:Bind local:LocalizedStrings.Instance.WF_FirewallRuleInfo_IPv6Route43}" Tag="43" />
                                <ComboBoxItem Content="{x:Bind local:LocalizedStrings.Instance.WF_FirewallRuleInfo_IPv6Frag44}" Tag="44" />
                                <ComboBoxItem Content="{x:Bind local:LocalizedStrings.Instance.WF_FirewallRuleInfo_GRE47}" Tag="47" />
                                <ComboBoxItem Content="{x:Bind local:LocalizedStrings.Instance.WF_FirewallRuleInfo_ICMPv658}" Tag="58" />
                                <ComboBoxItem Content="{x:Bind local:LocalizedStrings.Instance.WF_FirewallRuleInfo_IPv6NoNxt59}" Tag="59" />
                                <ComboBoxItem Content="{x:Bind local:LocalizedStrings.Instance.WF_FirewallRuleInfo_IPv6Opts60}" Tag="60" />
                                <ComboBoxItem Content="{x:Bind local:LocalizedStrings.Instance.WF_FirewallRuleInfo_VRRP112}" Tag="112" />
                                <ComboBoxItem Content="{x:Bind local:LocalizedStrings.Instance.WF_FirewallRuleInfo_PGM113}" Tag="113" />
                                <ComboBoxItem Content="{x:Bind local:LocalizedStrings.Instance.WF_FirewallRuleInfo_L2TP115}" Tag="115" />
                            </ComboBox>
                        </controls:SettingsCard>
                        <controls:SettingsCard Header="{x:Bind LocalizedStrings.WF_Protocol_Number}">
                            <NumberBox
                                x:Name="CsrProtocolNumberBox"
                                MinWidth="160"
                                IsEnabled="False"
                                Maximum="255"
                                Minimum="0"
                                ValueChanged="CsrProtocolNumberBox_ValueChanged"
                                Value="{x:Bind Rule.ProtocolNumber, Mode=OneWay}" />
                        </controls:SettingsCard>
                        <controls:SettingsCard Header="{x:Bind LocalizedStrings.WF_CSR_Endpoint1Port}">
                            <ComboBox
                                x:Name="CsrEndpoint1PortBox"
                                MinWidth="160"
                                SelectionChanged="CsrEndpoint1PortBox_SelectionChanged">
                                <ComboBoxItem Content="{x:Bind LocalizedStrings.WF_Port_AllPorts}" Tag="AllPorts" />
                                <ComboBoxItem Content="{x:Bind LocalizedStrings.WF_Port_SpecificPorts}" Tag="SpecificPorts" />
                            </ComboBox>
                        </controls:SettingsCard>
                        <controls:SettingsCard
                            x:Name="CsrEndpoint1PortInputCard"
                            Header="{x:Bind LocalizedStrings.WF_CSR_Endpoint1Port_Input}"
                            Visibility="Collapsed">
                            <TextBox
                                x:Name="CsrEndpoint1PortInputBox"
                                MinWidth="160"
                                PlaceholderText="{x:Bind local:LocalizedStrings.Instance.WF_FirewallRuleInfo_EG80443}"
                                Text="{x:Bind Rule.LocalPort, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </controls:SettingsCard>
                        <controls:SettingsCard Header="{x:Bind LocalizedStrings.WF_CSR_Endpoint2Port}">
                            <ComboBox
                                x:Name="CsrEndpoint2PortBox"
                                MinWidth="160"
                                SelectionChanged="CsrEndpoint2PortBox_SelectionChanged">
                                <ComboBoxItem Content="{x:Bind LocalizedStrings.WF_Port_AllPorts}" Tag="AllPorts" />
                                <ComboBoxItem Content="{x:Bind LocalizedStrings.WF_Port_SpecificPorts}" Tag="SpecificPorts" />
                            </ComboBox>
                        </controls:SettingsCard>
                        <controls:SettingsCard
                            x:Name="CsrEndpoint2PortInputCard"
                            Header="{x:Bind LocalizedStrings.WF_CSR_Endpoint2Port_Input}"
                            Visibility="Collapsed">
                            <TextBox
                                x:Name="CsrEndpoint2PortInputBox"
                                MinWidth="160"
                                PlaceholderText="{x:Bind local:LocalizedStrings.Instance.WF_FirewallRuleInfo_EG80443}"
                                Text="{x:Bind Rule.RemotePort, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </controls:SettingsCard>
                    </controls:SettingsExpander.Items>
                </controls:SettingsExpander>

                <!--  ── Scope ──  -->
                <TextBlock
                    x:Name="ScopeLabel"
                    Margin="4,12,0,4"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Text="{x:Bind LocalizedStrings.WF_Section_Scope}" />

                <controls:SettingsCard x:Name="ScopeCard" Header="{x:Bind LocalizedStrings.WF_Scope_ManageIPAddress}">
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xEDA3;" />
                    </controls:SettingsCard.HeaderIcon>
                    <Button
                        MinWidth="120"
                        Click="ScopeManageButton_Click"
                        Content="{x:Bind LocalizedStrings.WF_Button_Manage}" />
                </controls:SettingsCard>

                <!--  ── Authentication (Connection Security Rules only) ──  -->
                <TextBlock
                    x:Name="VerificationLabel"
                    Margin="4,12,0,4"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Text="{x:Bind LocalizedStrings.WF_Section_Authentication}"
                    Visibility="Collapsed" />

                <controls:SettingsCard
                    x:Name="VerificationModeCard"
                    Header="{x:Bind LocalizedStrings.WF_CSR_AuthenticationMode}"
                    Visibility="Collapsed">
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE72E;" />
                    </controls:SettingsCard.HeaderIcon>
                    <ComboBox
                        x:Name="VerificationModeBox"
                        MinWidth="300"
                        SelectionChanged="VerificationModeBox_SelectionChanged">
                        <ComboBoxItem Content="{x:Bind LocalizedStrings.WF_CSR_AuthMode_DoNotAuthenticate}" Tag="DoNotAuthenticate" />
                        <ComboBoxItem Content="{x:Bind LocalizedStrings.WF_CSR_AuthMode_RequestInboundOutbound}" Tag="RequestInboundOutbound" />
                        <ComboBoxItem Content="{x:Bind LocalizedStrings.WF_CSR_AuthMode_RequireInboundRequestOutbound}" Tag="RequireInboundRequestOutbound" />
                        <ComboBoxItem Content="{x:Bind LocalizedStrings.WF_CSR_AuthMode_RequireInboundOutbound}" Tag="RequireInboundOutbound" />
                        <ComboBoxItem Content="{x:Bind LocalizedStrings.WF_CSR_AuthMode_RequireInboundClearOutbound}" Tag="RequireInboundClearOutbound" />
                    </ComboBox>
                </controls:SettingsCard>

                <controls:SettingsExpander
                    x:Name="VerificationMethodsExpander"
                    Margin="0,4,0,0"
                    IsExpanded="True"
                    Visibility="Collapsed">
                    <controls:SettingsExpander.Header>
                        <TextBlock Text="{x:Bind LocalizedStrings.WF_CSR_Section_Methods}" />
                    </controls:SettingsExpander.Header>
                    <controls:SettingsExpander.HeaderIcon>
                        <FontIcon Glyph="&#xE8D7;" />
                    </controls:SettingsExpander.HeaderIcon>
                    <controls:SettingsExpander.Items>
                        <controls:SettingsCard Header="{x:Bind LocalizedStrings.WF_CSR_AuthenticationMethod}">
                            <Grid MinWidth="420" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <RadioButtons
                                    x:Name="VerificationMethodsRadioButtons"
                                    MaxColumns="1"
                                    SelectionChanged="VerificationMethodsRadioButtons_SelectionChanged">
                                    <RadioButton Content="{x:Bind LocalizedStrings.WF_CSR_AuthMethod_Default}" />
                                    <RadioButton Content="{x:Bind LocalizedStrings.WF_CSR_AuthMethod_ComputerAndUser}" />
                                    <RadioButton Content="{x:Bind LocalizedStrings.WF_CSR_AuthMethod_Computer}" />
                                    <RadioButton Content="{x:Bind LocalizedStrings.WF_CSR_AuthMethod_User}" />
                                    <RadioButton Content="{x:Bind LocalizedStrings.WF_CSR_AuthMethod_Advanced}" />
                                </RadioButtons>
                                <Button
                                    x:Name="CustomizeMethodsButton"
                                    Grid.Column="1"
                                    MinWidth="120"
                                    VerticalAlignment="Bottom"
                                    Click="CustomizeAuthMethodsButton_Click"
                                    Content="{x:Bind LocalizedStrings.WF_Button_Customize}"
                                    IsEnabled="False" />
                            </Grid>
                        </controls:SettingsCard>
                    </controls:SettingsExpander.Items>
                </controls:SettingsExpander>

                <!--  ── Advanced ──  -->
                <TextBlock
                    Margin="4,12,0,4"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Text="{x:Bind LocalizedStrings.WF_Section_Advanced}" />

                <!--  Profiles expander  -->
                <controls:SettingsExpander IsExpanded="True">
                    <controls:SettingsExpander.Header>
                        <TextBlock Text="{x:Bind LocalizedStrings.WF_Advanced_Profiles}" />
                    </controls:SettingsExpander.Header>
                    <controls:SettingsExpander.HeaderIcon>
                        <FontIcon Glyph="&#xE7C3;" />
                    </controls:SettingsExpander.HeaderIcon>
                    <controls:SettingsExpander.Items>
                        <controls:SettingsCard>
                            <controls:SettingsCard.Description>
                                <StackPanel Spacing="12">
                                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind LocalizedStrings.WF_Advanced_ProfilesDescription}" />
                                    <CheckBox Content="{x:Bind LocalizedStrings.WF_Profile_Domain}" IsChecked="{x:Bind Rule.ProfileDomain, Mode=TwoWay}" />
                                    <CheckBox Content="{x:Bind LocalizedStrings.WF_Profile_Private}" IsChecked="{x:Bind Rule.ProfilePrivate, Mode=TwoWay}" />
                                    <CheckBox Content="{x:Bind LocalizedStrings.WF_Profile_Public}" IsChecked="{x:Bind Rule.ProfilePublic, Mode=TwoWay}" />
                                </StackPanel>
                            </controls:SettingsCard.Description>
                        </controls:SettingsCard>
                    </controls:SettingsExpander.Items>
                </controls:SettingsExpander>

                <!--  Interface types  -->
                <controls:SettingsCard
                    x:Name="InterfaceTypesCard"
                    Margin="0,4,0,0"
                    Header="{x:Bind LocalizedStrings.WF_Advanced_InterfaceTypes}">
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xF211;" />
                    </controls:SettingsCard.HeaderIcon>
                    <Button
                        x:Name="InterfaceTypesButton"
                        MinWidth="120"
                        Click="InterfaceTypesButton_Click"
                        Content="{x:Bind LocalizedStrings.WF_Button_Specify}" />
                </controls:SettingsCard>

                <!--  Configure IPsec channel (Connection Security Rules only)  -->
                <controls:SettingsCard
                    x:Name="ConfigureIPsecCard"
                    Margin="0,4,0,0"
                    Header="{x:Bind LocalizedStrings.WF_CSR_ConfigureIPsec}"
                    Visibility="Collapsed">
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE968;" />
                    </controls:SettingsCard.HeaderIcon>
                    <Button
                        MinWidth="120"
                        Click="ConfigureIPsecButton_Click"
                        Content="{x:Bind LocalizedStrings.WF_Button_Configure}" />
                </controls:SettingsCard>

                <!--  Edge traversal (Inbound only)  -->
                <controls:SettingsExpander
                    x:Name="EdgeTraversalExpander"
                    Margin="0,4,0,0"
                    IsExpanded="True"
                    Visibility="Collapsed">
                    <controls:SettingsExpander.Header>
                        <TextBlock Text="{x:Bind LocalizedStrings.WF_Advanced_EdgeTraversal}" />
                    </controls:SettingsExpander.Header>
                    <controls:SettingsExpander.Description>
                        <TextBlock Text="{x:Bind LocalizedStrings.WF_Advanced_EdgeTraversalDescription}" TextWrapping="Wrap" />
                    </controls:SettingsExpander.Description>
                    <controls:SettingsExpander.HeaderIcon>
                        <FontIcon Glyph="&#xE839;" />
                    </controls:SettingsExpander.HeaderIcon>
                    <controls:SettingsExpander.Items>
                        <controls:SettingsCard Header="{x:Bind LocalizedStrings.WF_Advanced_EdgeTraversalType}">
                            <ComboBox
                                x:Name="EdgeTraversalBox"
                                MinWidth="180"
                                SelectionChanged="EdgeTraversalBox_SelectionChanged">
                                <ComboBoxItem Content="{x:Bind LocalizedStrings.WF_EdgeTraversal_Block}" Tag="Block" />
                                <ComboBoxItem Content="{x:Bind LocalizedStrings.WF_EdgeTraversal_Allow}" Tag="Allow" />
                                <ComboBoxItem Content="{x:Bind LocalizedStrings.WF_EdgeTraversal_DeferToUser}" Tag="DeferToUser" />
                                <ComboBoxItem Content="{x:Bind LocalizedStrings.WF_EdgeTraversal_DeferToApp}" Tag="DeferToApp" />
                            </ComboBox>
                        </controls:SettingsCard>
                        <controls:SettingsCard x:Name="EdgeTraversalDescCard">
                            <controls:SettingsCard.Description>
                                <TextBlock x:Name="EdgeTraversalDescText" TextWrapping="Wrap" />
                            </controls:SettingsCard.Description>
                        </controls:SettingsCard>
                    </controls:SettingsExpander.Items>
                </controls:SettingsExpander>

                <!--  ── Local Principals (Inbound only) ──  -->
                <TextBlock
                    x:Name="LocalPrincipalsLabel"
                    Margin="4,12,0,4"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Text="{x:Bind LocalizedStrings.WF_Section_LocalPrincipals}"
                    Visibility="Collapsed" />

                <controls:SettingsCard
                    x:Name="LocalPrincipalsCard"
                    Header="{x:Bind LocalizedStrings.WF_LocalPrincipals_Manage}"
                    Visibility="Collapsed">
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE716;" />
                    </controls:SettingsCard.HeaderIcon>
                    <Button
                        MinWidth="120"
                        Click="LocalPrincipalsManageButton_Click"
                        Content="{x:Bind LocalizedStrings.WF_Button_Manage}" />
                </controls:SettingsCard>

                <!--  ── Remote Users (Inbound only) ──  -->
                <TextBlock
                    x:Name="RemoteUsersLabel"
                    Margin="4,12,0,4"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Text="{x:Bind LocalizedStrings.WF_Section_RemoteUsers}"
                    Visibility="Collapsed" />

                <controls:SettingsCard
                    x:Name="RemoteUsersCard"
                    Header="{x:Bind LocalizedStrings.WF_RemoteUsers_Manage}"
                    Visibility="Collapsed">
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE716;" />
                    </controls:SettingsCard.HeaderIcon>
                    <Button
                        MinWidth="120"
                        Click="RemoteUsersManageButton_Click"
                        Content="{x:Bind LocalizedStrings.WF_Button_Manage}" />
                </controls:SettingsCard>

            </StackPanel>
        </ScrollViewer>

        <Grid
            x:Name="ApplyProgressOverlay"
            Grid.RowSpan="3"
            Visibility="Collapsed"
            Background="Transparent">
            <ProgressBar
                Margin="16,16,16,0"
                VerticalAlignment="Top"
                AutomationProperties.Name="{x:Bind LocalizedStrings.WF_Rule_Apply}"
                IsIndeterminate="True" />
        </Grid>
    </Grid>
</Page>
