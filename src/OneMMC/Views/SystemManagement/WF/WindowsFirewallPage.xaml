<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="OneMMC.Views.WindowsFirewallPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:OneMMC.Localization"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <local:LocalizedStrings x:Key="LocalizedStrings" />
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  CommandBar  -->
        <CommandBar Grid.Row="0" DefaultLabelPosition="Right">
            <AppBarButton Click="RefreshButton_Click" Icon="Refresh" Label="Refresh" />
            <AppBarButton Icon="More">
                <AppBarButton.Flyout>
                    <MenuFlyout>
                        <MenuFlyoutItem
                            Click="RestoreDefaultsItem_Click"
                            Text="{Binding WF_WindowsFirewall_RestoreLocalDefaults, Source={StaticResource LocalizedStrings}}">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE777;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem
                            x:Name="OpenLegacyFirewallItem"
                            Click="OpenLegacyFirewallItem_Click"
                            Text="{Binding WF_OpenLegacyFirewall, Source={StaticResource LocalizedStrings}}">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE8A7;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                    </MenuFlyout>
                </AppBarButton.Flyout>
            </AppBarButton>
        </CommandBar>

        <!--  Main Content  -->
        <ScrollViewer Grid.Row="1">
            <StackPanel Padding="24,8,24,24" Spacing="4">

                <!--  Overview SettingsExpander  -->
                <controls:SettingsExpander Header="{Binding WF_WindowsFirewall_Overview, Source={StaticResource LocalizedStrings}}" IsExpanded="True">
                    <controls:SettingsExpander.HeaderIcon>
                        <FontIcon Glyph="&#xEB05;" />
                    </controls:SettingsExpander.HeaderIcon>

                    <controls:SettingsExpander.Items>
                        <controls:SettingsCard x:Name="DomainProfileCard" Padding="16,12" Header="{Binding WF_WindowsFirewall_DomainProfile, Source={StaticResource LocalizedStrings}}">
                            <controls:SettingsCard.Description>
                                <StackPanel Spacing="4">
                                    <TextBlock
                                        x:Name="DomainStatusText"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{Binding WF_WindowsFirewall_WindowsDefenderFirewallIsOn, Source={StaticResource LocalizedStrings}}"
                                        TextWrapping="Wrap" />
                                    <TextBlock
                                        x:Name="DomainInboundText"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{Binding WF_WindowsFirewall_InboundConnectionsThatDoNotMatchARuleAreBlocked, Source={StaticResource LocalizedStrings}}"
                                        TextWrapping="Wrap" />
                                    <TextBlock
                                        x:Name="DomainOutboundText"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{Binding WF_WindowsFirewall_OutboundConnectionsThatDoNotMatchARuleAreAllowed, Source={StaticResource LocalizedStrings}}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </controls:SettingsCard.Description>
                        </controls:SettingsCard>

                        <controls:SettingsCard x:Name="PrivateProfileCard" Padding="16,12" Header="{Binding WF_WindowsFirewall_PrivateProfile, Source={StaticResource LocalizedStrings}}">
                            <controls:SettingsCard.Description>
                                <StackPanel Spacing="4">
                                    <TextBlock
                                        x:Name="PrivateStatusText"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{Binding WF_WindowsFirewall_WindowsDefenderFirewallIsOn, Source={StaticResource LocalizedStrings}}"
                                        TextWrapping="Wrap" />
                                    <TextBlock
                                        x:Name="PrivateInboundText"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{Binding WF_WindowsFirewall_InboundConnectionsThatDoNotMatchARuleAreBlocked, Source={StaticResource LocalizedStrings}}"
                                        TextWrapping="Wrap" />
                                    <TextBlock
                                        x:Name="PrivateOutboundText"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{Binding WF_WindowsFirewall_OutboundConnectionsThatDoNotMatchARuleAreAllowed, Source={StaticResource LocalizedStrings}}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </controls:SettingsCard.Description>
                        </controls:SettingsCard>

                        <controls:SettingsCard x:Name="PublicProfileCard" Padding="16,12" Header="{Binding WF_WindowsFirewall_PublicProfile, Source={StaticResource LocalizedStrings}}">
                            <controls:SettingsCard.Description>
                                <StackPanel Spacing="4">
                                    <TextBlock
                                        x:Name="PublicStatusText"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{Binding WF_WindowsFirewall_WindowsDefenderFirewallIsOn, Source={StaticResource LocalizedStrings}}"
                                        TextWrapping="Wrap" />
                                    <TextBlock
                                        x:Name="PublicInboundText"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{Binding WF_WindowsFirewall_InboundConnectionsThatDoNotMatchARuleAreBlocked, Source={StaticResource LocalizedStrings}}"
                                        TextWrapping="Wrap" />
                                    <TextBlock
                                        x:Name="PublicOutboundText"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{Binding WF_WindowsFirewall_OutboundConnectionsThatDoNotMatchARuleAreAllowed, Source={StaticResource LocalizedStrings}}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </controls:SettingsCard.Description>
                        </controls:SettingsCard>
                    </controls:SettingsExpander.Items>
                </controls:SettingsExpander>

                <!--  Inbound rules SettingsCard  -->
                <controls:SettingsCard
                    x:Name="InboundRulesCard"
                    Click="InboundRulesCard_Click"
                    Description="{Binding WF_WindowsFirewall_InboundRulesDescription, Source={StaticResource LocalizedStrings}}"
                    Header="{Binding WF_InboundRules_PageTitle, Source={StaticResource LocalizedStrings}}"
                    IsClickEnabled="True">
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xEA4E;" />
                    </controls:SettingsCard.HeaderIcon>
                </controls:SettingsCard>

                <!--  Outbound rules SettingsCard  -->
                <controls:SettingsCard
                    x:Name="OutboundRulesCard"
                    Click="OutboundRulesCard_Click"
                    Description="{Binding WF_WindowsFirewall_OutboundRulesDescription, Source={StaticResource LocalizedStrings}}"
                    Header="{Binding WF_OutboundRules_PageTitle, Source={StaticResource LocalizedStrings}}"
                    IsClickEnabled="True">
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE976;" />
                    </controls:SettingsCard.HeaderIcon>
                </controls:SettingsCard>

                <!--  Connection security rules SettingsCard  -->
                <controls:SettingsCard
                    x:Name="ConnectionSecurityRulesCard"
                    Click="ConnectionSecurityRulesCard_Click"
                    Description="{Binding WF_WindowsFirewall_ConnectionSecurityRulesDescription, Source={StaticResource LocalizedStrings}}"
                    Header="{Binding WF_ConnectionSecurityRules_PageTitle, Source={StaticResource LocalizedStrings}}"
                    IsClickEnabled="True">
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xEDA3;" />
                    </controls:SettingsCard.HeaderIcon>
                </controls:SettingsCard>

                <!--  Monitoring SettingsCard  -->
                <controls:SettingsCard
                    x:Name="MonitoringCard"
                    Click="MonitoringCard_Click"
                    Description="{Binding WF_WindowsFirewall_MonitoringDescription, Source={StaticResource LocalizedStrings}}"
                    Header="{Binding WF_Monitoring_PageTitle, Source={StaticResource LocalizedStrings}}"
                    IsClickEnabled="True">
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE9D9;" />
                    </controls:SettingsCard.HeaderIcon>
                </controls:SettingsCard>

                <!--  Firewall properties SettingsCard  -->
                <controls:SettingsCard
                    x:Name="FirewallPropertiesCard"
                    Click="FirewallPropertiesCard_Click"
                    Description="{Binding WF_WindowsFirewall_PropertiesDescription, Source={StaticResource LocalizedStrings}}"
                    Header="{Binding WF_Common_WindowsDefenderFirewallProperties, Source={StaticResource LocalizedStrings}}"
                    IsClickEnabled="True">
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE713;" />
                    </controls:SettingsCard.HeaderIcon>
                </controls:SettingsCard>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
