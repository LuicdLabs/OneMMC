<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="OneMMC.Views.FirewallMonitoringPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  CommandBar  -->
        <CommandBar Grid.Row="0" DefaultLabelPosition="Right">
            <AppBarButton
                Click="RefreshButton_Click"
                Icon="Refresh"
                Label="{x:Bind LocalizedStrings.Common_Refresh}" />
            <AppBarButton
                Icon="More" />
        </CommandBar>

        <!--  Main Content  -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" MinWidth="200" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="300" />
            </Grid.ColumnDefinitions>

            <!--  Tree View  -->
            <TreeView
                x:Name="MonitoringTree"
                AllowDrop="False"
                CanDragItems="False"
                CanReorderItems="False"
                ItemInvoked="MonitoringTree_ItemInvoked"
                SelectionMode="Single">
                <TreeView.ItemTemplate>
                    <DataTemplate>
                        <Grid Height="30">
                            <TextBlock VerticalAlignment="Center" Text="{Binding Content.Name}" />
                        </Grid>
                    </DataTemplate>
                </TreeView.ItemTemplate>
            </TreeView>

            <controls:GridSplitter
                Grid.Column="1"
                Width="12"
                ResizeBehavior="BasedOnAlignment"
                ResizeDirection="Columns" />

            <!--  Details Panel  -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <AutoSuggestBox
                    x:Name="SearchBox"
                    Grid.Row="0"
                    Margin="12,8,12,4"
                    PlaceholderText="{x:Bind LocalizedStrings.Common_SearchPlaceholder}"
                    QueryIcon="Find"
                    TextChanged="SearchBox_TextChanged" />

                <!--  Details List  -->
                <ListView
                    x:Name="DetailsListView"
                    Grid.Row="1"
                    Padding="12"
                    SelectionMode="Single"
                    DoubleTapped="DetailsListView_DoubleTapped">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,8" Spacing="4">
                                <TextBlock Text="{Binding Name}" TextWrapping="Wrap" />
                                <TextBlock
                                    Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="{Binding Description}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>

            <!--  Loading Indicator  -->
            <ProgressRing
                x:Name="LoadingRing"
                Grid.Column="2"
                Width="50"
                Height="50"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                IsActive="False" />
        </Grid>
    </Grid>
</Page>
