<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="OneMMC.Views.FirewallRuleEditorPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:OneMMC.Localization"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:converters="using:OneMMC.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:wf="using:OneMMC.Core.Features.SystemManagement.Models.WF.Rules"
    mc:Ignorable="d">

    <Page.Resources>
        <local:LocalizedStrings x:Key="LocalizedStrings" />
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <converters:NullToBoolConverter x:Key="NullToBoolConverter" />
        <converters:StringVisibilityConverter x:Key="StringVisibilityConverter" />
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Toolbar: Search | Add  Refresh  ... -->
        <Grid Grid.Row="0" Padding="16,8" BorderThickness="0,0,0,1" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <AutoSuggestBox
                Grid.Column="0"
                MinWidth="300"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                PlaceholderText="{x:Bind LocalizedStrings.WF_SearchRules}"
                QueryIcon="Find"
                Text="{x:Bind ViewModel.FilterText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="0">
                <!-- Add -->
                <Button
                    x:Name="AddRuleButton"
                    Click="AddRuleButton_Click"
                    Style="{StaticResource SubtleButtonStyle}"
                    Padding="12,8">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon FontSize="14" Glyph="&#xE710;" />
                        <TextBlock Text="{x:Bind LocalizedStrings.WF_NewRule}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <!-- Refresh -->
                <Button
                    Command="{x:Bind ViewModel.RefreshCommand}"
                    Style="{StaticResource SubtleButtonStyle}"
                    Padding="12,8">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon FontSize="14" Glyph="&#xE72C;" />
                        <TextBlock Text="{x:Bind LocalizedStrings.Common_Refresh}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <!-- Separator -->
                <Rectangle Width="1" Margin="4,8" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

                <!-- More -->
                <Button Style="{StaticResource SubtleButtonStyle}" Padding="12,8">
                    <FontIcon FontSize="14" Glyph="&#xE712;" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- Rules list as SettingsCards -->
        <Grid Grid.Row="1">
            <ScrollViewer>
                <ItemsRepeater
                    x:Name="RulesRepeater"
                    Margin="16,12,16,24"
                    ItemsSource="{x:Bind ViewModel.FilteredRules, Mode=OneWay}">
                    <ItemsRepeater.Layout>
                        <StackLayout Spacing="4" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="wf:FirewallRuleModel">
                            <controls:SettingsCard
                                IsClickEnabled="True"
                                Click="RuleCard_Click"
                                Tag="{x:Bind}">

                                <!-- Rule name as header -->
                                <controls:SettingsCard.Header>
                                    <TextBlock Text="{x:Bind DisplayName, Mode=OneWay}" />
                                </controls:SettingsCard.Header>

                                <!-- Description: Show simple description for Connection Security, detailed for others -->
                                <controls:SettingsCard.Description>
                                    <TextBlock Text="{x:Bind DisplayDescription, Mode=OneWay}" />
                                </controls:SettingsCard.Description>

                                <!-- Toggle -->
                                <ToggleSwitch
                                    IsOn="{x:Bind Enabled, Mode=OneWay}"
                                    OnContent="{Binding WF_State_On, Source={StaticResource LocalizedStrings}}"
                                    OffContent="{Binding WF_State_Off, Source={StaticResource LocalizedStrings}}"
                                    MinWidth="0"
                                    Loaded="RuleToggle_Loaded"
                                    Toggled="RuleToggle_Toggled"
                                    Tag="{x:Bind}"
                                    Unloaded="RuleToggle_Unloaded" />

                            </controls:SettingsCard>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </ScrollViewer>

            <Grid
                IsHitTestVisible="True"
                Visibility="{x:Bind ViewModel.IsLoading, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}"
                Background="Transparent">
                <Grid.Transitions>
                    <TransitionCollection>
                        <EntranceThemeTransition FromVerticalOffset="12" />
                    </TransitionCollection>
                </Grid.Transitions>

                <ProgressBar
                    VerticalAlignment="Top"
                    AutomationProperties.Name="{x:Bind LocalizedStrings.WF_LoadingRules}"
                    IsIndeterminate="True" />
            </Grid>
        </Grid>
    </Grid>
</Page>
