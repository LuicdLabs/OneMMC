<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="OneMMC.Views.Dialogs.Scope.CapabilitiesFlyoutContent"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:OneMMC.Localization"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <UserControl.Resources>
    </UserControl.Resources>

    <StackPanel Width="320" Padding="12" Spacing="8">
        <TextBlock
            FontWeight="SemiBold"
            Text="{x:Bind local:LocalizedStrings.Instance.WF_Capabilities_ChooseCapabilities}" />
        <TextBlock
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Text="{x:Bind local:LocalizedStrings.Instance.WF_Capabilities_SelectTheApplicationPackageCapabilitiesToAuthorize}"
            TextWrapping="Wrap" />

        <Border
            Margin="0,4,0,0"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="4"
            MaxHeight="260">
            <ListView
                x:Name="CapabilitiesListView"
                ScrollViewer.VerticalScrollBarVisibility="Auto"
                ScrollViewer.VerticalScrollMode="Enabled"
                SelectionMode="Multiple" />
        </Border>

        <StackPanel
            HorizontalAlignment="Right"
            Orientation="Horizontal"
            Spacing="8">
            <Button
                x:Name="CancelButton"
                Content="{x:Bind local:LocalizedStrings.Instance.Common_CancelButton}"
                Click="CancelButton_Click" />
            <Button
                x:Name="OkButton"
                Content="{x:Bind local:LocalizedStrings.Instance.Common_OKButton}"
                Style="{StaticResource AccentButtonStyle}"
                Click="OkButton_Click" />
        </StackPanel>
    </StackPanel>
</UserControl>
