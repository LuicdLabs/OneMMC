<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="OneMMC.Views.Dialogs.Scope.PrincipalsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:OneMMC.Localization"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    PrimaryButtonText="{Binding Common_OKButton, Source={StaticResource LocalizedStrings}}"
    SecondaryButtonText="{Binding Common_CancelButton, Source={StaticResource LocalizedStrings}}"
    Style="{StaticResource DefaultContentDialogStyle}"
    mc:Ignorable="d">

    <ContentDialog.Resources>
        <local:LocalizedStrings x:Key="LocalizedStrings" />
    </ContentDialog.Resources>

    <ScrollViewer
        MaxHeight="560"
        HorizontalScrollBarVisibility="Disabled"
        VerticalScrollBarVisibility="Auto"
        VerticalScrollMode="Enabled">
    <Grid MinWidth="480" MinHeight="400">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <InfoBar
            x:Name="SecureConnectionInfoBar"
            Grid.Row="0"
            Margin="0,0,0,12"
            IsClosable="False"
            IsOpen="False"
            Message="You can specify user and computer authentication only when the action is set to &quot;Allow only secure connections.&quot;"
            Severity="Warning" />

        <TextBlock
            x:Name="DescriptionText"
            Grid.Row="1"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            TextWrapping="Wrap" />

        <!-- Authorized principals -->
        <StackPanel Grid.Row="2" Margin="0,12,0,6" Spacing="4">
            <TextBlock x:Name="AuthorizedLabel" FontWeight="SemiBold" />
            <CheckBox x:Name="OnlyAllowCheckBox" Content="{Binding WF_Common_OnlyAllowConnectionsFromTheseUsers, Source={StaticResource LocalizedStrings}}"
                      Checked="OnlyAllowCheckBox_Changed" Unchecked="OnlyAllowCheckBox_Changed" />
        </StackPanel>

        <Border
            x:Name="AuthorizedSection"
            Grid.Row="3"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="4">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <ListView
                    x:Name="AuthorizedListView"
                    Grid.Row="0"
                    MaxHeight="140"
                    SelectionMode="Single" />
                <StackPanel
                    Grid.Row="1"
                    Padding="8"
                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                    Orientation="Horizontal"
                    Spacing="8">
                    <!--
                        Local Principals mode: DropDownButton with two options
                        Remote Users mode: plain Add button (AuthAddButton visible, AuthAddDropDown collapsed)
                    -->
                    <Button
                        x:Name="AuthAddButton"
                        Content="{Binding Common_AddButton, Source={StaticResource LocalizedStrings}}"
                        Click="AuthAddButton_Click"
                        Visibility="Collapsed" />
                    <DropDownButton
                        x:Name="AuthAddDropDown"
                        Content="{Binding Common_AddButton, Source={StaticResource LocalizedStrings}}">
                        <DropDownButton.Flyout>
                            <MenuFlyout Placement="Bottom">
                                <MenuFlyoutItem
                                    x:Name="AuthAddLocalUserItem"
                                    Text="{Binding WF_Principals_LocalUser, Source={StaticResource LocalizedStrings}}"
                                    Click="AuthAddLocalUserItem_Click">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE77B;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem
                                    x:Name="AuthAddAppPackageItem"
                                    Text="{Binding WF_Principals_ApplicationPackageProperties, Source={StaticResource LocalizedStrings}}"
                                    Click="AuthAddAppPackageItem_Click">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE7B8;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </DropDownButton.Flyout>
                    </DropDownButton>
                    <Button x:Name="AuthDeleteButton" Content="{Binding Common_RemoveButton, Source={StaticResource LocalizedStrings}}" Click="AuthDeleteButton_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Exception principals -->
        <StackPanel Grid.Row="4" Margin="0,12,0,6" Spacing="4">
            <TextBlock x:Name="ExceptionLabel" FontWeight="SemiBold" />
            <CheckBox x:Name="SkipRuleCheckBox" Content="{Binding WF_Principals_SkipThisRuleForConnectionsFromTheseUsers, Source={StaticResource LocalizedStrings}}"
                      Checked="SkipRuleCheckBox_Changed" Unchecked="SkipRuleCheckBox_Changed" />
        </StackPanel>

        <Border
            x:Name="ExceptionSection"
            Grid.Row="5"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="4">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <ListView
                    x:Name="ExceptionListView"
                    Grid.Row="0"
                    MaxHeight="120"
                    SelectionMode="Single" />
                <StackPanel
                    Grid.Row="1"
                    Padding="8"
                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                    Orientation="Horizontal"
                    Spacing="8">
                    <Button
                        x:Name="ExcAddButton"
                        Content="{Binding Common_AddButton, Source={StaticResource LocalizedStrings}}"
                        Click="ExcAddButton_Click"
                        Visibility="Collapsed" />
                    <DropDownButton
                        x:Name="ExcAddDropDown"
                        Content="{Binding Common_AddButton, Source={StaticResource LocalizedStrings}}">
                        <DropDownButton.Flyout>
                            <MenuFlyout Placement="Bottom">
                                <MenuFlyoutItem
                                    x:Name="ExcAddLocalUserItem"
                                    Text="{Binding WF_Principals_LocalUser, Source={StaticResource LocalizedStrings}}"
                                    Click="ExcAddLocalUserItem_Click">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE77B;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem
                                    x:Name="ExcAddAppPackageItem"
                                    Text="{Binding WF_Principals_ApplicationPackageProperties, Source={StaticResource LocalizedStrings}}"
                                    Click="ExcAddAppPackageItem_Click">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE7B8;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </DropDownButton.Flyout>
                    </DropDownButton>
                    <Button x:Name="ExcDeleteButton" Content="{Binding Common_RemoveButton, Source={StaticResource LocalizedStrings}}" Click="ExcDeleteButton_Click" />
                </StackPanel>
            </Grid>
        </Border>

    </Grid>
    </ScrollViewer>
</ContentDialog>
