<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="OneMMC.Views.Dialogs.NewRule.NewConnectionSecurityRuleDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:OneMMC.Localization"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="{x:Bind local:LocalizedStrings.Instance.WF_NewConnectionSecurityRule_NewConnectionSecurityRule}"
    DefaultButton="Primary"
    PrimaryButtonText="{x:Bind local:LocalizedStrings.Instance.Common_CreateButton}"
    SecondaryButtonText="{x:Bind local:LocalizedStrings.Instance.Common_CancelButton}"
    Style="{StaticResource DefaultContentDialogStyle}"
    mc:Ignorable="d">

    <ContentDialog.Resources>
    </ContentDialog.Resources>

    <ScrollViewer
        MinWidth="500"
        MaxHeight="560"
        HorizontalScrollBarVisibility="Disabled"
        VerticalScrollBarVisibility="Auto"
        VerticalScrollMode="Enabled">
        <StackPanel Spacing="14">
            <TextBlock
                x:Name="ValidationErrorTextBlock"
                Foreground="IndianRed"
                TextWrapping="Wrap"
                Visibility="Collapsed" />

            <TextBlock FontWeight="SemiBold" Text="{x:Bind local:LocalizedStrings.Instance.WF_Common_Type}" />
            <ComboBox
                x:Name="RuleTypeBox"
                Width="Auto"
                HorizontalAlignment="Stretch"
                SelectedIndex="0"
                SelectionChanged="RuleTypeBox_SelectionChanged">
                <ComboBoxItem Content="{x:Bind local:LocalizedStrings.Instance.WF_NewConnectionSecurityRule_Isolation}" Tag="Isolation" />
                <ComboBoxItem Content="{x:Bind local:LocalizedStrings.Instance.WF_NewConnectionSecurityRule_AuthenticationExemption}" Tag="AuthenticationExemption" />
                <ComboBoxItem Content="{x:Bind local:LocalizedStrings.Instance.WF_NewConnectionSecurityRule_ServerToServer}" Tag="ServerToServer" />
                <ComboBoxItem Content="{x:Bind local:LocalizedStrings.Instance.WF_NewConnectionSecurityRule_Tunnel}" Tag="Tunnel" />
                <ComboBoxItem Content="{x:Bind local:LocalizedStrings.Instance.WF_Common_Custom}" Tag="Custom" />
            </ComboBox>

            <StackPanel
                x:Name="TunnelTypeSection"
                Spacing="10"
                Visibility="Collapsed">
                <TextBlock FontWeight="SemiBold" Text="{x:Bind local:LocalizedStrings.Instance.WF_NewConnectionSecurityRule_WhatTypeOfTunnelWouldYouLikeToCreate}" />
                <ComboBox
                    x:Name="TunnelTypeBox"
                    Width="Auto"
                    HorizontalAlignment="Stretch"
                    SelectedIndex="0"
                    SelectionChanged="TunnelTypeBox_SelectionChanged">
                    <ComboBoxItem Content="{x:Bind local:LocalizedStrings.Instance.WF_NewConnectionSecurityRule_CustomConfiguration}" Tag="CustomConfiguration" />
                    <ComboBoxItem Content="{x:Bind local:LocalizedStrings.Instance.WF_NewConnectionSecurityRule_ClientToGateway}" Tag="ClientToGateway" />
                    <ComboBoxItem Content="{x:Bind local:LocalizedStrings.Instance.WF_NewConnectionSecurityRule_GatewayToClient}" Tag="GatewayToClient" />
                </ComboBox>
                <TextBlock x:Name="TunnelTypeDescriptionTextBlock" TextWrapping="Wrap" />

                <TextBlock FontWeight="SemiBold" Text="{x:Bind local:LocalizedStrings.Instance.WF_NewConnectionSecurityRule_WouldYouLikeToExemptIPsecProtectedConnectionsFromThisTunnel}" />
                <RadioButton x:Name="TunnelExemptYesRadio" GroupName="TunnelExemptGroup">
                    <TextBlock Text="{x:Bind local:LocalizedStrings.Instance.WF_NewConnectionSecurityRule_YesIfANetworkConnectionIsAlreadyProtectedByIPsecThroughAnother}" TextWrapping="Wrap" />
                </RadioButton>
                <RadioButton
                    x:Name="TunnelExemptNoRadio"
                    GroupName="TunnelExemptGroup"
                    IsChecked="True">
                    <TextBlock Text="{x:Bind local:LocalizedStrings.Instance.WF_NewConnectionSecurityRule_NoSendAllNetworkTrafficThatMatchesThisRuleThroughTheTunnel}" TextWrapping="Wrap" />
                </RadioButton>

                <Grid
                    x:Name="TunnelKeyModuleGrid"
                    ColumnSpacing="8"
                    Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        Text="{x:Bind local:LocalizedStrings.Instance.WF_NewConnectionSecurityRule_KeyingModule}" />
                    <ComboBox
                        x:Name="TunnelKeyModuleBox"
                        Grid.Column="1"
                        HorizontalAlignment="Stretch"
                        SelectedIndex="0">
                        <ComboBoxItem Content="{x:Bind local:LocalizedStrings.Instance.WF_Common_Default}" Tag="Default" />
                        <ComboBoxItem Content="{x:Bind local:LocalizedStrings.Instance.WF_NewConnectionSecurityRule_IKEv2}" Tag="IKEv2" />
                    </ComboBox>
                </Grid>
            </StackPanel>

            <StackPanel
                x:Name="ExemptComputersSection"
                Spacing="10"
                Visibility="Collapsed">
                <TextBlock FontWeight="SemiBold" Text="{x:Bind local:LocalizedStrings.Instance.WF_NewConnectionSecurityRule_ExemptComputers}" />
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <ListView
                        x:Name="ExemptComputersListView"
                        Grid.Column="0"
                        Height="140"
                        SelectionMode="Single" />

                    <StackPanel Grid.Column="1" Spacing="6">
                        <Button
                            MinWidth="120"
                            Click="ExemptAddButton_Click"
                            Content="{x:Bind local:LocalizedStrings.Instance.Common_AddButton}" />
                        <Button
                            MinWidth="120"
                            Click="ExemptEditButton_Click"
                            Content="{x:Bind local:LocalizedStrings.Instance.Common_EditButton}" />
                        <Button
                            MinWidth="120"
                            Click="ExemptRemoveButton_Click"
                            Content="{x:Bind local:LocalizedStrings.Instance.Common_RemoveButton}" />
                    </StackPanel>
                </Grid>
            </StackPanel>

            <StackPanel
                x:Name="EndpointsSection"
                Spacing="10"
                Visibility="Collapsed">
                <TextBlock FontWeight="SemiBold" Text="{x:Bind local:LocalizedStrings.Instance.WF_NewConnectionSecurityRule_Endpoints}" />
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        Text="{x:Bind local:LocalizedStrings.Instance.WF_NewConnectionSecurityRule_ConfigureIPEndpoints}" />
                    <Button
                        Grid.Column="1"
                        MinWidth="160"
                        Click="ConfigureEndpointsButton_Click"
                        Content="{x:Bind local:LocalizedStrings.Instance.WF_Button_Configure}" />
                </Grid>
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        x:Name="InterfaceTypesValueTextBlock"
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        Text="{x:Bind local:LocalizedStrings.Instance.WF_Common_AllInterfaceTypes}" />
                    <Button
                        Grid.Column="1"
                        MinWidth="160"
                        Click="CustomizeInterfaceTypesButton_Click"
                        Content="{x:Bind local:LocalizedStrings.Instance.WF_NewConnectionSecurityRule_CustomizeInterfaceTypes}" />
                </Grid>
            </StackPanel>

            <StackPanel x:Name="RequirementsSection" Spacing="10">
                <TextBlock FontWeight="SemiBold" Text="{x:Bind local:LocalizedStrings.Instance.WF_NewConnectionSecurityRule_Requirements}" />
                <ComboBox
                    x:Name="RequirementsBox"
                    Width="Auto"
                    HorizontalAlignment="Stretch"
                    SelectedIndex="0"
                    SelectionChanged="RequirementsBox_SelectionChanged">
                    <ComboBoxItem Content="{x:Bind local:LocalizedStrings.Instance.WF_CSR_AuthMode_DoNotAuthenticate}" Tag="DoNotAuthenticate" />
                    <ComboBoxItem Content="{x:Bind local:LocalizedStrings.Instance.WF_CSR_AuthMode_RequestInboundOutbound}" Tag="RequestInboundOutbound" />
                    <ComboBoxItem Content="{x:Bind local:LocalizedStrings.Instance.WF_CSR_AuthMode_RequireInboundRequestOutbound}" Tag="RequireInboundRequestOutbound" />
                    <ComboBoxItem Content="{x:Bind local:LocalizedStrings.Instance.WF_CSR_AuthMode_RequireInboundOutbound}" Tag="RequireInboundOutbound" />
                    <ComboBoxItem Content="{x:Bind local:LocalizedStrings.Instance.WF_CSR_AuthMode_RequireInboundClearOutbound}" Tag="RequireInboundClearOutbound" />
                </ComboBox>
            </StackPanel>

            <StackPanel
                x:Name="TunnelEndpointsSection"
                Spacing="10"
                Visibility="Collapsed">
                <TextBlock FontWeight="SemiBold" Text="{x:Bind local:LocalizedStrings.Instance.WF_NewConnectionSecurityRule_TunnelEndpoints}" />
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        Text="{x:Bind local:LocalizedStrings.Instance.WF_Common_ConfigureTunnelEndpoints}" />
                    <Button
                        Grid.Column="1"
                        MinWidth="160"
                        Click="ConfigureTunnelEndpointsButton_Click"
                        Content="{x:Bind local:LocalizedStrings.Instance.WF_Button_Configure}" />
                </Grid>
            </StackPanel>

            <StackPanel x:Name="AuthenticationMethodSection" Spacing="10">
                <TextBlock FontWeight="SemiBold" Text="{x:Bind local:LocalizedStrings.Instance.WF_CSR_AuthenticationMethod}" />
                <ComboBox
                    x:Name="AuthenticationMethodBox"
                    Width="Auto"
                    HorizontalAlignment="Stretch"
                    SelectedIndex="4"
                    SelectionChanged="AuthenticationMethodBox_SelectionChanged">
                    <ComboBoxItem Content="{x:Bind local:LocalizedStrings.Instance.WF_Common_Default}" Tag="Default" />
                    <ComboBoxItem Content="{x:Bind local:LocalizedStrings.Instance.WF_CSR_AuthMethod_ComputerAndUser}" Tag="ComputerAndUser" />
                    <ComboBoxItem Content="{x:Bind local:LocalizedStrings.Instance.WF_Common_ComputerKerberosV5}" Tag="Computer" />
                    <ComboBoxItem Content="{x:Bind local:LocalizedStrings.Instance.WF_Common_UserKerberosV5}" Tag="User" />
                    <ComboBoxItem Content="{x:Bind local:LocalizedStrings.Instance.WF_Tab_Advanced}" Tag="Advanced" />
                    <ComboBoxItem Content="{x:Bind local:LocalizedStrings.Instance.WF_NewConnectionSecurityRule_ComputerCertificate}" Tag="ComputerCertificate" />
                </ComboBox>

                <StackPanel
                    x:Name="ComputerCertificateSection"
                    Spacing="8"
                    Visibility="Collapsed">
                    <Grid ColumnSpacing="10" RowSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            Text="{x:Bind local:LocalizedStrings.Instance.WF_NewConnectionSecurityRule_SigningAlgorithm}" />
                        <ComboBox
                            x:Name="SigningAlgorithmBox"
                            Grid.Row="0"
                            Grid.Column="1"
                            Width="Auto"
                            HorizontalAlignment="Stretch"
                            SelectedIndex="0">
                            <ComboBoxItem Content="{x:Bind local:LocalizedStrings.Instance.WF_SigningAlgorithm_RsaDefault}" Tag="RSA" />
                            <ComboBoxItem Content="{x:Bind local:LocalizedStrings.Instance.WF_SigningAlgorithm_EcdsaP256}" Tag="ECDSA-P256" />
                            <ComboBoxItem Content="{x:Bind local:LocalizedStrings.Instance.WF_SigningAlgorithm_EcdsaP384}" Tag="ECDSA-P384" />
                        </ComboBox>

                        <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            Text="{x:Bind local:LocalizedStrings.Instance.WF_NewConnectionSecurityRule_CertificateStoreType}" />
                        <ComboBox
                            x:Name="CertificateStoreTypeBox"
                            Grid.Row="1"
                            Grid.Column="1"
                            Width="Auto"
                            HorizontalAlignment="Stretch"
                            SelectedIndex="0">
                            <ComboBoxItem Content="{x:Bind local:LocalizedStrings.Instance.WF_CertificateStore_RootCADefault}" Tag="RootCA" />
                            <ComboBoxItem Content="{x:Bind local:LocalizedStrings.Instance.WF_CertificateStore_IntermediateCA}" Tag="IntermediateCA" />
                        </ComboBox>
                    </Grid>

                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox
                            x:Name="CertificateAuthorityNameTextBox"
                            Grid.Column="0"
                            PlaceholderText="{x:Bind local:LocalizedStrings.Instance.WF_NewConnectionSecurityRule_CAName}" />
                        <Button
                            Grid.Column="1"
                            MinWidth="160"
                            Click="BrowseCertificateAuthorityButton_Click"
                            Content="{x:Bind local:LocalizedStrings.Instance.Common_BrowseButton}" />
                    </Grid>

                    <CheckBox x:Name="AcceptHealthCertificatesCheckBox" Content="{x:Bind local:LocalizedStrings.Instance.WF_Common_AcceptOnlyHealthCertificates}" />
                </StackPanel>

                <Grid
                    x:Name="CustomizeMethodsGrid"
                    ColumnSpacing="8"
                    Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        Text="{x:Bind local:LocalizedStrings.Instance.WF_CSR_CustomizeMethods}" />
                    <Button
                        x:Name="CustomizeMethodsButton"
                        Grid.Column="1"
                        MinWidth="160"
                        Click="CustomizeMethodsButton_Click"
                        Content="{x:Bind local:LocalizedStrings.Instance.WF_Button_Customize}" />
                </Grid>
            </StackPanel>

            <StackPanel
                x:Name="ProtocolsAndPortsSection"
                Spacing="10"
                Visibility="Collapsed">
                <TextBlock FontWeight="SemiBold" Text="{x:Bind local:LocalizedStrings.Instance.WF_Section_ProtocolsPorts}" />
                <Grid ColumnSpacing="10" RowSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock
                        Grid.Row="0"
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        Text="{x:Bind local:LocalizedStrings.Instance.WF_Protocol_Type}" />
                    <ComboBox
                        x:Name="ProtocolTypeBox"
                        Grid.Row="0"
                        Grid.Column="1"
                        SelectedIndex="0"
                        SelectionChanged="ProtocolTypeBox_SelectionChanged">
                        <ComboBoxItem Content="{x:Bind local:LocalizedStrings.Instance.WF_Common_Any}" Tag="Any" />
                        <ComboBoxItem Content="{x:Bind local:LocalizedStrings.Instance.WF_Common_TCP}" Tag="TCP" />
                        <ComboBoxItem Content="{x:Bind local:LocalizedStrings.Instance.WF_Common_UDP}" Tag="UDP" />
                        <ComboBoxItem Content="{x:Bind local:LocalizedStrings.Instance.WF_Common_Custom}" Tag="Custom" />
                    </ComboBox>

                    <TextBlock
                        Grid.Row="1"
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        Text="{x:Bind local:LocalizedStrings.Instance.WF_Protocol_Number}" />
                    <NumberBox
                        x:Name="ProtocolNumberBox"
                        Grid.Row="1"
                        Grid.Column="1"
                        IsEnabled="False"
                        Maximum="255"
                        Minimum="0"
                        Value="0" />

                    <TextBlock
                        Grid.Row="2"
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        Text="{x:Bind local:LocalizedStrings.Instance.WF_CSR_Endpoint1Port}" />
                    <ComboBox
                        x:Name="Endpoint1PortBox"
                        Grid.Row="2"
                        Grid.Column="1"
                        SelectedIndex="0"
                        SelectionChanged="Endpoint1PortBox_SelectionChanged">
                        <ComboBoxItem Content="{x:Bind local:LocalizedStrings.Instance.WF_Port_AllPorts}" Tag="AllPorts" />
                        <ComboBoxItem Content="{x:Bind local:LocalizedStrings.Instance.WF_Port_SpecificPorts}" Tag="SpecificPorts" />
                    </ComboBox>

                    <TextBlock
                        x:Name="Endpoint1PortInputLabel"
                        Grid.Row="3"
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        Text="{x:Bind local:LocalizedStrings.Instance.WF_CSR_Endpoint1Port_Input}"
                        Visibility="Collapsed" />
                    <TextBox
                        x:Name="Endpoint1PortInputTextBox"
                        Grid.Row="3"
                        Grid.Column="1"
                        Visibility="Collapsed" />

                    <TextBlock
                        Grid.Row="4"
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        Text="{x:Bind local:LocalizedStrings.Instance.WF_CSR_Endpoint2Port}" />
                    <ComboBox
                        x:Name="Endpoint2PortBox"
                        Grid.Row="4"
                        Grid.Column="1"
                        SelectedIndex="0"
                        SelectionChanged="Endpoint2PortBox_SelectionChanged">
                        <ComboBoxItem Content="{x:Bind local:LocalizedStrings.Instance.WF_Port_AllPorts}" Tag="AllPorts" />
                        <ComboBoxItem Content="{x:Bind local:LocalizedStrings.Instance.WF_Port_SpecificPorts}" Tag="SpecificPorts" />
                    </ComboBox>

                    <TextBlock
                        x:Name="Endpoint2PortInputLabel"
                        Grid.Row="5"
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        Text="{x:Bind local:LocalizedStrings.Instance.WF_CSR_Endpoint2Port_Input}"
                        Visibility="Collapsed" />
                    <TextBox
                        x:Name="Endpoint2PortInputTextBox"
                        Grid.Row="5"
                        Grid.Column="1"
                        Visibility="Collapsed" />
                </Grid>
            </StackPanel>

            <StackPanel x:Name="ProfileSection" Spacing="10">
                <TextBlock FontWeight="SemiBold" Text="{x:Bind local:LocalizedStrings.Instance.WF_Field_Profile}" />
                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind local:LocalizedStrings.Instance.WF_Advanced_ProfilesDescription}" />
                <CheckBox x:Name="DomainCheckBox" Content="{x:Bind local:LocalizedStrings.Instance.WF_Profile_Domain}" IsChecked="True" />
                <CheckBox
                    x:Name="PrivateCheckBox"
                    Content="{x:Bind local:LocalizedStrings.Instance.WF_Profile_Private}"
                    IsChecked="True" />
                <CheckBox x:Name="PublicCheckBox" Content="{x:Bind local:LocalizedStrings.Instance.WF_Profile_Public}" IsChecked="True" />
            </StackPanel>

            <StackPanel x:Name="NameSection" Spacing="10">
                <TextBlock FontWeight="SemiBold" Text="{x:Bind local:LocalizedStrings.Instance.WF_Field_Name}" />
                <TextBlock Text="{x:Bind local:LocalizedStrings.Instance.WF_Common_RuleName}" />
                <TextBox x:Name="RuleNameTextBox" />
                <TextBlock Text="{x:Bind local:LocalizedStrings.Instance.WF_Common_DescriptionOptional}" />
                <TextBox
                    x:Name="RuleDescriptionTextBox"
                    Height="130"
                    AcceptsReturn="True"
                    TextWrapping="Wrap" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
