<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="OneMMC.Views.Dialogs.NewRule.NewFirewallRuleDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:OneMMC.Localization"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:wf="using:OneMMC.Core.Features.SystemManagement.Models.WF.Rules"
    Title="{x:Bind local:LocalizedStrings.Instance.WF_NewRule}"
    DefaultButton="Primary"
    PrimaryButtonText="{x:Bind local:LocalizedStrings.Instance.Common_CreateButton}"
    SecondaryButtonText="{x:Bind local:LocalizedStrings.Instance.Common_CancelButton}"
    Style="{StaticResource DefaultContentDialogStyle}"
    mc:Ignorable="d">

    <ContentDialog.Resources>
    </ContentDialog.Resources>

    <ScrollViewer
        MinWidth="500"
        MaxHeight="560"
        HorizontalScrollBarVisibility="Disabled"
        VerticalScrollBarVisibility="Auto"
        VerticalScrollMode="Enabled">
        <StackPanel Spacing="14">
            <TextBlock
                x:Name="ValidationErrorTextBlock"
                Foreground="IndianRed"
                TextWrapping="Wrap"
                Visibility="Collapsed" />

            <TextBlock FontWeight="SemiBold" Text="{x:Bind local:LocalizedStrings.Instance.WF_Common_Type}" />
            <ComboBox
                x:Name="RuleTypeBox"
                Width="Auto"
                HorizontalAlignment="Stretch"
                SelectedIndex="0"
                SelectionChanged="RuleTypeBox_SelectionChanged">
                <ComboBoxItem Content="{x:Bind local:LocalizedStrings.Instance.WF_Field_Program}" Tag="Program" />
                <ComboBoxItem Content="{x:Bind local:LocalizedStrings.Instance.WF_NewFirewallRule_Port}" Tag="Port" />
                <ComboBoxItem Content="{x:Bind local:LocalizedStrings.Instance.WF_NewFirewallRule_Predefined}" Tag="Predefined" />
                <ComboBoxItem Content="{x:Bind local:LocalizedStrings.Instance.WF_Common_Custom}" Tag="Custom" />
            </ComboBox>

            <StackPanel x:Name="ProgramSection" Spacing="10">
                <TextBlock FontWeight="SemiBold" Text="{x:Bind local:LocalizedStrings.Instance.WF_Field_Program}" />
                <ComboBox
                    x:Name="ProgramScopeBox"
                    Width="Auto"
                    HorizontalAlignment="Stretch"
                    SelectedIndex="0"
                    SelectionChanged="ProgramScopeBox_SelectionChanged">
                    <ComboBoxItem Content="{x:Bind local:LocalizedStrings.Instance.WF_Program_ThisProgram}" Tag="This" />
                    <ComboBoxItem Content="{x:Bind local:LocalizedStrings.Instance.WF_Program_AllPrograms}" Tag="All" />
                </ComboBox>
                <Grid x:Name="ProgramPathGrid" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox
                        x:Name="ProgramPathTextBox"
                        Grid.Column="0"
                        PlaceholderText="{x:Bind local:LocalizedStrings.Instance.WF_NewFirewallRule_ExampleCPathProgramExe}" />
                    <Button
                        Grid.Column="1"
                        MinWidth="160"
                        Click="BrowseProgramButton_Click"
                        Content="{x:Bind local:LocalizedStrings.Instance.Common_BrowseButton}" />
                </Grid>
            </StackPanel>

            <StackPanel
                x:Name="PortSection"
                Spacing="10"
                Visibility="Collapsed">
                <TextBlock FontWeight="SemiBold" Text="{x:Bind local:LocalizedStrings.Instance.WF_Section_ProtocolsPorts}" />

                <Grid ColumnSpacing="10" RowSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock
                        Grid.Row="0"
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        Text="{x:Bind local:LocalizedStrings.Instance.WF_Protocol_Type}" />
                    <ComboBox
                        x:Name="PortProtocolTypeBox"
                        Grid.Row="0"
                        Grid.Column="1"
                        Width="Auto"
                        HorizontalAlignment="Stretch"
                        SelectedIndex="0">
                        <ComboBoxItem Content="{x:Bind local:LocalizedStrings.Instance.WF_Common_TCP}" Tag="TCP" />
                        <ComboBoxItem Content="{x:Bind local:LocalizedStrings.Instance.WF_Common_UDP}" Tag="UDP" />
                    </ComboBox>

                    <TextBlock
                        Grid.Row="1"
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        Text="{x:Bind local:LocalizedStrings.Instance.WF_Field_LocalPort}" />
                    <ComboBox
                        x:Name="PortLocalPortBox"
                        Grid.Row="1"
                        Grid.Column="1"
                        Width="Auto"
                        HorizontalAlignment="Stretch"
                        SelectedIndex="0"
                        SelectionChanged="PortLocalPortBox_SelectionChanged">
                        <ComboBoxItem Content="{x:Bind local:LocalizedStrings.Instance.WF_Port_AllPorts}" Tag="AllPorts" />
                        <ComboBoxItem Content="{x:Bind local:LocalizedStrings.Instance.WF_Port_SpecificPorts}" Tag="SpecificPorts" />
                    </ComboBox>

                    <TextBlock
                        x:Name="PortInputLabel"
                        Grid.Row="2"
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        Text="{x:Bind local:LocalizedStrings.Instance.WF_Port_InputLocalPort}"
                        Visibility="Collapsed" />
                    <TextBox
                        x:Name="PortInputTextBox"
                        Grid.Row="2"
                        Grid.Column="1"
                        PlaceholderText="{x:Bind local:LocalizedStrings.Instance.WF_NewFirewallRule_Value8044380808090}"
                        Visibility="Collapsed" />
                </Grid>
            </StackPanel>

            <StackPanel
                x:Name="PredefinedSection"
                Spacing="10"
                Visibility="Collapsed">
                <TextBlock FontWeight="SemiBold" Text="{x:Bind local:LocalizedStrings.Instance.WF_NewFirewallRule_PredefinedRule}" />
                <ComboBox
                    x:Name="PredefinedGroupBox"
                    Width="Auto"
                    HorizontalAlignment="Stretch"
                    DisplayMemberPath="DisplayName"
                    SelectionChanged="PredefinedGroupBox_SelectionChanged" />

                <ListView
                    x:Name="PredefinedRulesListView"
                    MaxHeight="260"
                    SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="wf:PredefinedFirewallRuleItem">
                            <CheckBox Padding="4" IsChecked="{x:Bind IsSelected, Mode=TwoWay}">
                                <StackPanel Spacing="2">
                                    <TextBlock
                                        FontWeight="SemiBold"
                                        Text="{x:Bind Name}"
                                        TextWrapping="Wrap" />
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{x:Bind Description}"
                                        TextWrapping="Wrap" />
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{x:Bind Service}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </CheckBox>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel>

            <StackPanel
                x:Name="CustomSection"
                Spacing="10"
                Visibility="Collapsed">
                <TextBlock FontWeight="SemiBold" Text="{x:Bind local:LocalizedStrings.Instance.WF_Field_Program}" />
                <ComboBox
                    x:Name="CustomProgramScopeBox"
                    Width="Auto"
                    HorizontalAlignment="Stretch"
                    SelectedIndex="0"
                    SelectionChanged="CustomProgramScopeBox_SelectionChanged">
                    <ComboBoxItem Content="{x:Bind local:LocalizedStrings.Instance.WF_Program_ThisProgram}" Tag="This" />
                    <ComboBoxItem Content="{x:Bind local:LocalizedStrings.Instance.WF_Program_AllPrograms}" Tag="All" />
                </ComboBox>

                <Grid x:Name="CustomProgramPathGrid" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox
                        x:Name="CustomProgramPathTextBox"
                        Grid.Column="0"
                        PlaceholderText="{x:Bind local:LocalizedStrings.Instance.WF_NewFirewallRule_ExampleCPathProgramExe}" />
                    <Button
                        Grid.Column="1"
                        MinWidth="160"
                        Click="BrowseCustomProgramButton_Click"
                        Content="{x:Bind local:LocalizedStrings.Instance.Common_BrowseButton}" />
                </Grid>

                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        Text="{x:Bind local:LocalizedStrings.Instance.WF_NewFirewallRule_SpecifyServices}" />
                    <Button
                        Grid.Column="1"
                        MinWidth="160"
                        Click="SpecifyServicesButton_Click"
                        Content="{x:Bind local:LocalizedStrings.Instance.WF_Button_Specify}" />
                </Grid>

                <TextBlock FontWeight="SemiBold" Text="{x:Bind local:LocalizedStrings.Instance.WF_Section_ProtocolsPorts}" />
                <Grid ColumnSpacing="10" RowSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock
                        Grid.Row="0"
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        Text="{x:Bind local:LocalizedStrings.Instance.WF_Protocol_Type}" />
                    <ComboBox
                        x:Name="CustomProtocolTypeBox"
                        Grid.Row="0"
                        Grid.Column="1"
                        Width="Auto"
                        HorizontalAlignment="Stretch"
                        SelectedIndex="0"
                        SelectionChanged="CustomProtocolTypeBox_SelectionChanged">
                        <ComboBoxItem Content="{x:Bind local:LocalizedStrings.Instance.WF_Common_Any}" Tag="Any" />
                        <ComboBoxItem Content="{x:Bind local:LocalizedStrings.Instance.WF_Common_TCP}" Tag="TCP" />
                        <ComboBoxItem Content="{x:Bind local:LocalizedStrings.Instance.WF_Common_UDP}" Tag="UDP" />
                        <ComboBoxItem Content="{x:Bind local:LocalizedStrings.Instance.WF_Common_Custom}" Tag="Custom" />
                        <ComboBoxItem Content="{x:Bind local:LocalizedStrings.Instance.WF_NewFirewallRule_ICMPv4}" Tag="ICMPv4" />
                        <ComboBoxItem Content="{x:Bind local:LocalizedStrings.Instance.WF_NewFirewallRule_ICMPv6}" Tag="ICMPv6" />
                    </ComboBox>

                    <TextBlock
                        Grid.Row="1"
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        Text="{x:Bind local:LocalizedStrings.Instance.WF_Protocol_Number}" />
                    <NumberBox
                        x:Name="CustomProtocolNumberBox"
                        Grid.Row="1"
                        Grid.Column="1"
                        IsEnabled="False"
                        Maximum="255"
                        Minimum="0"
                        Value="0" />

                    <TextBlock
                        Grid.Row="2"
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        Text="{x:Bind local:LocalizedStrings.Instance.WF_Field_LocalPort}" />
                    <ComboBox
                        x:Name="CustomLocalPortBox"
                        Grid.Row="2"
                        Grid.Column="1"
                        Width="Auto"
                        HorizontalAlignment="Stretch"
                        SelectedIndex="0"
                        SelectionChanged="CustomLocalPortBox_SelectionChanged">
                        <ComboBoxItem Content="{x:Bind local:LocalizedStrings.Instance.WF_Port_AllPorts}" Tag="AllPorts" />
                        <ComboBoxItem Content="{x:Bind local:LocalizedStrings.Instance.WF_Port_SpecificPorts}" Tag="SpecificPorts" />
                    </ComboBox>

                    <TextBlock
                        x:Name="CustomLocalInputLabel"
                        Grid.Row="3"
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        Text="{x:Bind local:LocalizedStrings.Instance.WF_Port_InputLocalPort}"
                        Visibility="Collapsed" />
                    <TextBox
                        x:Name="CustomLocalPortInput"
                        Grid.Row="3"
                        Grid.Column="1"
                        PlaceholderText="{x:Bind local:LocalizedStrings.Instance.WF_NewFirewallRule_Value80443}"
                        Visibility="Collapsed" />

                    <TextBlock
                        Grid.Row="4"
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        Text="{x:Bind local:LocalizedStrings.Instance.WF_Field_RemotePort}" />
                    <ComboBox
                        x:Name="CustomRemotePortBox"
                        Grid.Row="4"
                        Grid.Column="1"
                        Width="Auto"
                        HorizontalAlignment="Stretch"
                        SelectedIndex="0"
                        SelectionChanged="CustomRemotePortBox_SelectionChanged">
                        <ComboBoxItem Content="{x:Bind local:LocalizedStrings.Instance.WF_Port_AllPorts}" Tag="AllPorts" />
                        <ComboBoxItem Content="{x:Bind local:LocalizedStrings.Instance.WF_Port_SpecificPorts}" Tag="SpecificPorts" />
                    </ComboBox>

                    <TextBlock
                        x:Name="CustomRemoteInputLabel"
                        Grid.Row="5"
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        Text="{x:Bind local:LocalizedStrings.Instance.WF_Port_InputRemotePort}"
                        Visibility="Collapsed" />
                    <TextBox
                        x:Name="CustomRemotePortInput"
                        Grid.Row="5"
                        Grid.Column="1"
                        PlaceholderText="{x:Bind local:LocalizedStrings.Instance.WF_NewFirewallRule_Value80443}"
                        Visibility="Collapsed" />

                    <TextBlock
                        Grid.Row="6"
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        Text="{x:Bind local:LocalizedStrings.Instance.WF_NewFirewallRule_ICMPSettings}" />
                    <Button
                        x:Name="IcmpCustomizeButton"
                        Grid.Row="6"
                        Grid.Column="1"
                        MinWidth="160"
                        Click="IcmpCustomizeButton_Click"
                        Content="{x:Bind local:LocalizedStrings.Instance.WF_Button_Customize}"
                        IsEnabled="False" />
                </Grid>

                <TextBlock FontWeight="SemiBold" Text="{x:Bind local:LocalizedStrings.Instance.WF_Section_Scope}" />
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        Text="{x:Bind local:LocalizedStrings.Instance.WF_NewFirewallRule_ConfigureIPScope}" />
                    <Button
                        Grid.Column="1"
                        MinWidth="160"
                        Click="ConfigureScopeButton_Click"
                        Content="{x:Bind local:LocalizedStrings.Instance.WF_Button_Configure}" />
                </Grid>
            </StackPanel>

            <StackPanel x:Name="ActionSection" Spacing="10">
                <TextBlock FontWeight="SemiBold" Text="{x:Bind local:LocalizedStrings.Instance.WF_Field_Action}" />
                <ComboBox
                    x:Name="ActionBox"
                    Width="Auto"
                    HorizontalAlignment="Stretch"
                    SelectedIndex="0"
                    SelectionChanged="ActionBox_SelectionChanged">
                    <ComboBoxItem Content="{x:Bind local:LocalizedStrings.Instance.WF_Action_Allow}" Tag="Allow" />
                    <ComboBoxItem Content="{x:Bind local:LocalizedStrings.Instance.WF_Action_AllowIfSecure}" Tag="AllowIfSecure" />
                    <ComboBoxItem Content="{x:Bind local:LocalizedStrings.Instance.WF_Action_Block}" Tag="Block" />
                </ComboBox>

                <Grid
                    x:Name="CustomizeAllowIfSecureGrid"
                    ColumnSpacing="8"
                    Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        Text="{x:Bind local:LocalizedStrings.Instance.WF_Action_CustomizeAllowSecure}" />
                    <Button
                        Grid.Column="1"
                        MinWidth="160"
                        Click="CustomizeAllowIfSecureButton_Click"
                        Content="{x:Bind local:LocalizedStrings.Instance.WF_Button_Customize}" />
                </Grid>
            </StackPanel>

            <StackPanel x:Name="ProfileSection" Spacing="10">
                <TextBlock FontWeight="SemiBold" Text="{x:Bind local:LocalizedStrings.Instance.WF_Field_Profile}" />
                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind local:LocalizedStrings.Instance.WF_Advanced_ProfilesDescription}" />
                <CheckBox x:Name="DomainCheckBox" Content="{x:Bind local:LocalizedStrings.Instance.WF_Profile_Domain}" IsChecked="True" />
                <CheckBox
                    x:Name="PrivateCheckBox"
                    Content="{x:Bind local:LocalizedStrings.Instance.WF_Profile_Private}"
                    IsChecked="True" />
                <CheckBox x:Name="PublicCheckBox" Content="{x:Bind local:LocalizedStrings.Instance.WF_Profile_Public}" IsChecked="True" />
            </StackPanel>

            <StackPanel x:Name="NameSection" Spacing="10">
                <TextBlock FontWeight="SemiBold" Text="{x:Bind local:LocalizedStrings.Instance.WF_Field_Name}" />
                <TextBlock Text="{x:Bind local:LocalizedStrings.Instance.WF_Common_RuleName}" />
                <TextBox x:Name="RuleNameTextBox" />
                <TextBlock Text="{x:Bind local:LocalizedStrings.Instance.WF_Common_DescriptionOptional}" />
                <TextBox
                    x:Name="RuleDescriptionTextBox"
                    Height="130"
                    AcceptsReturn="True"
                    TextWrapping="Wrap" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
