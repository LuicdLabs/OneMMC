<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="OneMMC.Views.Dialogs.WFProperties.IntegrityEncryptionAlgorithmEditorDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:OneMMC.Localization"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <UserControl.Resources>
    </UserControl.Resources>

    <StackPanel MinWidth="560" Spacing="12">
        <Border
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="4"
            Padding="10">
            <StackPanel Spacing="10">
                <TextBlock FontWeight="SemiBold" Text="{x:Bind local:LocalizedStrings.Instance.WF_Field_Protocol}" />

                <StackPanel Spacing="4">
                    <RadioButton
                        x:Name="EspProtocolRadioButton"
                        Checked="ProtocolRadioButton_Checked"
                        Content="{x:Bind local:LocalizedStrings.Instance.WF_Common_ESPRecommended}"
                        GroupName="ProtocolGroup"
                        IsChecked="True" />
                    <TextBlock
                        Margin="24,0,0,0"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind local:LocalizedStrings.Instance.WF_IntegrityEncryptionAlgorithmEditor_ESPProtocolProvidesPrivacyAndIntegrityForThePacketPayloadESPIs}"
                        TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel Spacing="4">
                    <RadioButton
                        x:Name="EspAndAhProtocolRadioButton"
                        Checked="ProtocolRadioButton_Checked"
                        Content="{x:Bind local:LocalizedStrings.Instance.WF_IntegrityEncryptionAlgorithmEditor_ESPAndAH}"
                        GroupName="ProtocolGroup" />
                    <TextBlock
                        Margin="24,0,0,0"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind local:LocalizedStrings.Instance.WF_IntegrityEncryptionAlgorithmEditor_AddingTheAHProtocolProvidesAdditionalIntegrityForTheIPHeaderThis}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </StackPanel>
        </Border>

        <Border
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="4"
            Padding="10">
            <StackPanel Spacing="8">
                <TextBlock FontWeight="SemiBold" Text="{x:Bind local:LocalizedStrings.Instance.WF_IntegrityEncryptionAlgorithmEditor_Algorithms}" />

                <Grid ColumnSpacing="8" RowSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="280" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Text="{x:Bind local:LocalizedStrings.Instance.WF_Common_EncryptionAlgorithm}" />
                    <ComboBox x:Name="EncryptionAlgorithmComboBox" Grid.Row="0" Grid.Column="1" SelectionChanged="EncryptionAlgorithmComboBox_SelectionChanged">
                        <ComboBoxItem Content="{x:Bind local:LocalizedStrings.Instance.WF_IntegrityEncryptionAlgorithmEditor_AESGCM256}" Tag="AES-GCM 256" />
                        <ComboBoxItem Content="{x:Bind local:LocalizedStrings.Instance.WF_IntegrityEncryptionAlgorithmEditor_AESGCM192}" Tag="AES-GCM 192" />
                        <ComboBoxItem Content="{x:Bind local:LocalizedStrings.Instance.WF_IntegrityEncryptionAlgorithmEditor_AESGCM128}" Tag="AES-GCM 128" />
                        <ComboBoxItem Content="{x:Bind local:LocalizedStrings.Instance.WF_Common_AESCBC256}" Tag="AES-CBC 256" />
                        <ComboBoxItem Content="{x:Bind local:LocalizedStrings.Instance.WF_Common_AESCBC192}" Tag="AES-CBC 192" />
                        <ComboBoxItem Content="{x:Bind local:LocalizedStrings.Instance.WF_Common_AESCBC128}" Tag="AES-CBC 128" />
                        <ComboBoxItem Content="{x:Bind local:LocalizedStrings.Instance.WF_Common_Value3DES}" Tag="3DES" />
                        <ComboBoxItem Content="{x:Bind local:LocalizedStrings.Instance.WF_Common_DES}" Tag="DES" />
                    </ComboBox>

                    <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Text="{x:Bind local:LocalizedStrings.Instance.WF_Common_IntegrityAlgorithm}" />
                    <ComboBox x:Name="IntegrityAlgorithmComboBox" Grid.Row="1" Grid.Column="1" SelectionChanged="IntegrityAlgorithmComboBox_SelectionChanged">
                        <ComboBoxItem Content="{x:Bind local:LocalizedStrings.Instance.WF_IntegrityEncryptionAlgorithmEditor_AESGCM256}" Tag="AES-GCM 256" />
                        <ComboBoxItem Content="{x:Bind local:LocalizedStrings.Instance.WF_IntegrityEncryptionAlgorithmEditor_AESGCM192}" Tag="AES-GCM 192" />
                        <ComboBoxItem Content="{x:Bind local:LocalizedStrings.Instance.WF_IntegrityEncryptionAlgorithmEditor_AESGCM128}" Tag="AES-GCM 128" />
                        <ComboBoxItem Content="{x:Bind local:LocalizedStrings.Instance.WF_Common_AESGMAC256}" Tag="AES-GMAC 256" />
                        <ComboBoxItem Content="{x:Bind local:LocalizedStrings.Instance.WF_Common_AESGMAC192}" Tag="AES-GMAC 192" />
                        <ComboBoxItem Content="{x:Bind local:LocalizedStrings.Instance.WF_Common_AESGMAC128}" Tag="AES-GMAC 128" />
                        <ComboBoxItem Content="{x:Bind local:LocalizedStrings.Instance.WF_Common_SHA256}" Tag="SHA-256" />
                        <ComboBoxItem Content="{x:Bind local:LocalizedStrings.Instance.WF_Common_SHA1}" Tag="SHA-1" />
                        <ComboBoxItem Content="{x:Bind local:LocalizedStrings.Instance.WF_Common_MD5}" Tag="MD5" />
                    </ComboBox>
                </Grid>

                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE946;" />
                    <TextBlock x:Name="EncryptionDescriptionTextBlock" TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE946;" />
                    <TextBlock x:Name="IntegrityDescriptionTextBlock" TextWrapping="Wrap" />
                </StackPanel>

                <TextBlock
                    x:Name="ValidationWarningTextBlock"
                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                    Text="{x:Bind local:LocalizedStrings.Instance.WF_IntegrityEncryptionAlgorithmEditor_InvalidAlgorithmCombinationForAESGCMEncryptionIntegrityMustMatchTheSame}"
                    TextWrapping="Wrap"
                    Visibility="Collapsed" />
            </StackPanel>
        </Border>

        <Border
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="4"
            Padding="10">
            <StackPanel Spacing="8">
                <TextBlock FontWeight="SemiBold" Text="{x:Bind local:LocalizedStrings.Instance.WF_Common_KeyLifetimes}" />

                <Grid ColumnSpacing="8" RowSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="140" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Text="{x:Bind local:LocalizedStrings.Instance.WF_Common_Minutes}" />
                    <NumberBox
                        x:Name="MinutesNumberBox"
                        Grid.Row="0"
                        Grid.Column="1"
                        Minimum="0"
                        SpinButtonPlacementMode="Inline"
                        Value="60" />

                    <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Text="{x:Bind local:LocalizedStrings.Instance.WF_Common_KB}" />
                    <NumberBox
                        x:Name="KilobytesNumberBox"
                        Grid.Row="1"
                        Grid.Column="1"
                        Minimum="0"
                        SpinButtonPlacementMode="Inline"
                        Value="100000" />
                </Grid>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
