<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="OneMMC.Views.Dialogs.WFProperties.ProfileLoggingSettingsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:OneMMC.Localization"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    CloseButtonText="{x:Bind local:LocalizedStrings.Instance.Common_CancelButton}"
    PrimaryButtonText="{x:Bind local:LocalizedStrings.Instance.Common_OKButton}"
    Style="{StaticResource DefaultContentDialogStyle}"
    mc:Ignorable="d">

    <ContentDialog.Resources>
    </ContentDialog.Resources>

    <ScrollViewer
        MaxHeight="560"
        HorizontalScrollBarVisibility="Disabled"
        VerticalScrollBarVisibility="Auto"
        VerticalScrollMode="Enabled">
        <StackPanel MinWidth="450" Spacing="10">
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Text="{x:Bind local:LocalizedStrings.Instance.WF_ProfileLoggingSettings_Name}" />
                <TextBox
                    x:Name="LogFilePathTextBox"
                    Grid.Column="1"
                    Text="{x:Bind local:LocalizedStrings.Instance.WF_ProfileLoggingSettings_System32LogFilesFirewallPfirewallLog}" />
                <Button
                    Grid.Column="2"
                    MinWidth="120"
                    Click="BrowseButton_Click"
                    Content="{x:Bind local:LocalizedStrings.Instance.WF_Common_Browse}" />
            </Grid>

            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="220" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Text="{x:Bind local:LocalizedStrings.Instance.WF_ProfileLoggingSettings_SizeLimitKB}" />
                <NumberBox
                    x:Name="SizeLimitNumberBox"
                    Grid.Column="1"
                    Minimum="1"
                    SmallChange="128"
                    SpinButtonPlacementMode="Inline"
                    Value="4096" />
            </Grid>

            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="220" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Text="{x:Bind local:LocalizedStrings.Instance.WF_ProfileLoggingSettings_LogDroppedPackets}" />
                <ComboBox
                    x:Name="LogDroppedPacketsComboBox"
                    Grid.Column="1"
                    SelectedIndex="1">
                    <ComboBoxItem Content="{x:Bind local:LocalizedStrings.Instance.WF_Common_Yes}" Tag="Yes" />
                    <ComboBoxItem Content="{x:Bind local:LocalizedStrings.Instance.WF_Common_NoDefault}" Tag="No (default)" />
                </ComboBox>
            </Grid>

            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="220" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Text="{x:Bind local:LocalizedStrings.Instance.WF_ProfileLoggingSettings_LogSuccessfulConnections}" />
                <ComboBox
                    x:Name="LogSuccessfulConnectionsComboBox"
                    Grid.Column="1"
                    SelectedIndex="1">
                    <ComboBoxItem Content="{x:Bind local:LocalizedStrings.Instance.WF_Common_Yes}" Tag="Yes" />
                    <ComboBoxItem Content="{x:Bind local:LocalizedStrings.Instance.WF_Common_NoDefault}" Tag="No (default)" />
                </ComboBox>
            </Grid>

            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="{x:Bind local:LocalizedStrings.Instance.WF_ProfileLoggingSettings_NoteIfYouAreConfiguringTheLogFileNameOnGroupPolicy}"
                TextWrapping="Wrap" />

            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="{x:Bind local:LocalizedStrings.Instance.WF_ProfileLoggingSettings_DefaultPathForTheLogFileIsSystemrootSystem32LogfilesFirewallPfirewall}"
                TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
