<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="OneMMC.Views.Dialogs.WFProperties.DataProtectionSettingsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:OneMMC.Localization"
    xmlns:wfprof="using:OneMMC.Core.Features.SystemManagement.Models.WF.Profiles"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <UserControl.Resources>
    </UserControl.Resources>

    <Grid MinWidth="900" MinHeight="520" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock
            Grid.Row="0"
            Text="{x:Bind local:LocalizedStrings.Instance.WF_DataProtectionSettings_DataProtectionSettingsAreUsedByConnectionSecurityRulesToProtectNetwork}"
            TextWrapping="Wrap" />

        <CheckBox
            x:Name="RequireEncryptionCheckBox"
            Grid.Row="1"
            Content="{x:Bind local:LocalizedStrings.Instance.WF_DataProtectionSettings_RequireEncryptionForAllConnectionSecurityRulesThatUseTheseSettings}"
            Margin="0,2,0,2" />

        <Grid Grid.Row="2" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border
                Grid.Column="0"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="4"
                Padding="10">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" FontWeight="SemiBold" Text="{x:Bind local:LocalizedStrings.Instance.WF_DataProtectionSettings_DataIntegrity}" />
                    <TextBlock
                        Grid.Row="1"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind local:LocalizedStrings.Instance.WF_DataProtectionSettings_ProtectDataFromModificationOnTheNetworkWithTheseIntegrityAlgorithmsThose}"
                        TextWrapping="Wrap" />

                    <Grid Grid.Row="2" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <ListView
                            x:Name="IntegrityAlgorithmsListView"
                            Grid.Column="0"
                            MinHeight="260"
                            SelectionChanged="IntegrityAlgorithmsListView_SelectionChanged"
                            SelectionMode="Single">
                            <ListView.Header>
                                <Grid Padding="8,4" ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" MinWidth="80" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" MinWidth="150" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" FontWeight="SemiBold" Text="{x:Bind local:LocalizedStrings.Instance.WF_Field_Protocol}" />
                                    <TextBlock Grid.Column="1" FontWeight="SemiBold" Text="{x:Bind local:LocalizedStrings.Instance.WF_Common_Integrity}" />
                                    <TextBlock Grid.Column="2" FontWeight="SemiBold" Text="{x:Bind local:LocalizedStrings.Instance.WF_DataProtectionSettings_KeyLifetimeMinutesKB}" />
                                </Grid>
                            </ListView.Header>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="wfprof:DataIntegrityAlgorithmEntry">
                                    <Grid Padding="0,4" ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" MinWidth="80" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" MinWidth="150" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{x:Bind Protocol}" />
                                        <TextBlock Grid.Column="1" Text="{x:Bind IntegrityAlgorithm}" />
                                        <TextBlock Grid.Column="2" Text="{x:Bind KeyLifetimeDisplay}" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="6">
                            <Button
                                x:Name="MoveUpIntegrityButton"
                                Width="34"
                                Click="MoveUpIntegrityButton_Click"
                                Content="&#xE70E;"
                                FontFamily="Segoe MDL2 Assets" />
                            <Button
                                x:Name="MoveDownIntegrityButton"
                                Width="34"
                                Click="MoveDownIntegrityButton_Click"
                                Content="&#xE70D;"
                                FontFamily="Segoe MDL2 Assets" />
                        </StackPanel>
                    </Grid>

                    <StackPanel
                        Grid.Row="3"
                        Orientation="Horizontal"
                        Spacing="8">
                        <Button x:Name="AddIntegrityButton" MinWidth="88" Click="AddIntegrityButton_Click" Content="{x:Bind local:LocalizedStrings.Instance.WF_Common_AddEllipsis}" />
                        <Button x:Name="EditIntegrityButton" MinWidth="88" Click="EditIntegrityButton_Click" Content="{x:Bind local:LocalizedStrings.Instance.WF_Common_Edit}" />
                        <Button x:Name="RemoveIntegrityButton" MinWidth="88" Click="RemoveIntegrityButton_Click" Content="{x:Bind local:LocalizedStrings.Instance.Common_RemoveButton}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border
                Grid.Column="1"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="4"
                Padding="10">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" FontWeight="SemiBold" Text="{x:Bind local:LocalizedStrings.Instance.WF_DataProtectionSettings_DataIntegrityAndEncryption}" />
                    <TextBlock
                        Grid.Row="1"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind local:LocalizedStrings.Instance.WF_DataProtectionSettings_ProtectDataFromModificationAndPreserveConfidentialityOnTheNetworkWithThese}"
                        TextWrapping="Wrap" />

                    <Grid Grid.Row="2" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <ListView
                            x:Name="IntegrityEncryptionAlgorithmsListView"
                            Grid.Column="0"
                            MinHeight="260"
                            SelectionChanged="IntegrityEncryptionAlgorithmsListView_SelectionChanged"
                            SelectionMode="Single">
                            <ListView.Header>
                                <Grid Padding="8,4" ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" MinWidth="80" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" MinWidth="150" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" FontWeight="SemiBold" Text="{x:Bind local:LocalizedStrings.Instance.WF_Field_Protocol}" />
                                    <TextBlock Grid.Column="1" FontWeight="SemiBold" Text="{x:Bind local:LocalizedStrings.Instance.WF_Common_Integrity}" />
                                    <TextBlock Grid.Column="2" FontWeight="SemiBold" Text="{x:Bind local:LocalizedStrings.Instance.WF_Common_Encryption}" />
                                    <TextBlock Grid.Column="3" FontWeight="SemiBold" Text="{x:Bind local:LocalizedStrings.Instance.WF_DataProtectionSettings_KeyLifetimeMinutesKB}" />
                                </Grid>
                            </ListView.Header>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="wfprof:IntegrityEncryptionAlgorithmEntry">
                                    <Grid Padding="0,4" ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" MinWidth="80" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" MinWidth="150" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{x:Bind Protocol}" />
                                        <TextBlock Grid.Column="1" Text="{x:Bind IntegrityAlgorithm}" />
                                        <TextBlock Grid.Column="2" Text="{x:Bind EncryptionAlgorithm}" />
                                        <TextBlock Grid.Column="3" Text="{x:Bind KeyLifetimeDisplay}" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="6">
                            <Button
                                x:Name="MoveUpIntegrityEncryptionButton"
                                Width="34"
                                Click="MoveUpIntegrityEncryptionButton_Click"
                                Content="&#xE70E;"
                                FontFamily="Segoe MDL2 Assets" />
                            <Button
                                x:Name="MoveDownIntegrityEncryptionButton"
                                Width="34"
                                Click="MoveDownIntegrityEncryptionButton_Click"
                                Content="&#xE70D;"
                                FontFamily="Segoe MDL2 Assets" />
                        </StackPanel>
                    </Grid>

                    <StackPanel
                        Grid.Row="3"
                        Orientation="Horizontal"
                        Spacing="8">
                        <Button x:Name="AddIntegrityEncryptionButton" MinWidth="88" Click="AddIntegrityEncryptionButton_Click" Content="{x:Bind local:LocalizedStrings.Instance.WF_Common_AddEllipsis}" />
                        <Button x:Name="EditIntegrityEncryptionButton" MinWidth="88" Click="EditIntegrityEncryptionButton_Click" Content="{x:Bind local:LocalizedStrings.Instance.WF_Common_Edit}" />
                        <Button x:Name="RemoveIntegrityEncryptionButton" MinWidth="88" Click="RemoveIntegrityEncryptionButton_Click" Content="{x:Bind local:LocalizedStrings.Instance.Common_RemoveButton}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
