<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="OneMMC.Views.Dialogs.WFProperties.ProfileFirewallBehaviorDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:OneMMC.Localization"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    CloseButtonText="{x:Bind local:LocalizedStrings.Instance.Common_CancelButton}"
    PrimaryButtonText="{x:Bind local:LocalizedStrings.Instance.Common_OKButton}"
    Style="{StaticResource DefaultContentDialogStyle}"
    mc:Ignorable="d">

    <ContentDialog.Resources>
    </ContentDialog.Resources>

    <ScrollViewer
        MaxHeight="560"
        HorizontalScrollBarVisibility="Disabled"
        VerticalScrollBarVisibility="Auto"
        VerticalScrollMode="Enabled">
        <StackPanel MinWidth="500" Spacing="12">
            <TextBlock Text="{x:Bind local:LocalizedStrings.Instance.WF_ProfileFirewallBehavior_SpecifySettingsThatControlWindowsDefenderFirewallWithAdvancedSecurityBehavior}" TextWrapping="Wrap" />

            <Border
                Margin="0,2,0,0"
                Padding="10"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="4">
                <StackPanel Spacing="10">
                    <TextBlock FontWeight="SemiBold" Text="{x:Bind local:LocalizedStrings.Instance.WF_ProfileFirewallBehavior_FirewallSettings}" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind local:LocalizedStrings.Instance.WF_ProfileFirewallBehavior_DisplayNotificationsToTheUserWhenAProgramIsBlockedFromReceiving}"
                        TextWrapping="Wrap" />

                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="220" />
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            Text="{x:Bind local:LocalizedStrings.Instance.WF_ProfileFirewallBehavior_DisplayANotification}" />

                        <ComboBox
                            x:Name="NotificationComboBox"
                            Grid.Column="1"
                            SelectedIndex="0">
                            <ComboBoxItem Content="{x:Bind local:LocalizedStrings.Instance.WF_Common_Yes}" Tag="Yes" />
                            <ComboBoxItem Content="{x:Bind local:LocalizedStrings.Instance.WF_Common_No}" Tag="No" />
                        </ComboBox>
                    </Grid>
                </StackPanel>
            </Border>

            <Border
                Padding="10"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="4">
                <StackPanel Spacing="10">
                    <TextBlock FontWeight="SemiBold" Text="{x:Bind local:LocalizedStrings.Instance.WF_ProfileFirewallBehavior_UnicastResponse}" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind local:LocalizedStrings.Instance.WF_ProfileFirewallBehavior_AllowUnicastResponseToMulticastOrBroadcastNetworkTraffic}"
                        TextWrapping="Wrap" />

                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="220" />
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            Text="{x:Bind local:LocalizedStrings.Instance.WF_ProfileFirewallBehavior_AllowUnicastResponse}" />

                        <ComboBox
                            x:Name="UnicastResponseComboBox"
                            Grid.Column="1"
                            SelectedIndex="0">
                            <ComboBoxItem Content="{x:Bind local:LocalizedStrings.Instance.WF_Common_YesDefault}" Tag="Yes (default)" />
                            <ComboBoxItem Content="{x:Bind local:LocalizedStrings.Instance.WF_Common_No}" Tag="No" />
                        </ComboBox>
                    </Grid>
                </StackPanel>
            </Border>

            <Border
                Padding="10"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="4">
                <StackPanel Spacing="8">
                    <TextBlock FontWeight="SemiBold" Text="{x:Bind local:LocalizedStrings.Instance.WF_ProfileFirewallBehavior_RuleMerging}" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind local:LocalizedStrings.Instance.WF_ProfileFirewallBehavior_AllowsRulesCreatedByLocalAdministratorsToBeMergedWithRulesDistributed}"
                        TextWrapping="Wrap" />

                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="220" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            Text="{x:Bind local:LocalizedStrings.Instance.WF_ProfileFirewallBehavior_ApplyLocalFirewallRules}" />
                        <TextBox
                            x:Name="ApplyLocalFirewallRulesTextBox"
                            Grid.Column="1"
                            IsReadOnly="True"
                            Text="{x:Bind local:LocalizedStrings.Instance.WF_Common_YesDefault}" />
                    </Grid>

                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="220" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            Text="{x:Bind local:LocalizedStrings.Instance.WF_ProfileFirewallBehavior_ApplyLocalConnectionSecurityRules}" />
                        <TextBox
                            x:Name="ApplyLocalConnectionSecurityRulesTextBox"
                            Grid.Column="1"
                            IsReadOnly="True"
                            Text="{x:Bind local:LocalizedStrings.Instance.WF_Common_YesDefault}" />
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
