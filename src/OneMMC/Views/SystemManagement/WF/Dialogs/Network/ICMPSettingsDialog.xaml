<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="OneMMC.Views.Dialogs.Network.ICMPSettingsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:OneMMC.Localization"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <UserControl.Resources>
    </UserControl.Resources>

    <StackPanel MinWidth="440" Spacing="8">

        <!--  Description  -->
        <TextBlock
            Margin="0,0,0,4"
            Text="{x:Bind local:LocalizedStrings.Instance.WF_ICMPSettings_ApplyThisRuleToTheFollowingInternetControlMessageProtocolICMPConnections}"
            TextWrapping="Wrap" />

        <!--  All / Specific radio buttons  -->
        <RadioButton
            x:Name="AllTypesRadio"
            Content="{x:Bind local:LocalizedStrings.Instance.WF_ICMPSettings_AllICMPTypesA}"
            GroupName="IcmpGroup"
            IsChecked="True" />
        <RadioButton
            x:Name="SpecificTypesRadio"
            Content="{x:Bind local:LocalizedStrings.Instance.WF_ICMPSettings_SpecificICMPTypesS}"
            GroupName="IcmpGroup" />

        <!--  Specific ICMP type checkboxes  -->
        <Border
            BorderBrush="{ThemeResource SystemControlForegroundBaseMediumLowBrush}"
            BorderThickness="1">
            <ScrollViewer
                Height="220"
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto"
                VerticalScrollMode="Enabled">
                <StackPanel x:Name="IcmpCheckBoxPanel" Padding="4,4,4,4" Spacing="2">
                    <CheckBox x:Name="CbPacketTooBig"        Content="{x:Bind local:LocalizedStrings.Instance.WF_ICMPSettings_PacketTooBig}" Tag="2:*" />
                    <CheckBox x:Name="CbDestUnreachable"     Content="{x:Bind local:LocalizedStrings.Instance.WF_ICMPSettings_DestinationUnreachable}" Tag="3:*" />
                    <CheckBox x:Name="CbSourceQuench"        Content="{x:Bind local:LocalizedStrings.Instance.WF_ICMPSettings_SourceQuench}" Tag="4:*" />
                    <CheckBox x:Name="CbRedirect"            Content="{x:Bind local:LocalizedStrings.Instance.WF_ICMPSettings_Redirect}" Tag="5:*" />
                    <CheckBox x:Name="CbEchoRequest"         Content="{x:Bind local:LocalizedStrings.Instance.WF_ICMPSettings_EchoRequest}" Tag="8:*" />
                    <CheckBox x:Name="CbRouterAdvertisement" Content="{x:Bind local:LocalizedStrings.Instance.WF_ICMPSettings_RouterAdvertisement}" Tag="9:*" />
                    <CheckBox x:Name="CbRouterSolicitation"  Content="{x:Bind local:LocalizedStrings.Instance.WF_ICMPSettings_RouterSolicitation}" Tag="10:*" />
                    <CheckBox x:Name="CbTimeExceeded"        Content="{x:Bind local:LocalizedStrings.Instance.WF_ICMPSettings_TimeExceeded}" Tag="11:*" />
                    <CheckBox x:Name="CbParameterProblem"    Content="{x:Bind local:LocalizedStrings.Instance.WF_ICMPSettings_ParameterProblem}" Tag="12:*" />
                    <CheckBox x:Name="CbTimestampRequest"    Content="{x:Bind local:LocalizedStrings.Instance.WF_ICMPSettings_TimestampRequest}" Tag="13:*" />
                    <CheckBox x:Name="CbAddressMaskRequest"  Content="{x:Bind local:LocalizedStrings.Instance.WF_ICMPSettings_AddressMaskRequest}" Tag="17:*" />
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!--  Custom ICMP type row  -->
        <TextBlock
            Margin="0,4,0,0"
            FontWeight="SemiBold"
            Text="{x:Bind local:LocalizedStrings.Instance.WF_ICMPSettings_ThisICMPType}" />

        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="120" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="120" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock
                Grid.Column="0"
                VerticalAlignment="Center"
                Text="{x:Bind local:LocalizedStrings.Instance.WF_ICMPSettings_TypeT}" />
            <NumberBox
                x:Name="TypeNumberBox"
                Grid.Column="1"
                IsEnabled="False"
                Maximum="255"
                Minimum="0"
                SpinButtonPlacementMode="Compact"
                Value="0" />

            <TextBlock
                Grid.Column="2"
                VerticalAlignment="Center"
                Text="{x:Bind local:LocalizedStrings.Instance.WF_ICMPSettings_CodeC}" />
            <ComboBox
                x:Name="CodeComboBox"
                Grid.Column="3"
                IsEnabled="False"
                SelectedIndex="0" />

            <Button
                x:Name="AddTypeButton"
                Grid.Column="4"
                MinWidth="80"
                Click="AddTypeButton_Click"
                Content="{x:Bind local:LocalizedStrings.Instance.WF_ICMPSettings_AddD}"
                IsEnabled="False" />
        </Grid>

    </StackPanel>
</UserControl>
