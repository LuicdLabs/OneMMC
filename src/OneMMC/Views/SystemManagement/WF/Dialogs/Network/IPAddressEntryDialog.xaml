<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="OneMMC.Views.Dialogs.Network.IPAddressEntryDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:OneMMC.Localization"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <UserControl.Resources>
    </UserControl.Resources>

    <StackPanel x:Name="RootPanel" MinWidth="460" Spacing="12" Loaded="RootPanel_Loaded">
        <TextBlock Text="{x:Bind local:LocalizedStrings.Instance.WF_IPAddressEntry_SpecifyTheIPAddressesToMatch}" />

        <!-- Option 1: This IP address or subnet -->
        <RadioButton
            x:Name="SubnetRadio"
            Content="{x:Bind local:LocalizedStrings.Instance.WF_IPAddressEntry_ThisIPAddressOrSubnet}"
            GroupName="IPGroup"
            Checked="SubnetRadio_Checked" />
        <TextBox
            x:Name="SubnetTextBox"
            PlaceholderText="{x:Bind local:LocalizedStrings.Instance.WF_IPAddressEntry_EG1921681024}"
            Margin="20,0,0,0" />
        <TextBlock
            Margin="20,0,0,0"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            TextWrapping="Wrap">
            <Run Text="{x:Bind local:LocalizedStrings.Instance.WF_IPAddressEntry_Examples192168012}" /><LineBreak />
            <Run Text="{x:Bind local:LocalizedStrings.Instance.WF_IPAddressEntry_Value1921681024}" /><LineBreak />
            <Run Text="{x:Bind local:LocalizedStrings.Instance.WF_IPAddressEntry_Value20029d3b1a31420874ffFe396c43}" /><LineBreak />
            <Run Text="{x:Bind local:LocalizedStrings.Instance.WF_IPAddressEntry_Value20029d3b1a31420874ffFe390112}" />
        </TextBlock>

        <!-- Option 2: This IP address range -->
        <RadioButton
            x:Name="RangeRadio"
            Content="{x:Bind local:LocalizedStrings.Instance.WF_IPAddressEntry_ThisIPAddressRange}"
            GroupName="IPGroup"
            Checked="RangeRadio_Checked" />
        <Grid Margin="20,0,0,0" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="8" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Text="{x:Bind local:LocalizedStrings.Instance.WF_IPAddressEntry_From}" />
            <TextBox x:Name="RangeFromTextBox" Grid.Row="0" Grid.Column="1" IsEnabled="False" />
            <TextBlock Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Text="{x:Bind local:LocalizedStrings.Instance.WF_IPAddressEntry_To}" />
            <TextBox x:Name="RangeToTextBox" Grid.Row="2" Grid.Column="1" IsEnabled="False" />
        </Grid>

        <!-- Option 3: Predefined set of computers (only shown for Remote/Endpoint) -->
        <RadioButton
            x:Name="PredefinedRadio"
            Content="{x:Bind local:LocalizedStrings.Instance.WF_IPAddressEntry_PredefinedSetOfComputers}"
            GroupName="IPGroup"
            Visibility="Collapsed"
            Checked="PredefinedRadio_Checked" />
        <ComboBox
            x:Name="PredefinedComboBox"
            Margin="20,0,0,0"
            HorizontalAlignment="Stretch"
            IsEnabled="False"
            Visibility="Collapsed">
            <ComboBoxItem Content="{x:Bind local:LocalizedStrings.Instance.WF_IPAddressEntry_DefaultGateway}" Tag="Default gateway" />
            <ComboBoxItem Content="{x:Bind local:LocalizedStrings.Instance.WF_IPAddressEntry_WINSServers}" Tag="WINS servers" />
            <ComboBoxItem Content="{x:Bind local:LocalizedStrings.Instance.WF_IPAddressEntry_DHCPServers}" Tag="DHCP servers" />
            <ComboBoxItem Content="{x:Bind local:LocalizedStrings.Instance.WF_IPAddressEntry_DNSServers}" Tag="DNS servers" />
            <ComboBoxItem Content="{x:Bind local:LocalizedStrings.Instance.WF_IPAddressEntry_LocalSubnet}" Tag="Local subnet" />
            <ComboBoxItem Content="{x:Bind local:LocalizedStrings.Instance.WF_IPAddressEntry_Intranet}" Tag="Intranet" />
            <ComboBoxItem Content="{x:Bind local:LocalizedStrings.Instance.WF_IPAddressEntry_RemoteCorpNetwork}" Tag="Remote Corp Network" />
            <ComboBoxItem Content="{x:Bind local:LocalizedStrings.Instance.WF_IPAddressEntry_Internet}" Tag="Internet" />
            <ComboBoxItem Content="{x:Bind local:LocalizedStrings.Instance.WF_IPAddressEntry_PlayToRenderers}" Tag="PlayTo Renderers" />
            <ComboBoxItem Content="{x:Bind local:LocalizedStrings.Instance.WF_IPAddressEntry_CaptivePortalAddresses}" Tag="Captive Portal Addresses" />
        </ComboBox>

    </StackPanel>
</UserControl>
