<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="OneMMC.Views.Dialogs.Network.InterfaceTypesDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:OneMMC.Localization"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <UserControl.Resources>
    </UserControl.Resources>

    <StackPanel MinWidth="400" Spacing="12">

        <TextBlock
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Text="{x:Bind local:LocalizedStrings.Instance.WF_InterfaceTypes_SpecifyTheInterfaceTypesThisRuleAppliesTo}"
            TextWrapping="Wrap" />

        <RadioButton
            x:Name="AllInterfacesRadio"
            Content="{x:Bind local:LocalizedStrings.Instance.WF_Common_AllInterfaceTypes}"
            GroupName="InterfaceGroup"
            IsChecked="True" />

        <RadioButton
            x:Name="SpecificInterfacesRadio"
            Content="{x:Bind local:LocalizedStrings.Instance.WF_InterfaceTypes_TheseInterfaceTypes}"
            GroupName="InterfaceGroup" />

        <StackPanel
            x:Name="InterfaceCheckboxPanel"
            Margin="24,0,0,0"
            Spacing="8">
            <CheckBox
                x:Name="LanCheckBox"
                Content="{x:Bind local:LocalizedStrings.Instance.WF_Common_LocalAreaNetworkLAN}"
                IsChecked="True" />
            <CheckBox x:Name="WirelessCheckBox" Content="{x:Bind local:LocalizedStrings.Instance.WF_Common_Wireless}" />
            <CheckBox x:Name="RemoteAccessCheckBox" Content="{x:Bind local:LocalizedStrings.Instance.WF_Common_RemoteAccess}" />
        </StackPanel>

    </StackPanel>
</UserControl>
