<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="OneMMC.Views.Dialogs.ConnectionSecurity.ConfigureTunnelEndpointsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:OneMMC.Localization"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <UserControl.Resources>
    </UserControl.Resources>

    <ScrollViewer
        HorizontalScrollBarVisibility="Disabled"
        VerticalScrollBarVisibility="Auto"
        VerticalScrollMode="Enabled">
        <StackPanel MinWidth="780" Spacing="12">
            <TextBlock x:Name="DescriptionTextBlock" Text="{x:Bind local:LocalizedStrings.Instance.WF_TunnelEndpoints_DefaultDescription}" TextWrapping="Wrap" />

            <!--  Client section (top) — used by Client-to-gateway mode  -->
            <StackPanel x:Name="ClientTopSection" Spacing="8" Visibility="Collapsed">
                <TextBlock FontWeight="SemiBold" Text="{x:Bind local:LocalizedStrings.Instance.WF_ConfigureTunnelEndpoints_Client}" />
                <RadioButton
                    x:Name="ClientTopRadioButton"
                    Content="{x:Bind local:LocalizedStrings.Instance.WF_ConfigureTunnelEndpoints_MyIPAddress}"
                    GroupName="ClientTopGroup"
                    IsChecked="True"
                    IsEnabled="False" />
            </StackPanel>

            <!--  Endpoint 1 computers — used by Custom and Gateway-to-client  -->
            <StackPanel x:Name="Endpoint1Section" Spacing="8">
                <TextBlock x:Name="Endpoint1HeaderTextBlock" FontWeight="SemiBold" Text="{x:Bind local:LocalizedStrings.Instance.WF_TunnelEndpoints_Endpoint1Header}" />
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <ListView
                        x:Name="Endpoint1ComputersListView"
                        Grid.Column="0"
                        Height="120"
                        SelectionMode="Single" />

                    <StackPanel Grid.Column="1" Spacing="6">
                        <Button MinWidth="120" Click="Endpoint1AddButton_Click" Content="{x:Bind local:LocalizedStrings.Instance.WF_Common_AddEllipsis}" />
                        <Button MinWidth="120" Click="Endpoint1EditButton_Click" Content="{x:Bind local:LocalizedStrings.Instance.WF_Common_Edit}" />
                        <Button MinWidth="120" Click="Endpoint1RemoveButton_Click" Content="{x:Bind local:LocalizedStrings.Instance.Common_RemoveButton}" />
                    </StackPanel>
                </Grid>
            </StackPanel>

            <!--  Local tunnel endpoint — used by Custom and Gateway-to-client  -->
            <StackPanel x:Name="LocalTunnelSection" Spacing="8">
                <TextBlock FontWeight="SemiBold" Text="{x:Bind local:LocalizedStrings.Instance.WF_ConfigureTunnelEndpoints_WhatIsTheLocalTunnelEndpointClosestToEndpoint1}" />
                <Grid ColumnSpacing="8" RowSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" MinWidth="100" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Text="{x:Bind local:LocalizedStrings.Instance.WF_Common_IPv4Address}" />
                    <TextBox x:Name="LocalTunnelIpv4TextBox" Grid.Row="0" Grid.Column="1" />
                    <Button
                        x:Name="EditLocalTunnelButton"
                        Grid.Row="0"
                        Grid.Column="2"
                        MinWidth="120"
                        Click="EditLocalTunnelButton_Click"
                        Content="{x:Bind local:LocalizedStrings.Instance.WF_Common_Edit}" />

                    <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Text="{x:Bind local:LocalizedStrings.Instance.WF_Common_IPv6Address}" />
                    <TextBox x:Name="LocalTunnelIpv6TextBox" Grid.Row="1" Grid.Column="1" />
                </Grid>
            </StackPanel>

            <!--  IPsec Authorization — used by Custom and Gateway-to-client  -->
            <StackPanel x:Name="IpsecAuthorizationSection" Spacing="8">
                <CheckBox x:Name="ApplyIpsecAuthorizationCheckBox">
                    <TextBlock
                        Text="{x:Bind local:LocalizedStrings.Instance.WF_ConfigureTunnelEndpoints_ApplyIPsecTunnelAuthorizationAsSpecifiedOnTheIPsecSettingsTab}"
                        TextWrapping="Wrap" />
                </CheckBox>
            </StackPanel>

            <!--  Remote tunnel endpoint — used by Custom and Client-to-gateway  -->
            <StackPanel x:Name="RemoteTunnelSection" Spacing="8">
                <TextBlock FontWeight="SemiBold" Text="{x:Bind local:LocalizedStrings.Instance.WF_ConfigureTunnelEndpoints_WhatIsTheRemoteTunnelEndpointClosestToEndpoint2}" />
                <Grid ColumnSpacing="8" RowSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" MinWidth="100" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Text="{x:Bind local:LocalizedStrings.Instance.WF_Common_IPv4Address}" />
                    <TextBox x:Name="RemoteTunnelIpv4TextBox" Grid.Row="0" Grid.Column="1" />
                    <Button
                        x:Name="EditRemoteTunnelButton"
                        Grid.Row="0"
                        Grid.Column="2"
                        MinWidth="120"
                        Click="EditRemoteTunnelButton_Click"
                        Content="{x:Bind local:LocalizedStrings.Instance.WF_Common_Edit}" />

                    <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Text="{x:Bind local:LocalizedStrings.Instance.WF_Common_IPv6Address}" />
                    <TextBox x:Name="RemoteTunnelIpv6TextBox" Grid.Row="1" Grid.Column="1" />
                </Grid>
            </StackPanel>

            <!--  Endpoint 2 computers — used by Custom and Client-to-gateway  -->
            <StackPanel x:Name="Endpoint2Section" Spacing="8">
                <TextBlock x:Name="Endpoint2HeaderTextBlock" FontWeight="SemiBold" Text="{x:Bind local:LocalizedStrings.Instance.WF_TunnelEndpoints_Endpoint2Header}" />
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <ListView
                        x:Name="Endpoint2ComputersListView"
                        Grid.Column="0"
                        Height="120"
                        SelectionMode="Single" />

                    <StackPanel Grid.Column="1" Spacing="6">
                        <Button MinWidth="120" Click="Endpoint2AddButton_Click" Content="{x:Bind local:LocalizedStrings.Instance.WF_Common_AddEllipsis}" />
                        <Button MinWidth="120" Click="Endpoint2EditButton_Click" Content="{x:Bind local:LocalizedStrings.Instance.WF_Common_Edit}" />
                        <Button MinWidth="120" Click="Endpoint2RemoveButton_Click" Content="{x:Bind local:LocalizedStrings.Instance.Common_RemoveButton}" />
                    </StackPanel>
                </Grid>
            </StackPanel>

            <!--  Client section (bottom) — used by Gateway-to-client mode  -->
            <StackPanel x:Name="ClientBottomSection" Spacing="8" Visibility="Collapsed">
                <TextBlock FontWeight="SemiBold" Text="{x:Bind local:LocalizedStrings.Instance.WF_ConfigureTunnelEndpoints_Client}" />
                <RadioButton
                    x:Name="ClientBottomRadioButton"
                    Content="{x:Bind local:LocalizedStrings.Instance.WF_Common_AnyIPAddress}"
                    GroupName="ClientBottomGroup"
                    IsChecked="True"
                    IsEnabled="False" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
