<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="OneMMC.Views.Dialogs.ConnectionSecurity.ConfigureIPsecDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:OneMMC.Localization"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <UserControl.Resources>
        <!--  Specific Address Flyout  -->
        <Flyout x:Key="SpecificAddressFlyout" Placement="Bottom">
            <StackPanel MinWidth="400" Spacing="12">
                <TextBlock
                    FontWeight="SemiBold"
                    Text="{x:Bind local:LocalizedStrings.Instance.WF_ConfigureIPsec_SpecificAddress}"
                    TextWrapping="Wrap" />

                <Grid ColumnSpacing="8" RowSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" MinWidth="60" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock
                        Grid.Row="0"
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        Text="{x:Bind local:LocalizedStrings.Instance.WF_ConfigureIPsec_IPv4}" />
                    <TextBox
                        x:Name="FlyoutIPv4Box"
                        Grid.Row="0"
                        Grid.Column="1"
                        PlaceholderText="{x:Bind local:LocalizedStrings.Instance.WF_ConfigureIPsec_EG19216811}" />

                    <TextBlock
                        Grid.Row="1"
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        Text="{x:Bind local:LocalizedStrings.Instance.WF_ConfigureIPsec_IPv6}" />
                    <TextBox
                        x:Name="FlyoutIPv6Box"
                        Grid.Row="1"
                        Grid.Column="1"
                        PlaceholderText="{x:Bind local:LocalizedStrings.Instance.WF_ConfigureIPsec_EG2001Db81}" />
                </Grid>

                <StackPanel
                    HorizontalAlignment="Right"
                    Orientation="Horizontal"
                    Spacing="8">
                    <Button
                        x:Name="FlyoutOkButton"
                        MinWidth="80"
                        Click="FlyoutOk_Click"
                        Content="{x:Bind local:LocalizedStrings.Instance.Common_OKButton}"
                        Style="{StaticResource AccentButtonStyle}" />
                    <Button
                        x:Name="FlyoutCancelButton"
                        MinWidth="80"
                        Click="FlyoutCancel_Click"
                        Content="{x:Bind local:LocalizedStrings.Instance.Common_CancelButton}" />
                </StackPanel>
            </StackPanel>
        </Flyout>
    </UserControl.Resources>

    <StackPanel MinWidth="480" Spacing="12">

        <!--  Description  -->
        <TextBlock Text="{x:Bind local:LocalizedStrings.Instance.WF_ConfigureIPsec_ConnectionsFromEndpoint1ToEndpoint2WillPassThroughTheSpecified}" TextWrapping="Wrap" />

        <TextBlock
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Text="{x:Bind local:LocalizedStrings.Instance.WF_ConfigureIPsec_NoteWhenUsingIPsecTunnelsTheAuthenticationModeMustBeSetTo}"
            TextWrapping="Wrap" />

        <!--  Use IPsec tunnel  -->
        <CheckBox
            x:Name="UseTunnelCheckBox"
            Margin="0,4,0,0"
            Checked="UseTunnelCheckBox_Checked"
            Content="{x:Bind local:LocalizedStrings.Instance.WF_ConfigureIPsec_UseIPsecTunnelU}"
            Unchecked="UseTunnelCheckBox_Unchecked" />

        <StackPanel Margin="28,0,0,0" Spacing="4">
            <CheckBox
                x:Name="ApplyAuthorizationCheckBox"
                Content="{x:Bind local:LocalizedStrings.Instance.WF_ConfigureIPsec_ApplyAuthorizationA}"
                IsEnabled="False" />
            <CheckBox
                x:Name="ExemptIpsecCheckBox"
                Content="{x:Bind local:LocalizedStrings.Instance.WF_ConfigureIPsec_ExemptIPsecProtectedConnectionsX}"
                IsEnabled="False" />
        </StackPanel>

        <!--  Local tunnel endpoint  -->
        <TextBlock
            Margin="0,4,0,0"
            FontWeight="SemiBold"
            Text="{x:Bind local:LocalizedStrings.Instance.WF_ConfigureIPsec_LocalTunnelEndpointClosestToEndpoint1}" />

        <Grid ColumnSpacing="8" RowSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" MinWidth="60" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock
                Grid.Row="0"
                Grid.Column="0"
                VerticalAlignment="Center"
                Text="{x:Bind local:LocalizedStrings.Instance.WF_ConfigureIPsec_IPv4I}" />
            <TextBox
                x:Name="LocalIPv4Box"
                Grid.Row="0"
                Grid.Column="1"
                IsEnabled="False"
                PlaceholderText="{x:Bind local:LocalizedStrings.Instance.WF_Common_Any}" />
            <DropDownButton
                x:Name="LocalEditButton"
                Grid.Row="0"
                Grid.Column="2"
                MinWidth="90"
                Content="{x:Bind local:LocalizedStrings.Instance.WF_ConfigureIPsec_EditE}"
                IsEnabled="False">
                <DropDownButton.Flyout>
                    <MenuFlyout Placement="Bottom">
                        <MenuFlyoutItem Click="LocalAnyAddress_Click" Text="{x:Bind local:LocalizedStrings.Instance.WF_Common_AnyAddressForDynamicTunnelConfiguration}" />
                        <MenuFlyoutItem Click="LocalSpecificAddress_Click" Text="{x:Bind local:LocalizedStrings.Instance.WF_Common_SpecificAddress}" />
                    </MenuFlyout>
                </DropDownButton.Flyout>
            </DropDownButton>

            <TextBlock
                Grid.Row="1"
                Grid.Column="0"
                VerticalAlignment="Center"
                Text="{x:Bind local:LocalizedStrings.Instance.WF_ConfigureIPsec_IPv6P}" />
            <TextBox
                x:Name="LocalIPv6Box"
                Grid.Row="1"
                Grid.Column="1"
                IsEnabled="False"
                PlaceholderText="{x:Bind local:LocalizedStrings.Instance.WF_Common_Any}" />
        </Grid>

        <!--  Remote tunnel endpoint  -->
        <TextBlock
            Margin="0,4,0,0"
            FontWeight="SemiBold"
            Text="{x:Bind local:LocalizedStrings.Instance.WF_ConfigureIPsec_RemoteTunnelEndpointClosestToEndpoint2}" />

        <Grid ColumnSpacing="8" RowSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" MinWidth="60" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock
                Grid.Row="0"
                Grid.Column="0"
                VerticalAlignment="Center"
                Text="{x:Bind local:LocalizedStrings.Instance.WF_ConfigureIPsec_IPv4V}" />
            <TextBox
                x:Name="RemoteIPv4Box"
                Grid.Row="0"
                Grid.Column="1"
                IsEnabled="False"
                PlaceholderText="{x:Bind local:LocalizedStrings.Instance.WF_Common_Any}" />
            <DropDownButton
                x:Name="RemoteEditButton"
                Grid.Row="0"
                Grid.Column="2"
                MinWidth="90"
                Content="{x:Bind local:LocalizedStrings.Instance.WF_ConfigureIPsec_EditD}"
                IsEnabled="False">
                <DropDownButton.Flyout>
                    <MenuFlyout Placement="Bottom">
                        <MenuFlyoutItem Click="RemoteAnyAddress_Click" Text="{x:Bind local:LocalizedStrings.Instance.WF_Common_AnyAddressForDynamicTunnelConfiguration}" />
                        <MenuFlyoutItem Click="RemoteSpecificAddress_Click" Text="{x:Bind local:LocalizedStrings.Instance.WF_Common_SpecificAddress}" />
                    </MenuFlyout>
                </DropDownButton.Flyout>
            </DropDownButton>

            <TextBlock
                Grid.Row="1"
                Grid.Column="0"
                VerticalAlignment="Center"
                Text="{x:Bind local:LocalizedStrings.Instance.WF_ConfigureIPsec_IPv66}" />
            <TextBox
                x:Name="RemoteIPv6Box"
                Grid.Row="1"
                Grid.Column="1"
                IsEnabled="False"
                PlaceholderText="{x:Bind local:LocalizedStrings.Instance.WF_Common_Any}" />
        </Grid>

    </StackPanel>
</UserControl>
