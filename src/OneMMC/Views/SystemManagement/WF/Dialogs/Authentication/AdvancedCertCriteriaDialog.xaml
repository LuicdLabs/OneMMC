<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="OneMMC.Views.Dialogs.Authentication.AdvancedCertCriteriaDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:OneMMC.Localization"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <UserControl.Resources>
    </UserControl.Resources>

    <ScrollViewer
        HorizontalScrollBarVisibility="Disabled"
        VerticalScrollBarVisibility="Auto"
        VerticalScrollMode="Enabled">
        <StackPanel MinWidth="480" Spacing="16">
            <TextBlock
                x:Name="ValidationMessageTextBlock"
                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                TextWrapping="Wrap"
                Visibility="Collapsed" />

            <!-- Restrict usage -->
            <Border
                Padding="12"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="4">
                <StackPanel Spacing="8">
                    <TextBlock FontWeight="SemiBold" Text="{x:Bind local:LocalizedStrings.Instance.WF_AdvancedCertCriteria_RestrictUsage}" />
                    <StackPanel Orientation="Horizontal" Spacing="24">
                        <RadioButton
                            x:Name="NoRestrictionRadio"
                            Content="{x:Bind local:LocalizedStrings.Instance.WF_AdvancedCertCriteria_NoRestrictionDefault}"
                            GroupName="RestrictGroup"
                            IsChecked="True" />
                        <RadioButton
                            x:Name="SelectionOnlyRadio"
                            Content="{x:Bind local:LocalizedStrings.Instance.WF_AdvancedCriteria_RestrictSelectionOnly}"
                            GroupName="RestrictGroup" />
                        <RadioButton
                            x:Name="ValidationOnlyRadio"
                            Content="{x:Bind local:LocalizedStrings.Instance.WF_AdvancedCriteria_RestrictValidationOnly}"
                            GroupName="RestrictGroup" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Enhanced key usage (EKU) -->
            <Border
                Padding="12"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="4">
                <StackPanel Spacing="8">
                    <TextBlock FontWeight="SemiBold" Text="{x:Bind local:LocalizedStrings.Instance.WF_AdvancedCertCriteria_EnhancedKeyUsageEKU}" />
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- EKU dropdown -->
                        <ComboBox
                            x:Name="EkuCombo"
                            Grid.Row="0" Grid.Column="0"
                            HorizontalAlignment="Stretch"
                            SelectionChanged="EkuCombo_SelectionChanged"
                            SelectedIndex="0">
                            <ComboBoxItem Content="{x:Bind local:LocalizedStrings.Instance.WF_AdvancedCertCriteria_IPsecSecurityIKEIntermediate13615582}" Tag="IPsec security IKE intermediate (1.3.6.1.5.5.8.2.2)" />
                            <ComboBoxItem Content="{x:Bind local:LocalizedStrings.Instance.WF_AdvancedCertCriteria_DNSSEC1361413116411}" Tag="DNSSEC (1.3.6.1.4.1.311.64.1.1)" />
                            <ComboBoxItem Content="{x:Bind local:LocalizedStrings.Instance.WF_AdvancedCertCriteria_ClientAuthentication136155732}" Tag="Client Authentication (1.3.6.1.5.5.7.3.2)" />
                            <ComboBoxItem Content="{x:Bind local:LocalizedStrings.Instance.WF_AdvancedCertCriteria_ServerAuthentication136155731}" Tag="Server Authentication (1.3.6.1.5.5.7.3.1)" />
                            <ComboBoxItem Content="{x:Bind local:LocalizedStrings.Instance.WF_AdvancedCertCriteria_CustomEKU}" Tag="Custom" />
                        </ComboBox>

                        <StackPanel Grid.Row="0" Grid.Column="1" Grid.RowSpan="2" Spacing="4" VerticalAlignment="Top">
                            <Button x:Name="EkuAddButton" Content="{x:Bind local:LocalizedStrings.Instance.WF_AdvancedCertCriteria_Add}" Click="EkuAddButton_Click" HorizontalAlignment="Stretch" />
                            <Button x:Name="EkuRemoveButton" Content="{x:Bind local:LocalizedStrings.Instance.WF_AdvancedCertCriteria_Remove}" Click="EkuRemoveButton_Click" HorizontalAlignment="Stretch" />
                        </StackPanel>

                        <TextBlock
                            Grid.Row="0" Grid.Column="2"
                            HorizontalAlignment="Right"
                            Text="{x:Bind local:LocalizedStrings.Instance.WF_AdvancedCertCriteria_RequiredEKUs}" />

                        <!-- Custom EKU text input -->
                        <TextBox
                            x:Name="CustomEkuTextBox"
                            Grid.Row="1" Grid.Column="0"
                            Visibility="Collapsed"
                            PlaceholderText="{x:Bind local:LocalizedStrings.Instance.WF_AdvancedCertCriteria_CustomOIDEG1234}" />

                        <!-- Required EKUs list -->
                        <ListView
                            x:Name="RequiredEkuList"
                            Grid.Row="1" Grid.Column="2"
                            Grid.RowSpan="2"
                            MinHeight="80" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Certificate name restriction -->
            <Border
                Padding="12"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="4">
                <StackPanel Spacing="8">
                    <TextBlock FontWeight="SemiBold" Text="{x:Bind local:LocalizedStrings.Instance.WF_AdvancedCertCriteria_CertificateNameRestriction}" />
                    <Grid ColumnSpacing="12" RowSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Text="{x:Bind local:LocalizedStrings.Instance.WF_AdvancedCertCriteria_SelectNameType}" />
                        <ComboBox x:Name="NameTypeCombo" Grid.Row="0" Grid.Column="1" HorizontalAlignment="Stretch" SelectedIndex="0">
                            <ComboBoxItem Content="{x:Bind local:LocalizedStrings.Instance.WF_Common_None}" Tag="None" />
                            <ComboBoxItem Content="{x:Bind local:LocalizedStrings.Instance.WF_AdvancedCertCriteria_SubjectAlternativeNameEmail}" Tag="SANEmail" />
                            <ComboBoxItem Content="{x:Bind local:LocalizedStrings.Instance.WF_AdvancedCertCriteria_SubjectAlternativeNameDNS}" Tag="SANDNS" />
                            <ComboBoxItem Content="{x:Bind local:LocalizedStrings.Instance.WF_AdvancedCertCriteria_SubjectAlternativeNamePrincipal}" Tag="SANPrincipal" />
                            <ComboBoxItem Content="{x:Bind local:LocalizedStrings.Instance.WF_AdvancedCertCriteria_SubjectOU}" Tag="SubjectOU" />
                            <ComboBoxItem Content="{x:Bind local:LocalizedStrings.Instance.WF_AdvancedCertCriteria_SubjectO}" Tag="SubjectO" />
                            <ComboBoxItem Content="{x:Bind local:LocalizedStrings.Instance.WF_AdvancedCertCriteria_SubjectCN}" Tag="SubjectCN" />
                            <ComboBoxItem Content="{x:Bind local:LocalizedStrings.Instance.WF_AdvancedCertCriteria_SubjectDC}" Tag="SubjectDC" />
                        </ComboBox>
                        <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Text="{x:Bind local:LocalizedStrings.Instance.WF_AdvancedCertCriteria_CertificateName}" />
                        <TextBox x:Name="CertNameTextBox" Grid.Row="1" Grid.Column="1" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Certificate thumbprint -->
            <Border
                Padding="12"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="4">
                <StackPanel Spacing="8">
                    <TextBlock FontWeight="SemiBold" Text="{x:Bind local:LocalizedStrings.Instance.WF_AdvancedCertCriteria_CertificateThumbprint}" />
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="{x:Bind local:LocalizedStrings.Instance.WF_AdvancedCertCriteria_Thumbprint}" />
                        <TextBox x:Name="ThumbprintTextBox" Grid.Column="1" />
                    </Grid>
                    <CheckBox x:Name="FollowRenewalCheckBox" Content="{x:Bind local:LocalizedStrings.Instance.WF_AdvancedCertCriteria_FollowCertificateRenewal}" />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
