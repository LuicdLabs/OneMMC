<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="OneMMC.Views.Dialogs.Authentication.CustomizeAuthMethodsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:OneMMC.Localization"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <UserControl.Resources>
        <local:LocalizedStrings x:Key="LocalizedStrings" />
    </UserControl.Resources>

    <Grid MinWidth="520" MinHeight="480">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="6">
            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="{Binding WF_CustomizeAuthMethods_ConfigureTheFirstAndSecondAuthenticationMethodsForThisConnectionSecurityRule, Source={StaticResource LocalizedStrings}}"
                TextWrapping="Wrap" />
            <TextBlock
                x:Name="ValidationMessageTextBlock"
                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                TextWrapping="Wrap"
                Visibility="Collapsed" />
        </StackPanel>

        <!-- First authentication -->
        <TextBlock
            Grid.Row="1"
            Margin="0,12,0,4"
            FontWeight="SemiBold"
            Text="{Binding WF_CustomizeAuthMethods_FirstAuthenticationMethods, Source={StaticResource LocalizedStrings}}" />

        <CheckBox
            x:Name="FirstAuthOptionalCheckBox"
            Grid.Row="2"
            Margin="0,0,0,6"
            Content="{Binding WF_CustomizeAuthMethods_FirstAuthenticationIsOptional, Source={StaticResource LocalizedStrings}}" />

        <Border
            Grid.Row="3"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="4">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <ListView
                    x:Name="FirstAuthListView"
                    Grid.Row="0"
                    MaxHeight="160"
                    SelectionMode="Single">
                    <ListView.Header>
                        <Grid
                            Padding="12,6"
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" FontWeight="SemiBold" Style="{StaticResource CaptionTextBlockStyle}" Text="{Binding WF_Common_Method, Source={StaticResource LocalizedStrings}}" />
                            <TextBlock Grid.Column="1" FontWeight="SemiBold" Style="{StaticResource CaptionTextBlockStyle}" Text="{Binding WF_Common_Details, Source={StaticResource LocalizedStrings}}" />
                        </Grid>
                    </ListView.Header>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="0,4" ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Method}" TextWrapping="Wrap" />
                                <TextBlock Grid.Column="1" Text="{Binding Details}" TextWrapping="Wrap" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <StackPanel
                    Grid.Row="1"
                    Padding="8"
                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                    Orientation="Horizontal"
                    Spacing="8">
                    <Button x:Name="FirstAddButton" Content="{Binding Common_AddButton, Source={StaticResource LocalizedStrings}}" Click="FirstAddButton_Click" />
                    <Button x:Name="FirstEditButton" Content="{Binding Common_EditButton, Source={StaticResource LocalizedStrings}}" Click="FirstEditButton_Click" />
                    <Button x:Name="FirstDeleteButton" Content="{Binding Common_DeleteButton, Source={StaticResource LocalizedStrings}}" Click="FirstDeleteButton_Click" />
                    <Button x:Name="FirstMoveUpButton" Content="{Binding WF_CustomizeAuthMethods_MoveUp, Source={StaticResource LocalizedStrings}}" Click="FirstMoveUpButton_Click" />
                    <Button x:Name="FirstMoveDownButton" Content="{Binding WF_CustomizeAuthMethods_MoveDown, Source={StaticResource LocalizedStrings}}" Click="FirstMoveDownButton_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Second authentication -->
        <TextBlock
            Grid.Row="4"
            Margin="0,12,0,4"
            FontWeight="SemiBold"
            Text="{Binding WF_CustomizeAuthMethods_SecondAuthenticationMethods, Source={StaticResource LocalizedStrings}}" />

        <CheckBox
            x:Name="SecondAuthOptionalCheckBox"
            Grid.Row="5"
            Margin="0,0,0,6"
            Content="{Binding WF_CustomizeAuthMethods_SecondAuthenticationIsOptional, Source={StaticResource LocalizedStrings}}" />

        <Border
            Grid.Row="6"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="4">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <ListView
                    x:Name="SecondAuthListView"
                    Grid.Row="0"
                    MaxHeight="140"
                    SelectionMode="Single">
                    <ListView.Header>
                        <Grid
                            Padding="12,6"
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" FontWeight="SemiBold" Style="{StaticResource CaptionTextBlockStyle}" Text="{Binding WF_Common_Method, Source={StaticResource LocalizedStrings}}" />
                            <TextBlock Grid.Column="1" FontWeight="SemiBold" Style="{StaticResource CaptionTextBlockStyle}" Text="{Binding WF_Common_Details, Source={StaticResource LocalizedStrings}}" />
                        </Grid>
                    </ListView.Header>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="0,4" ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Method}" TextWrapping="Wrap" />
                                <TextBlock Grid.Column="1" Text="{Binding Details}" TextWrapping="Wrap" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <StackPanel
                    Grid.Row="1"
                    Padding="8"
                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                    Orientation="Horizontal"
                    Spacing="8">
                    <Button x:Name="SecondAddButton" Content="{Binding Common_AddButton, Source={StaticResource LocalizedStrings}}" Click="SecondAddButton_Click" />
                    <Button x:Name="SecondEditButton" Content="{Binding Common_EditButton, Source={StaticResource LocalizedStrings}}" Click="SecondEditButton_Click" />
                    <Button x:Name="SecondDeleteButton" Content="{Binding Common_DeleteButton, Source={StaticResource LocalizedStrings}}" Click="SecondDeleteButton_Click" />
                    <Button x:Name="SecondMoveUpButton" Content="{Binding WF_CustomizeAuthMethods_MoveUp, Source={StaticResource LocalizedStrings}}" Click="SecondMoveUpButton_Click" />
                    <Button x:Name="SecondMoveDownButton" Content="{Binding WF_CustomizeAuthMethods_MoveDown, Source={StaticResource LocalizedStrings}}" Click="SecondMoveDownButton_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <TextBlock
            Grid.Row="7"
            Margin="0,6,0,0"
            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
            Text="{Binding WF_CustomizeAuthMethods_SecondAuthenticationPresharedKeyNote, Source={StaticResource LocalizedStrings}}"
            TextWrapping="Wrap" />

    </Grid>
</UserControl>
