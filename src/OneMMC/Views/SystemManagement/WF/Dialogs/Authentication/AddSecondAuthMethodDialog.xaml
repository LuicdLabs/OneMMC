<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="OneMMC.Views.Dialogs.Authentication.AddSecondAuthMethodDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:OneMMC.Localization"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <UserControl.Resources>
    </UserControl.Resources>

    <ScrollViewer
        HorizontalScrollBarVisibility="Disabled"
        VerticalScrollBarVisibility="Auto"
        VerticalScrollMode="Enabled">
        <StackPanel MinWidth="440" Spacing="8">

            <TextBlock Text="{x:Bind local:LocalizedStrings.Instance.WF_AddSecondAuthMethod_SelectTheCredentialToUseForTheSecondAuthentication}" TextWrapping="Wrap" />
            <TextBlock
                x:Name="ValidationMessageTextBlock"
                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                TextWrapping="Wrap"
                Visibility="Collapsed" />

            <!-- User (Kerberos V5) -->
            <RadioButton
                x:Name="UserKerberosRadio"
                Content="{x:Bind local:LocalizedStrings.Instance.WF_Common_UserKerberosV5}"
                GroupName="SecondAuthGroup"
                IsChecked="True" />

            <!-- User (NTLMv2) -->
            <RadioButton
                x:Name="UserNtlmRadio"
                Content="{x:Bind local:LocalizedStrings.Instance.WF_AuthMethod_UserNtlm}"
                GroupName="SecondAuthGroup" />

            <!-- User certificate from CA -->
            <RadioButton
                x:Name="UserCertRadio"
                Content="{x:Bind local:LocalizedStrings.Instance.WF_AddSecondAuthMethod_UserCertificateFromThisCertificationAuthorityCA}"
                GroupName="SecondAuthGroup"
                Checked="UserCertRadio_Checked"
                Unchecked="UserCertRadio_Unchecked" />

            <StackPanel
                x:Name="UserCertPanel"
                Margin="24,0,0,0"
                Spacing="8">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Text="{x:Bind local:LocalizedStrings.Instance.WF_Common_SigningAlgorithm}" />
                    <ComboBox x:Name="UserSigningAlgoCombo" Grid.Row="0" Grid.Column="1" SelectedIndex="0">
                        <ComboBoxItem Content="{x:Bind local:LocalizedStrings.Instance.WF_SigningAlgorithm_RsaDefault}" Tag="RSA" />
                        <ComboBoxItem Content="{x:Bind local:LocalizedStrings.Instance.WF_SigningAlgorithm_EcdsaP256}" Tag="ECDSA-P256" />
                        <ComboBoxItem Content="{x:Bind local:LocalizedStrings.Instance.WF_SigningAlgorithm_EcdsaP384}" Tag="ECDSA-P384" />
                    </ComboBox>
                    <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,8,0,0" VerticalAlignment="Center" Text="{x:Bind local:LocalizedStrings.Instance.WF_Common_CertificateStoreType}" />
                    <ComboBox x:Name="UserCertStoreCombo" Grid.Row="1" Grid.Column="1" Margin="0,8,0,0" SelectedIndex="0">
                        <ComboBoxItem Content="{x:Bind local:LocalizedStrings.Instance.WF_CertificateStore_RootCADefault}" Tag="RootCA" />
                        <ComboBoxItem Content="{x:Bind local:LocalizedStrings.Instance.WF_CertificateStore_IntermediateCA}" Tag="IntermediateCA" />
                    </ComboBox>
                </Grid>
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBox x:Name="UserCertCATextBox" Grid.Row="0" Grid.Column="0" PlaceholderText="{x:Bind local:LocalizedStrings.Instance.WF_Common_CADistinguishedName}" />
                    <Button x:Name="UserBrowseButton" Grid.Row="0" Grid.Column="1" Content="{x:Bind local:LocalizedStrings.Instance.WF_Common_Browse}" Click="UserBrowseButton_Click" />
                    <CheckBox x:Name="UserCertMappingCheckBox" Grid.Row="1" Grid.Column="0" Content="{x:Bind local:LocalizedStrings.Instance.WF_Common_EnableCertificateToAccountMapping}" />
                    <Button x:Name="UserAdvancedButton" Grid.Row="1" Grid.Column="1" Content="{x:Bind local:LocalizedStrings.Instance.WF_Common_AdvancedEllipsis}" Click="UserAdvancedButton_Click" />
                </Grid>
            </StackPanel>

            <!-- Computer health certificate from CA -->
            <RadioButton
                x:Name="ComputerHealthCertRadio"
                Content="{x:Bind local:LocalizedStrings.Instance.WF_AddSecondAuthMethod_ComputerHealthCertificateFromThisCertificationAuthorityCA}"
                GroupName="SecondAuthGroup"
                Checked="ComputerHealthCertRadio_Checked"
                Unchecked="ComputerHealthCertRadio_Unchecked" />

            <StackPanel
                x:Name="ComputerCertPanel"
                Margin="24,0,0,0"
                Spacing="8">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Text="{x:Bind local:LocalizedStrings.Instance.WF_Common_SigningAlgorithm}" />
                    <ComboBox x:Name="CompSigningAlgoCombo" Grid.Row="0" Grid.Column="1" SelectedIndex="0">
                        <ComboBoxItem Content="{x:Bind local:LocalizedStrings.Instance.WF_SigningAlgorithm_RsaDefault}" Tag="RSA" />
                        <ComboBoxItem Content="{x:Bind local:LocalizedStrings.Instance.WF_SigningAlgorithm_EcdsaP256}" Tag="ECDSA-P256" />
                        <ComboBoxItem Content="{x:Bind local:LocalizedStrings.Instance.WF_SigningAlgorithm_EcdsaP384}" Tag="ECDSA-P384" />
                    </ComboBox>
                    <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,8,0,0" VerticalAlignment="Center" Text="{x:Bind local:LocalizedStrings.Instance.WF_Common_CertificateStoreType}" />
                    <ComboBox x:Name="CompCertStoreCombo" Grid.Row="1" Grid.Column="1" Margin="0,8,0,0" SelectedIndex="0">
                        <ComboBoxItem Content="{x:Bind local:LocalizedStrings.Instance.WF_CertificateStore_RootCADefault}" Tag="RootCA" />
                        <ComboBoxItem Content="{x:Bind local:LocalizedStrings.Instance.WF_CertificateStore_IntermediateCA}" Tag="IntermediateCA" />
                    </ComboBox>
                </Grid>
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBox x:Name="CompCertCATextBox" Grid.Row="0" Grid.Column="0" PlaceholderText="{x:Bind local:LocalizedStrings.Instance.WF_Common_CADistinguishedName}" />
                    <Button x:Name="CompBrowseButton" Grid.Row="0" Grid.Column="1" Content="{x:Bind local:LocalizedStrings.Instance.WF_Common_Browse}" Click="CompBrowseButton_Click" />
                    <CheckBox x:Name="CompCertMappingCheckBox" Grid.Row="1" Grid.Column="0" Content="{x:Bind local:LocalizedStrings.Instance.WF_Common_EnableCertificateToAccountMapping}" />
                    <Button x:Name="CompAdvancedButton" Grid.Row="1" Grid.Column="1" Content="{x:Bind local:LocalizedStrings.Instance.WF_Common_AdvancedEllipsis}" Click="CompAdvancedButton_Click" />
                </Grid>
            </StackPanel>

            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="{x:Bind local:LocalizedStrings.Instance.WF_AddSecondAuthMethod_NoteYouCannotUseBothUserCredentialsAndComputerCredentialsInThe}"
                TextWrapping="Wrap" />

        </StackPanel>
    </ScrollViewer>
</UserControl>
