<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="OneMMC.Views.Dialogs.Authentication.AddFirstAuthMethodDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:OneMMC.Localization"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <UserControl.Resources>
    </UserControl.Resources>

    <ScrollViewer
        HorizontalScrollBarVisibility="Disabled"
        VerticalScrollBarVisibility="Auto"
        VerticalScrollMode="Enabled">
        <StackPanel MinWidth="420" Spacing="8">

            <TextBlock Text="{x:Bind local:LocalizedStrings.Instance.WF_AddFirstAuthMethod_SelectTheCredentialToUseForFirstAuthentication}" TextWrapping="Wrap" />
            <TextBlock
                x:Name="ValidationMessageTextBlock"
                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                TextWrapping="Wrap"
                Visibility="Collapsed" />

            <!-- Computer (Kerberos V5) -->
            <RadioButton
                x:Name="KerberosRadio"
                Content="{x:Bind local:LocalizedStrings.Instance.WF_Common_ComputerKerberosV5}"
                GroupName="FirstAuthGroup"
                IsChecked="True" />

            <!-- Computer (NTLMv2) -->
            <RadioButton
                x:Name="NtlmRadio"
                Content="{x:Bind local:LocalizedStrings.Instance.WF_AuthMethod_ComputerNtlm}"
                GroupName="FirstAuthGroup" />

            <!-- Computer certificate from CA -->
            <RadioButton
                x:Name="CertRadio"
                Content="{x:Bind local:LocalizedStrings.Instance.WF_AddFirstAuthMethod_ComputerCertificateFromThisCertificationAuthorityCA}"
                GroupName="FirstAuthGroup"
                Checked="CertRadio_Checked"
                Unchecked="CertRadio_Unchecked" />

            <StackPanel
                x:Name="CertPanel"
                Margin="24,0,0,0"
                Spacing="8">

                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock
                        Grid.Row="0" Grid.Column="0"
                        VerticalAlignment="Center"
                        Text="{x:Bind local:LocalizedStrings.Instance.WF_Common_SigningAlgorithm}" />
                    <ComboBox
                        x:Name="SigningAlgorithmCombo"
                        Grid.Row="0" Grid.Column="1"
                        SelectedIndex="0">
                        <ComboBoxItem Content="{x:Bind local:LocalizedStrings.Instance.WF_SigningAlgorithm_RsaDefault}" Tag="RSA" />
                        <ComboBoxItem Content="{x:Bind local:LocalizedStrings.Instance.WF_SigningAlgorithm_EcdsaP256}" Tag="ECDSA-P256" />
                        <ComboBoxItem Content="{x:Bind local:LocalizedStrings.Instance.WF_SigningAlgorithm_EcdsaP384}" Tag="ECDSA-P384" />
                    </ComboBox>
                    <TextBlock
                        Grid.Row="1" Grid.Column="0"
                        Margin="0,8,0,0"
                        VerticalAlignment="Center"
                        Text="{x:Bind local:LocalizedStrings.Instance.WF_Common_CertificateStoreType}" />
                    <ComboBox
                        x:Name="CertStoreTypeCombo"
                        Grid.Row="1" Grid.Column="1"
                        Margin="0,8,0,0"
                        SelectedIndex="0">
                        <ComboBoxItem Content="{x:Bind local:LocalizedStrings.Instance.WF_CertificateStore_RootCADefault}" Tag="RootCA" />
                        <ComboBoxItem Content="{x:Bind local:LocalizedStrings.Instance.WF_CertificateStore_IntermediateCA}" Tag="IntermediateCA" />
                    </ComboBox>
                </Grid>

                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBox
                        x:Name="CertCATextBox"
                        Grid.Row="0" Grid.Column="0"
                        PlaceholderText="{x:Bind local:LocalizedStrings.Instance.WF_Common_CADistinguishedName}" />
                    <Button
                        x:Name="BrowseButton"
                        Grid.Row="0" Grid.Column="1"
                        Content="{x:Bind local:LocalizedStrings.Instance.WF_Common_Browse}"
                        Click="BrowseButton_Click" />
                    <CheckBox
                        x:Name="HealthCertCheckBox"
                        Grid.Row="1" Grid.Column="0"
                        Content="{x:Bind local:LocalizedStrings.Instance.WF_Common_AcceptOnlyHealthCertificates}" />
                    <Button
                        x:Name="AdvancedButton"
                        Grid.Row="1" Grid.Column="1"
                        Content="{x:Bind local:LocalizedStrings.Instance.WF_Common_AdvancedEllipsis}"
                        Click="AdvancedButton_Click" />
                </Grid>

                <CheckBox x:Name="CertMappingCheckBox" Content="{x:Bind local:LocalizedStrings.Instance.WF_Common_EnableCertificateToAccountMapping}" />
            </StackPanel>

            <!-- Preshared key -->
            <RadioButton
                x:Name="PresharedRadio"
                Content="{x:Bind local:LocalizedStrings.Instance.WF_AddFirstAuthMethod_PresharedKeyNotRecommended}"
                GroupName="FirstAuthGroup"
                Checked="PresharedRadio_Checked"
                Unchecked="PresharedRadio_Unchecked" />

            <TextBox
                x:Name="PresharedKeyTextBox"
                Margin="24,0,0,0"
                IsEnabled="False"
                PlaceholderText="{x:Bind local:LocalizedStrings.Instance.WF_AddFirstAuthMethod_EnterPresharedKey}" />

            <TextBlock
                Margin="0,4,0,0"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="{x:Bind local:LocalizedStrings.Instance.WF_AddFirstAuthMethod_PresharedKeyAuthenticationIsLessSecureThanOtherAuthenticationMethodsPresharedKeys}"
                TextWrapping="Wrap" />

        </StackPanel>
    </ScrollViewer>
</UserControl>
