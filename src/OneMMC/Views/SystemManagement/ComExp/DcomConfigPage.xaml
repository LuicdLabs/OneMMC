<Page
    x:Class="OneMMC.Views.ComExp.DcomConfigPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:localization="using:OneMMC.Localization"
    xmlns:converters="using:OneMMC.Converters"
    xmlns:core="using:OneMMC.Core.Features.SystemManagement.Models.ComExp"
    mc:Ignorable="d">

    <Page.Resources>
        <localization:LocalizedStrings x:Key="LocalizedStrings" />
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />

        <Style x:Key="PropertyHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

        <Style x:Key="PropertyLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="Margin" Value="0,0,8,4" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>

        <Style x:Key="PropertyValueStyle" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="IsTextSelectionEnabled" Value="True" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>
    </Page.Resources>

    <Grid RowDefinitions="Auto,*">
        <CommandBar DefaultLabelPosition="Right">
            <AppBarButton Icon="Refresh" Label="{x:Bind LocalizedStrings.ComExp_RefreshButton}" Click="RefreshButton_Click" />
        </CommandBar>

        <Grid Grid.Row="1" ColumnDefinitions="2*,3*" RowDefinitions="*,Auto" Padding="24,8,24,24">
            <ListView
                ItemsSource="{x:Bind ViewModel.Applications, Mode=OneWay}"
                SelectedItem="{x:Bind ViewModel.SelectedApplication, Mode=TwoWay}">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="core:DcomApplicationInfo">
                        <StackPanel Padding="8">
                            <TextBlock FontWeight="SemiBold" Text="{x:Bind Name}" />
                            <TextBlock FontSize="12" Opacity="0.7" Text="{x:Bind AppId}" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <ScrollViewer Grid.Column="1" Padding="16,0,0,0">
                <StackPanel Spacing="8">
                    <TextBlock Text="{x:Bind LocalizedStrings.ComExp_Application_Description}" Style="{StaticResource PropertyHeaderStyle}" />

                    <Grid ColumnDefinitions="140,*">
                        <TextBlock Text="{x:Bind LocalizedStrings.ComExp_Application_Name}" Style="{StaticResource PropertyLabelStyle}" />
                        <TextBlock Grid.Column="1" Style="{StaticResource PropertyValueStyle}" Text="{x:Bind ViewModel.SelectedApplicationName, Mode=OneWay}" />
                    </Grid>

                    <Grid ColumnDefinitions="140,*">
                        <TextBlock Text="{x:Bind LocalizedStrings.ComExp_Dcom_AppId}" Style="{StaticResource PropertyLabelStyle}" />
                        <TextBlock Grid.Column="1" Style="{StaticResource PropertyValueStyle}" Text="{x:Bind ViewModel.SelectedApplicationAppId, Mode=OneWay}" />
                    </Grid>

                    <Grid ColumnDefinitions="140,*">
                        <TextBlock Text="{x:Bind LocalizedStrings.ComExp_Dcom_LocalService}" Style="{StaticResource PropertyLabelStyle}" />
                        <TextBlock Grid.Column="1" Style="{StaticResource PropertyValueStyle}" Text="{x:Bind ViewModel.SelectedApplicationLocalService, Mode=OneWay}" />
                    </Grid>

                    <Grid ColumnDefinitions="140,*">
                        <TextBlock Text="{x:Bind LocalizedStrings.ComExp_Dcom_RunAs}" Style="{StaticResource PropertyLabelStyle}" />
                        <TextBlock Grid.Column="1" Style="{StaticResource PropertyValueStyle}" Text="{x:Bind ViewModel.SelectedApplicationRunAs, Mode=OneWay}" />
                    </Grid>

                    <Grid ColumnDefinitions="140,*">
                        <TextBlock Text="{x:Bind LocalizedStrings.ComExp_Dcom_DllSurrogate}" Style="{StaticResource PropertyLabelStyle}" />
                        <TextBlock Grid.Column="1" Style="{StaticResource PropertyValueStyle}" Text="{x:Bind ViewModel.SelectedApplicationDllSurrogate, Mode=OneWay}" />
                    </Grid>

                    <Grid ColumnDefinitions="140,*">
                        <TextBlock Text="{x:Bind LocalizedStrings.ComExp_Dcom_ServiceParameters}" Style="{StaticResource PropertyLabelStyle}" />
                        <TextBlock Grid.Column="1" Style="{StaticResource PropertyValueStyle}" Text="{x:Bind ViewModel.SelectedApplicationServiceParameters, Mode=OneWay}" />
                    </Grid>
                </StackPanel>
            </ScrollViewer>

            <Grid Grid.Row="1" Grid.ColumnSpan="2" ColumnDefinitions="*,Auto" Padding="8,12,8,0">
                <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" />
                <ProgressRing
                    Grid.Column="1"
                    Width="20"
                    Height="20"
                    IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.IsLoading, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}" />
            </Grid>
        </Grid>
    </Grid>
</Page>
