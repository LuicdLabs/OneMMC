<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="OneMMC.Views.ComExp.DcomPropertiesDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    CloseButtonText="{x:Bind LocalizedStrings.ComExp_Dialog_Close}"
    Style="{StaticResource DefaultContentDialogStyle}"
    mc:Ignorable="d">

    <ContentDialog.Resources>
        <Style x:Key="PropertyLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="Margin" Value="0,0,8,4" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>

        <Style x:Key="PropertyValueStyle" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="IsTextSelectionEnabled" Value="True" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>
    </ContentDialog.Resources>

    <Grid MinWidth="480" MinHeight="480">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12" Spacing="2">
            <TextBlock
                x:Name="AppTitle"
                Style="{StaticResource SubtitleTextBlockStyle}"
                TextWrapping="Wrap" />
            <TextBlock
                x:Name="AppIdText"
                FontFamily="Consolas"
                FontSize="12"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                IsTextSelectionEnabled="True"
                TextWrapping="Wrap" />
        </StackPanel>

        <!-- SelectorBar -->
        <muxc:SelectorBar
            x:Name="DcomPropertiesSelectorBar"
            Grid.Row="1"
            Margin="0,0,0,12"
            SelectionChanged="DcomPropertiesSelectorBar_SelectionChanged">
            <muxc:SelectorBarItem IsSelected="True" Tag="General" Text="{x:Bind LocalizedStrings.ComExp_Dcom_Tab_General}" />
            <muxc:SelectorBarItem Tag="Location" Text="{x:Bind LocalizedStrings.ComExp_Dcom_Tab_Location}" />
            <muxc:SelectorBarItem Tag="Security" Text="{x:Bind LocalizedStrings.ComExp_Dcom_Tab_Security}" />
            <muxc:SelectorBarItem Tag="Endpoints" Text="{x:Bind LocalizedStrings.ComExp_Dcom_Tab_Endpoints}" />
            <muxc:SelectorBarItem Tag="Identity" Text="{x:Bind LocalizedStrings.ComExp_Dcom_Tab_Identity}" />
        </muxc:SelectorBar>

        <!-- Content -->
        <Grid Grid.Row="2">
            <!-- General -->
            <ScrollViewer x:Name="GeneralPanel" Visibility="Visible">
                <StackPanel Spacing="8">
                    <Grid ColumnDefinitions="150,*">
                        <TextBlock Text="{x:Bind LocalizedStrings.ComExp_Dcom_ApplicationName}" Style="{StaticResource PropertyLabelStyle}" />
                        <TextBlock x:Name="GeneralNameText" Grid.Column="1" Style="{StaticResource PropertyValueStyle}" />
                    </Grid>
                    <Grid ColumnDefinitions="150,*">
                        <TextBlock Text="{x:Bind LocalizedStrings.ComExp_Dcom_AppId}" Style="{StaticResource PropertyLabelStyle}" />
                        <TextBlock x:Name="GeneralAppIdText" Grid.Column="1" Style="{StaticResource PropertyValueStyle}" />
                    </Grid>
                    <Grid ColumnDefinitions="150,*">
                        <TextBlock Text="{x:Bind LocalizedStrings.ComExp_Dcom_ApplicationType}" Style="{StaticResource PropertyLabelStyle}" />
                        <TextBlock x:Name="GeneralTypeText" Grid.Column="1" Style="{StaticResource PropertyValueStyle}" />
                    </Grid>
                    <Grid ColumnDefinitions="150,*">
                        <TextBlock Text="{x:Bind LocalizedStrings.ComExp_Dcom_AuthenticationLevel}" Style="{StaticResource PropertyLabelStyle}" />
                        <TextBlock x:Name="GeneralAuthText" Grid.Column="1" Style="{StaticResource PropertyValueStyle}" />
                    </Grid>
                    <Grid ColumnDefinitions="150,*">
                        <TextBlock Text="{x:Bind LocalizedStrings.ComExp_Dcom_LocalPath}" Style="{StaticResource PropertyLabelStyle}" />
                        <TextBlock x:Name="GeneralPathText" Grid.Column="1" Style="{StaticResource PropertyValueStyle}" />
                    </Grid>
                    <Grid ColumnDefinitions="150,*">
                        <TextBlock Text="{x:Bind LocalizedStrings.ComExp_Dcom_DllSurrogate}" Style="{StaticResource PropertyLabelStyle}" />
                        <TextBlock x:Name="GeneralSurrogateText" Grid.Column="1" Style="{StaticResource PropertyValueStyle}" />
                    </Grid>
                    <Grid ColumnDefinitions="150,*">
                        <TextBlock Text="{x:Bind LocalizedStrings.ComExp_Dcom_ServiceParameters}" Style="{StaticResource PropertyLabelStyle}" />
                        <TextBlock x:Name="GeneralSvcParamsText" Grid.Column="1" Style="{StaticResource PropertyValueStyle}" />
                    </Grid>
                </StackPanel>
            </ScrollViewer>

            <!-- Location -->
            <ScrollViewer x:Name="LocationPanel" Visibility="Collapsed">
                <StackPanel Spacing="8">
                    <CheckBox
                        x:Name="RunOnThisComputerCheck"
                        Content="{x:Bind LocalizedStrings.ComExp_Dcom_RunOnThisComputer}"
                        IsEnabled="False" />
                    <CheckBox
                        x:Name="RunOnRemoteCheck"
                        Content="{x:Bind LocalizedStrings.ComExp_Dcom_RunOnFollowingComputer}"
                        IsEnabled="False" />
                    <TextBlock Text="{x:Bind LocalizedStrings.ComExp_Dcom_RemoteComputerName}" Style="{StaticResource PropertyLabelStyle}" />
                    <TextBox x:Name="RemoteComputerBox" IsReadOnly="True" />
                </StackPanel>
            </ScrollViewer>

            <!-- Security -->
            <ScrollViewer x:Name="SecurityPanel" Visibility="Collapsed">
                <StackPanel Spacing="8">
                    <Grid ColumnDefinitions="220,*">
                        <TextBlock Text="{x:Bind LocalizedStrings.ComExp_Dcom_LaunchPermissions}" Style="{StaticResource PropertyLabelStyle}" TextWrapping="Wrap" />
                        <TextBlock x:Name="LaunchPermText" Grid.Column="1" Style="{StaticResource PropertyValueStyle}" />
                    </Grid>
                    <Grid ColumnDefinitions="220,*">
                        <TextBlock Text="{x:Bind LocalizedStrings.ComExp_Dcom_AccessPermissions}" Style="{StaticResource PropertyLabelStyle}" TextWrapping="Wrap" />
                        <TextBlock x:Name="AccessPermText" Grid.Column="1" Style="{StaticResource PropertyValueStyle}" />
                    </Grid>
                    <muxc:InfoBar
                        Margin="0,8,0,0"
                        IsClosable="False"
                        IsOpen="True"
                        Severity="Informational">
                        <muxc:InfoBar.Content>
                            <TextBlock Text="{x:Bind LocalizedStrings.ComExp_Dcom_ReadOnlyNote}" TextWrapping="Wrap" />
                        </muxc:InfoBar.Content>
                    </muxc:InfoBar>
                </StackPanel>
            </ScrollViewer>

            <!-- Endpoints -->
            <ScrollViewer x:Name="EndpointsPanel" Visibility="Collapsed">
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{x:Bind LocalizedStrings.ComExp_Dcom_EndpointsEmpty}"
                    TextWrapping="Wrap" />
            </ScrollViewer>

            <!-- Identity -->
            <ScrollViewer x:Name="IdentityPanel" Visibility="Collapsed">
                <StackPanel Spacing="8">
                    <Grid ColumnDefinitions="150,*">
                        <TextBlock Text="{x:Bind LocalizedStrings.ComExp_Dcom_Identity}" Style="{StaticResource PropertyLabelStyle}" />
                        <TextBlock x:Name="IdentityText" Grid.Column="1" Style="{StaticResource PropertyValueStyle}" />
                    </Grid>
                    <Grid ColumnDefinitions="150,*">
                        <TextBlock Text="{x:Bind LocalizedStrings.ComExp_Dcom_RunAs}" Style="{StaticResource PropertyLabelStyle}" />
                        <TextBlock x:Name="IdentityRunAsText" Grid.Column="1" Style="{StaticResource PropertyValueStyle}" />
                    </Grid>
                    <Grid ColumnDefinitions="150,*">
                        <TextBlock Text="{x:Bind LocalizedStrings.ComExp_Dcom_LocalService}" Style="{StaticResource PropertyLabelStyle}" />
                        <TextBlock x:Name="IdentityServiceText" Grid.Column="1" Style="{StaticResource PropertyValueStyle}" />
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</ContentDialog>
