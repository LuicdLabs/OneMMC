<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="OneMMC.Views.ComponentServicesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:oneMmcControls="using:OneMMC.Controls"
    xmlns:core="using:OneMMC.Core.Features.SystemManagement.Models.ComExp"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:OneMMC.Localization"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:winui="using:Microsoft.UI.Xaml.Controls"
    mc:Ignorable="d">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///CommunityToolkit.WinUI.Controls.SettingsControls/SettingsExpander/SettingsExpander.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  CommandBar  -->
        <CommandBar Grid.Row="0" DefaultLabelPosition="Right">
            <AppBarButton Icon="Refresh" Label="{x:Bind LocalizedStrings.ComExp_RefreshButton}" />
            <AppBarButton Icon="More">
                <AppBarButton.Flyout>
                    <MenuFlyout>
                        <MenuFlyoutItem Click="OpenComexpLegacy_Click" Text="{x:Bind LocalizedStrings.ComExp_OpenLegacy}">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE8A7;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                    </MenuFlyout>
                </AppBarButton.Flyout>
            </AppBarButton>
        </CommandBar>

        <!--  Main Content  -->
        <ScrollViewer Grid.Row="1">
            <StackPanel Padding="24,8,24,24" Spacing="4">

                <!--  Current PC Info  -->
                <TextBlock
                    Margin="0,0,0,16"
                    FontSize="14"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{x:Bind CurrentPCText, Mode=OneTime}" />

                <!--  COM+ and DCOM Section  -->
                <TextBlock
                    Margin="0,8,0,12"
                    FontSize="14"
                    FontWeight="SemiBold"
                    Text="{x:Bind LocalizedStrings.ComExp_ComPlusDcom}" />

                <!--  COM+ Applications Expander  -->
                <controls:SettingsExpander
                    Description="{x:Bind LocalizedStrings.ComExp_ComPlusApplications_Description}"
                    Header="{x:Bind LocalizedStrings.ComExp_ComPlusApplications}"
                    IsExpanded="False"
                    ItemsSource="{x:Bind ComPlusApplications, Mode=OneWay}">
                    <controls:SettingsExpander.HeaderIcon>
                        <FontIcon Glyph="&#xE9F5;" />
                    </controls:SettingsExpander.HeaderIcon>

                    <controls:SettingsExpander.ItemTemplate>
                        <DataTemplate x:DataType="core:ComPlusApplicationInfo">
                            <controls:SettingsCard
                                BorderThickness="0.5"
                                Description="{x:Bind Summary}"
                                Header="{x:Bind Name}">

                                <!--  More button with MenuFlyout  -->
                                <Button Style="{StaticResource SubtleButtonStyle}" Tag="{x:Bind}">
                                    <FontIcon FontSize="16" Glyph="&#xE712;" />
                                    <Button.Flyout>
                                        <MenuFlyout>
                                            <MenuFlyoutItem
                                                Click="ComPlusApplicationProperties_Click"
                                                Tag="{x:Bind}"
                                                Text="{x:Bind local:LocalizedStrings.Instance.ComExp_PropertiesButton}">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon Glyph="&#xE946;" />
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                        </MenuFlyout>
                                    </Button.Flyout>
                                </Button>
                            </controls:SettingsCard>
                        </DataTemplate>
                    </controls:SettingsExpander.ItemTemplate>
                </controls:SettingsExpander>

                <!--  DCOM config  -->
                <controls:SettingsCard Header="{x:Bind LocalizedStrings.ComExp_DcomConfig}">
                    <Button MinWidth="120" Content="{x:Bind LocalizedStrings.ComExp_ViewButton}" />
                </controls:SettingsCard>

                <!--  Running processes  -->
                <controls:SettingsCard Header="{x:Bind LocalizedStrings.ComExp_RunningProcesses}">
                    <Button MinWidth="120" Content="{x:Bind LocalizedStrings.ComExp_ViewButton}" />
                </controls:SettingsCard>

                <!--  Distributed Transaction Coordinator Section  -->
                <TextBlock
                    Margin="0,24,0,12"
                    FontSize="14"
                    FontWeight="SemiBold"
                    Text="{x:Bind LocalizedStrings.ComExp_DistributedTransactionCoordinator}" />

                <!--  Local DTC Expander  -->
                <oneMmcControls:StableSettingsExpander Header="{x:Bind LocalizedStrings.ComExp_LocalDtc}" IsExpanded="True">
                    <oneMmcControls:StableSettingsExpander.HeaderIcon>
                        <FontIcon Glyph="&#xE7F4;" />
                    </oneMmcControls:StableSettingsExpander.HeaderIcon>

                    <oneMmcControls:StableSettingsExpander.Items>
                        <!--  Transaction List  -->
                        <controls:SettingsCard Header="{x:Bind LocalizedStrings.ComExp_Dtc_TransactionList}" IsClickEnabled="True">
                            <controls:SettingsCard.ActionIcon>
                                <FontIcon Glyph="&#xE8A7;" />
                            </controls:SettingsCard.ActionIcon>
                        </controls:SettingsCard>

                        <!--  Transaction Statistics  -->
                        <controls:SettingsCard Header="{x:Bind LocalizedStrings.ComExp_Dtc_TransactionStatistics}" IsClickEnabled="True">
                            <controls:SettingsCard.ActionIcon>
                                <FontIcon Glyph="&#xE8A7;" />
                            </controls:SettingsCard.ActionIcon>
                        </controls:SettingsCard>
                    </oneMmcControls:StableSettingsExpander.Items>
                </oneMmcControls:StableSettingsExpander>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
