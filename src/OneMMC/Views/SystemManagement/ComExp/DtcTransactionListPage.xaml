<Page
    x:Class="OneMMC.Views.ComExp.DtcTransactionListPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:localization="using:OneMMC.Localization"
    xmlns:converters="using:OneMMC.Converters"
    xmlns:core="using:OneMMC.Core.Features.SystemManagement.Models.ComExp"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />

        <Style x:Key="PropertyHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

        <Style x:Key="PropertyLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="Margin" Value="0,0,8,4" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>

        <Style x:Key="PropertyValueStyle" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="IsTextSelectionEnabled" Value="True" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>
    </Page.Resources>

    <Grid RowDefinitions="Auto,*">
        <CommandBar DefaultLabelPosition="Right">
            <AppBarButton Icon="Refresh" Label="{x:Bind LocalizedStrings.ComExp_RefreshButton}" Click="RefreshButton_Click" />
        </CommandBar>

        <Grid Grid.Row="1" RowDefinitions="*,Auto" Padding="24,8,24,24">
            <ListView ItemsSource="{x:Bind ViewModel.Transactions, Mode=OneWay}">
                <ListView.Header>
                    <Grid ColumnDefinitions="*,2*" Padding="12,8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                        <TextBlock Text="{x:Bind LocalizedStrings.ComExp_Transaction_Status}" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="1" Text="{x:Bind LocalizedStrings.ComExp_Transaction_UnitOfWorkId}" FontWeight="SemiBold" />
                    </Grid>
                </ListView.Header>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="core:DtcTransactionItem">
                        <Grid ColumnDefinitions="*,2*" Padding="12,8">
                            <TextBlock Text="{x:Bind Status}" />
                            <TextBlock Grid.Column="1" Text="{x:Bind UnitOfWorkId}" FontFamily="Consolas" FontSize="12" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Padding="8,12,8,0">
                <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" />
                <ProgressRing
                    Grid.Column="1"
                    Width="20"
                    Height="20"
                    IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.IsLoading, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}" />
            </Grid>
        </Grid>
    </Grid>
</Page>
