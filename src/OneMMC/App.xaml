<?xml version="1.0" encoding="utf-8" ?>
<Application
	x:Class="OneMMC.App"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:local="using:OneMMC"
	xmlns:converters="using:OneMMC.Converters"
	xmlns:localization="using:OneMMC.Localization">
<Application.Resources>
	<ResourceDictionary>
		<ResourceDictionary.MergedDictionaries>
			<XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
		</ResourceDictionary.MergedDictionaries>
		<!--  Converters  -->
		<converters:StringToBoolConverter x:Key="StringToBoolConverter" />
		<converters:NullToBoolConverter x:Key="NullToBoolConverter" />
		<converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
		<converters:NullableBoolToBoolConverter x:Key="NullableBoolToBoolConverter" />
        <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent"/>
		<!--
			Entrance/reposition transitions are opt-in via these keyed styles rather than implicit
			(TargetType-only) styles. As implicit styles they applied to *every* StackPanel and *every*
			ListView in the app - including the panels inside every DataTemplate - so each realized list
			row carried transition state, and virtualizing lists re-ran the entrance animation on every
			recycled container. Apply Style="{StaticResource AnimatedStackPanelStyle}" (or
			AnimatedListViewStyle) only where the animation is actually wanted.
		-->
		<Style x:Key="AnimatedStackPanelStyle" TargetType="StackPanel">
			<Setter Property="ChildrenTransitions">
				<Setter.Value>
					<TransitionCollection>
						<EntranceThemeTransition FromVerticalOffset="50" />
						<RepositionThemeTransition IsStaggeringEnabled="False" />
					</TransitionCollection>
				</Setter.Value>
			</Setter>
		</Style>
		<Style x:Key="AnimatedListViewStyle" TargetType="ListView">
			<Setter Property="ItemContainerTransitions">
				<Setter.Value>
					<TransitionCollection>
						<EntranceThemeTransition FromVerticalOffset="50" />
						<RepositionThemeTransition IsStaggeringEnabled="False" />
					</TransitionCollection>
				</Setter.Value>
			</Setter>
		</Style>
		</ResourceDictionary>
	</Application.Resources>
</Application>
