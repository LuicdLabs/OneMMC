<?xml version="1.0" encoding="utf-8" ?>
<Page
	x:Class="ManagementTools.Views.LocalComputerCertificatesPage"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:local="using:ManagementTools.Views"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:controls="using:CommunityToolkit.WinUI.Controls"
	mc:Ignorable="d">

	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
		</Grid.RowDefinitions>

		<!-- Header Section -->
		<Grid Grid.Row="0" Padding="24,16,24,16">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="*" />
				<ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
				<ColumnDefinition Width="Auto" />
			</Grid.ColumnDefinitions>

			<!-- Search Box -->
			<AutoSuggestBox Grid.Column="0" PlaceholderText="Search" QueryIcon="Find" Width="300" MaxHeight="35" HorizontalAlignment="Left" />

			<!-- Current PC Label -->
			<TextBlock Grid.Column="1" Text="Current PC: WIN-PC (local)" VerticalAlignment="Center" Margin="0,0,16,0" FontSize="14" />

            <CommandBar Grid.Column="2" DefaultLabelPosition="Right">
                <AppBarButton
						Icon="Refresh"
						Label="Refresh" />
                <AppBarSeparator />
                <AppBarButton 
                        Icon="More" />
            </CommandBar>
        </Grid>

		<!-- Main Content -->
		<ScrollViewer Grid.Row="1" Padding="24,20,24,24">
			<StackPanel Spacing="4">

				<!-- Trusted Root Certification Authorities -->
				<controls:SettingsExpander Header="Trusted Root Certification Authorities" IsExpanded="True">
					<controls:SettingsExpander.Items>
						<!-- Certificates Section -->
						<controls:SettingsCard Header="Certificates" HeaderIcon="{x:Null}" Padding="16,12">
							<controls:SettingsCard.Resources>
								<Style TargetType="controls:SettingsCard">
									<Setter Property="Background" Value="Transparent" />
									<Setter Property="BorderThickness" Value="0" />
								</Style>
							</controls:SettingsCard.Resources>
						</controls:SettingsCard>

						<!-- Certificate Item 1 -->
						<controls:SettingsCard Padding="16,8">
							<controls:SettingsCard.Header>
								<StackPanel>
									<TextBlock Text="AAA Certificate Services" FontWeight="SemiBold" />
									<TextBlock Text="AAA Certificate Services | Valid to: 2029/1/1" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
								</StackPanel>
							</controls:SettingsCard.Header>
							<StackPanel Orientation="Horizontal" Spacing="8">
								<Button Background="Transparent" BorderThickness="0" Padding="8">
									<FontIcon Glyph="&#xE7B3;" FontSize="16" />
								</Button>
								<Button Background="Transparent" BorderThickness="0" Padding="8">
									<FontIcon Glyph="&#xE712;" FontSize="16" />
								</Button>
							</StackPanel>
						</controls:SettingsCard>
					</controls:SettingsExpander.Items>
				</controls:SettingsExpander>

				<!-- Intermediate Certification Authorities -->
				<controls:SettingsExpander Header="Intermediate Certification Authorities" IsExpanded="True" Margin="0,4,0,0">
					<controls:SettingsExpander.Items>
						<!-- Certificates Section -->
						<controls:SettingsCard Header="Certificates" HeaderIcon="{x:Null}" Padding="16,12">
							<controls:SettingsCard.Resources>
								<Style TargetType="controls:SettingsCard">
									<Setter Property="Background" Value="Transparent" />
									<Setter Property="BorderThickness" Value="0" />
								</Style>
							</controls:SettingsCard.Resources>
						</controls:SettingsCard>

						<!-- Certificate Item 1 -->
						<controls:SettingsCard Padding="16,8">
							<controls:SettingsCard.Header>
								<StackPanel>
									<TextBlock Text="COMODO RSA Code Signing CA" FontWeight="SemiBold" />
									<TextBlock Text="COMODO RSA Certification Authority | Valid to: 2028/5/9" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
								</StackPanel>
							</controls:SettingsCard.Header>
							<StackPanel Orientation="Horizontal" Spacing="8">
								<Button Background="Transparent" BorderThickness="0" Padding="8">
									<FontIcon Glyph="&#xE7B3;" FontSize="16" />
								</Button>
								<Button Background="Transparent" BorderThickness="0" Padding="8">
									<FontIcon Glyph="&#xE712;" FontSize="16" />
								</Button>
							</StackPanel>
						</controls:SettingsCard>

						<!-- Certificate Item 2 -->
						<controls:SettingsCard Padding="16,8">
							<controls:SettingsCard.Header>
								<StackPanel>
									<TextBlock Text="Microsoft Windows Hardware Compatibility" FontWeight="SemiBold" />
									<TextBlock Text="Microsoft Root Authority | Valid to: 2002/12/31" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
								</StackPanel>
							</controls:SettingsCard.Header>
							<StackPanel Orientation="Horizontal" Spacing="8">
								<Button Background="Transparent" BorderThickness="0" Padding="8">
									<FontIcon Glyph="&#xE7B3;" FontSize="16" />
								</Button>
								<Button Background="Transparent" BorderThickness="0" Padding="8">
									<FontIcon Glyph="&#xE712;" FontSize="16" />
								</Button>
							</StackPanel>
						</controls:SettingsCard>

						<!-- Certificate Revocation List Section -->
						<controls:SettingsCard Header="Certificate Revocation List" HeaderIcon="{x:Null}" Padding="16,12">
							<controls:SettingsCard.Resources>
								<Style TargetType="controls:SettingsCard">
									<Setter Property="Background" Value="Transparent" />
									<Setter Property="BorderThickness" Value="0" />
								</Style>
							</controls:SettingsCard.Resources>
						</controls:SettingsCard>

						<!-- CRL Item -->
						<controls:SettingsCard Padding="16,8">
							<controls:SettingsCard.Header>
								<StackPanel>
									<TextBlock Text="VeriSign Commercial Software Publishers CA, &quot;VeriSign, Inc.&quot;, Internet" FontWeight="SemiBold" />
									<TextBlock Text="Effective date: 2001/3/24 | Next update: 2004/1/8" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
								</StackPanel>
							</controls:SettingsCard.Header>
							<StackPanel Orientation="Horizontal" Spacing="8">
								<Button Background="Transparent" BorderThickness="0" Padding="8">
									<FontIcon Glyph="&#xE7B3;" FontSize="16" />
								</Button>
								<Button Background="Transparent" BorderThickness="0" Padding="8">
									<FontIcon Glyph="&#xE712;" FontSize="16" />
								</Button>
							</StackPanel>
						</controls:SettingsCard>
					</controls:SettingsExpander.Items>
				</controls:SettingsExpander>

				<!-- Untrusted Certificates -->
				<controls:SettingsExpander Header="Untrusted Certificates" IsExpanded="True" Margin="0,4,0,0">
					<controls:SettingsExpander.Items>
						<!-- Certificate Trust List Section -->
						<controls:SettingsCard Header="Certificate Trust List" HeaderIcon="{x:Null}" Padding="16,12">
							<controls:SettingsCard.Resources>
								<Style TargetType="controls:SettingsCard">
									<Setter Property="Background" Value="Transparent" />
									<Setter Property="BorderThickness" Value="0" />
								</Style>
							</controls:SettingsCard.Resources>
						</controls:SettingsCard>

						<!-- CTL Item -->
						<controls:SettingsCard Padding="16,8">
							<controls:SettingsCard.Header>
								<StackPanel>
									<TextBlock Text="[not available]" FontWeight="SemiBold" />
									<TextBlock Text="Effective Date: 2012/5/31" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
								</StackPanel>
							</controls:SettingsCard.Header>
							<StackPanel Orientation="Horizontal" Spacing="8">
								<Button Background="Transparent" BorderThickness="0" Padding="8">
									<FontIcon Glyph="&#xE7B3;" FontSize="16" />
								</Button>
								<Button Background="Transparent" BorderThickness="0" Padding="8">
									<FontIcon Glyph="&#xE712;" FontSize="16" />
								</Button>
							</StackPanel>
						</controls:SettingsCard>
					</controls:SettingsExpander.Items>
				</controls:SettingsExpander>

			</StackPanel>
		</ScrollViewer>
	</Grid>
</Page>