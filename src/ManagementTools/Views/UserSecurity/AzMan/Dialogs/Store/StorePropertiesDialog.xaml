<?xml version="1.0" encoding="utf-8" ?>
<!--
    StorePropertiesDialog.xaml

    Store Properties Dialog - Edit authorization store properties and security settings
-->
<ContentDialog
    x:Class="ManagementTools.Views.UserSecurity.AzMan.Dialogs.StorePropertiesDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    mc:Ignorable="d"
    Title="{x:Bind LocalizedStrings.StorePropertiesDialog_Title}"
    PrimaryButtonText="{x:Bind LocalizedStrings.Common_OKButton}"
    CloseButtonText="{x:Bind LocalizedStrings.Common_CancelButton}"
    DefaultButton="Primary"
    PrimaryButtonClick="OnPrimaryButtonClick">

    <Grid MinWidth="620" MinHeight="500">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <SelectorBar x:Name="StorePropertiesSelectorBar" SelectionChanged="StorePropertiesSelectorBar_SelectionChanged">
            <SelectorBarItem IsSelected="True" Tag="General" Text="{x:Bind LocalizedStrings.StorePropertiesDialog_Tab_General}" />
            <SelectorBarItem Tag="Security" Text="{x:Bind LocalizedStrings.StorePropertiesDialog_Tab_Security}" />
            <SelectorBarItem Tag="Limits" Text="{x:Bind LocalizedStrings.StorePropertiesDialog_Tab_Limits}" />
            <SelectorBarItem Tag="Auditing" Text="{x:Bind LocalizedStrings.StorePropertiesDialog_Tab_Auditing}" />
        </SelectorBar>

        <Grid Grid.Row="1" Margin="0,12,0,0">
            <ScrollViewer x:Name="GeneralPanel" Visibility="Visible">
                <StackPanel Spacing="16" Padding="0,8,0,0">
                    <InfoBar x:Name="ErrorInfoBar"
                             IsOpen="False"
                             Severity="Error"
                             Title="{x:Bind LocalizedStrings.Common_ErrorTitle}"
                             IsClosable="True" />

                    <StackPanel x:Name="SchemaUpgradePanel" Spacing="8" Visibility="Collapsed">
                        <InfoBar IsOpen="True"
                                 IsClosable="False"
                                 Severity="Warning"
                                 Title="{x:Bind LocalizedStrings.StorePropertiesDialog_SchemaUpgrade_Title}"
                                 Message="{x:Bind LocalizedStrings.StorePropertiesDialog_SchemaUpgrade_Message}" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="UpgradeSchemaButton" Content="{x:Bind LocalizedStrings.StorePropertiesDialog_UpgradeSchema_Button}" Click="OnUpgradeSchemaButtonClick" />
                            <TextBlock x:Name="SchemaUpgradeStatusTextBlock" VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Spacing="8">
                        <TextBlock Text="{x:Bind LocalizedStrings.StorePropertiesDialog_StoreInfo_Header}" FontWeight="SemiBold" />

                        <TextBox x:Name="StorePathTextBox"
                                 Header="{x:Bind LocalizedStrings.StorePropertiesDialog_StorePath_Header}"
                                 IsReadOnly="True" />

                        <TextBox x:Name="StoreTypeTextBox"
                                 Header="{x:Bind LocalizedStrings.StorePropertiesDialog_StoreType_Header}"
                                 IsReadOnly="True" />

                        <TextBox x:Name="VersionTextBox"
                                 Header="{x:Bind LocalizedStrings.StorePropertiesDialog_SchemaVersion_Header}"
                                 IsReadOnly="True" />
                    </StackPanel>

                    <StackPanel Spacing="8">
                        <TextBlock Text="{x:Bind LocalizedStrings.StorePropertiesDialog_Description_Header}" FontWeight="SemiBold" />

                        <TextBox x:Name="DescriptionTextBox"
                                 PlaceholderText="{x:Bind LocalizedStrings.StorePropertiesDialog_Description_Placeholder}"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 MaxHeight="100" />

                        <TextBox x:Name="ApplicationDataTextBox"
                                 Header="{x:Bind LocalizedStrings.StorePropertiesDialog_ApplicationData_Header}"
                                 PlaceholderText="{x:Bind LocalizedStrings.StorePropertiesDialog_ApplicationData_Placeholder}"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 MaxHeight="80" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer x:Name="SecurityPanel" Visibility="Collapsed">
                <StackPanel Spacing="16" Padding="0,8,0,0">
                    <StackPanel Spacing="8">
                        <TextBlock Text="{x:Bind LocalizedStrings.StorePropertiesDialog_PolicyAdmins_Header}" FontWeight="SemiBold" />
                        <TextBlock Text="{x:Bind LocalizedStrings.StorePropertiesDialog_PolicyAdmins_Description}"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
                                <Button Click="OnAddPolicyAdminClick">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE710;" FontSize="12" />
                                        <TextBlock Text="{x:Bind LocalizedStrings.Common_AddButtonEllipsis}" />
                                    </StackPanel>
                                </Button>
                                <Button Click="OnRemovePolicyAdminClick">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE74D;" FontSize="12" />
                                        <TextBlock Text="{x:Bind LocalizedStrings.Common_RemoveButton}" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                            <ListView x:Name="PolicyAdminsListView"
                                      Grid.Row="1"
                                      MaxHeight="140"
                                      SelectionMode="Extended"
                                      BorderThickness="1"
                                      BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                      CornerRadius="4" />
                        </Grid>
                    </StackPanel>

                    <StackPanel Spacing="8">
                        <TextBlock Text="{x:Bind LocalizedStrings.StorePropertiesDialog_PolicyReaders_Header}" FontWeight="SemiBold" />
                        <TextBlock Text="{x:Bind LocalizedStrings.StorePropertiesDialog_PolicyReaders_Description}"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
                                <Button Click="OnAddPolicyReaderClick">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE710;" FontSize="12" />
                                        <TextBlock Text="{x:Bind LocalizedStrings.Common_AddButtonEllipsis}" />
                                    </StackPanel>
                                </Button>
                                <Button Click="OnRemovePolicyReaderClick">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE74D;" FontSize="12" />
                                        <TextBlock Text="{x:Bind LocalizedStrings.Common_RemoveButton}" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                            <ListView x:Name="PolicyReadersListView"
                                      Grid.Row="1"
                                      MaxHeight="140"
                                      SelectionMode="Extended"
                                      BorderThickness="1"
                                      BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                      CornerRadius="4" />
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer x:Name="LimitsPanel" Visibility="Collapsed">
                <StackPanel Spacing="12" Padding="0,8,0,0">
                    <TextBlock Text="{x:Bind LocalizedStrings.StorePropertiesDialog_AuthorizationRules_Header}" FontWeight="SemiBold" />
                    <ComboBox x:Name="AuthorizationRulesModeComboBox" SelectionChanged="AuthorizationRulesModeComboBox_SelectionChanged">
                        <ComboBoxItem Content="{x:Bind LocalizedStrings.StorePropertiesDialog_AuthRules_Disable}" Tag="Disable" />
                        <ComboBoxItem Content="{x:Bind LocalizedStrings.StorePropertiesDialog_AuthRules_EnableNoTimeout}" Tag="EnableNoTimeout" />
                        <ComboBoxItem Content="{x:Bind LocalizedStrings.StorePropertiesDialog_AuthRules_EnableSpecifiedTimeout}" Tag="EnableSpecifiedTimeout" />
                    </ComboBox>

                    <NumberBox x:Name="AuthorizationRuleTimeoutNumberBox"
                               Header="{x:Bind LocalizedStrings.StorePropertiesDialog_AuthRuleTimeout_Header}"
                               Minimum="0"
                               Maximum="2147483647"
                               SpinButtonPlacementMode="Compact" />

                    <NumberBox x:Name="MaximumCachedAuthorizationRulesNumberBox"
                               Header="{x:Bind LocalizedStrings.StorePropertiesDialog_MaxCachedAuthRules_Header}"
                               Minimum="0"
                               Maximum="2147483647"
                               SpinButtonPlacementMode="Compact" />

                    <NumberBox x:Name="LdapQueryTimeoutNumberBox"
                               Header="{x:Bind LocalizedStrings.StorePropertiesDialog_LdapQueryTimeout_Header}"
                               Minimum="0"
                               Maximum="2147483647"
                               SpinButtonPlacementMode="Compact" />

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="UseDefaultValuesButton" Content="{x:Bind LocalizedStrings.StorePropertiesDialog_UseDefaultValues_Button}" Click="OnUseDefaultValuesButtonClick" />
                        <TextBlock x:Name="UseDefaultValuesStatusTextBlock" VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer x:Name="AuditingPanel" Visibility="Collapsed">
                <StackPanel Spacing="12" Padding="0,8,0,0">
                    <CheckBox x:Name="RuntimeApplicationInitializationAuditingCheckBox" Content="{x:Bind LocalizedStrings.StorePropertiesDialog_RuntimeAppInitAuditing}" />
                    <CheckBox x:Name="AuthorizationStoreChangeAuditingCheckBox" Content="{x:Bind LocalizedStrings.StorePropertiesDialog_StoreChangeAuditing}" />
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</ContentDialog>
