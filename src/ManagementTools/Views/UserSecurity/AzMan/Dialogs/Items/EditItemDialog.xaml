<?xml version="1.0" encoding="utf-8" ?>
<!--
    EditItemDialog.xaml
    
    Generic Edit Item Dialog - For editing properties of applications, groups, roles, tasks, operations, etc.
-->
<ContentDialog
    x:Class="ManagementTools.Views.UserSecurity.AzMan.Dialogs.EditItemDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    mc:Ignorable="d"
    Title="{x:Bind LocalizedStrings.EditItemDialog_Title_Default}"
    PrimaryButtonText="{x:Bind LocalizedStrings.Common_SaveButton}"
    CloseButtonText="{x:Bind LocalizedStrings.Common_CancelButton}"
    DefaultButton="Primary"
    PrimaryButtonClick="OnPrimaryButtonClick">

    <StackPanel Spacing="16" MinWidth="400">
        <!-- Error message -->
        <InfoBar x:Name="ErrorInfoBar" 
                 IsOpen="False" 
                 Severity="Error" 
                 Title="{x:Bind LocalizedStrings.Common_ErrorTitle}"
                 IsClosable="True" />

        <!-- General information block -->
        <StackPanel Spacing="8">
            <TextBlock Text="{x:Bind LocalizedStrings.EditItemDialog_General_Header}" FontWeight="SemiBold" />
            
            <!-- Name (read-only) -->
            <TextBox x:Name="NameTextBox"
                     Header="{x:Bind LocalizedStrings.EditItemDialog_Name_Header}"
                     IsReadOnly="True"
                     PlaceholderText="{x:Bind LocalizedStrings.EditItemDialog_Name_Placeholder}" />
            
            <!-- Description -->
            <TextBox x:Name="DescriptionTextBox"
                     Header="{x:Bind LocalizedStrings.EditItemDialog_Description_Header}"
                     PlaceholderText="{x:Bind LocalizedStrings.EditItemDialog_Description_Placeholder}"
                     TextWrapping="Wrap"
                     AcceptsReturn="True"
                     MaxHeight="100" />
        </StackPanel>

        <!-- Group-specific block -->
        <StackPanel x:Name="GroupTypePanel" Spacing="8" Visibility="Collapsed">
            <TextBlock Text="{x:Bind LocalizedStrings.EditItemDialog_GroupType_Header}" FontWeight="SemiBold" />
            
            <ComboBox x:Name="GroupTypeComboBox" 
                      Header="{x:Bind LocalizedStrings.EditItemDialog_GroupType_Label}"
                      HorizontalAlignment="Stretch"
                      IsEnabled="False">
                <ComboBoxItem Content="{x:Bind LocalizedStrings.EditItemDialog_GroupType_Basic}" Tag="Basic" />
                <ComboBoxItem Content="{x:Bind LocalizedStrings.EditItemDialog_GroupType_LdapQuery}" Tag="LdapQuery" />
                <ComboBoxItem Content="{x:Bind LocalizedStrings.EditItemDialog_GroupType_Bizrule}" Tag="Bizrule" />
            </ComboBox>
        </StackPanel>

        <!-- LDAP query block -->
        <StackPanel x:Name="LdapQueryPanel" Spacing="8" Visibility="Collapsed">
            <TextBlock Text="{x:Bind LocalizedStrings.EditItemDialog_LdapQuery_Header}" FontWeight="SemiBold" />
            
            <TextBox x:Name="LdapQueryTextBox"
                     Header="{x:Bind LocalizedStrings.EditItemDialog_LdapQuery_Label}"
                     PlaceholderText="{x:Bind LocalizedStrings.EditItemDialog_LdapQuery_Placeholder}"
                     TextWrapping="Wrap"
                     AcceptsReturn="True"
                     MaxHeight="100" />
        </StackPanel>

        <!-- Operation-specific block -->
        <StackPanel x:Name="OperationPanel" Spacing="8" Visibility="Collapsed">
            <TextBlock Text="{x:Bind LocalizedStrings.EditItemDialog_Operation_Header}" FontWeight="SemiBold" />
            
            <NumberBox x:Name="OperationIdNumberBox"
                       Header="{x:Bind LocalizedStrings.EditItemDialog_OperationId_Header}"
                       Minimum="0"
                       Maximum="2147483647"
                       SpinButtonPlacementMode="Compact"
                        IsEnabled="True" />
        </StackPanel>

    </StackPanel>
</ContentDialog>
