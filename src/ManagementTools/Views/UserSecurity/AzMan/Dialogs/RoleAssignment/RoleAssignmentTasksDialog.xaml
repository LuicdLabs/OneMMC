<?xml version="1.0" encoding="utf-8" ?>
<!--
    RoleAssignmentTasksDialog.xaml
    
    Role Assignment Tasks/Operations Dialog - For managing tasks and operations in a role assignment
-->
<ContentDialog
    x:Class="ManagementTools.Views.UserSecurity.AzMan.Dialogs.RoleAssignmentTasksDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    mc:Ignorable="d"
    Title="{x:Bind LocalizedStrings.RoleAssignmentTasksDialog_Title}"
    CloseButtonText="{x:Bind LocalizedStrings.Common_CloseButton}"
    DefaultButton="Close">

    <Grid MinWidth="600" MinHeight="450" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Error/Info message -->
        <InfoBar x:Name="MessageInfoBar" 
                 Grid.Row="0"
                 IsOpen="False" 
                 Severity="Informational" 
                 Title="{x:Bind LocalizedStrings.Common_InformationTitle}"
                 IsClosable="True" />

        <!-- Main content with two columns -->
        <Grid Grid.Row="1" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Tasks column -->
            <Grid Grid.Column="0" RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="{x:Bind LocalizedStrings.RoleAssignmentTasksDialog_AssignedTasks_Header}" FontWeight="SemiBold" />

                <Border Grid.Row="1" 
                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" 
                        BorderThickness="1" 
                        CornerRadius="4">
                    <Grid>
                        <ListView x:Name="TasksListView"
                                  SelectionMode="Single"
                                  Padding="4">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="8,4" ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon Grid.Column="0" Glyph="&#xE9D5;" FontSize="14" />
                                        <TextBlock Grid.Column="1" Text="{Binding}" VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <TextBlock x:Name="NoTasksText"
                                   Text="{x:Bind LocalizedStrings.RoleAssignmentTasksDialog_NoTasks}" 
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Visibility="Collapsed" />
                    </Grid>
                </Border>

                <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                    <Button x:Name="AddTaskButton" Content="{x:Bind LocalizedStrings.Common_AddButtonEllipsis}" Click="OnAddTaskClick" />
                    <Button x:Name="RemoveTaskButton" Content="{x:Bind LocalizedStrings.Common_RemoveButton}" Click="OnRemoveTaskClick" IsEnabled="False" />
                </StackPanel>
            </Grid>

            <!-- Operations column -->
            <Grid Grid.Column="1" RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="{x:Bind LocalizedStrings.RoleAssignmentTasksDialog_AssignedOperations_Header}" FontWeight="SemiBold" />

                <Border Grid.Row="1" 
                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" 
                        BorderThickness="1" 
                        CornerRadius="4">
                    <Grid>
                        <ListView x:Name="OperationsListView"
                                  SelectionMode="Single"
                                  Padding="4">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="8,4" ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon Grid.Column="0" Glyph="&#xE768;" FontSize="14" />
                                        <TextBlock Grid.Column="1" Text="{Binding}" VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <TextBlock x:Name="NoOperationsText"
                                   Text="{x:Bind LocalizedStrings.RoleAssignmentTasksDialog_NoOperations}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Visibility="Collapsed" />
                    </Grid>
                </Border>

                <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                    <Button x:Name="AddOperationButton" Content="{x:Bind LocalizedStrings.Common_AddButtonEllipsis}" Click="OnAddOperationClick" />
                    <Button x:Name="RemoveOperationButton" Content="{x:Bind LocalizedStrings.Common_RemoveButton}" Click="OnRemoveOperationClick" IsEnabled="False" />
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</ContentDialog>
