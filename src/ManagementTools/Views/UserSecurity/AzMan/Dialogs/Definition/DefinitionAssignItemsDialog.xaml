<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="ManagementTools.Views.UserSecurity.AzMan.Dialogs.DefinitionAssignItemsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:ManagementTools.Views.UserSecurity.AzMan.Dialogs"
    xmlns:loc="using:ManagementTools.Localization"
    mc:Ignorable="d">

    <Grid MinWidth="520" MinHeight="360">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="HeaderTextBlock"
                   Grid.Row="0"
                   FontWeight="SemiBold"
                   Margin="0,0,0,10" />

        <SelectorBar x:Name="AssignSelectorBar"
                     Grid.Row="1"
                     SelectionChanged="AssignSelectorBar_SelectionChanged">
            <SelectorBarItem x:Name="RolesTabItem" Tag="Roles" Text="{x:Bind loc:LocalizedStrings.Instance.DefinitionAssignItemsDialog_Tab_Roles}" />
            <SelectorBarItem x:Name="TasksTabItem" Tag="Tasks" Text="{x:Bind loc:LocalizedStrings.Instance.DefinitionAssignItemsDialog_Tab_Tasks}" />
            <SelectorBarItem x:Name="OperationsTabItem" Tag="Operations" Text="{x:Bind loc:LocalizedStrings.Instance.DefinitionAssignItemsDialog_Tab_Operations}" />
        </SelectorBar>

        <Grid Grid.Row="2" Margin="0,12,0,0">
            <ListView x:Name="RolesListView"
                      Visibility="Visible"
                      SelectionMode="None"
                      BorderThickness="1"
                      BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                      CornerRadius="4">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:AssignableItem">
                        <Grid Padding="8,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <CheckBox Grid.Column="0"
                                      VerticalAlignment="Center"
                                      IsChecked="{x:Bind IsSelected, Mode=TwoWay}" />
                            <FontIcon Grid.Column="1"
                                      Glyph="&#xE713;"
                                      FontSize="16"
                                      Margin="8,0,12,0" />
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{x:Bind Name}" />
                                <TextBlock Text="{x:Bind Description}"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <ListView x:Name="TasksListView"
                      Visibility="Collapsed"
                      SelectionMode="None"
                      BorderThickness="1"
                      BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                      CornerRadius="4">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:AssignableItem">
                        <Grid Padding="8,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <CheckBox Grid.Column="0"
                                      VerticalAlignment="Center"
                                      IsChecked="{x:Bind IsSelected, Mode=TwoWay}" />
                            <FontIcon Grid.Column="1"
                                      Glyph="&#xE713;"
                                      FontSize="16"
                                      Margin="8,0,12,0" />
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{x:Bind Name}" />
                                <TextBlock Text="{x:Bind Description}"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <ListView x:Name="OperationsListView"
                      Visibility="Collapsed"
                      SelectionMode="None"
                      BorderThickness="1"
                      BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                      CornerRadius="4">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:AssignableItem">
                        <Grid Padding="8,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <CheckBox Grid.Column="0"
                                      VerticalAlignment="Center"
                                      IsChecked="{x:Bind IsSelected, Mode=TwoWay}" />
                            <FontIcon Grid.Column="1"
                                      Glyph="&#xE713;"
                                      FontSize="16"
                                      Margin="8,0,12,0" />
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{x:Bind Name}" />
                                <TextBlock Text="{x:Bind Description}"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Grid>
</UserControl>