<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="ManagementTools.Views.UserSecurity.AzMan.Dialogs.DefinitionPropertiesDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:ManagementTools.Views.UserSecurity.AzMan.Dialogs"
    mc:Ignorable="d"
    PrimaryButtonText="{x:Bind LocalizedStrings.Common_SaveButton}"
    CloseButtonText="{x:Bind LocalizedStrings.Common_CancelButton}"
    DefaultButton="Primary"
    PrimaryButtonClick="OnPrimaryButtonClick">

    <Grid MinWidth="620" MinHeight="480">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <InfoBar x:Name="ErrorInfoBar"
                 Grid.Row="0"
                 IsOpen="False"
                 Severity="Error"
                 IsClosable="True"
                 Margin="0,0,0,12" />

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <SelectorBar x:Name="SelectorBar" SelectionChanged="SelectorBar_SelectionChanged">
                <SelectorBarItem Tag="General" Text="{x:Bind LocalizedStrings.DefinitionPropertiesDialog_Tab_General}" IsSelected="True" />
                <SelectorBarItem Tag="Definition" Text="{x:Bind LocalizedStrings.DefinitionPropertiesDialog_Tab_Definition}" />
            </SelectorBar>

            <Grid Grid.Row="1" Margin="0,12,0,0">

                <!-- General tab -->
                <ScrollViewer x:Name="GeneralPanel" Visibility="Visible">
                    <StackPanel Spacing="12" Padding="0,0,0,4">
                        <TextBox x:Name="NameTextBox"
                                 Header="{x:Bind LocalizedStrings.DefinitionPropertiesDialog_Name_Header}"
                                 IsReadOnly="True" />
                        <TextBox x:Name="DescriptionTextBox"
                                 Header="{x:Bind LocalizedStrings.DefinitionPropertiesDialog_Description_Header}"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 MinHeight="120" />
                    </StackPanel>
                </ScrollViewer>

                <!-- Definition tab -->
                <StackPanel x:Name="DefinitionPanel"
                            Visibility="Collapsed"
                            Spacing="12">

                    <!-- Assign items -->
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button x:Name="OpenAssignItemsButton"
                                Click="OnOpenAssignItemsClick"
                                Content="{x:Bind LocalizedStrings.DefinitionPropertiesDialog_AssignItems_Button}" />
                        <TextBlock x:Name="AssignItemsSummaryTextBlock"
                                   VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button x:Name="OpenAuthorizationRuleButton"
                                Click="OnOpenAuthorizationRuleClick"
                                Content="{x:Bind LocalizedStrings.DefinitionPropertiesDialog_AuthorizationRule_Button}" />
                        <TextBlock x:Name="AuthorizationRuleSummaryTextBlock"
                                   VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </StackPanel>

            </Grid>
        </Grid>
    </Grid>
</ContentDialog>
