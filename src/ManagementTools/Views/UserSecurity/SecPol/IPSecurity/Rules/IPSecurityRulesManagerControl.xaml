<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="ManagementTools.Views.UserSecurity.SecPol.IPSecurity.Rules.IPSecurityRulesManagerControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <CommandBar
            AutomationProperties.AutomationId="IPSecurityRulesCommandBar"
            Background="Transparent"
            DefaultLabelPosition="Right">
            <AppBarButton
                x:Name="AddRuleButton"
                AutomationProperties.AutomationId="IPSecurityAddRuleButton"
                Click="AddRuleButton_Click"
                Icon="Add"
                Label="{x:Bind LocalizedStrings.IPSec_Command_AddRule}" />
            <AppBarButton
                x:Name="EditRuleButton"
                AutomationProperties.AutomationId="IPSecurityEditRuleButton"
                Click="EditRuleButton_Click"
                Icon="Edit"
                Label="{x:Bind LocalizedStrings.IPSec_Command_EditRule}" />
            <AppBarButton
                x:Name="DeleteRuleButton"
                AutomationProperties.AutomationId="IPSecurityDeleteRuleButton"
                Click="DeleteRuleButton_Click"
                Icon="Delete"
                Label="{x:Bind LocalizedStrings.IPSec_Command_DeleteRule}" />
        </CommandBar>

        <InfoBar
            x:Name="ErrorInfoBar"
            Grid.Row="1"
            Margin="4,0,4,12"
            IsClosable="True"
            IsOpen="False"
            Severity="Error"
            Title="{x:Bind LocalizedStrings.Common_ErrorTitle}" />

        <Grid
            Grid.Row="2"
            Margin="12,0,20,4"
            ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="1.4*" />
                <ColumnDefinition Width="1.2*" />
            </Grid.ColumnDefinitions>
            <TextBlock
                FontWeight="SemiBold"
                Text="{x:Bind LocalizedStrings.IPSec_Column_Name}"
                TextWrapping="WrapWholeWords" />
            <TextBlock
                Grid.Column="1"
                FontWeight="SemiBold"
                Text="{x:Bind LocalizedStrings.IPSec_Editor_RuleFilterList}"
                TextWrapping="WrapWholeWords" />
            <TextBlock
                Grid.Column="2"
                FontWeight="SemiBold"
                Text="{x:Bind LocalizedStrings.IPSec_Editor_RuleFilterAction}"
                TextWrapping="WrapWholeWords" />
            <TextBlock
                Grid.Column="3"
                FontWeight="SemiBold"
                Text="{x:Bind LocalizedStrings.IPSec_Editor_ConnectionType}"
                TextWrapping="WrapWholeWords" />
            <TextBlock
                Grid.Column="4"
                FontWeight="SemiBold"
                Text="{x:Bind LocalizedStrings.IPSec_Editor_RuleActive}"
                TextWrapping="WrapWholeWords" />
        </Grid>

        <ListView
            x:Name="RulesListView"
            AutomationProperties.AutomationId="IPSecurityRulesList"
            Grid.Row="3"
            DoubleTapped="RulesListView_DoubleTapped"
            Padding="0,4,8,8"
            SelectionChanged="RulesListView_SelectionChanged"
            SelectionMode="Single">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid
                        MinHeight="56"
                        ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="1.4*" />
                            <ColumnDefinition Width="1.2*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            VerticalAlignment="Center"
                            Text="{Binding Name}"
                            TextTrimming="CharacterEllipsis"
                            ToolTipService.ToolTip="{Binding Description}" />
                        <TextBlock
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                            Text="{Binding FilterListName}"
                            TextTrimming="CharacterEllipsis"
                            ToolTipService.ToolTip="{Binding FilterListName}" />
                        <TextBlock
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                            Text="{Binding FilterActionName}"
                            TextTrimming="CharacterEllipsis"
                            ToolTipService.ToolTip="{Binding FilterActionName}" />
                        <TextBlock
                            Grid.Column="3"
                            VerticalAlignment="Center"
                            Text="{Binding ConnectionTypeDisplay}"
                            TextTrimming="CharacterEllipsis"
                            ToolTipService.ToolTip="{Binding ConnectionTypeDisplay}" />
                        <TextBlock
                            Grid.Column="4"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Text="{Binding ActiveDisplay}" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <ProgressRing
            x:Name="BusyProgressRing"
            Grid.RowSpan="4"
            Width="52"
            Height="52"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            IsActive="False"
            Visibility="Collapsed" />
    </Grid>
</UserControl>
