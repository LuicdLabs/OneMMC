<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="ManagementTools.Views.SoftwareRestrictionPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  CommandBar  -->
        <CommandBar Grid.Row="0" DefaultLabelPosition="Right">
            <AppBarButton Icon="Refresh" Label="Refresh" />
            <AppBarButton Icon="Add" Label="New Rule" />
        </CommandBar>

        <!--  Content  -->
        <ScrollViewer Grid.Row="1">
            <StackPanel Padding="24,8,24,24" Spacing="4">
                <!--  Security Levels  -->
                <controls:SettingsCard
                    Description="Configure default security levels for software execution"
                    Header="Security Levels">
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE72E;" />
                    </controls:SettingsCard.HeaderIcon>
                </controls:SettingsCard>

                <!--  Additional Rules  -->
                <controls:SettingsCard
                    Description="Create rules to allow or deny specific software"
                    Header="Additional Rules">
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE8AC;" />
                    </controls:SettingsCard.HeaderIcon>
                </controls:SettingsCard>

                <!--  Enforcement  -->
                <controls:SettingsCard
                    Description="Configure which users and file types are affected"
                    Header="Enforcement">
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE72E;" />
                    </controls:SettingsCard.HeaderIcon>
                </controls:SettingsCard>

                <!--  Designated File Types  -->
                <controls:SettingsCard
                    Description="Manage file types considered executable"
                    Header="Designated File Types">
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE8A5;" />
                    </controls:SettingsCard.HeaderIcon>
                </controls:SettingsCard>

                <!--  Trusted Publishers  -->
                <controls:SettingsCard
                    Description="Manage trusted software publishers"
                    Header="Trusted Publishers">
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE7EE;" />
                    </controls:SettingsCard.HeaderIcon>
                </controls:SettingsCard>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
