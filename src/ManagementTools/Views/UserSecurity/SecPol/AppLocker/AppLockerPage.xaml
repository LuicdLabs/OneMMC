<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="ManagementTools.Views.AppLockerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  CommandBar  -->
        <CommandBar Grid.Row="0" DefaultLabelPosition="Right">
            <AppBarButton Icon="Refresh" Label="Refresh" />
            <AppBarButton Icon="Add" Label="Create Rule" />
        </CommandBar>

        <!--  Content  -->
        <ScrollViewer Grid.Row="1">
            <StackPanel Padding="24,8,24,24" Spacing="4">
                <!--  Executable Rules  -->
                <controls:SettingsCard
                    Description="Control which executable files (.exe, .com) can run"
                    Header="Executable Rules">
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE8A7;" />
                    </controls:SettingsCard.HeaderIcon>
                </controls:SettingsCard>

                <!--  Windows Installer Rules  -->
                <controls:SettingsCard
                    Description="Control which Windows Installer files (.msi, .msp, .mst) can run"
                    Header="Windows Installer Rules">
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE896;" />
                    </controls:SettingsCard.HeaderIcon>
                </controls:SettingsCard>

                <!--  Script Rules  -->
                <controls:SettingsCard
                    Description="Control which scripts (.ps1, .bat, .cmd, .vbs, .js) can run"
                    Header="Script Rules">
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE943;" />
                    </controls:SettingsCard.HeaderIcon>
                </controls:SettingsCard>

                <!--  Packaged app Rules  -->
                <controls:SettingsCard
                    Description="Control which packaged apps and installers can run"
                    Header="Packaged app Rules">
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE74C;" />
                    </controls:SettingsCard.HeaderIcon>
                </controls:SettingsCard>

                <!--  DLL Rules (Only if PC has enabled DLL rule collection) -->
                <controls:SettingsCard
                    Description="Control which DLL files can be loaded"
                    Header="DLL Rules (DLL rule collection enabled PCs only)">
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE8B7;" />
                    </controls:SettingsCard.HeaderIcon>
                </controls:SettingsCard>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
