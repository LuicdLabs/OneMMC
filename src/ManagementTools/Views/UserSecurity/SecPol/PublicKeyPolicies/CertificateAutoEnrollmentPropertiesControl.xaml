<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="ManagementTools.Views.CertificateAutoEnrollmentPropertiesControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <StackPanel MinWidth="480" Spacing="16">
        <TextBlock
            FontSize="20"
            FontWeight="SemiBold"
            Text="{x:Bind LocalizedStrings.PKP_AutoEnrollment_TabTitle}"
            TextWrapping="Wrap" />

        <TextBlock
            Text="{x:Bind LocalizedStrings.PKP_AutoEnrollment_Help}"
            TextWrapping="Wrap" />

        <StackPanel Spacing="6">
            <TextBlock
                Text="{x:Bind LocalizedStrings.PKP_AutoEnrollment_ConfigurationModel}"
                TextWrapping="Wrap" />
            <ComboBox
                x:Name="ConfigurationModelComboBox"
                MinWidth="280"
                SelectionChanged="ConfigurationModelComboBox_SelectionChanged">
                <ComboBoxItem Content="{x:Bind LocalizedStrings.PKP_NotConfigured}" />
                <ComboBoxItem Content="{x:Bind LocalizedStrings.SecPol_Value_Enabled}" />
                <ComboBoxItem Content="{x:Bind LocalizedStrings.SecPol_Value_Disabled}" />
            </ComboBox>
        </StackPanel>

        <StackPanel
            x:Name="EnabledOptionsPanel"
            Spacing="8"
            Visibility="Collapsed">
            <CheckBox
                x:Name="StoreManagementCheckBox"
                Content="{x:Bind LocalizedStrings.PKP_AutoEnrollment_RenewExpired}" />
            <CheckBox
                x:Name="TemplateCheckCheckBox"
                Content="{x:Bind LocalizedStrings.PKP_AutoEnrollment_UpdateTemplates}" />
        </StackPanel>
    </StackPanel>
</UserControl>
