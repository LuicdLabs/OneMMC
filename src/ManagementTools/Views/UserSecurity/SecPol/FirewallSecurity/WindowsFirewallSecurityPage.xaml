<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="ManagementTools.Views.WindowsFirewallSecurityPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  CommandBar  -->
        <CommandBar Grid.Row="0" DefaultLabelPosition="Right">
            <AppBarButton Icon="Refresh" Label="Refresh" />
            <AppBarButton Icon="Add" Label="New Rule" />
        </CommandBar>

        <!--  Content  -->
        <ScrollViewer Grid.Row="1">
            <StackPanel Padding="24,8,24,24" Spacing="4">
                <!--  Inbound Rules  -->
                <controls:SettingsCard
                    Description="Configure rules for incoming network traffic"
                    Header="Inbound Rules">
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE896;" />
                    </controls:SettingsCard.HeaderIcon>
                </controls:SettingsCard>

                <!--  Outbound Rules  -->
                <controls:SettingsCard
                    Description="Configure rules for outgoing network traffic"
                    Header="Outbound Rules">
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE8A7;" />
                    </controls:SettingsCard.HeaderIcon>
                </controls:SettingsCard>

                <!--  Connection Security Rules  -->
                <controls:SettingsCard
                    Description="Configure IPsec connection security rules"
                    Header="Connection Security Rules">
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE192;" />
                    </controls:SettingsCard.HeaderIcon>
                </controls:SettingsCard>

                <!--  Monitoring  -->
                <controls:SettingsCard
                    Description="View active firewall rules and connections"
                    Header="Monitoring">
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE7F4;" />
                    </controls:SettingsCard.HeaderIcon>
                </controls:SettingsCard>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
