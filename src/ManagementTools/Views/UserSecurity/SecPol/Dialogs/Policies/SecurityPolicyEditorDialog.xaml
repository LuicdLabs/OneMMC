<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="ManagementTools.Views.SecurityPolicyEditorDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    CloseButtonText="{x:Bind LocalizedStrings.Common_CancelButton}"
    DefaultButton="Primary"
    PrimaryButtonClick="ContentDialog_PrimaryButtonClick"
    PrimaryButtonText="{x:Bind LocalizedStrings.Common_OKButton}"
    Style="{StaticResource DefaultContentDialogStyle}"
    mc:Ignorable="d">

    <Grid MinWidth="480" MinHeight="350">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Policy Title  -->
        <StackPanel
            Grid.Row="0"
            Margin="0,0,0,12"
            Orientation="Horizontal"
            Spacing="12">
            <TextBlock
                x:Name="PolicyTitleText"
                VerticalAlignment="Center"
                Style="{StaticResource SubtitleTextBlockStyle}"
                TextWrapping="Wrap" />
        </StackPanel>

        <!--  SelectorBar for Local Security Setting / Explain  -->
        <muxc:SelectorBar
            x:Name="EditorSelectorBar"
            Grid.Row="1"
            Margin="0,0,0,12"
            SelectionChanged="EditorSelectorBar_SelectionChanged">
            <muxc:SelectorBarItem
                IsSelected="True"
                Tag="General"
                Text="{x:Bind LocalizedStrings.SecPol_Tab_General}" />
            <muxc:SelectorBarItem Tag="Explain" Text="{x:Bind LocalizedStrings.SecPol_Tab_Explain}" />
        </muxc:SelectorBar>

        <!--  Content Area  -->
        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
            <Grid>
                <!--  General Panel  -->
                <StackPanel
                    x:Name="GeneralPanel"
                    Spacing="12"
                    Visibility="Visible">

                    <!--  Define this policy CheckBox (for AllowNotDefined policies)  -->
                    <CheckBox
                        x:Name="DefinePolicyCheckBox"
                        Checked="DefinePolicyCheckBox_Changed"
                        Content="{x:Bind LocalizedStrings.SecPol_DefineThisPolicy}"
                        Unchecked="DefinePolicyCheckBox_Changed"
                        Visibility="Collapsed" />

                    <!--  Editor Container (enabled/disabled based on DefinePolicyCheckBox)  -->
                    <StackPanel x:Name="EditorContainer" Spacing="12">

                        <!--  Numeric Policy Editor  -->
                        <StackPanel
                            x:Name="NumericEditor"
                            Spacing="8"
                            Visibility="Collapsed">
                            <TextBlock x:Name="NumericLabel" TextWrapping="Wrap" />
                            <muxc:NumberBox
                                x:Name="NumericValueBox"
                                Width="280"
                                HorizontalAlignment="Left"
                                SpinButtonPlacementMode="Inline"
                                ValueChanged="NumericValueBox_ValueChanged" />
                            <TextBlock
                                x:Name="NumericUnitText"
                                FontSize="12"
                                Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" />
                        </StackPanel>

                        <!--  Boolean Policy Editor  -->
                        <StackPanel
                            x:Name="BooleanEditor"
                            Spacing="8"
                            Visibility="Collapsed">
                            <RadioButton
                                x:Name="EnabledRadio"
                                Content="{x:Bind LocalizedStrings.Common_Enabled}"
                                GroupName="BooleanGroup" />
                            <RadioButton
                                x:Name="DisabledRadio"
                                Content="{x:Bind LocalizedStrings.Common_Disabled}"
                                GroupName="BooleanGroup" />
                        </StackPanel>

                        <!--  String Policy Editor (single-line)  -->
                        <StackPanel
                            x:Name="StringEditor"
                            Spacing="8"
                            Visibility="Collapsed">
                            <TextBlock
                                x:Name="StringLabel"
                                TextWrapping="Wrap"
                                Visibility="Collapsed" />
                            <TextBox
                                x:Name="StringValueBox"
                                AcceptsReturn="False"
                                TextWrapping="NoWrap" />
                        </StackPanel>

                        <!--  MultiString Policy Editor (multi-line, like secpol.msc listbox)  -->
                        <StackPanel
                            x:Name="MultiStringEditor"
                            Spacing="8"
                            Visibility="Collapsed">
                            <TextBlock
                                x:Name="MultiStringLabel"
                                TextWrapping="Wrap"
                                Visibility="Collapsed" />
                            <TextBox
                                x:Name="MultiStringValueBox"
                                MinHeight="160"
                                MaxHeight="280"
                                AcceptsReturn="True"
                                ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                ScrollViewer.VerticalScrollBarVisibility="Auto"
                                TextWrapping="NoWrap" />
                        </StackPanel>

                        <!--  Audit Policy Editor  -->
                        <StackPanel
                            x:Name="AuditEditor"
                            Spacing="8"
                            Visibility="Collapsed">
                            <TextBlock FontWeight="SemiBold" Text="{x:Bind LocalizedStrings.SecPol_AuditSettings}" />
                            <CheckBox x:Name="AuditSuccessCheck" Content="{x:Bind LocalizedStrings.SecPol_AuditSuccess}" />
                            <CheckBox x:Name="AuditFailureCheck" Content="{x:Bind LocalizedStrings.SecPol_AuditFailure}" />
                        </StackPanel>

                        <!--  User Rights Assignment Editor  -->
                        <StackPanel
                            x:Name="UserRightsEditor"
                            Spacing="8"
                            Visibility="Collapsed">
                            <TextBlock FontWeight="SemiBold" Text="{x:Bind LocalizedStrings.SecPol_AssignedAccounts}" />
                            <ListView
                                x:Name="AccountsList"
                                MaxHeight="200"
                                SelectionMode="Single">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <TextBlock Text="{x:Bind}" />
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button
                                    x:Name="AddAccountButton"
                                    Click="AddAccountButton_Click"
                                    Content="{x:Bind LocalizedStrings.Common_AddButton}" />
                                <Button
                                    x:Name="RemoveAccountButton"
                                    Click="RemoveAccountButton_Click"
                                    Content="{x:Bind LocalizedStrings.Common_RemoveButton}" />
                            </StackPanel>
                        </StackPanel>

                        <!--  Dropdown Policy Editor (matches secpol.msc ComboBox)  -->
                        <StackPanel
                            x:Name="DropdownEditor"
                            Spacing="8"
                            Visibility="Collapsed">
                            <ComboBox
                                x:Name="DropdownValueCombo"
                                MinWidth="400"
                                HorizontalAlignment="Stretch" />
                        </StackPanel>

                        <!--  Bitmask Flags Policy Editor  -->
                        <StackPanel
                            x:Name="BitmaskFlagsEditor"
                            Spacing="8"
                            Visibility="Collapsed">
                            <TextBlock x:Name="BitmaskFlagsLabel" TextWrapping="Wrap" />
                            <StackPanel x:Name="BitmaskFlagsOptionsPanel" Spacing="6" />
                        </StackPanel>

                    </StackPanel>
                </StackPanel>

                <!--  Explain Panel  -->
                <StackPanel
                    x:Name="ExplainPanel"
                    Spacing="8"
                    Visibility="Collapsed">
                    <Border Padding="12" CornerRadius="4">
                        <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto">
                            <TextBlock
                                x:Name="ExplainText"
                                IsTextSelectionEnabled="True"
                                TextWrapping="Wrap" />
                        </ScrollViewer>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!--  Validation Error  -->
        <InfoBar
            x:Name="ValidationError"
            Grid.Row="4"
            Margin="0,8,0,0"
            IsClosable="False"
            IsOpen="False"
            Severity="Error" />
    </Grid>
</ContentDialog>
