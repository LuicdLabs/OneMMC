<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="ManagementTools.Views.LusrMgr.GroupPropertiesDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:ManagementTools.Core.Features.PCManagement.Models.LusrMgr"
    mc:Ignorable="d"
    CloseButtonText="{x:Bind LocalizedStrings.Common_CancelButton}"
    PrimaryButtonText="{x:Bind LocalizedStrings.Common_OKButton}"
    DefaultButton="Primary"
    Style="{StaticResource DefaultContentDialogStyle}">

    <Grid MinWidth="400" MinHeight="400">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock
            Grid.Row="0"
            Margin="0,0,0,12"
            Style="{StaticResource SubtitleTextBlockStyle}"
            Text="{x:Bind LocalizedStrings.LusrMgr_GroupProperties_Title}"
            TextWrapping="Wrap" />

        <!-- Content -->
        <ScrollViewer Grid.Row="1">
            <StackPanel Spacing="12">
                <TextBlock Text="{x:Bind LocalizedStrings.LusrMgr_GroupProperties_GroupName}" FontWeight="SemiBold" />
                <TextBox x:Name="GroupNameBox" IsReadOnly="True" Background="Transparent" />

                <TextBlock Text="{x:Bind LocalizedStrings.LusrMgr_GroupProperties_Description}" FontWeight="SemiBold" />
                <TextBox x:Name="DescriptionBox" />

                <TextBlock Text="{x:Bind LocalizedStrings.LusrMgr_GroupProperties_Members}" FontWeight="SemiBold" />
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4">
                    <ListView x:Name="MembersList" MinHeight="120" MaxHeight="180">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE77B;" FontSize="16" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    <TextBlock Text="{x:Bind}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Border>

                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                    <Button Content="{x:Bind LocalizedStrings.Common_AddButton}" Click="OnAddMemberClick"/>
                    <Button Content="{x:Bind LocalizedStrings.Common_RemoveButton}" Click="OnRemoveMemberClick"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</ContentDialog>
