<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="ManagementTools.Views.LusrMgr.SelectGroupDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:ManagementTools.Core.Features.PCManagement.Models.LusrMgr"
    CloseButtonText="{x:Bind LocalizedStrings.Common_CancelButton}"
    DefaultButton="Primary"
    PrimaryButtonText="{x:Bind LocalizedStrings.LusrMgr_SelectGroup_Select}"
    Style="{StaticResource DefaultContentDialogStyle}"
    mc:Ignorable="d">

    <Grid MinWidth="400" MinHeight="400">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  Header  -->
        <TextBlock
            Grid.Row="0"
            Margin="0,0,0,12"
            Style="{StaticResource SubtitleTextBlockStyle}"
            Text="{x:Bind LocalizedStrings.LusrMgr_SelectGroup_Title}"
            TextWrapping="Wrap" />

        <!--  Content  -->
        <ScrollViewer Grid.Row="1">
            <StackPanel Spacing="12">
                <TextBox
                    x:Name="SearchBox"
                    PlaceholderText="{x:Bind LocalizedStrings.LusrMgr_SearchGroups}"
                    TextChanged="OnSearchTextChanged" />

                <Border>
                    <ListView
                        x:Name="GroupsList"
                        MinHeight="200"
                        SelectionMode="Single">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:LocalGroup">
                                <StackPanel Spacing="2">
                                    <TextBlock FontWeight="Bold" Text="{x:Bind Name}" />
                                    <TextBlock
                                        FontSize="12"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{x:Bind Description}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</ContentDialog>
