<?xml version="1.0" encoding="utf-8" ?>
<!--
    TaskSchedulerPage — UI prototype for a modern taskschd.msc replacement (main view).

    NOTE: This page currently renders MOCK / SAMPLE data only. Every value, list item,
    toggle state and string below is hardcoded to demonstrate the final UI.
    TODO(TaskScheduler): wire to a real ViewModel + service (Task Scheduler 2.0 COM API:
    Schedule.Service / ITaskService, or Microsoft.Win32.TaskScheduler) under Core/Features
    following the project's MVVM + DI conventions, and migrate all user-facing strings to
    ResourceKeys / .resw (en-US, zh-TW). Double-tapping a task opens TaskPropertiesPage.
-->
<Page
	x:Class="ManagementTools.Views.PCManagement.TaskSchedulerPage"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:converters="using:ManagementTools.Converters"
	xmlns:cwuc="using:CommunityToolkit.WinUI.Controls"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:local="using:ManagementTools.Views.PCManagement"
	xmlns:localization="using:ManagementTools.Localization"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	mc:Ignorable="d">

	<Page.Resources>
		<localization:LocalizedStrings x:Key="LocalizedStrings" />
		<converters:NullToBoolConverter x:Key="NullToBoolConverter" />

		<!--  Secondary (subtitle) text inside list rows  -->
		<Style x:Key="SecondaryTextStyle" TargetType="TextBlock">
			<Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
			<Setter Property="FontSize" Value="12" />
		</Style>
	</Page.Resources>

	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
		</Grid.RowDefinitions>

		<!--  CommandBar  -->
		<CommandBar Grid.Row="0" DefaultLabelPosition="Right">
			<!--  Opens CreateTaskDialog (UI prototype). TODO(TaskScheduler): back it with a real creation flow.  -->
			<AppBarButton
				x:Name="CreateTaskButton"
				Click="CreateTaskButton_Click"
				Icon="Add"
				Label="Create Task" />
			<!--  TODO(TaskScheduler): re-enumerate the selected folder's tasks.  -->
			<AppBarButton Icon="Refresh" Label="Refresh" />
			<AppBarSeparator />

			<!--
				Disable / Enable is ONE toggle button (glyph + label swap in code-behind).
				Disable glyph E769, Enable glyph E768. Enabled only when a task is selected.
			-->
			<AppBarButton
				x:Name="DisableEnableButton"
				Click="DisableEnableButton_Click"
				IsEnabled="{x:Bind TasksListView.SelectedItem, Converter={StaticResource NullToBoolConverter}, Mode=OneWay}"
				Label="Disable">
				<AppBarButton.Icon>
					<FontIcon x:Name="DisableEnableIcon" Glyph="&#xE769;" />
				</AppBarButton.Icon>
			</AppBarButton>

			<!--  Properties (glyph E90F): opens TaskPropertiesPage for the selected task.  -->
			<AppBarButton
				x:Name="PropertiesButton"
				Click="PropertiesButton_Click"
				IsEnabled="{x:Bind TasksListView.SelectedItem, Converter={StaticResource NullToBoolConverter}, Mode=OneWay}"
				Label="Properties">
				<AppBarButton.Icon>
					<FontIcon Glyph="&#xE90F;" />
				</AppBarButton.Icon>
			</AppBarButton>

			<!--  More (glyph E712): MenuFlyout with task / folder actions.  -->
			<AppBarButton Label="More" LabelPosition="Collapsed">
				<AppBarButton.Icon>
					<FontIcon Glyph="&#xE712;" />
				</AppBarButton.Icon>
				<AppBarButton.Flyout>
					<MenuFlyout>
						<!--  Run / End toggle (Run glyph E768, End glyph E71A). Needs a selected task.  -->
						<MenuFlyoutItem
							x:Name="RunEndMenuItem"
							Click="RunEndMenuItem_Click"
							IsEnabled="{x:Bind TasksListView.SelectedItem, Converter={StaticResource NullToBoolConverter}, Mode=OneWay}"
							Text="Run">
							<MenuFlyoutItem.Icon>
								<FontIcon x:Name="RunEndIcon" Glyph="&#xE768;" />
							</MenuFlyoutItem.Icon>
						</MenuFlyoutItem>
						<!--  TODO(TaskScheduler): export the selected task definition to XML.  -->
						<MenuFlyoutItem IsEnabled="{x:Bind TasksListView.SelectedItem, Converter={StaticResource NullToBoolConverter}, Mode=OneWay}" Text="Export">
							<MenuFlyoutItem.Icon>
								<FontIcon Glyph="&#xEDE1;" />
							</MenuFlyoutItem.Icon>
						</MenuFlyoutItem>
						<!--  TODO(TaskScheduler): delete the selected task (confirm via ContentDialog first).  -->
						<MenuFlyoutItem IsEnabled="{x:Bind TasksListView.SelectedItem, Converter={StaticResource NullToBoolConverter}, Mode=OneWay}" Text="Delete">
							<MenuFlyoutItem.Icon>
								<FontIcon Glyph="&#xE74D;" />
							</MenuFlyoutItem.Icon>
						</MenuFlyoutItem>
						<MenuFlyoutSeparator />
						<!--
							Folder-scoped actions. TODO(TaskScheduler): enable/disable these based on the
							currently selected TreeView folder node (a folder must be selected to create a
							sub-folder or import a task into it).
						-->
						<MenuFlyoutItem Text="New folder">
							<MenuFlyoutItem.Icon>
								<FontIcon Glyph="&#xE8F4;" />
							</MenuFlyoutItem.Icon>
						</MenuFlyoutItem>
						<MenuFlyoutItem Text="Import Task...">
							<MenuFlyoutItem.Icon>
								<FontIcon Glyph="&#xE8B5;" />
							</MenuFlyoutItem.Icon>
						</MenuFlyoutItem>
						<!--  TODO(TaskScheduler): launch the legacy taskschd.msc snap-in.  -->
						<MenuFlyoutItem Click="OpenLegacyTaskScheduler_Click" Text="Open Legacy Task Scheduler" />
					</MenuFlyout>
				</AppBarButton.Flyout>
			</AppBarButton>
		</CommandBar>

		<!--  Content: TreeView | ContentSizer | (Search + Task list)  -->
		<Grid Grid.Row="1">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition Width="*" MinWidth="320" />
			</Grid.ColumnDefinitions>

			<!--  Left: folder tree (Task Scheduler Library)  -->
			<Border
				x:Name="TreePanel"
				Grid.Column="0"
				Width="280"
				MinWidth="200"
				BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
				BorderThickness="0,0,1,0">
				<!--  TODO(TaskScheduler): populate RootNodes from ITaskFolder hierarchy under "\".  -->
				<TreeView
					x:Name="LibraryTreeView"
					AllowDrop="False"
					CanDrag="False"
					CanReorderItems="False"
					ItemInvoked="LibraryTreeView_ItemInvoked"
					SelectionMode="Single">
					<TreeView.ItemContainerStyle>
						<Style TargetType="TreeViewItem">
							<Setter Property="MinHeight" Value="36" />
						</Style>
					</TreeView.ItemContainerStyle>
				</TreeView>
			</Border>

			<!--  Resizer for the tree panel (CommunityToolkit ContentSizer)  -->
			<cwuc:ContentSizer
				Grid.Column="1"
				Width="12"
				TargetControl="{x:Bind TreePanel}" />

			<!--  Right: search + task list  -->
			<Grid Grid.Column="2">
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto" />
					<RowDefinition Height="*" />
				</Grid.RowDefinitions>

				<!--  TODO(TaskScheduler): filter the task list by the typed query.  -->
				<AutoSuggestBox
					Grid.Row="0"
					Margin="12,12,12,8"
					PlaceholderText="Search"
					QueryIcon="Find" />

				<!--  Task list. Double-tap a task to open its properties (TaskPropertiesPage).  -->
				<ListView
					x:Name="TasksListView"
					Grid.Row="1"
					Margin="12,0,12,12"
					DoubleTapped="TasksListView_DoubleTapped"
					ItemsSource="{x:Bind SampleTasks}"
					SelectionMode="Single">
					<ListView.ItemTemplate>
						<DataTemplate x:DataType="local:ScheduledTaskSample">
							<StackPanel Padding="4,8" Spacing="2">
								<TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind Name}" />
								<TextBlock
									Style="{StaticResource SecondaryTextStyle}"
									Text="{x:Bind StatusLine}"
									TextTrimming="CharacterEllipsis" />
							</StackPanel>
						</DataTemplate>
					</ListView.ItemTemplate>
				</ListView>
			</Grid>
		</Grid>
	</Grid>
</Page>
