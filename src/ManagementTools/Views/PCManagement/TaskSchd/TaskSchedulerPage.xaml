<?xml version="1.0" encoding="utf-8" ?>
<Page
	x:Class="ManagementTools.Views.PCManagement.TaskSchedulerPage"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:cwuc="using:CommunityToolkit.WinUI.Controls"
	xmlns:localization="using:ManagementTools.Localization"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	mc:Ignorable="d">
	<Page.Resources>
		<localization:LocalizedStrings x:Key="LocalizedStrings" />
	</Page.Resources>

	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
		</Grid.RowDefinitions>

		<!-- CommandBar -->
		<CommandBar Grid.Row="0" DefaultLabelPosition="Right">
			<AppBarButton Icon="Refresh" Label="Refresh" />
            <AppBarButton Icon="More" />
        </CommandBar>

		<!-- Content Area -->
		<ScrollViewer Grid.Row="1">
			<StackPanel Padding="24,20,24,24" Spacing="4">
				<!-- Scheduler Library Card -->
				<cwuc:SettingsCard 
					Header="Scheduler Library"
					IsClickEnabled="True">
                    <cwuc:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE8F1;" />
                    </cwuc:SettingsCard.HeaderIcon>
                </cwuc:SettingsCard>

				<!-- Task Status Card -->
				<cwuc:SettingsCard 
					Header="Task Status"
					IsClickEnabled="False">
					<cwuc:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xF739;" />
					</cwuc:SettingsCard.HeaderIcon>
					<Button Content="View" MinWidth="120" />
				</cwuc:SettingsCard>

				<!-- Active Tasks Card -->
				<cwuc:SettingsCard 
					Header="Active Tasks"
					IsClickEnabled="False">
					<cwuc:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xF7EC;" />
					</cwuc:SettingsCard.HeaderIcon>
                    <Button Content="View" MinWidth="120" />
				</cwuc:SettingsCard>
			</StackPanel>
		</ScrollViewer>
	</Grid>
</Page>
