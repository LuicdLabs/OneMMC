<?xml version="1.0" encoding="utf-8" ?>
<!--
    CustomRangeDialog — opened from the New Event Filter "Logged" picker when the user chooses
    "Custom range…". Lets the user bound the filter by a From/To range; each side is either an open
    bound (First Event / Last Event) or a specific "Events On" date and time. The OK button is gated
    on validation (From must be earlier than To), and the caller reverts the Logged selection when the
    dialog is cancelled.
-->
<ContentDialog
	x:Class="ManagementTools.Views.PCManagement.CustomRangeDialog"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	Title="Custom Range"
	mc:Ignorable="d"
	CloseButtonText="Cancel"
	DefaultButton="Primary"
	PrimaryButtonText="OK">

	<Grid MinWidth="480" RowSpacing="14">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>

		<TextBlock
			Grid.Row="0"
			Foreground="{ThemeResource TextFillColorSecondaryBrush}"
			Text="Enter a custom date range for your filter."
			TextWrapping="Wrap" />

		<!--  From bound  -->
		<Grid
			Grid.Row="1"
			ColumnSpacing="8"
			RowSpacing="8">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="44" />
				<ColumnDefinition Width="118" />
				<ColumnDefinition Width="*" />
			</Grid.ColumnDefinitions>
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto" />
				<RowDefinition Height="Auto" />
			</Grid.RowDefinitions>
			<TextBlock
				Grid.Row="0"
				Grid.Column="0"
				VerticalAlignment="Center"
				Text="From:" />
			<ComboBox
				x:Name="FromModeCombo"
				Grid.Row="0"
				Grid.Column="1"
				Width="118"
				SelectionChanged="Mode_SelectionChanged">
				<ComboBoxItem Content="First Event" />
				<ComboBoxItem Content="Events On" />
			</ComboBox>
			<Grid
				Grid.Row="1"
				Grid.Column="1"
				Grid.ColumnSpan="2"
				ColumnSpacing="8">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="132" />
					<ColumnDefinition Width="*" />
				</Grid.ColumnDefinitions>
				<CalendarDatePicker
					x:Name="FromDate"
					Grid.Column="0"
					HorizontalAlignment="Stretch" />
				<TimePicker
					x:Name="FromTime"
					Grid.Column="1"
					MinWidth="0"
					HorizontalAlignment="Stretch"
					ClockIdentifier="24HourClock" />
			</Grid>
		</Grid>

		<!--  To bound  -->
		<Grid
			Grid.Row="2"
			ColumnSpacing="8"
			RowSpacing="8">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="44" />
				<ColumnDefinition Width="118" />
				<ColumnDefinition Width="*" />
			</Grid.ColumnDefinitions>
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto" />
				<RowDefinition Height="Auto" />
			</Grid.RowDefinitions>
			<TextBlock
				Grid.Row="0"
				Grid.Column="0"
				VerticalAlignment="Center"
				Text="To:" />
			<ComboBox
				x:Name="ToModeCombo"
				Grid.Row="0"
				Grid.Column="1"
				Width="118"
				SelectionChanged="Mode_SelectionChanged">
				<ComboBoxItem Content="Last Event" />
				<ComboBoxItem Content="Events On" />
			</ComboBox>
			<Grid
				Grid.Row="1"
				Grid.Column="1"
				Grid.ColumnSpan="2"
				ColumnSpacing="8">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="132" />
					<ColumnDefinition Width="*" />
				</Grid.ColumnDefinitions>
				<CalendarDatePicker
					x:Name="ToDate"
					Grid.Column="0"
					HorizontalAlignment="Stretch" />
				<TimePicker
					x:Name="ToTime"
					Grid.Column="1"
					MinWidth="0"
					HorizontalAlignment="Stretch"
					ClockIdentifier="24HourClock" />
			</Grid>
		</Grid>

		<InfoBar
			x:Name="ValidationBar"
			Grid.Row="3"
			IsClosable="False"
			IsOpen="False"
			Severity="Error" />
	</Grid>
</ContentDialog>
