<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="ManagementTools.Views.DeviceManagerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:coreServices="using:ManagementTools.Core.Features.PCManagement.Services.DevMgmt"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:ManagementTools.Views"
    xmlns:localization="using:ManagementTools.Localization"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:winui="using:Microsoft.UI.Xaml.Controls"
    mc:Ignorable="d">

    <Page.Resources>
        <local:BoolToGlyphConverter x:Key="BoolToGlyphConverter" />
        <local:BoolToColorConverter x:Key="BoolToColorConverter" />
        <local:BoolToGlyphConverter x:Key="DeviceStatusGlyphConverter" FalseValue="&#xE73E;" TrueValue="&#xE7BA;" />
        <local:BoolToColorConverter x:Key="DeviceStatusColorConverter" FalseValue="#FF107C10" TrueValue="#FFD83B01" />
        <local:InverseBoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <local:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter_Normal" />
        <local:DeviceCountFormatter x:Key="DeviceCountFormatter" />
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  Toolbar  -->
        <Grid Grid.Row="0" Padding="24,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel
                Width="300"
                HorizontalAlignment="Left"
                VerticalAlignment="Center">
                <AutoSuggestBox
                    x:Name="SearchBox"
                    Grid.Column="0"
                    PlaceholderText="{x:Bind LocalizedStrings.DeviceManager_SearchPlaceholder}"
                    QueryIcon="Find"
                    Text="{x:Bind ViewModel.SearchText, Mode=TwoWay}" />
            </StackPanel>
            <TextBlock
                x:Name="DeviceCountText"
                Grid.Column="1"
                Margin="16,0,0,0"
                VerticalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <CommandBar
                Grid.Column="2"
                Background="Transparent"
                DefaultLabelPosition="Right">

                <AppBarButton
                    x:Name="RefreshButton"
                    Click="RefreshButton_Click"
                    Label="{x:Bind LocalizedStrings.Common_Refresh}"
                    ToolTipService.ToolTip="{x:Bind LocalizedStrings.DeviceManager_RefreshTooltip}">
                    <AppBarButton.Icon>
                        <FontIcon FontSize="16" Glyph="&#xE72C;" />
                    </AppBarButton.Icon>
                </AppBarButton>

                <AppBarButton ToolTipService.ToolTip="{x:Bind LocalizedStrings.Common_MoreOptionsTooltip}">
                    <AppBarButton.Icon>
                        <FontIcon FontSize="16" Glyph="&#xE712;" />
                    </AppBarButton.Icon>
                    <AppBarButton.Flyout>
                        <MenuFlyout>
                            <MenuFlyoutItem Click="OpenDevMgmtButton_Click" Text="{x:Bind LocalizedStrings.DeviceManager_OpenSystemDeviceManager}">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE8A7;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutSeparator />
                            <ToggleMenuFlyoutItem IsChecked="{x:Bind ViewModel.ShowHiddenDevices, Mode=TwoWay}" Text="{x:Bind LocalizedStrings.DeviceManager_ShowHiddenDevices}" />
                        </MenuFlyout>
                    </AppBarButton.Flyout>
                </AppBarButton>
            </CommandBar>
        </Grid>

        <!--  Device List  -->
        <Grid Grid.Row="1" Padding="24,0,24,24">
            <!--  Pull-to-Refresh ListView  -->
            <winui:RefreshContainer x:Name="PullToRefreshContainer" RefreshRequested="PullToRefresh_RefreshRequested">
                <ListView
                    x:Name="DeviceCategoriesListView"
                    ItemsSource="{x:Bind ViewModel.DeviceCategories, Mode=OneWay}"
                    SelectionMode="None">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0,0,0,4" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="coreServices:DeviceCategory">
                            <controls:SettingsExpander
                                Header="{x:Bind Name}"
                                IsExpanded="False"
                                ItemsSource="{x:Bind Devices}">
                                <controls:SettingsExpander.Description>
                                    <TextBlock>
                                        <Run Text="{x:Bind DeviceCount, Converter={StaticResource DeviceCountFormatter}}" />
                                    </TextBlock>
                                </controls:SettingsExpander.Description>
                                <controls:SettingsExpander.ItemTemplate>
                                    <DataTemplate x:DataType="coreServices:DeviceInfo">
                                        <controls:SettingsCard
                                            Click="DeviceCard_Click"
                                            Description="{x:Bind StatusDescription}"
                                            Header="{x:Bind Name}"
                                            IsClickEnabled="True"
                                            Tag="{x:Bind}">
                                            <controls:SettingsCard.HeaderIcon>
                                                <FontIcon
                                                    Glyph="{x:Bind HasProblem, Converter={StaticResource DeviceStatusGlyphConverter}}"
                                                    Foreground="{x:Bind HasProblem, Converter={StaticResource DeviceStatusColorConverter}}" />
                                            </controls:SettingsCard.HeaderIcon>
                                        </controls:SettingsCard>
                                    </DataTemplate>
                                </controls:SettingsExpander.ItemTemplate>
                            </controls:SettingsExpander>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </winui:RefreshContainer>

            <!--  Loading overlay  -->
            <Grid
                x:Name="LoadingOverlay"
                IsHitTestVisible="True"
                Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter_Normal}}">
                <ProgressRing
                    Width="50"
                    Height="50"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />
            </Grid>
        </Grid>

    </Grid>
</Page>
