<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="ManagementTools.Views.DeviceDetailsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
    </Page.Resources>

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  Action Buttons  -->
        <CommandBar
            Grid.Row="0"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Background="Transparent"
            DefaultLabelPosition="Right">
            <AppBarButton
                x:Name="EnableDeviceButton"
                Click="EnableDeviceButton_Click"
                Icon="Play"
                IsEnabled="False"
                Label="{x:Bind LocalizedStrings.DeviceManager_EnableDevice}" />
            <AppBarButton
                x:Name="DisableDeviceButton"
                Click="DisableDeviceButton_Click"
                Icon="Stop"
                IsEnabled="False"
                Label="{x:Bind LocalizedStrings.DeviceManager_DisableDevice}" />
            <AppBarButton
                x:Name="UninstallDeviceButton"
                Click="UninstallDeviceButton_Click"
                Icon="Delete"
                IsEnabled="False"
                Label="{x:Bind LocalizedStrings.DeviceManager_UninstallDevice}" />
        </CommandBar>

        <!--  Details Content  -->
        <ScrollViewer Grid.Row="1" Padding="24,10,24,24">
            <StackPanel Spacing="4">
                <!--  General Information  -->
                <controls:SettingsExpander Header="{x:Bind LocalizedStrings.DeviceManager_GeneralInformation}" IsExpanded="True">
                    <controls:SettingsExpander.HeaderIcon>
                        <FontIcon Glyph="&#xE946;" />
                    </controls:SettingsExpander.HeaderIcon>

                    <controls:SettingsExpander.Items>
                        <controls:SettingsCard Header="{x:Bind LocalizedStrings.DeviceManager_DeviceName}">
                            <TextBlock
                                x:Name="DeviceNameDetail"
                                IsTextSelectionEnabled="True"
                                TextWrapping="Wrap" />
                        </controls:SettingsCard>

                        <controls:SettingsCard Header="{x:Bind LocalizedStrings.DeviceManager_DeviceType}">
                            <TextBlock x:Name="DeviceClassDetail" IsTextSelectionEnabled="True" />
                        </controls:SettingsCard>

                        <controls:SettingsCard Header="{x:Bind LocalizedStrings.DeviceManager_Manufacturer}">
                            <TextBlock x:Name="ManufacturerDetail" IsTextSelectionEnabled="True" />
                        </controls:SettingsCard>

                        <controls:SettingsCard Header="{x:Bind LocalizedStrings.DeviceManager_Status}">
                            <TextBlock x:Name="StatusDetail" IsTextSelectionEnabled="True" />
                        </controls:SettingsCard>

                        <controls:SettingsCard Description="{x:Bind LocalizedStrings.DeviceManager_DeviceIDDescription}" Header="{x:Bind LocalizedStrings.DeviceManager_DeviceID}">
                            <TextBlock
                                x:Name="DeviceIdDetail"
                                FontSize="12"
                                IsTextSelectionEnabled="True"
                                TextWrapping="Wrap" />
                        </controls:SettingsCard>

                        
                    </controls:SettingsExpander.Items>
                </controls:SettingsExpander>

                <!--  Driver Information  -->
                <controls:SettingsExpander Header="{x:Bind LocalizedStrings.DeviceManager_DriverInformation}" IsExpanded="True">
                    <controls:SettingsExpander.HeaderIcon>
                        <FontIcon Glyph="&#xE74C;" />
                    </controls:SettingsExpander.HeaderIcon>

                    <controls:SettingsExpander.Items>
                        <controls:SettingsCard Header="{x:Bind LocalizedStrings.DeviceManager_DriverVersion}">
                            <TextBlock x:Name="DriverVersionDetail" IsTextSelectionEnabled="True" />
                        </controls:SettingsCard>

                        <controls:SettingsCard Header="{x:Bind LocalizedStrings.DeviceManager_DriverDate}">
                            <TextBlock x:Name="DriverDateDetail" IsTextSelectionEnabled="True" />
                        </controls:SettingsCard>

                        <controls:SettingsCard Header="{x:Bind LocalizedStrings.DeviceManager_DriverProvider}">
                            <TextBlock x:Name="DriverProviderDetail" IsTextSelectionEnabled="True" />
                        </controls:SettingsCard>

                        <controls:SettingsCard Header="{x:Bind LocalizedStrings.DeviceManager_INFName}">
                            <TextBlock x:Name="InfNameDetail" IsTextSelectionEnabled="True" />
                        </controls:SettingsCard>

                        <controls:SettingsCard Header="{x:Bind LocalizedStrings.DeviceManager_DigitalSignature}">
                            <TextBlock x:Name="IsSignedDetail" IsTextSelectionEnabled="True" />
                        </controls:SettingsCard>

                        <controls:SettingsCard Header="{x:Bind LocalizedStrings.DeviceManager_Signer}">
                            <TextBlock
                                x:Name="SignerDetail"
                                IsTextSelectionEnabled="True"
                                TextWrapping="Wrap" />
                        </controls:SettingsCard>
                    </controls:SettingsExpander.Items>
                </controls:SettingsExpander>

                <!--  Hardware IDs  -->
                <controls:SettingsExpander Header="{x:Bind LocalizedStrings.DeviceManager_HardwareIDs}" IsExpanded="False">
                    <controls:SettingsExpander.HeaderIcon>
                        <FontIcon Glyph="&#xE950;" />
                    </controls:SettingsExpander.HeaderIcon>

                    <controls:SettingsExpander.Items>
                        <controls:SettingsCard Header="{x:Bind LocalizedStrings.DeviceManager_HardwareID}">
                            <controls:SettingsCard.Description>
                                <ItemsRepeater x:Name="HardwareIdsList" Margin="0,8,0,0">
                                    <ItemsRepeater.ItemTemplate>
                                        <DataTemplate x:DataType="x:String">
                                            <TextBlock
                                                Margin="0,2"
                                                FontFamily="Consolas"
                                                FontSize="12"
                                                IsTextSelectionEnabled="True"
                                                Text="{x:Bind}"
                                                TextWrapping="Wrap" />
                                        </DataTemplate>
                                    </ItemsRepeater.ItemTemplate>
                                </ItemsRepeater>
                            </controls:SettingsCard.Description>
                        </controls:SettingsCard>

                        <controls:SettingsCard Header="{x:Bind LocalizedStrings.DeviceManager_CompatibleID}">
                            <controls:SettingsCard.Description>
                                <ItemsRepeater x:Name="CompatibleIdsList" Margin="0,8,0,0">
                                    <ItemsRepeater.ItemTemplate>
                                        <DataTemplate x:DataType="x:String">
                                            <TextBlock
                                                Margin="0,2"
                                                FontFamily="Consolas"
                                                FontSize="12"
                                                IsTextSelectionEnabled="True"
                                                Text="{x:Bind}"
                                                TextWrapping="Wrap" />
                                        </DataTemplate>
                                    </ItemsRepeater.ItemTemplate>
                                </ItemsRepeater>
                            </controls:SettingsCard.Description>
                        </controls:SettingsCard>
                    </controls:SettingsExpander.Items>
                </controls:SettingsExpander>

                
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
