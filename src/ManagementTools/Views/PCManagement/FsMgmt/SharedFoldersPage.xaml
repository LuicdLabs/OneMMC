<?xml version="1.0" encoding="utf-8" ?>
<Page
	x:Class="ManagementTools.Views.SharedFoldersPage"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:local="using:ManagementTools.Views"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:controls="using:CommunityToolkit.WinUI.Controls"
	mc:Ignorable="d">

	<Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
		</Grid.RowDefinitions>

		<!-- CommandBar -->
        <CommandBar Grid.Row="0" Margin="0,12,0,0" DefaultLabelPosition="Right" Background="Transparent">
			<CommandBar.Content>
				<AutoSuggestBox 
					PlaceholderText="Search" 
					QueryIcon="Find"
					Width="300"
					Margin="12,8,0,8" />
			</CommandBar.Content>
			
			<AppBarButton Icon="Refresh" Label="Refresh" />
            <AppBarButton Icon="More" />
        </CommandBar>

		<!-- Main Content -->
		<ScrollViewer Grid.Row="1">
			<StackPanel Padding="24,12,24,24" Spacing="4">
				
				<!-- Shares Section -->
				<controls:SettingsExpander 
					IsExpanded="True"
					Header="Shares"
					Description="4 folders shared">
					<controls:SettingsExpander.HeaderIcon>
                        <FontIcon Glyph="&#xEC25;" />
					</controls:SettingsExpander.HeaderIcon>
					<controls:SettingsExpander.Items>
						
						<!-- Lab Share -->
                        <controls:SettingsCard 
							Header="Lab">
                            <controls:SettingsCard.Description>
                                <StackPanel>
                                    <TextBlock 
										Text="This is a description" 
										Foreground="{ThemeResource TextFillColorSecondaryBrush}"
										FontSize="12"
										VerticalAlignment="Center" />
                                    <TextBlock 
										Text="Path: C:\Users\Admin\Desktop\Lab | Client Connections: 0" 
										Foreground="{ThemeResource TextFillColorSecondaryBrush}"
										FontSize="12"
										VerticalAlignment="Center" />
                                </StackPanel>
                            </controls:SettingsCard.Description>
                            <Button Grid.Column="1" Margin="8,0,0,0" Style="{StaticResource SubtleButtonStyle}">
                                <FontIcon Glyph="&#xE712;" FontSize="16" />
                            </Button>
                        </controls:SettingsCard>

						<!-- ADMIN$ Share -->
                        <controls:SettingsCard 
							Header="ADMIN$">
                            <controls:SettingsCard.Description>
                                <StackPanel>
                                    <TextBlock 
										Text="Remote Admin" 
										Foreground="{ThemeResource TextFillColorSecondaryBrush}"
										FontSize="12"
										VerticalAlignment="Center" />
                                    <TextBlock 
										Text="Path: C:\WINDOWS | Client Connections: 0" 
										Foreground="{ThemeResource TextFillColorSecondaryBrush}"
										FontSize="12"
										VerticalAlignment="Center" />
                                </StackPanel>
                            </controls:SettingsCard.Description>
                            <Button Grid.Column="1" Margin="8,0,0,0" Style="{StaticResource SubtleButtonStyle}">
                                <FontIcon Glyph="&#xE712;" FontSize="16" />
                            </Button>
                        </controls:SettingsCard>

						<!-- C$ Share -->
                        <controls:SettingsCard 
							Header="C$">
                            <controls:SettingsCard.Description>
                                <StackPanel>
                                    <TextBlock 
										Text="Default share" 
										Foreground="{ThemeResource TextFillColorSecondaryBrush}"
										FontSize="12"
										VerticalAlignment="Center" />
                                    <TextBlock 
										Text="Path: C:\ | Client Connections: 0" 
										Foreground="{ThemeResource TextFillColorSecondaryBrush}"
										FontSize="12"
										VerticalAlignment="Center" />
                                </StackPanel>
                            </controls:SettingsCard.Description>
                            <Button Grid.Column="1" Margin="8,0,0,0" Style="{StaticResource SubtleButtonStyle}">
                                <FontIcon Glyph="&#xE712;" FontSize="16" />
                            </Button>
                        </controls:SettingsCard>

						<!-- IPC$ Share -->
                        <controls:SettingsCard 
							Header="IPC$">
                            <controls:SettingsCard.Description>
                                <StackPanel>
                                    <TextBlock 
										Text="Remote IPC" 
										Foreground="{ThemeResource TextFillColorSecondaryBrush}"
										FontSize="12"
										VerticalAlignment="Center" />
                                    <TextBlock 
										Text="Path:  | Client Connections: 1" 
										Foreground="{ThemeResource TextFillColorSecondaryBrush}"
										FontSize="12"
										VerticalAlignment="Center" />
                                </StackPanel>
                            </controls:SettingsCard.Description>
                            <Button Grid.Column="1" Margin="8,0,0,0" Style="{StaticResource SubtleButtonStyle}">
                                <FontIcon Glyph="&#xE712;" FontSize="16" />
                            </Button>
                        </controls:SettingsCard>

					</controls:SettingsExpander.Items>
					
					<!-- Add Button in Header -->
                    <Button Content="Add" MinWidth="120" />
                </controls:SettingsExpander>

				<!-- Sessions Section -->
				<controls:SettingsCard 
					Header="Sessions">
					<controls:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE7EE;" />
					</controls:SettingsCard.HeaderIcon>
					<Button Content="View" MinWidth="120" />
				</controls:SettingsCard>

				<!-- Open Files Section -->
				<controls:SettingsCard 
					Header="Open Files">
					<controls:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE838;" />
					</controls:SettingsCard.HeaderIcon>
					<Button Content="View" MinWidth="120" />
				</controls:SettingsCard>

			</StackPanel>
		</ScrollViewer>
	</Grid>
</Page>