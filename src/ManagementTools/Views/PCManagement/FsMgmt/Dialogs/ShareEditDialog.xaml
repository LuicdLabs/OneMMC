<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="ManagementTools.Views.FsMgmt.ShareEditDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid MinWidth="720" MaxWidth="820">
        <ScrollViewer VerticalScrollBarVisibility="Auto" VerticalScrollMode="Enabled">
            <StackPanel Padding="8" Spacing="18">
                <TextBlock
                    x:Name="DialogTitleTextBlock"
                    FontSize="24"
                    FontWeight="SemiBold"
                    TextWrapping="Wrap" />

                <InfoBar
                    x:Name="ValidationInfoBar"
                    IsClosable="True"
                    IsOpen="False"
                    Severity="Error" />

                <InfoBar
                    x:Name="AdminShareInfoBar"
                    IsClosable="False"
                    IsOpen="False"
                    Message="{x:Bind LocalizedStrings.FsMgmt_AdminShare_Info}"
                    Severity="Informational" />

                <StackPanel
                    x:Name="ComputerNamePanel"
                    Spacing="6">
                    <TextBlock
                        FontSize="15"
                        FontWeight="SemiBold"
                        Text="{x:Bind LocalizedStrings.FsMgmt_ComputerName_Label}" />
                    <TextBlock
                        x:Name="ComputerNameTextBlock"
                        FontSize="16" />
                </StackPanel>

                <StackPanel Spacing="6">
                    <TextBlock
                        FontSize="15"
                        FontWeight="SemiBold"
                        Text="{x:Bind LocalizedStrings.FsMgmt_FolderPath_Label}" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <TextBox
                            x:Name="FolderPathBox"
                            Grid.Column="0"
                            PlaceholderText="{x:Bind LocalizedStrings.FsMgmt_FolderPath_Placeholder}" />
                        <Button
                            x:Name="BrowseButton"
                            Grid.Column="1"
                            Click="BrowseButton_Click"
                            Content="{x:Bind LocalizedStrings.Common_BrowseButton}"
                            MinWidth="140" />
                    </Grid>
                </StackPanel>

                <TextBlock
                    x:Name="ShareInformationHeaderTextBlock"
                    FontSize="15"
                    FontWeight="SemiBold"
                    Text="{x:Bind LocalizedStrings.FsMgmt_ShareInformation_Header}" />

                <StackPanel Spacing="16">
                    <StackPanel Spacing="6">
                        <TextBlock
                            FontSize="15"
                            Text="{x:Bind LocalizedStrings.FsMgmt_ShareName_Label}" />
                        <TextBox
                            x:Name="ShareNameBox"
                            TextChanged="ShareNameBox_TextChanged" />
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock
                            FontSize="15"
                            Text="{x:Bind LocalizedStrings.FsMgmt_SharePath_Label}" />
                        <TextBox
                            x:Name="SharePathBox"
                            IsReadOnly="True" />
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock
                            FontSize="15"
                            Text="{x:Bind LocalizedStrings.FsMgmt_Description_Label}" />
                        <TextBox
                            x:Name="DescriptionBox"
                            AcceptsReturn="True"
                            MaxHeight="120"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>

                <StackPanel
                    x:Name="UserLimitPanel"
                    Spacing="10">
                    <TextBlock
                        FontSize="15"
                        FontWeight="SemiBold"
                        Text="{x:Bind LocalizedStrings.FsMgmt_UserLimit_Header}" />
                    <RadioButton
                        x:Name="MaximumAllowedRadio"
                        Checked="UserLimitRadio_Checked"
                        Content="{x:Bind LocalizedStrings.FsMgmt_UserLimit_MaximumAllowed}" />
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <RadioButton
                            x:Name="LimitedUsersRadio"
                            VerticalAlignment="Center"
                            Checked="UserLimitRadio_Checked"
                            Content="{x:Bind LocalizedStrings.FsMgmt_UserLimit_AllowNumber}" />
                        <NumberBox
                            x:Name="UserLimitBox"
                            Width="160"
                            Maximum="2147483647"
                            Minimum="1"
                            SmallChange="1"
                            SpinButtonPlacementMode="Inline"
                            Value="10" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Spacing="8">
                    <TextBlock
                        FontSize="15"
                        FontWeight="SemiBold"
                        Text="{x:Bind LocalizedStrings.FsMgmt_Offline_Label}" />
                    <ComboBox
                        x:Name="OfflineComboBox"
                        MinWidth="360"
                        SelectionChanged="OfflineComboBox_SelectionChanged">
                        <ComboBoxItem Content="{x:Bind LocalizedStrings.FsMgmt_Offline_Manual}" Tag="Manual" />
                        <ComboBoxItem Content="{x:Bind LocalizedStrings.FsMgmt_Offline_None}" Tag="None" />
                        <ComboBoxItem Content="{x:Bind LocalizedStrings.FsMgmt_Offline_Automatic}" Tag="Automatic" />
                    </ComboBox>
                    <CheckBox
                        x:Name="OptimizeCheckBox"
                        Content="{x:Bind LocalizedStrings.FsMgmt_OptimizePerformance}" />
                </StackPanel>

                <StackPanel x:Name="PermissionsPanel" Spacing="10">
                    <TextBlock
                        x:Name="PermissionsHeaderTextBlock"
                        FontSize="15"
                        FontWeight="SemiBold"
                        Text="{x:Bind LocalizedStrings.FsMgmt_PermissionsPreset_Label}" />
                    <ComboBox
                        x:Name="PermissionsPresetComboBox"
                        MinWidth="360"
                        SelectionChanged="PermissionsPresetComboBox_SelectionChanged">
                        <ComboBoxItem Content="{x:Bind LocalizedStrings.FsMgmt_Preset_EveryoneRead}" Tag="EveryoneRead" />
                        <ComboBoxItem Content="{x:Bind LocalizedStrings.FsMgmt_Preset_AdminFullOthersRead}" Tag="AdministratorsFullOthersRead" />
                        <ComboBoxItem Content="{x:Bind LocalizedStrings.FsMgmt_Preset_AdminFullOthersNone}" Tag="AdministratorsFullOthersNone" />
                        <ComboBoxItem Content="{x:Bind LocalizedStrings.FsMgmt_Preset_Custom}" Tag="Custom" />
                    </ComboBox>
                    <Grid
                        x:Name="CustomizePermissionsRow"
                        ColumnDefinitions="*,Auto"
                        ColumnSpacing="12">
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="15"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{x:Bind LocalizedStrings.FsMgmt_CustomPermissions_Header}" />
                        <Button
                            x:Name="CustomizePermissionsButton"
                            Grid.Column="1"
                            Click="CustomizePermissionsButton_Click"
                            Content="{x:Bind LocalizedStrings.FsMgmt_Customize}"
                            MinWidth="140" />
                    </Grid>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
