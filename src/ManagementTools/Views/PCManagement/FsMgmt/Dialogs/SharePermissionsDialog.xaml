<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="ManagementTools.Views.FsMgmt.SharePermissionsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:ManagementTools.Core.Features.PCManagement.Models.FsMgmt"
    mc:Ignorable="d">

    <Grid MinWidth="680" MaxWidth="820">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock
            Grid.Row="0"
            Margin="8,8,8,12"
            FontSize="15"
            FontWeight="SemiBold"
            Text="{x:Bind LocalizedStrings.FsMgmt_Permissions_AccountsHeader}" />

        <ListView
            x:Name="PermissionsList"
            Grid.Row="1"
            Margin="8,0"
            MaxHeight="320"
            ItemsSource="{x:Bind Entries}"
            SelectionChanged="PermissionsList_SelectionChanged"
            SelectionMode="Single">
            <ListView.Header>
                <Grid Padding="12,0,12,8" ColumnDefinitions="2*,*,*">
                    <TextBlock FontWeight="SemiBold" Text="{x:Bind LocalizedStrings.FsMgmt_Permissions_Account}" />
                    <TextBlock
                        Grid.Column="1"
                        FontWeight="SemiBold"
                        Text="{x:Bind LocalizedStrings.FsMgmt_Permissions_AccessType}" />
                    <TextBlock
                        Grid.Column="2"
                        FontWeight="SemiBold"
                        Text="{x:Bind LocalizedStrings.FsMgmt_Permissions_AccessRight}" />
                </Grid>
            </ListView.Header>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:SharePermissionEntry">
                    <Grid Padding="4" ColumnDefinitions="2*,*,*">
                        <TextBlock
                            Text="{x:Bind Name, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="NoWrap" />
                        <TextBlock
                            Grid.Column="1"
                            Text="{x:Bind AccessTypeDisplayName, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="NoWrap" />
                        <TextBlock
                            Grid.Column="2"
                            Text="{x:Bind AccessRightDisplayName, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="NoWrap" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <Grid
            Grid.Row="2"
            Margin="8,12,8,8"
            ColumnDefinitions="*,Auto">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button
                    Click="AddButton_Click"
                    Content="{x:Bind LocalizedStrings.Common_AddButton}" />
                <Button
                    x:Name="RemoveButton"
                    Click="RemoveButton_Click"
                    Content="{x:Bind LocalizedStrings.Common_RemoveButton}" />
                <Button
                    Click="AdvancedButton_Click"
                    Content="{x:Bind LocalizedStrings.FsMgmt_Permissions_Advanced}" />
            </StackPanel>

            <StackPanel
                Grid.Column="1"
                HorizontalAlignment="Right"
                Orientation="Horizontal"
                Spacing="8">
                <ComboBox
                    x:Name="AccessTypeComboBox"
                    MinWidth="120"
                    SelectionChanged="PermissionComboBox_SelectionChanged">
                    <ComboBoxItem Content="{x:Bind LocalizedStrings.FsMgmt_Permissions_Allow}" Tag="Allow" />
                    <ComboBoxItem Content="{x:Bind LocalizedStrings.FsMgmt_Permissions_Deny}" Tag="Deny" />
                </ComboBox>
                <ComboBox
                    x:Name="AccessRightComboBox"
                    MinWidth="160"
                    SelectionChanged="PermissionComboBox_SelectionChanged">
                    <ComboBoxItem Content="{x:Bind LocalizedStrings.FsMgmt_Permissions_Read}" Tag="Read" />
                    <ComboBoxItem Content="{x:Bind LocalizedStrings.FsMgmt_Permissions_Change}" Tag="Change" />
                    <ComboBoxItem Content="{x:Bind LocalizedStrings.FsMgmt_Permissions_FullControl}" Tag="FullControl" />
                </ComboBox>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
