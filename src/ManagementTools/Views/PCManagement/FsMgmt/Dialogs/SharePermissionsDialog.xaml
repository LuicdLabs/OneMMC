<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="ManagementTools.Views.FsMgmt.SharePermissionsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:ManagementTools.Views.FsMgmt"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:ManagementTools.Core.Features.PCManagement.Models.FsMgmt"
    mc:Ignorable="d">

    <UserControl.Resources>
        <Style x:Key="PermissionCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Padding" Value="0" />
        </Style>
    </UserControl.Resources>

    <Grid MinWidth="340" MaxWidth="380">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <SelectorBar
            x:Name="PermissionsSelectorBar"
            Grid.Row="0"
            Margin="0,0,0,10"
            SelectionChanged="PermissionsSelectorBar_SelectionChanged">
            <SelectorBarItem
                x:Name="SharePermissionsTabItem"
                IsSelected="True"
                Tag="SharePermissions"
                Text="{x:Bind LocalizedStrings.FsMgmt_Permissions_Title}" />
            <SelectorBarItem
                x:Name="SecurityTabItem"
                Tag="Security"
                Text="{x:Bind LocalizedStrings.FsMgmt_Permissions_SecurityTab}" />
        </SelectorBar>

        <Grid Grid.Row="1">
            <Grid
                x:Name="SharePermissionsPane"
                RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="112" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="140" />
                </Grid.RowDefinitions>

                <TextBlock Text="{x:Bind LocalizedStrings.FsMgmt_Permissions_AccountsHeader}" />

                <ListView
                    x:Name="PermissionsList"
                    Grid.Row="1"
                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    ItemsSource="{x:Bind Entries}"
                    SelectionChanged="PermissionsList_SelectionChanged"
                    SelectionMode="Single">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="MinHeight" Value="22" />
                            <Setter Property="Padding" Value="2,0" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:SharePermissionEntry">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="4">
                                <FontIcon
                                    FontSize="14"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Glyph="&#xE716;" />
                                <TextBlock
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Text="{x:Bind Name, Mode=OneTime}"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="NoWrap" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <StackPanel
                    Grid.Row="2"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal"
                    Spacing="8">
                    <Button
                        MinWidth="72"
                        Click="AddButton_Click"
                        Content="{x:Bind LocalizedStrings.FsMgmt_Permissions_AddButton}" />
                    <Button
                        x:Name="RemoveButton"
                        MinWidth="72"
                        Click="RemoveButton_Click"
                        Content="{x:Bind LocalizedStrings.Common_RemoveButton}" />
                </StackPanel>

                <TextBlock
                    x:Name="PermissionsForTextBlock"
                    Grid.Row="3" />

                <Border
                    Grid.Row="4"
                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1">
                    <Grid Padding="10,6" ColumnDefinitions="*,64,64" RowSpacing="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="26" />
                            <RowDefinition Height="26" />
                            <RowDefinition Height="26" />
                        </Grid.RowDefinitions>

                        <TextBlock
                            Grid.Column="1"
                            HorizontalAlignment="Center"
                            Text="{x:Bind LocalizedStrings.FsMgmt_Permissions_Allow}" />
                        <TextBlock
                            Grid.Column="2"
                            HorizontalAlignment="Center"
                            Text="{x:Bind LocalizedStrings.FsMgmt_Permissions_Deny}" />

                        <TextBlock
                            Grid.Row="1"
                            VerticalAlignment="Center"
                            Text="{x:Bind LocalizedStrings.FsMgmt_Permissions_FullControl}" />
                        <CheckBox
                            x:Name="AllowFullControlCheckBox"
                            Grid.Row="1"
                            Grid.Column="1"
                            Checked="PermissionCheckBox_Changed"
                            Style="{StaticResource PermissionCheckBoxStyle}"
                            Tag="Allow|FullControl"
                            Unchecked="PermissionCheckBox_Changed" />
                        <CheckBox
                            x:Name="DenyFullControlCheckBox"
                            Grid.Row="1"
                            Grid.Column="2"
                            Checked="PermissionCheckBox_Changed"
                            Style="{StaticResource PermissionCheckBoxStyle}"
                            Tag="Deny|FullControl"
                            Unchecked="PermissionCheckBox_Changed" />

                        <TextBlock
                            Grid.Row="2"
                            VerticalAlignment="Center"
                            Text="{x:Bind LocalizedStrings.FsMgmt_Permissions_Change}" />
                        <CheckBox
                            x:Name="AllowChangeCheckBox"
                            Grid.Row="2"
                            Grid.Column="1"
                            Checked="PermissionCheckBox_Changed"
                            Style="{StaticResource PermissionCheckBoxStyle}"
                            Tag="Allow|Change"
                            Unchecked="PermissionCheckBox_Changed" />
                        <CheckBox
                            x:Name="DenyChangeCheckBox"
                            Grid.Row="2"
                            Grid.Column="2"
                            Checked="PermissionCheckBox_Changed"
                            Style="{StaticResource PermissionCheckBoxStyle}"
                            Tag="Deny|Change"
                            Unchecked="PermissionCheckBox_Changed" />

                        <TextBlock
                            Grid.Row="3"
                            VerticalAlignment="Center"
                            Text="{x:Bind LocalizedStrings.FsMgmt_Permissions_Read}" />
                        <CheckBox
                            x:Name="AllowReadCheckBox"
                            Grid.Row="3"
                            Grid.Column="1"
                            Checked="PermissionCheckBox_Changed"
                            Style="{StaticResource PermissionCheckBoxStyle}"
                            Tag="Allow|Read"
                            Unchecked="PermissionCheckBox_Changed" />
                        <CheckBox
                            x:Name="DenyReadCheckBox"
                            Grid.Row="3"
                            Grid.Column="2"
                            Checked="PermissionCheckBox_Changed"
                            Style="{StaticResource PermissionCheckBoxStyle}"
                            Tag="Deny|Read"
                            Unchecked="PermissionCheckBox_Changed" />
                    </Grid>
                </Border>
            </Grid>

            <Grid
                x:Name="SecurityPane"
                RowSpacing="8"
                Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="74" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="154" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                    <TextBlock Text="{x:Bind LocalizedStrings.FsMgmt_Permissions_ObjectName}" />
                    <TextBlock
                        x:Name="ObjectNameTextBlock"
                        Grid.Column="1"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="NoWrap" />
                </Grid>

                <TextBlock
                    Grid.Row="1"
                    Text="{x:Bind LocalizedStrings.FsMgmt_Permissions_AccountsHeader}" />

                <ListView
                    x:Name="SecurityPrincipalsList"
                    Grid.Row="2"
                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    ItemsSource="{x:Bind SecurityEntries}"
                    SelectionChanged="SecurityPrincipalsList_SelectionChanged"
                    SelectionMode="Single">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="MinHeight" Value="22" />
                            <Setter Property="Padding" Value="2,0" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:FileSystemPermissionEntry">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="4">
                                <FontIcon
                                    FontSize="14"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Glyph="&#xE716;" />
                                <TextBlock
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Text="{x:Bind Name, Mode=OneTime}"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="NoWrap" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <Grid
                    Grid.Row="3"
                    ColumnDefinitions="*,Auto"
                    ColumnSpacing="12">
                    <TextBlock
                        VerticalAlignment="Center"
                        Text="{x:Bind LocalizedStrings.FsMgmt_Permissions_EditInstruction}" />
                    <Button
                        x:Name="SecurityEditButton"
                        Grid.Column="1"
                        MinWidth="88"
                        Click="SecurityEditButton_Click"
                        Content="{x:Bind LocalizedStrings.FsMgmt_Permissions_EditButton}" />
                </Grid>

                <TextBlock
                    x:Name="SecurityPermissionsForTextBlock"
                    Grid.Row="4" />

                <Border
                    Grid.Row="5"
                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" VerticalScrollMode="Auto">
                        <Grid Padding="10,6" ColumnDefinitions="*,64,64" RowSpacing="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="24" />
                                <RowDefinition Height="24" />
                                <RowDefinition Height="24" />
                                <RowDefinition Height="24" />
                                <RowDefinition Height="24" />
                                <RowDefinition Height="24" />
                            </Grid.RowDefinitions>

                            <TextBlock
                                Grid.Column="1"
                                HorizontalAlignment="Center"
                                Text="{x:Bind LocalizedStrings.FsMgmt_Permissions_Allow}" />
                            <TextBlock
                                Grid.Column="2"
                                HorizontalAlignment="Center"
                                Text="{x:Bind LocalizedStrings.FsMgmt_Permissions_Deny}" />

                            <TextBlock Grid.Row="1" Text="{x:Bind LocalizedStrings.FsMgmt_Permissions_FullControl}" />
                            <SymbolIcon
                                x:Name="SecurityAllowFullControlIcon"
                                Grid.Row="1"
                                Grid.Column="1"
                                Symbol="Accept" />
                            <SymbolIcon
                                x:Name="SecurityDenyFullControlIcon"
                                Grid.Row="1"
                                Grid.Column="2"
                                Symbol="Accept" />

                            <TextBlock Grid.Row="2" Text="{x:Bind LocalizedStrings.FsMgmt_Permissions_Modify}" />
                            <SymbolIcon
                                x:Name="SecurityAllowModifyIcon"
                                Grid.Row="2"
                                Grid.Column="1"
                                Symbol="Accept" />
                            <SymbolIcon
                                x:Name="SecurityDenyModifyIcon"
                                Grid.Row="2"
                                Grid.Column="2"
                                Symbol="Accept" />

                            <TextBlock Grid.Row="3" Text="{x:Bind LocalizedStrings.FsMgmt_Permissions_ReadExecute}" />
                            <SymbolIcon
                                x:Name="SecurityAllowReadExecuteIcon"
                                Grid.Row="3"
                                Grid.Column="1"
                                Symbol="Accept" />
                            <SymbolIcon
                                x:Name="SecurityDenyReadExecuteIcon"
                                Grid.Row="3"
                                Grid.Column="2"
                                Symbol="Accept" />

                            <TextBlock Grid.Row="4" Text="{x:Bind LocalizedStrings.FsMgmt_Permissions_ListFolder}" />
                            <SymbolIcon
                                x:Name="SecurityAllowListFolderIcon"
                                Grid.Row="4"
                                Grid.Column="1"
                                Symbol="Accept" />
                            <SymbolIcon
                                x:Name="SecurityDenyListFolderIcon"
                                Grid.Row="4"
                                Grid.Column="2"
                                Symbol="Accept" />

                            <TextBlock Grid.Row="5" Text="{x:Bind LocalizedStrings.FsMgmt_Permissions_Read}" />
                            <SymbolIcon
                                x:Name="SecurityAllowReadIcon"
                                Grid.Row="5"
                                Grid.Column="1"
                                Symbol="Accept" />
                            <SymbolIcon
                                x:Name="SecurityDenyReadIcon"
                                Grid.Row="5"
                                Grid.Column="2"
                                Symbol="Accept" />

                            <TextBlock Grid.Row="6" Text="{x:Bind LocalizedStrings.FsMgmt_Permissions_Write}" />
                            <SymbolIcon
                                x:Name="SecurityAllowWriteIcon"
                                Grid.Row="6"
                                Grid.Column="1"
                                Symbol="Accept" />
                            <SymbolIcon
                                x:Name="SecurityDenyWriteIcon"
                                Grid.Row="6"
                                Grid.Column="2"
                                Symbol="Accept" />
                        </Grid>
                    </ScrollViewer>
                </Border>

                <Grid
                    Grid.Row="6"
                    ColumnDefinitions="*,Auto"
                    ColumnSpacing="12">
                    <TextBlock
                        VerticalAlignment="Center"
                        Text="{x:Bind LocalizedStrings.FsMgmt_Permissions_AdvancedInstruction}"
                        TextWrapping="Wrap" />
                    <Button
                        x:Name="SecurityAdvancedButton"
                        Grid.Column="1"
                        MinWidth="88"
                        Click="SecurityAdvancedButton_Click"
                        Content="{x:Bind LocalizedStrings.FsMgmt_Permissions_Advanced}" />
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
