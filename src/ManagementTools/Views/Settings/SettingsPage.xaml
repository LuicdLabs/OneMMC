<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="ManagementTools.Views.SettingsPage"
    x:Name="SettingsPageRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:cwuc="using:CommunityToolkit.WinUI.Controls"
    xmlns:local="using:ManagementTools.Models"
    xmlns:localization="using:ManagementTools.Localization"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
	<Page.Resources>
		<localization:LocalizedStrings x:Key="LocalizedStrings" />
	</Page.Resources>

    <ScrollViewer>
        <StackPanel Padding="24,20,24,24" Spacing="20">
			<!--  Settings Section  -->
			<StackPanel Spacing="4">
				<cwuc:SettingsCard
					Description="{x:Bind LocalizedStrings.SettingItem_Theme_Subtitle}"
					Header="{x:Bind LocalizedStrings.SettingItem_Theme_Title}"
					IsClickEnabled="False">
					<cwuc:SettingsCard.HeaderIcon>
						<FontIcon Glyph="&#xE790;" />
					</cwuc:SettingsCard.HeaderIcon>
					<controls:ComboBox
						x:Name="ThemeComboBox"
						ItemsSource="{x:Bind ViewModel.ThemeOptions}"
						DisplayMemberPath="DisplayName"
						SelectedValuePath="Value"
						SelectedValue="{x:Bind ViewModel.SelectedTheme, Mode=TwoWay}"
						HorizontalAlignment="Right"
						MinWidth="120">
					</controls:ComboBox>
				</cwuc:SettingsCard>

				<!-- CommunityToolkit Expander with LocalizedStrings binding -->
				   <cwuc:SettingsExpander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
					   <cwuc:SettingsExpander.Header>
						   <Grid>
							   <Grid.ColumnDefinitions>
								   <ColumnDefinition Width="Auto" />
								   <ColumnDefinition Width="*" />
								   <ColumnDefinition Width="Auto" />
							   </Grid.ColumnDefinitions>
                            <Image Source="ms-appx:///Assets/StoreLogo.png" Width="24" Height="24" VerticalAlignment="Center" Margin="0,0,20,0" />
							   <StackPanel Grid.Column="1" VerticalAlignment="Center">
								   <TextBlock Text="{x:Bind LocalizedStrings.Settings_About_Title}" Style="{StaticResource BodyTextBlockStyle}" />
								   <TextBlock Text="{x:Bind LocalizedStrings.Settings_About_AppDescription}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
							   </StackPanel>
						   </Grid>
					   </cwuc:SettingsExpander.Header>
							   <TextBlock Grid.Column="2" Text="0.0.1" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
					   <cwuc:SettingsExpander.Items>
						   <cwuc:SettingsCard HorizontalContentAlignment="Left" ContentAlignment="Left">
							   <StackPanel Margin="-12,0,0,0" Orientation="Vertical">
								   <HyperlinkButton Content="{x:Bind LocalizedStrings.Settings_About_LicenseTerms}" Click="LicenseTerms_Click" />
								   <HyperlinkButton Content="{x:Bind LocalizedStrings.Settings_About_ThirdPartyNotices}" Click="ThirdPartyNotices_Click" />
								   <HyperlinkButton Content="{x:Bind LocalizedStrings.Settings_About_PrivacyStatement}" Click="PrivacyStatement_Click" />
							   </StackPanel>
						   </cwuc:SettingsCard>
					   </cwuc:SettingsExpander.Items>
				   </cwuc:SettingsExpander>

				<HyperlinkButton
					Content="{x:Bind LocalizedStrings.Settings_About_SendFeedback}"
					HorizontalAlignment="Left"
					Margin="0,12,0,0"
					Click="SendFeedback_Click" />
			</StackPanel>
		</StackPanel>
    </ScrollViewer>
</Page>