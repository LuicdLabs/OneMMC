<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="ManagementTools.Views.Dialogs.Scope.ServicesDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid MinWidth="480" MinHeight="360">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock
            Grid.Row="0"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Text="{x:Bind LocalizedStrings.WF_ServicesDialog_Description}"
            TextWrapping="Wrap" />

        <InfoBar
            x:Name="ValidationInfoBar"
            Grid.Row="1"
            Margin="0,12,0,0"
            IsClosable="False"
            IsOpen="False"
            Severity="Error" />

        <!-- Apply to -->
        <StackPanel Grid.Row="2" Margin="0,12,0,0" Spacing="8">
            <RadioButton
                x:Name="AllServicesRadio"
                Content="{x:Bind LocalizedStrings.WF_ServicesDialog_All}"
                GroupName="ServiceGroup"
                IsChecked="True" />
            <RadioButton
                x:Name="OnlyServicesRadio"
                Content="{x:Bind LocalizedStrings.WF_ServicesDialog_Only}"
                GroupName="ServiceGroup" />
            <RadioButton
                x:Name="SpecificServiceRadio"
                Content="{x:Bind LocalizedStrings.WF_ServicesDialog_Specific}"
                GroupName="ServiceGroup" />

            <!-- Service list -->
            <Border
                Margin="24,4,0,0"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="4">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid
                        Grid.Row="0"
                        Padding="12,8"
                        Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Grid.Column="0"
                            FontWeight="SemiBold"
                            Text="{x:Bind LocalizedStrings.WF_Column_Name}" />
                        <TextBlock
                            Grid.Column="1"
                            FontWeight="SemiBold"
                            Text="{x:Bind LocalizedStrings.WF_ServicesDialog_ShortNameColumn}" />
                    </Grid>
                    <ListView
                        x:Name="ServiceListView"
                        Grid.Row="1"
                        MaxHeight="200"
                        IsEnabled="False"
                        SelectionMode="Single">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="12,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        Grid.Column="0"
                                        Text="{Binding DisplayName}"
                                        TextWrapping="WrapWholeWords" />
                                    <TextBlock
                                        Grid.Column="1"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{Binding ShortName}"
                                        TextWrapping="WrapWholeWords" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <RadioButton
                x:Name="ServiceShortNameRadio"
                Content="{x:Bind LocalizedStrings.WF_ServicesDialog_ShortName}"
                GroupName="ServiceGroup" />
            <TextBox
                x:Name="ServiceShortNameInputBox"
                IsEnabled="False"
                PlaceholderText="{x:Bind LocalizedStrings.WF_ServicesDialog_ShortNamePlaceholder}" />
        </StackPanel>

    </Grid>
</UserControl>
