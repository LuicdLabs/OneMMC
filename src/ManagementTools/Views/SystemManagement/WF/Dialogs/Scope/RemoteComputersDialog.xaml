<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="ManagementTools.Views.Dialogs.Scope.RemoteComputersDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    PrimaryButtonText="{x:Bind LocalizedStrings.Common_OKButton}"
    SecondaryButtonText="{x:Bind LocalizedStrings.Common_CancelButton}"
    Style="{StaticResource DefaultContentDialogStyle}"
    mc:Ignorable="d">

    <ScrollViewer
        MaxHeight="560"
        HorizontalScrollBarVisibility="Disabled"
        VerticalScrollBarVisibility="Auto"
        VerticalScrollMode="Enabled">
    <Grid MinWidth="480" MinHeight="400">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <InfoBar
            x:Name="SecureConnectionInfoBar"
            Grid.Row="0"
            Margin="0,0,0,12"
            IsClosable="False"
            IsOpen="False"
            Message="{x:Bind LocalizedStrings.WF_RemoteComputersDialog_SecureRequired}"
            Severity="Warning" />

        <InfoBar
            x:Name="ValidationInfoBar"
            Grid.Row="1"
            Margin="0,0,0,12"
            IsClosable="False"
            IsOpen="False"
            Severity="Error" />

        <TextBlock
            Grid.Row="2"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Text="{x:Bind LocalizedStrings.WF_RemoteComputersDialog_Description}"
            TextWrapping="Wrap" />

        <!-- Authorized computers -->
        <CheckBox
            x:Name="AuthorizedCheckBox"
            Grid.Row="3"
            Margin="0,12,0,6"
            Checked="AuthorizedCheckBox_Checked"
            Content="{x:Bind LocalizedStrings.WF_RemoteComputersDialog_Authorized}"
            FontWeight="SemiBold"
            Unchecked="AuthorizedCheckBox_Unchecked" />

        <Border
            Grid.Row="4"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="4">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <ListView
                    x:Name="AuthorizedListView"
                    Grid.Row="0"
                    IsEnabled="False"
                    MaxHeight="140"
                    SelectionMode="Single" />
                <StackPanel
                    Grid.Row="1"
                    Padding="8"
                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                    Orientation="Horizontal"
                    Spacing="8">
                    <Button x:Name="AuthAddButton" Content="{x:Bind LocalizedStrings.Common_AddButton}" IsEnabled="False" Click="AuthAddButton_Click" />
                    <Button x:Name="AuthDeleteButton" Content="{x:Bind LocalizedStrings.Common_DeleteButton}" IsEnabled="False" Click="AuthDeleteButton_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Exception computers -->
        <CheckBox
            x:Name="ExceptionCheckBox"
            Grid.Row="5"
            Margin="0,12,0,6"
            Checked="ExceptionCheckBox_Checked"
            Content="{x:Bind LocalizedStrings.WF_RemoteComputersDialog_Exception}"
            FontWeight="SemiBold"
            Unchecked="ExceptionCheckBox_Unchecked" />

        <TextBlock
            Grid.Row="6"
            Margin="0,0,0,6"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Text="{x:Bind LocalizedStrings.WF_RemoteComputersDialog_ExceptionDescription}"
            TextWrapping="Wrap" />

        <Border
            Grid.Row="7"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="4">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <ListView
                    x:Name="ExceptionListView"
                    Grid.Row="0"
                    IsEnabled="False"
                    MaxHeight="120"
                    SelectionMode="Single" />
                <StackPanel
                    Grid.Row="1"
                    Padding="8"
                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                    Orientation="Horizontal"
                    Spacing="8">
                    <Button x:Name="ExcAddButton" Content="{x:Bind LocalizedStrings.Common_AddButton}" IsEnabled="False" Click="ExcAddButton_Click" />
                    <Button x:Name="ExcDeleteButton" Content="{x:Bind LocalizedStrings.Common_DeleteButton}" IsEnabled="False" Click="ExcDeleteButton_Click" />
                </StackPanel>
            </Grid>
        </Border>

    </Grid>
    </ScrollViewer>
</ContentDialog>
