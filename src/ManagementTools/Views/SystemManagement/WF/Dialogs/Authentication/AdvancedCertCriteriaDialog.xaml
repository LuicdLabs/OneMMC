<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="ManagementTools.Views.Dialogs.Authentication.AdvancedCertCriteriaDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ManagementTools.Localization"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <UserControl.Resources>
        <local:LocalizedStrings x:Key="LocalizedStrings" />
    </UserControl.Resources>

    <ScrollViewer
        HorizontalScrollBarVisibility="Disabled"
        VerticalScrollBarVisibility="Auto"
        VerticalScrollMode="Enabled">
        <StackPanel MinWidth="480" Spacing="16">
            <TextBlock
                x:Name="ValidationMessageTextBlock"
                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                TextWrapping="Wrap"
                Visibility="Collapsed" />

            <!-- Restrict usage -->
            <Border
                Padding="12"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="4">
                <StackPanel Spacing="8">
                    <TextBlock FontWeight="SemiBold" Text="{Binding WF_AdvancedCertCriteria_RestrictUsage, Source={StaticResource LocalizedStrings}}" />
                    <StackPanel Orientation="Horizontal" Spacing="24">
                        <RadioButton
                            x:Name="NoRestrictionRadio"
                            Content="{Binding WF_AdvancedCertCriteria_NoRestrictionDefault, Source={StaticResource LocalizedStrings}}"
                            GroupName="RestrictGroup"
                            IsChecked="True" />
                        <RadioButton
                            x:Name="SelectionOnlyRadio"
                            Content="{Binding WF_AdvancedCriteria_RestrictSelectionOnly, Source={StaticResource LocalizedStrings}}"
                            GroupName="RestrictGroup" />
                        <RadioButton
                            x:Name="ValidationOnlyRadio"
                            Content="{Binding WF_AdvancedCriteria_RestrictValidationOnly, Source={StaticResource LocalizedStrings}}"
                            GroupName="RestrictGroup" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Enhanced key usage (EKU) -->
            <Border
                Padding="12"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="4">
                <StackPanel Spacing="8">
                    <TextBlock FontWeight="SemiBold" Text="{Binding WF_AdvancedCertCriteria_EnhancedKeyUsageEKU, Source={StaticResource LocalizedStrings}}" />
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- EKU dropdown -->
                        <ComboBox
                            x:Name="EkuCombo"
                            Grid.Row="0" Grid.Column="0"
                            HorizontalAlignment="Stretch"
                            SelectionChanged="EkuCombo_SelectionChanged"
                            SelectedIndex="0">
                            <ComboBoxItem Content="{Binding WF_AdvancedCertCriteria_IPsecSecurityIKEIntermediate13615582, Source={StaticResource LocalizedStrings}}" Tag="IPsec security IKE intermediate (1.3.6.1.5.5.8.2.2)" />
                            <ComboBoxItem Content="{Binding WF_AdvancedCertCriteria_DNSSEC1361413116411, Source={StaticResource LocalizedStrings}}" Tag="DNSSEC (1.3.6.1.4.1.311.64.1.1)" />
                            <ComboBoxItem Content="{Binding WF_AdvancedCertCriteria_ClientAuthentication136155732, Source={StaticResource LocalizedStrings}}" Tag="Client Authentication (1.3.6.1.5.5.7.3.2)" />
                            <ComboBoxItem Content="{Binding WF_AdvancedCertCriteria_ServerAuthentication136155731, Source={StaticResource LocalizedStrings}}" Tag="Server Authentication (1.3.6.1.5.5.7.3.1)" />
                            <ComboBoxItem Content="{Binding WF_AdvancedCertCriteria_CustomEKU, Source={StaticResource LocalizedStrings}}" Tag="Custom" />
                        </ComboBox>

                        <StackPanel Grid.Row="0" Grid.Column="1" Grid.RowSpan="2" Spacing="4" VerticalAlignment="Top">
                            <Button x:Name="EkuAddButton" Content="{Binding WF_AdvancedCertCriteria_Add, Source={StaticResource LocalizedStrings}}" Click="EkuAddButton_Click" HorizontalAlignment="Stretch" />
                            <Button x:Name="EkuRemoveButton" Content="{Binding WF_AdvancedCertCriteria_Remove, Source={StaticResource LocalizedStrings}}" Click="EkuRemoveButton_Click" HorizontalAlignment="Stretch" />
                        </StackPanel>

                        <TextBlock
                            Grid.Row="0" Grid.Column="2"
                            HorizontalAlignment="Right"
                            Text="{Binding WF_AdvancedCertCriteria_RequiredEKUs, Source={StaticResource LocalizedStrings}}" />

                        <!-- Custom EKU text input -->
                        <TextBox
                            x:Name="CustomEkuTextBox"
                            Grid.Row="1" Grid.Column="0"
                            Visibility="Collapsed"
                            PlaceholderText="{Binding WF_AdvancedCertCriteria_CustomOIDEG1234, Source={StaticResource LocalizedStrings}}" />

                        <!-- Required EKUs list -->
                        <ListView
                            x:Name="RequiredEkuList"
                            Grid.Row="1" Grid.Column="2"
                            Grid.RowSpan="2"
                            MinHeight="80" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Certificate name restriction -->
            <Border
                Padding="12"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="4">
                <StackPanel Spacing="8">
                    <TextBlock FontWeight="SemiBold" Text="{Binding WF_AdvancedCertCriteria_CertificateNameRestriction, Source={StaticResource LocalizedStrings}}" />
                    <Grid ColumnSpacing="12" RowSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Text="{Binding WF_AdvancedCertCriteria_SelectNameType, Source={StaticResource LocalizedStrings}}" />
                        <ComboBox x:Name="NameTypeCombo" Grid.Row="0" Grid.Column="1" HorizontalAlignment="Stretch" SelectedIndex="0">
                            <ComboBoxItem Content="{Binding WF_Common_None, Source={StaticResource LocalizedStrings}}" Tag="None" />
                            <ComboBoxItem Content="{Binding WF_AdvancedCertCriteria_SubjectAlternativeNameEmail, Source={StaticResource LocalizedStrings}}" Tag="SANEmail" />
                            <ComboBoxItem Content="{Binding WF_AdvancedCertCriteria_SubjectAlternativeNameDNS, Source={StaticResource LocalizedStrings}}" Tag="SANDNS" />
                            <ComboBoxItem Content="{Binding WF_AdvancedCertCriteria_SubjectAlternativeNamePrincipal, Source={StaticResource LocalizedStrings}}" Tag="SANPrincipal" />
                            <ComboBoxItem Content="{Binding WF_AdvancedCertCriteria_SubjectOU, Source={StaticResource LocalizedStrings}}" Tag="SubjectOU" />
                            <ComboBoxItem Content="{Binding WF_AdvancedCertCriteria_SubjectO, Source={StaticResource LocalizedStrings}}" Tag="SubjectO" />
                            <ComboBoxItem Content="{Binding WF_AdvancedCertCriteria_SubjectCN, Source={StaticResource LocalizedStrings}}" Tag="SubjectCN" />
                            <ComboBoxItem Content="{Binding WF_AdvancedCertCriteria_SubjectDC, Source={StaticResource LocalizedStrings}}" Tag="SubjectDC" />
                        </ComboBox>
                        <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Text="{Binding WF_AdvancedCertCriteria_CertificateName, Source={StaticResource LocalizedStrings}}" />
                        <TextBox x:Name="CertNameTextBox" Grid.Row="1" Grid.Column="1" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Certificate thumbprint -->
            <Border
                Padding="12"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="4">
                <StackPanel Spacing="8">
                    <TextBlock FontWeight="SemiBold" Text="{Binding WF_AdvancedCertCriteria_CertificateThumbprint, Source={StaticResource LocalizedStrings}}" />
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="{Binding WF_AdvancedCertCriteria_Thumbprint, Source={StaticResource LocalizedStrings}}" />
                        <TextBox x:Name="ThumbprintTextBox" Grid.Column="1" />
                    </Grid>
                    <CheckBox x:Name="FollowRenewalCheckBox" Content="{Binding WF_AdvancedCertCriteria_FollowCertificateRenewal, Source={StaticResource LocalizedStrings}}" />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
