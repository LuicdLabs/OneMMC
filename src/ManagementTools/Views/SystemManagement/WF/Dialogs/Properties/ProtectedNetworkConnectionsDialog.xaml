<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="ManagementTools.Views.Dialogs.WFProperties.ProtectedNetworkConnectionsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ManagementTools.Localization"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    PrimaryButtonText="{Binding Common_OKButton, Source={StaticResource LocalizedStrings}}"
    CloseButtonText="{Binding Common_CancelButton, Source={StaticResource LocalizedStrings}}"
    Style="{StaticResource DefaultContentDialogStyle}"
    mc:Ignorable="d">

    <ContentDialog.Resources>
        <local:LocalizedStrings x:Key="LocalizedStrings" />
    </ContentDialog.Resources>

    <ScrollViewer
        MaxHeight="560"
        HorizontalScrollBarVisibility="Disabled"
        VerticalScrollBarVisibility="Auto"
        VerticalScrollMode="Enabled">
        <StackPanel MinWidth="500" Spacing="12">
            <TextBlock
                Text="{Binding WF_ProtectedNetworkConnections_SelectTheCheckBoxForEachConnectionYouWantWindowsDefenderFirewall, Source={StaticResource LocalizedStrings}}"
                TextWrapping="Wrap" />

            <TextBlock FontWeight="SemiBold" Text="{Binding WF_ProtectedNetworkConnections_NetworkConnections, Source={StaticResource LocalizedStrings}}" />

            <Border
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="4"
                Padding="8">
                <ListView
                    x:Name="ConnectionsListView"
                    MinHeight="160"
                    SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <CheckBox
                                Content="{Binding Name}"
                                IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Border>
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
