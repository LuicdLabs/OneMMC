<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="ManagementTools.Views.Dialogs.WFProperties.ProfileLoggingSettingsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ManagementTools.Localization"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    CloseButtonText="{Binding Common_CancelButton, Source={StaticResource LocalizedStrings}}"
    PrimaryButtonText="{Binding Common_OKButton, Source={StaticResource LocalizedStrings}}"
    Style="{StaticResource DefaultContentDialogStyle}"
    mc:Ignorable="d">

    <ContentDialog.Resources>
        <local:LocalizedStrings x:Key="LocalizedStrings" />
    </ContentDialog.Resources>

    <ScrollViewer
        MaxHeight="560"
        HorizontalScrollBarVisibility="Disabled"
        VerticalScrollBarVisibility="Auto"
        VerticalScrollMode="Enabled">
        <StackPanel MinWidth="450" Spacing="10">
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Text="{Binding WF_ProfileLoggingSettings_Name, Source={StaticResource LocalizedStrings}}" />
                <TextBox
                    x:Name="LogFilePathTextBox"
                    Grid.Column="1"
                    Text="{Binding WF_ProfileLoggingSettings_System32LogFilesFirewallPfirewallLog, Source={StaticResource LocalizedStrings}}" />
                <Button
                    Grid.Column="2"
                    MinWidth="120"
                    Click="BrowseButton_Click"
                    Content="{Binding WF_Common_Browse, Source={StaticResource LocalizedStrings}}" />
            </Grid>

            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="220" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Text="{Binding WF_ProfileLoggingSettings_SizeLimitKB, Source={StaticResource LocalizedStrings}}" />
                <NumberBox
                    x:Name="SizeLimitNumberBox"
                    Grid.Column="1"
                    Minimum="1"
                    SmallChange="128"
                    SpinButtonPlacementMode="Inline"
                    Value="4096" />
            </Grid>

            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="220" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Text="{Binding WF_ProfileLoggingSettings_LogDroppedPackets, Source={StaticResource LocalizedStrings}}" />
                <ComboBox
                    x:Name="LogDroppedPacketsComboBox"
                    Grid.Column="1"
                    SelectedIndex="1">
                    <ComboBoxItem Content="{Binding WF_Common_Yes, Source={StaticResource LocalizedStrings}}" Tag="Yes" />
                    <ComboBoxItem Content="{Binding WF_Common_NoDefault, Source={StaticResource LocalizedStrings}}" Tag="No (default)" />
                </ComboBox>
            </Grid>

            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="220" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Text="{Binding WF_ProfileLoggingSettings_LogSuccessfulConnections, Source={StaticResource LocalizedStrings}}" />
                <ComboBox
                    x:Name="LogSuccessfulConnectionsComboBox"
                    Grid.Column="1"
                    SelectedIndex="1">
                    <ComboBoxItem Content="{Binding WF_Common_Yes, Source={StaticResource LocalizedStrings}}" Tag="Yes" />
                    <ComboBoxItem Content="{Binding WF_Common_NoDefault, Source={StaticResource LocalizedStrings}}" Tag="No (default)" />
                </ComboBox>
            </Grid>

            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="{Binding WF_ProfileLoggingSettings_NoteIfYouAreConfiguringTheLogFileNameOnGroupPolicy, Source={StaticResource LocalizedStrings}}"
                TextWrapping="Wrap" />

            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="{Binding WF_ProfileLoggingSettings_DefaultPathForTheLogFileIsSystemrootSystem32LogfilesFirewallPfirewall, Source={StaticResource LocalizedStrings}}"
                TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
