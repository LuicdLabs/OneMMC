<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="ManagementTools.Views.Dialogs.NewRule.NewConnectionSecurityRuleDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ManagementTools.Localization"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="{Binding WF_NewConnectionSecurityRule_NewConnectionSecurityRule, Source={StaticResource LocalizedStrings}}"
    DefaultButton="Primary"
    PrimaryButtonText="{Binding Common_CreateButton, Source={StaticResource LocalizedStrings}}"
    SecondaryButtonText="{Binding Common_CancelButton, Source={StaticResource LocalizedStrings}}"
    Style="{StaticResource DefaultContentDialogStyle}"
    mc:Ignorable="d">

    <ContentDialog.Resources>
        <local:LocalizedStrings x:Key="LocalizedStrings" />
    </ContentDialog.Resources>

    <ScrollViewer
        MinWidth="500"
        MaxHeight="560"
        HorizontalScrollBarVisibility="Disabled"
        VerticalScrollBarVisibility="Auto"
        VerticalScrollMode="Enabled">
        <StackPanel Spacing="14">
            <TextBlock
                x:Name="ValidationErrorTextBlock"
                Foreground="IndianRed"
                TextWrapping="Wrap"
                Visibility="Collapsed" />

            <TextBlock FontWeight="SemiBold" Text="{Binding WF_Common_Type, Source={StaticResource LocalizedStrings}}" />
            <ComboBox
                x:Name="RuleTypeBox"
                Width="Auto"
                HorizontalAlignment="Stretch"
                SelectedIndex="0"
                SelectionChanged="RuleTypeBox_SelectionChanged">
                <ComboBoxItem Content="{Binding WF_NewConnectionSecurityRule_Isolation, Source={StaticResource LocalizedStrings}}" Tag="Isolation" />
                <ComboBoxItem Content="{Binding WF_NewConnectionSecurityRule_AuthenticationExemption, Source={StaticResource LocalizedStrings}}" Tag="AuthenticationExemption" />
                <ComboBoxItem Content="{Binding WF_NewConnectionSecurityRule_ServerToServer, Source={StaticResource LocalizedStrings}}" Tag="ServerToServer" />
                <ComboBoxItem Content="{Binding WF_NewConnectionSecurityRule_Tunnel, Source={StaticResource LocalizedStrings}}" Tag="Tunnel" />
                <ComboBoxItem Content="{Binding WF_Common_Custom, Source={StaticResource LocalizedStrings}}" Tag="Custom" />
            </ComboBox>

            <StackPanel
                x:Name="TunnelTypeSection"
                Spacing="10"
                Visibility="Collapsed">
                <TextBlock FontWeight="SemiBold" Text="{Binding WF_NewConnectionSecurityRule_WhatTypeOfTunnelWouldYouLikeToCreate, Source={StaticResource LocalizedStrings}}" />
                <ComboBox
                    x:Name="TunnelTypeBox"
                    Width="Auto"
                    HorizontalAlignment="Stretch"
                    SelectedIndex="0"
                    SelectionChanged="TunnelTypeBox_SelectionChanged">
                    <ComboBoxItem Content="{Binding WF_NewConnectionSecurityRule_CustomConfiguration, Source={StaticResource LocalizedStrings}}" Tag="CustomConfiguration" />
                    <ComboBoxItem Content="{Binding WF_NewConnectionSecurityRule_ClientToGateway, Source={StaticResource LocalizedStrings}}" Tag="ClientToGateway" />
                    <ComboBoxItem Content="{Binding WF_NewConnectionSecurityRule_GatewayToClient, Source={StaticResource LocalizedStrings}}" Tag="GatewayToClient" />
                </ComboBox>
                <TextBlock x:Name="TunnelTypeDescriptionTextBlock" TextWrapping="Wrap" />

                <TextBlock FontWeight="SemiBold" Text="{Binding WF_NewConnectionSecurityRule_WouldYouLikeToExemptIPsecProtectedConnectionsFromThisTunnel, Source={StaticResource LocalizedStrings}}" />
                <RadioButton x:Name="TunnelExemptYesRadio" GroupName="TunnelExemptGroup">
                    <TextBlock Text="{Binding WF_NewConnectionSecurityRule_YesIfANetworkConnectionIsAlreadyProtectedByIPsecThroughAnother, Source={StaticResource LocalizedStrings}}" TextWrapping="Wrap" />
                </RadioButton>
                <RadioButton
                    x:Name="TunnelExemptNoRadio"
                    GroupName="TunnelExemptGroup"
                    IsChecked="True">
                    <TextBlock Text="{Binding WF_NewConnectionSecurityRule_NoSendAllNetworkTrafficThatMatchesThisRuleThroughTheTunnel, Source={StaticResource LocalizedStrings}}" TextWrapping="Wrap" />
                </RadioButton>

                <Grid
                    x:Name="TunnelKeyModuleGrid"
                    ColumnSpacing="8"
                    Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        Text="{Binding WF_NewConnectionSecurityRule_KeyingModule, Source={StaticResource LocalizedStrings}}" />
                    <ComboBox
                        x:Name="TunnelKeyModuleBox"
                        Grid.Column="1"
                        HorizontalAlignment="Stretch"
                        SelectedIndex="0">
                        <ComboBoxItem Content="{Binding WF_Common_Default, Source={StaticResource LocalizedStrings}}" Tag="Default" />
                        <ComboBoxItem Content="{Binding WF_NewConnectionSecurityRule_IKEv2, Source={StaticResource LocalizedStrings}}" Tag="IKEv2" />
                    </ComboBox>
                </Grid>
            </StackPanel>

            <StackPanel
                x:Name="ExemptComputersSection"
                Spacing="10"
                Visibility="Collapsed">
                <TextBlock FontWeight="SemiBold" Text="{Binding WF_NewConnectionSecurityRule_ExemptComputers, Source={StaticResource LocalizedStrings}}" />
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <ListView
                        x:Name="ExemptComputersListView"
                        Grid.Column="0"
                        Height="140"
                        SelectionMode="Single" />

                    <StackPanel Grid.Column="1" Spacing="6">
                        <Button
                            MinWidth="120"
                            Click="ExemptAddButton_Click"
                            Content="{Binding Common_AddButton, Source={StaticResource LocalizedStrings}}" />
                        <Button
                            MinWidth="120"
                            Click="ExemptEditButton_Click"
                            Content="{Binding Common_EditButton, Source={StaticResource LocalizedStrings}}" />
                        <Button
                            MinWidth="120"
                            Click="ExemptRemoveButton_Click"
                            Content="{Binding Common_RemoveButton, Source={StaticResource LocalizedStrings}}" />
                    </StackPanel>
                </Grid>
            </StackPanel>

            <StackPanel
                x:Name="EndpointsSection"
                Spacing="10"
                Visibility="Collapsed">
                <TextBlock FontWeight="SemiBold" Text="{Binding WF_NewConnectionSecurityRule_Endpoints, Source={StaticResource LocalizedStrings}}" />
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        Text="{Binding WF_NewConnectionSecurityRule_ConfigureIPEndpoints, Source={StaticResource LocalizedStrings}}" />
                    <Button
                        Grid.Column="1"
                        MinWidth="160"
                        Click="ConfigureEndpointsButton_Click"
                        Content="{Binding WF_Button_Configure, Source={StaticResource LocalizedStrings}}" />
                </Grid>
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        x:Name="InterfaceTypesValueTextBlock"
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        Text="{Binding WF_Common_AllInterfaceTypes, Source={StaticResource LocalizedStrings}}" />
                    <Button
                        Grid.Column="1"
                        MinWidth="160"
                        Click="CustomizeInterfaceTypesButton_Click"
                        Content="{Binding WF_NewConnectionSecurityRule_CustomizeInterfaceTypes, Source={StaticResource LocalizedStrings}}" />
                </Grid>
            </StackPanel>

            <StackPanel x:Name="RequirementsSection" Spacing="10">
                <TextBlock FontWeight="SemiBold" Text="{Binding WF_NewConnectionSecurityRule_Requirements, Source={StaticResource LocalizedStrings}}" />
                <ComboBox
                    x:Name="RequirementsBox"
                    Width="Auto"
                    HorizontalAlignment="Stretch"
                    SelectedIndex="0"
                    SelectionChanged="RequirementsBox_SelectionChanged">
                    <ComboBoxItem Content="{Binding WF_CSR_AuthMode_DoNotAuthenticate, Source={StaticResource LocalizedStrings}}" Tag="DoNotAuthenticate" />
                    <ComboBoxItem Content="{Binding WF_CSR_AuthMode_RequestInboundOutbound, Source={StaticResource LocalizedStrings}}" Tag="RequestInboundOutbound" />
                    <ComboBoxItem Content="{Binding WF_CSR_AuthMode_RequireInboundRequestOutbound, Source={StaticResource LocalizedStrings}}" Tag="RequireInboundRequestOutbound" />
                    <ComboBoxItem Content="{Binding WF_CSR_AuthMode_RequireInboundOutbound, Source={StaticResource LocalizedStrings}}" Tag="RequireInboundOutbound" />
                    <ComboBoxItem Content="{Binding WF_CSR_AuthMode_RequireInboundClearOutbound, Source={StaticResource LocalizedStrings}}" Tag="RequireInboundClearOutbound" />
                </ComboBox>
            </StackPanel>

            <StackPanel
                x:Name="TunnelEndpointsSection"
                Spacing="10"
                Visibility="Collapsed">
                <TextBlock FontWeight="SemiBold" Text="{Binding WF_NewConnectionSecurityRule_TunnelEndpoints, Source={StaticResource LocalizedStrings}}" />
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        Text="{Binding WF_Common_ConfigureTunnelEndpoints, Source={StaticResource LocalizedStrings}}" />
                    <Button
                        Grid.Column="1"
                        MinWidth="160"
                        Click="ConfigureTunnelEndpointsButton_Click"
                        Content="{Binding WF_Button_Configure, Source={StaticResource LocalizedStrings}}" />
                </Grid>
            </StackPanel>

            <StackPanel x:Name="AuthenticationMethodSection" Spacing="10">
                <TextBlock FontWeight="SemiBold" Text="{Binding WF_CSR_AuthenticationMethod, Source={StaticResource LocalizedStrings}}" />
                <ComboBox
                    x:Name="AuthenticationMethodBox"
                    Width="Auto"
                    HorizontalAlignment="Stretch"
                    SelectedIndex="4"
                    SelectionChanged="AuthenticationMethodBox_SelectionChanged">
                    <ComboBoxItem Content="{Binding WF_Common_Default, Source={StaticResource LocalizedStrings}}" Tag="Default" />
                    <ComboBoxItem Content="{Binding WF_CSR_AuthMethod_ComputerAndUser, Source={StaticResource LocalizedStrings}}" Tag="ComputerAndUser" />
                    <ComboBoxItem Content="{Binding WF_Common_ComputerKerberosV5, Source={StaticResource LocalizedStrings}}" Tag="Computer" />
                    <ComboBoxItem Content="{Binding WF_Common_UserKerberosV5, Source={StaticResource LocalizedStrings}}" Tag="User" />
                    <ComboBoxItem Content="{Binding WF_Tab_Advanced, Source={StaticResource LocalizedStrings}}" Tag="Advanced" />
                    <ComboBoxItem Content="{Binding WF_NewConnectionSecurityRule_ComputerCertificate, Source={StaticResource LocalizedStrings}}" Tag="ComputerCertificate" />
                </ComboBox>

                <StackPanel
                    x:Name="ComputerCertificateSection"
                    Spacing="8"
                    Visibility="Collapsed">
                    <Grid ColumnSpacing="10" RowSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            Text="{Binding WF_NewConnectionSecurityRule_SigningAlgorithm, Source={StaticResource LocalizedStrings}}" />
                        <ComboBox
                            x:Name="SigningAlgorithmBox"
                            Grid.Row="0"
                            Grid.Column="1"
                            Width="Auto"
                            HorizontalAlignment="Stretch"
                            SelectedIndex="0">
                            <ComboBoxItem Content="{Binding WF_SigningAlgorithm_RsaDefault, Source={StaticResource LocalizedStrings}}" Tag="RSA" />
                            <ComboBoxItem Content="{Binding WF_SigningAlgorithm_EcdsaP256, Source={StaticResource LocalizedStrings}}" Tag="ECDSA-P256" />
                            <ComboBoxItem Content="{Binding WF_SigningAlgorithm_EcdsaP384, Source={StaticResource LocalizedStrings}}" Tag="ECDSA-P384" />
                        </ComboBox>

                        <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            Text="{Binding WF_NewConnectionSecurityRule_CertificateStoreType, Source={StaticResource LocalizedStrings}}" />
                        <ComboBox
                            x:Name="CertificateStoreTypeBox"
                            Grid.Row="1"
                            Grid.Column="1"
                            Width="Auto"
                            HorizontalAlignment="Stretch"
                            SelectedIndex="0">
                            <ComboBoxItem Content="{Binding WF_CertificateStore_RootCADefault, Source={StaticResource LocalizedStrings}}" Tag="RootCA" />
                            <ComboBoxItem Content="{Binding WF_CertificateStore_IntermediateCA, Source={StaticResource LocalizedStrings}}" Tag="IntermediateCA" />
                        </ComboBox>
                    </Grid>

                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox
                            x:Name="CertificateAuthorityNameTextBox"
                            Grid.Column="0"
                            PlaceholderText="{Binding WF_NewConnectionSecurityRule_CAName, Source={StaticResource LocalizedStrings}}" />
                        <Button
                            Grid.Column="1"
                            MinWidth="160"
                            Click="BrowseCertificateAuthorityButton_Click"
                            Content="{Binding Common_BrowseButton, Source={StaticResource LocalizedStrings}}" />
                    </Grid>

                    <CheckBox x:Name="AcceptHealthCertificatesCheckBox" Content="{Binding WF_Common_AcceptOnlyHealthCertificates, Source={StaticResource LocalizedStrings}}" />
                </StackPanel>

                <Grid
                    x:Name="CustomizeMethodsGrid"
                    ColumnSpacing="8"
                    Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        Text="{Binding WF_CSR_CustomizeMethods, Source={StaticResource LocalizedStrings}}" />
                    <Button
                        x:Name="CustomizeMethodsButton"
                        Grid.Column="1"
                        MinWidth="160"
                        Click="CustomizeMethodsButton_Click"
                        Content="{Binding WF_Button_Customize, Source={StaticResource LocalizedStrings}}" />
                </Grid>
            </StackPanel>

            <StackPanel
                x:Name="ProtocolsAndPortsSection"
                Spacing="10"
                Visibility="Collapsed">
                <TextBlock FontWeight="SemiBold" Text="{Binding WF_Section_ProtocolsPorts, Source={StaticResource LocalizedStrings}}" />
                <Grid ColumnSpacing="10" RowSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock
                        Grid.Row="0"
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        Text="{Binding WF_Protocol_Type, Source={StaticResource LocalizedStrings}}" />
                    <ComboBox
                        x:Name="ProtocolTypeBox"
                        Grid.Row="0"
                        Grid.Column="1"
                        SelectedIndex="0"
                        SelectionChanged="ProtocolTypeBox_SelectionChanged">
                        <ComboBoxItem Content="{Binding WF_Common_Any, Source={StaticResource LocalizedStrings}}" Tag="Any" />
                        <ComboBoxItem Content="{Binding WF_Common_TCP, Source={StaticResource LocalizedStrings}}" Tag="TCP" />
                        <ComboBoxItem Content="{Binding WF_Common_UDP, Source={StaticResource LocalizedStrings}}" Tag="UDP" />
                        <ComboBoxItem Content="{Binding WF_Common_Custom, Source={StaticResource LocalizedStrings}}" Tag="Custom" />
                    </ComboBox>

                    <TextBlock
                        Grid.Row="1"
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        Text="{Binding WF_Protocol_Number, Source={StaticResource LocalizedStrings}}" />
                    <NumberBox
                        x:Name="ProtocolNumberBox"
                        Grid.Row="1"
                        Grid.Column="1"
                        IsEnabled="False"
                        Maximum="255"
                        Minimum="0"
                        Value="0" />

                    <TextBlock
                        Grid.Row="2"
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        Text="{Binding WF_CSR_Endpoint1Port, Source={StaticResource LocalizedStrings}}" />
                    <ComboBox
                        x:Name="Endpoint1PortBox"
                        Grid.Row="2"
                        Grid.Column="1"
                        SelectedIndex="0"
                        SelectionChanged="Endpoint1PortBox_SelectionChanged">
                        <ComboBoxItem Content="{Binding WF_Port_AllPorts, Source={StaticResource LocalizedStrings}}" Tag="AllPorts" />
                        <ComboBoxItem Content="{Binding WF_Port_SpecificPorts, Source={StaticResource LocalizedStrings}}" Tag="SpecificPorts" />
                    </ComboBox>

                    <TextBlock
                        x:Name="Endpoint1PortInputLabel"
                        Grid.Row="3"
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        Text="{Binding WF_CSR_Endpoint1Port_Input, Source={StaticResource LocalizedStrings}}"
                        Visibility="Collapsed" />
                    <TextBox
                        x:Name="Endpoint1PortInputTextBox"
                        Grid.Row="3"
                        Grid.Column="1"
                        Visibility="Collapsed" />

                    <TextBlock
                        Grid.Row="4"
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        Text="{Binding WF_CSR_Endpoint2Port, Source={StaticResource LocalizedStrings}}" />
                    <ComboBox
                        x:Name="Endpoint2PortBox"
                        Grid.Row="4"
                        Grid.Column="1"
                        SelectedIndex="0"
                        SelectionChanged="Endpoint2PortBox_SelectionChanged">
                        <ComboBoxItem Content="{Binding WF_Port_AllPorts, Source={StaticResource LocalizedStrings}}" Tag="AllPorts" />
                        <ComboBoxItem Content="{Binding WF_Port_SpecificPorts, Source={StaticResource LocalizedStrings}}" Tag="SpecificPorts" />
                    </ComboBox>

                    <TextBlock
                        x:Name="Endpoint2PortInputLabel"
                        Grid.Row="5"
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        Text="{Binding WF_CSR_Endpoint2Port_Input, Source={StaticResource LocalizedStrings}}"
                        Visibility="Collapsed" />
                    <TextBox
                        x:Name="Endpoint2PortInputTextBox"
                        Grid.Row="5"
                        Grid.Column="1"
                        Visibility="Collapsed" />
                </Grid>
            </StackPanel>

            <StackPanel x:Name="ProfileSection" Spacing="10">
                <TextBlock FontWeight="SemiBold" Text="{Binding WF_Field_Profile, Source={StaticResource LocalizedStrings}}" />
                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{Binding WF_Advanced_ProfilesDescription, Source={StaticResource LocalizedStrings}}" />
                <CheckBox x:Name="DomainCheckBox" Content="{Binding WF_Profile_Domain, Source={StaticResource LocalizedStrings}}" IsChecked="True" />
                <CheckBox
                    x:Name="PrivateCheckBox"
                    Content="{Binding WF_Profile_Private, Source={StaticResource LocalizedStrings}}"
                    IsChecked="True" />
                <CheckBox x:Name="PublicCheckBox" Content="{Binding WF_Profile_Public, Source={StaticResource LocalizedStrings}}" IsChecked="True" />
            </StackPanel>

            <StackPanel x:Name="NameSection" Spacing="10">
                <TextBlock FontWeight="SemiBold" Text="{Binding WF_Field_Name, Source={StaticResource LocalizedStrings}}" />
                <TextBlock Text="{Binding WF_Common_RuleName, Source={StaticResource LocalizedStrings}}" />
                <TextBox x:Name="RuleNameTextBox" />
                <TextBlock Text="{Binding WF_Common_DescriptionOptional, Source={StaticResource LocalizedStrings}}" />
                <TextBox
                    x:Name="RuleDescriptionTextBox"
                    Height="130"
                    AcceptsReturn="True"
                    TextWrapping="Wrap" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
