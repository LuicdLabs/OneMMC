<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="ManagementTools.Views.Dialogs.ConnectionSecurity.ConfigureTunnelEndpointsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ManagementTools.Localization"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <UserControl.Resources>
        <local:LocalizedStrings x:Key="LocalizedStrings" />
    </UserControl.Resources>

    <ScrollViewer
        HorizontalScrollBarVisibility="Disabled"
        VerticalScrollBarVisibility="Auto"
        VerticalScrollMode="Enabled">
        <StackPanel MinWidth="780" Spacing="12">
            <TextBlock x:Name="DescriptionTextBlock" Text="{Binding WF_TunnelEndpoints_DefaultDescription, Source={StaticResource LocalizedStrings}}" TextWrapping="Wrap" />

            <!--  Client section (top) — used by Client-to-gateway mode  -->
            <StackPanel x:Name="ClientTopSection" Spacing="8" Visibility="Collapsed">
                <TextBlock FontWeight="SemiBold" Text="{Binding WF_ConfigureTunnelEndpoints_Client, Source={StaticResource LocalizedStrings}}" />
                <RadioButton
                    x:Name="ClientTopRadioButton"
                    Content="{Binding WF_ConfigureTunnelEndpoints_MyIPAddress, Source={StaticResource LocalizedStrings}}"
                    GroupName="ClientTopGroup"
                    IsChecked="True"
                    IsEnabled="False" />
            </StackPanel>

            <!--  Endpoint 1 computers — used by Custom and Gateway-to-client  -->
            <StackPanel x:Name="Endpoint1Section" Spacing="8">
                <TextBlock x:Name="Endpoint1HeaderTextBlock" FontWeight="SemiBold" Text="{Binding WF_TunnelEndpoints_Endpoint1Header, Source={StaticResource LocalizedStrings}}" />
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <ListView
                        x:Name="Endpoint1ComputersListView"
                        Grid.Column="0"
                        Height="120"
                        SelectionMode="Single" />

                    <StackPanel Grid.Column="1" Spacing="6">
                        <Button MinWidth="120" Click="Endpoint1AddButton_Click" Content="{Binding WF_Common_AddEllipsis, Source={StaticResource LocalizedStrings}}" />
                        <Button MinWidth="120" Click="Endpoint1EditButton_Click" Content="{Binding WF_Common_Edit, Source={StaticResource LocalizedStrings}}" />
                        <Button MinWidth="120" Click="Endpoint1RemoveButton_Click" Content="{Binding Common_RemoveButton, Source={StaticResource LocalizedStrings}}" />
                    </StackPanel>
                </Grid>
            </StackPanel>

            <!--  Local tunnel endpoint — used by Custom and Gateway-to-client  -->
            <StackPanel x:Name="LocalTunnelSection" Spacing="8">
                <TextBlock FontWeight="SemiBold" Text="{Binding WF_ConfigureTunnelEndpoints_WhatIsTheLocalTunnelEndpointClosestToEndpoint1, Source={StaticResource LocalizedStrings}}" />
                <Grid ColumnSpacing="8" RowSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" MinWidth="100" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Text="{Binding WF_Common_IPv4Address, Source={StaticResource LocalizedStrings}}" />
                    <TextBox x:Name="LocalTunnelIpv4TextBox" Grid.Row="0" Grid.Column="1" />
                    <Button
                        x:Name="EditLocalTunnelButton"
                        Grid.Row="0"
                        Grid.Column="2"
                        MinWidth="120"
                        Click="EditLocalTunnelButton_Click"
                        Content="{Binding WF_Common_Edit, Source={StaticResource LocalizedStrings}}" />

                    <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Text="{Binding WF_Common_IPv6Address, Source={StaticResource LocalizedStrings}}" />
                    <TextBox x:Name="LocalTunnelIpv6TextBox" Grid.Row="1" Grid.Column="1" />
                </Grid>
            </StackPanel>

            <!--  IPsec Authorization — used by Custom and Gateway-to-client  -->
            <StackPanel x:Name="IpsecAuthorizationSection" Spacing="8">
                <CheckBox x:Name="ApplyIpsecAuthorizationCheckBox">
                    <TextBlock
                        Text="{Binding WF_ConfigureTunnelEndpoints_ApplyIPsecTunnelAuthorizationAsSpecifiedOnTheIPsecSettingsTab, Source={StaticResource LocalizedStrings}}"
                        TextWrapping="Wrap" />
                </CheckBox>
            </StackPanel>

            <!--  Remote tunnel endpoint — used by Custom and Client-to-gateway  -->
            <StackPanel x:Name="RemoteTunnelSection" Spacing="8">
                <TextBlock FontWeight="SemiBold" Text="{Binding WF_ConfigureTunnelEndpoints_WhatIsTheRemoteTunnelEndpointClosestToEndpoint2, Source={StaticResource LocalizedStrings}}" />
                <Grid ColumnSpacing="8" RowSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" MinWidth="100" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Text="{Binding WF_Common_IPv4Address, Source={StaticResource LocalizedStrings}}" />
                    <TextBox x:Name="RemoteTunnelIpv4TextBox" Grid.Row="0" Grid.Column="1" />
                    <Button
                        x:Name="EditRemoteTunnelButton"
                        Grid.Row="0"
                        Grid.Column="2"
                        MinWidth="120"
                        Click="EditRemoteTunnelButton_Click"
                        Content="{Binding WF_Common_Edit, Source={StaticResource LocalizedStrings}}" />

                    <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Text="{Binding WF_Common_IPv6Address, Source={StaticResource LocalizedStrings}}" />
                    <TextBox x:Name="RemoteTunnelIpv6TextBox" Grid.Row="1" Grid.Column="1" />
                </Grid>
            </StackPanel>

            <!--  Endpoint 2 computers — used by Custom and Client-to-gateway  -->
            <StackPanel x:Name="Endpoint2Section" Spacing="8">
                <TextBlock x:Name="Endpoint2HeaderTextBlock" FontWeight="SemiBold" Text="{Binding WF_TunnelEndpoints_Endpoint2Header, Source={StaticResource LocalizedStrings}}" />
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <ListView
                        x:Name="Endpoint2ComputersListView"
                        Grid.Column="0"
                        Height="120"
                        SelectionMode="Single" />

                    <StackPanel Grid.Column="1" Spacing="6">
                        <Button MinWidth="120" Click="Endpoint2AddButton_Click" Content="{Binding WF_Common_AddEllipsis, Source={StaticResource LocalizedStrings}}" />
                        <Button MinWidth="120" Click="Endpoint2EditButton_Click" Content="{Binding WF_Common_Edit, Source={StaticResource LocalizedStrings}}" />
                        <Button MinWidth="120" Click="Endpoint2RemoveButton_Click" Content="{Binding Common_RemoveButton, Source={StaticResource LocalizedStrings}}" />
                    </StackPanel>
                </Grid>
            </StackPanel>

            <!--  Client section (bottom) — used by Gateway-to-client mode  -->
            <StackPanel x:Name="ClientBottomSection" Spacing="8" Visibility="Collapsed">
                <TextBlock FontWeight="SemiBold" Text="{Binding WF_ConfigureTunnelEndpoints_Client, Source={StaticResource LocalizedStrings}}" />
                <RadioButton
                    x:Name="ClientBottomRadioButton"
                    Content="{Binding WF_Common_AnyIPAddress, Source={StaticResource LocalizedStrings}}"
                    GroupName="ClientBottomGroup"
                    IsChecked="True"
                    IsEnabled="False" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
