<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="ManagementTools.Views.Dialogs.ConnectionSecurity.CustomizeAllowIfSecureDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ManagementTools.Localization"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <UserControl.Resources>
        <local:LocalizedStrings x:Key="LocalizedStrings" />
    </UserControl.Resources>

    <StackPanel MinWidth="440" Spacing="0">

        <!--  Description  -->
        <TextBlock
            Margin="0,0,0,16"
            Text="{Binding WF_CustomizeAllowIfSecure_SelectOneOfTheFollowingOptionsToDetermineTheActionWindowsDefender, Source={StaticResource LocalizedStrings}}"
            TextWrapping="Wrap" />

        <!--  Option 1: Allow authenticated and integrity-protected connections  -->
        <RadioButton
            x:Name="AllowAuthenticatedRadio"
            Margin="0,0,0,4"
            Content="{Binding WF_CustomizeAllowIfSecure_AllowAuthenticatedAndIntegrityProtectedConnectionsA, Source={StaticResource LocalizedStrings}}"
            FontWeight="SemiBold"
            GroupName="AllowIfSecureGroup"
            IsChecked="True" />
        <TextBlock
            Margin="28,0,0,0"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Text="{Binding WF_CustomizeAllowIfSecure_OnlyAllowConnectionsThatAreAuthenticatedAndIntegrityProtectedUsingIPsecCompatible, Source={StaticResource LocalizedStrings}}"
            TextWrapping="Wrap" />

        <Border
            Height="1"
            Margin="0,12,0,12"
            Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

        <!--  Option 2: Require encrypted connections  -->
        <RadioButton
            x:Name="RequireEncryptionRadio"
            Margin="0,0,0,4"
            Content="{Binding WF_CustomizeAllowIfSecure_RequireEncryptedConnectionsE, Source={StaticResource LocalizedStrings}}"
            FontWeight="SemiBold"
            GroupName="AllowIfSecureGroup" />
        <TextBlock
            Margin="28,0,0,0"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Text="{Binding WF_CustomizeAllowIfSecure_InAdditionToIntegrityAndAuthenticationAlsoRequirePrivacy, Source={StaticResource LocalizedStrings}}"
            TextWrapping="Wrap" />
        <CheckBox
            x:Name="NegotiateEncryptionCheckBox"
            Margin="28,6,0,4"
            Content="{Binding WF_CustomizeAllowIfSecure_AllowTheComputersToDynamicallyNegotiateEncryption, Source={StaticResource LocalizedStrings}}"
            IsEnabled="False" />
        <TextBlock
            x:Name="NegotiateEncryptionDescriptionText"
            Margin="28,0,0,0"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Text="{Binding WF_CustomizeAllowIfSecure_ThisOptionAllowsAuthenticatedButUnencryptedNetworkPacketsToBeSentWhile, Source={StaticResource LocalizedStrings}}"
            TextWrapping="Wrap" />

        <Border
            Height="1"
            Margin="0,12,0,12"
            Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

        <!--  Option 3: Allow connections using Null encapsulation  -->
        <RadioButton
            x:Name="AllowNullEncapRadio"
            Margin="0,0,0,4"
            Content="{Binding WF_CustomizeAllowIfSecure_AllowConnectionsUsingNullEncapsulationN, Source={StaticResource LocalizedStrings}}"
            FontWeight="SemiBold"
            GroupName="AllowIfSecureGroup" />
        <TextBlock
            Margin="28,0,0,0"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Text="{Binding WF_CustomizeAllowIfSecure_NullEncapsulationAllowsYouToRequireAuthenticationForConnectionsButWithoutProviding, Source={StaticResource LocalizedStrings}}"
            TextWrapping="Wrap" />

        <Border
            Height="1"
            Margin="0,12,0,12"
            Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

        <!--  Override block rules  -->
        <CheckBox
            x:Name="OverrideBlockRulesCheckBox"
            Margin="0,0,0,4"
            Content="{Binding WF_CustomizeAllowIfSecure_OverrideBlockRulesO, Source={StaticResource LocalizedStrings}}"
            FontWeight="SemiBold" />
        <TextBlock
            x:Name="OverrideBlockRulesDescriptionText"
            Margin="28,0,0,0"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Text=""
            TextWrapping="Wrap" />

        <Border
            Height="1"
            Margin="0,12,0,0"
            Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

    </StackPanel>
</UserControl>
