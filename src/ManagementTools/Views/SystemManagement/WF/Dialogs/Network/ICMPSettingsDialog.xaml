<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="ManagementTools.Views.Dialogs.Network.ICMPSettingsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ManagementTools.Localization"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <UserControl.Resources>
        <local:LocalizedStrings x:Key="LocalizedStrings" />
    </UserControl.Resources>

    <StackPanel MinWidth="440" Spacing="8">

        <!--  Description  -->
        <TextBlock
            Margin="0,0,0,4"
            Text="{Binding WF_ICMPSettings_ApplyThisRuleToTheFollowingInternetControlMessageProtocolICMPConnections, Source={StaticResource LocalizedStrings}}"
            TextWrapping="Wrap" />

        <!--  All / Specific radio buttons  -->
        <RadioButton
            x:Name="AllTypesRadio"
            Content="{Binding WF_ICMPSettings_AllICMPTypesA, Source={StaticResource LocalizedStrings}}"
            GroupName="IcmpGroup"
            IsChecked="True" />
        <RadioButton
            x:Name="SpecificTypesRadio"
            Content="{Binding WF_ICMPSettings_SpecificICMPTypesS, Source={StaticResource LocalizedStrings}}"
            GroupName="IcmpGroup" />

        <!--  Specific ICMP type checkboxes  -->
        <Border
            BorderBrush="{ThemeResource SystemControlForegroundBaseMediumLowBrush}"
            BorderThickness="1">
            <ScrollViewer
                Height="220"
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto"
                VerticalScrollMode="Enabled">
                <StackPanel x:Name="IcmpCheckBoxPanel" Padding="4,4,4,4" Spacing="2">
                    <CheckBox x:Name="CbPacketTooBig"        Content="{Binding WF_ICMPSettings_PacketTooBig, Source={StaticResource LocalizedStrings}}" Tag="2:*" />
                    <CheckBox x:Name="CbDestUnreachable"     Content="{Binding WF_ICMPSettings_DestinationUnreachable, Source={StaticResource LocalizedStrings}}" Tag="3:*" />
                    <CheckBox x:Name="CbSourceQuench"        Content="{Binding WF_ICMPSettings_SourceQuench, Source={StaticResource LocalizedStrings}}" Tag="4:*" />
                    <CheckBox x:Name="CbRedirect"            Content="{Binding WF_ICMPSettings_Redirect, Source={StaticResource LocalizedStrings}}" Tag="5:*" />
                    <CheckBox x:Name="CbEchoRequest"         Content="{Binding WF_ICMPSettings_EchoRequest, Source={StaticResource LocalizedStrings}}" Tag="8:*" />
                    <CheckBox x:Name="CbRouterAdvertisement" Content="{Binding WF_ICMPSettings_RouterAdvertisement, Source={StaticResource LocalizedStrings}}" Tag="9:*" />
                    <CheckBox x:Name="CbRouterSolicitation"  Content="{Binding WF_ICMPSettings_RouterSolicitation, Source={StaticResource LocalizedStrings}}" Tag="10:*" />
                    <CheckBox x:Name="CbTimeExceeded"        Content="{Binding WF_ICMPSettings_TimeExceeded, Source={StaticResource LocalizedStrings}}" Tag="11:*" />
                    <CheckBox x:Name="CbParameterProblem"    Content="{Binding WF_ICMPSettings_ParameterProblem, Source={StaticResource LocalizedStrings}}" Tag="12:*" />
                    <CheckBox x:Name="CbTimestampRequest"    Content="{Binding WF_ICMPSettings_TimestampRequest, Source={StaticResource LocalizedStrings}}" Tag="13:*" />
                    <CheckBox x:Name="CbAddressMaskRequest"  Content="{Binding WF_ICMPSettings_AddressMaskRequest, Source={StaticResource LocalizedStrings}}" Tag="17:*" />
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!--  Custom ICMP type row  -->
        <TextBlock
            Margin="0,4,0,0"
            FontWeight="SemiBold"
            Text="{Binding WF_ICMPSettings_ThisICMPType, Source={StaticResource LocalizedStrings}}" />

        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="120" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="120" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock
                Grid.Column="0"
                VerticalAlignment="Center"
                Text="{Binding WF_ICMPSettings_TypeT, Source={StaticResource LocalizedStrings}}" />
            <NumberBox
                x:Name="TypeNumberBox"
                Grid.Column="1"
                IsEnabled="False"
                Maximum="255"
                Minimum="0"
                SpinButtonPlacementMode="Compact"
                Value="0" />

            <TextBlock
                Grid.Column="2"
                VerticalAlignment="Center"
                Text="{Binding WF_ICMPSettings_CodeC, Source={StaticResource LocalizedStrings}}" />
            <ComboBox
                x:Name="CodeComboBox"
                Grid.Column="3"
                IsEnabled="False"
                SelectedIndex="0" />

            <Button
                x:Name="AddTypeButton"
                Grid.Column="4"
                MinWidth="80"
                Click="AddTypeButton_Click"
                Content="{Binding WF_ICMPSettings_AddD, Source={StaticResource LocalizedStrings}}"
                IsEnabled="False" />
        </Grid>

    </StackPanel>
</UserControl>
