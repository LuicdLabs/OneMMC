<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="ManagementTools.Views.Dialogs.Network.IPAddressEntryDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ManagementTools.Localization"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <UserControl.Resources>
        <local:LocalizedStrings x:Key="LocalizedStrings" />
    </UserControl.Resources>

    <StackPanel x:Name="RootPanel" MinWidth="460" Spacing="12" Loaded="RootPanel_Loaded">
        <TextBlock Text="{Binding WF_IPAddressEntry_SpecifyTheIPAddressesToMatch, Source={StaticResource LocalizedStrings}}" />

        <!-- Option 1: This IP address or subnet -->
        <RadioButton
            x:Name="SubnetRadio"
            Content="{Binding WF_IPAddressEntry_ThisIPAddressOrSubnet, Source={StaticResource LocalizedStrings}}"
            GroupName="IPGroup"
            Checked="SubnetRadio_Checked" />
        <TextBox
            x:Name="SubnetTextBox"
            PlaceholderText="{Binding WF_IPAddressEntry_EG1921681024, Source={StaticResource LocalizedStrings}}"
            Margin="20,0,0,0" />
        <TextBlock
            Margin="20,0,0,0"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            TextWrapping="Wrap">
            <Run Text="{Binding WF_IPAddressEntry_Examples192168012, Source={StaticResource LocalizedStrings}}" /><LineBreak />
            <Run Text="{Binding WF_IPAddressEntry_Value1921681024, Source={StaticResource LocalizedStrings}}" /><LineBreak />
            <Run Text="{Binding WF_IPAddressEntry_Value20029d3b1a31420874ffFe396c43, Source={StaticResource LocalizedStrings}}" /><LineBreak />
            <Run Text="{Binding WF_IPAddressEntry_Value20029d3b1a31420874ffFe390112, Source={StaticResource LocalizedStrings}}" />
        </TextBlock>

        <!-- Option 2: This IP address range -->
        <RadioButton
            x:Name="RangeRadio"
            Content="{Binding WF_IPAddressEntry_ThisIPAddressRange, Source={StaticResource LocalizedStrings}}"
            GroupName="IPGroup"
            Checked="RangeRadio_Checked" />
        <Grid Margin="20,0,0,0" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="8" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Text="{Binding WF_IPAddressEntry_From, Source={StaticResource LocalizedStrings}}" />
            <TextBox x:Name="RangeFromTextBox" Grid.Row="0" Grid.Column="1" IsEnabled="False" />
            <TextBlock Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Text="{Binding WF_IPAddressEntry_To, Source={StaticResource LocalizedStrings}}" />
            <TextBox x:Name="RangeToTextBox" Grid.Row="2" Grid.Column="1" IsEnabled="False" />
        </Grid>

        <!-- Option 3: Predefined set of computers (only shown for Remote/Endpoint) -->
        <RadioButton
            x:Name="PredefinedRadio"
            Content="{Binding WF_IPAddressEntry_PredefinedSetOfComputers, Source={StaticResource LocalizedStrings}}"
            GroupName="IPGroup"
            Visibility="Collapsed"
            Checked="PredefinedRadio_Checked" />
        <ComboBox
            x:Name="PredefinedComboBox"
            Margin="20,0,0,0"
            HorizontalAlignment="Stretch"
            IsEnabled="False"
            Visibility="Collapsed">
            <ComboBoxItem Content="{Binding WF_IPAddressEntry_DefaultGateway, Source={StaticResource LocalizedStrings}}" Tag="Default gateway" />
            <ComboBoxItem Content="{Binding WF_IPAddressEntry_WINSServers, Source={StaticResource LocalizedStrings}}" Tag="WINS servers" />
            <ComboBoxItem Content="{Binding WF_IPAddressEntry_DHCPServers, Source={StaticResource LocalizedStrings}}" Tag="DHCP servers" />
            <ComboBoxItem Content="{Binding WF_IPAddressEntry_DNSServers, Source={StaticResource LocalizedStrings}}" Tag="DNS servers" />
            <ComboBoxItem Content="{Binding WF_IPAddressEntry_LocalSubnet, Source={StaticResource LocalizedStrings}}" Tag="Local subnet" />
            <ComboBoxItem Content="{Binding WF_IPAddressEntry_Intranet, Source={StaticResource LocalizedStrings}}" Tag="Intranet" />
            <ComboBoxItem Content="{Binding WF_IPAddressEntry_RemoteCorpNetwork, Source={StaticResource LocalizedStrings}}" Tag="Remote Corp Network" />
            <ComboBoxItem Content="{Binding WF_IPAddressEntry_Internet, Source={StaticResource LocalizedStrings}}" Tag="Internet" />
            <ComboBoxItem Content="{Binding WF_IPAddressEntry_PlayToRenderers, Source={StaticResource LocalizedStrings}}" Tag="PlayTo Renderers" />
            <ComboBoxItem Content="{Binding WF_IPAddressEntry_CaptivePortalAddresses, Source={StaticResource LocalizedStrings}}" Tag="Captive Portal Addresses" />
        </ComboBox>

    </StackPanel>
</UserControl>
