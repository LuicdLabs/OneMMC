<Page
    x:Class="ManagementTools.Views.ComExp.DtcStatisticsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:localization="using:ManagementTools.Localization"
    xmlns:converters="using:ManagementTools.Converters"
    mc:Ignorable="d">

    <Page.Resources>
        <localization:LocalizedStrings x:Key="LocalizedStrings" />
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />

        <Style x:Key="PropertyHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

        <Style x:Key="PropertyLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="Margin" Value="0,0,8,4" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>

        <Style x:Key="PropertyValueStyle" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="IsTextSelectionEnabled" Value="True" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>
    </Page.Resources>

    <Grid RowDefinitions="Auto,*">
        <CommandBar DefaultLabelPosition="Right">
            <AppBarButton Icon="Refresh" Label="{x:Bind LocalizedStrings.ComExp_RefreshButton}" Click="RefreshButton_Click" />
        </CommandBar>

        <Grid Grid.Row="1" RowDefinitions="*,Auto" Padding="24,8,24,24">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="24" Padding="0,8,0,0">
                    <!-- Current Section -->
                    <StackPanel Spacing="8">
                        <TextBlock Text="{x:Bind LocalizedStrings.ComExp_Stats_Current}" Style="{StaticResource PropertyHeaderStyle}" />
                        
                        <Grid ColumnDefinitions="200,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="4">
                            <TextBlock Text="{x:Bind LocalizedStrings.ComExp_Stats_Open}" Style="{StaticResource PropertyLabelStyle}" />
                            <TextBlock Grid.Column="1" Style="{StaticResource PropertyValueStyle}">
                                <Run Text="{x:Bind ViewModel.Statistics.Open, Mode=OneWay, FallbackValue=0}" />
                            </TextBlock>
                            
                            <TextBlock Grid.Row="1" Text="{x:Bind LocalizedStrings.ComExp_Stats_OpenMax}" Style="{StaticResource PropertyLabelStyle}" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource PropertyValueStyle}">
                                <Run Text="{x:Bind ViewModel.Statistics.OpenMax, Mode=OneWay, FallbackValue=0}" />
                            </TextBlock>
                            
                            <TextBlock Grid.Row="2" Text="{x:Bind LocalizedStrings.ComExp_Stats_InDoubt}" Style="{StaticResource PropertyLabelStyle}" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource PropertyValueStyle}">
                                <Run Text="{x:Bind ViewModel.Statistics.InDoubt, Mode=OneWay, FallbackValue=0}" />
                            </TextBlock>
                        </Grid>
                    </StackPanel>

                    <!-- Aggregate Section -->
                    <StackPanel Spacing="8">
                        <TextBlock Text="{x:Bind LocalizedStrings.ComExp_Stats_Aggregate}" Style="{StaticResource PropertyHeaderStyle}" />
                        
                        <Grid ColumnDefinitions="200,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="4">
                            <TextBlock Text="{x:Bind LocalizedStrings.ComExp_Stats_Committed}" Style="{StaticResource PropertyLabelStyle}" />
                            <TextBlock Grid.Column="1" Style="{StaticResource PropertyValueStyle}">
                                <Run Text="{x:Bind ViewModel.Statistics.Committed, Mode=OneWay, FallbackValue=0}" />
                            </TextBlock>
                            
                            <TextBlock Grid.Row="1" Text="{x:Bind LocalizedStrings.ComExp_Stats_Aborted}" Style="{StaticResource PropertyLabelStyle}" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource PropertyValueStyle}">
                                <Run Text="{x:Bind ViewModel.Statistics.Aborted, Mode=OneWay, FallbackValue=0}" />
                            </TextBlock>
                            
                            <TextBlock Grid.Row="2" Text="{x:Bind LocalizedStrings.ComExp_Stats_ForcedCommit}" Style="{StaticResource PropertyLabelStyle}" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource PropertyValueStyle}">
                                <Run Text="{x:Bind ViewModel.Statistics.ForcedCommit, Mode=OneWay, FallbackValue=0}" />
                            </TextBlock>
                            
                            <TextBlock Grid.Row="3" Text="{x:Bind LocalizedStrings.ComExp_Stats_ForcedAbort}" Style="{StaticResource PropertyLabelStyle}" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource PropertyValueStyle}">
                                <Run Text="{x:Bind ViewModel.Statistics.ForcedAbort, Mode=OneWay, FallbackValue=0}" />
                            </TextBlock>
                            
                            <TextBlock Grid.Row="4" Text="{x:Bind LocalizedStrings.ComExp_Stats_Heuristic}" Style="{StaticResource PropertyLabelStyle}" />
                            <TextBlock Grid.Row="4" Grid.Column="1" Style="{StaticResource PropertyValueStyle}">
                                <Run Text="{x:Bind ViewModel.Statistics.Heuristic, Mode=OneWay, FallbackValue=0}" />
                            </TextBlock>
                            
                            <TextBlock Grid.Row="5" Text="{x:Bind LocalizedStrings.ComExp_Stats_Total}" Style="{StaticResource PropertyLabelStyle}" />
                            <TextBlock Grid.Row="5" Grid.Column="1" Style="{StaticResource PropertyValueStyle}">
                                <Run Text="{x:Bind ViewModel.Statistics.Total, Mode=OneWay, FallbackValue=0}" />
                            </TextBlock>
                        </Grid>
                    </StackPanel>

                    <!-- Response Times Section -->
                    <StackPanel Spacing="8">
                        <TextBlock Text="{x:Bind LocalizedStrings.ComExp_Stats_ResponseTimes}" Style="{StaticResource PropertyHeaderStyle}" />
                        
                        <Grid ColumnDefinitions="200,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="4">
                            <TextBlock Text="{x:Bind LocalizedStrings.ComExp_Stats_ResponseTimeMin}" Style="{StaticResource PropertyLabelStyle}" />
                            <TextBlock Grid.Column="1" Style="{StaticResource PropertyValueStyle}">
                                <Run Text="{x:Bind ViewModel.Statistics.ResponseTimeMin, Mode=OneWay, FallbackValue=0}" />
                            </TextBlock>
                            
                            <TextBlock Grid.Row="1" Text="{x:Bind LocalizedStrings.ComExp_Stats_ResponseTimeAvg}" Style="{StaticResource PropertyLabelStyle}" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource PropertyValueStyle}">
                                <Run Text="{x:Bind ViewModel.Statistics.ResponseTimeAverage, Mode=OneWay, FallbackValue=0}" />
                            </TextBlock>
                            
                            <TextBlock Grid.Row="2" Text="{x:Bind LocalizedStrings.ComExp_Stats_ResponseTimeMax}" Style="{StaticResource PropertyLabelStyle}" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource PropertyValueStyle}">
                                <Run Text="{x:Bind ViewModel.Statistics.ResponseTimeMax, Mode=OneWay, FallbackValue=0}" />
                            </TextBlock>
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Padding="8,12,8,0">
                <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" />
                <ProgressRing
                    Grid.Column="1"
                    Width="20"
                    Height="20"
                    IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.IsLoading, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}" />
            </Grid>
        </Grid>
    </Grid>
</Page>
