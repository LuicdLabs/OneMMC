<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="ManagementTools.Views.PrintManagement"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    xmlns:cwuc="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:ManagementTools.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:ManagementTools.Core.Features.PrintManagement.Models.PrintManagement"
    mc:Ignorable="d">
    <Page.Resources>
        <DataTemplate x:Key="PrinterItemTemplate" x:DataType="models:PrinterInfo">
            <cwuc:SettingsCard>
                <cwuc:SettingsCard.Header>
                    <StackPanel Spacing="4">
                        <TextBlock FontWeight="SemiBold" Text="{x:Bind Name}" />
                        <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                            <Run Text="{x:Bind Status}" />
                            <Run Text=" | " />
                            <Run Text="{x:Bind DriverVersion}" />
                        </TextBlock>
                    </StackPanel>
                </cwuc:SettingsCard.Header>
                <!-- Printers more button -->
                <Button
                    Style="{StaticResource SubtleButtonStyle}"
                    Tag="{x:Bind}">
                    <Button.Flyout>
                        <MenuFlyout Opening="PrinterMenuFlyout_Opening">
                            <MenuFlyoutItem Click="OpenPrinterQueue_Click" Tag="{x:Bind}" Text="Open Printer Queue">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE7C3;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Click="PauseResumePrinter_Click" Tag="{x:Bind}" Text="Pause Printing">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE769;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Click="DeployPrinter_Click" Tag="{x:Bind}" Text="Deploy with Group Policy">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE902;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Click="SetPrintingDefaults_Click" Tag="{x:Bind}" Text="Set Printing Defaults">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE713;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Click="PrintTestPage_Click" Tag="{x:Bind}" Text="Print Test Page">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE749;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Click="PrinterProperties_Click" Tag="{x:Bind}" Text="Properties">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE946;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem Click="DeletePrinter_Click" Tag="{x:Bind}" Text="Delete">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE74D;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Click="RenamePrinter_Click" Tag="{x:Bind}" Text="Rename">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE8AC;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </Button.Flyout>
                    <FontIcon FontSize="16" Glyph="&#xE712;" />
                </Button>
            </cwuc:SettingsCard>
        </DataTemplate>

        <DataTemplate x:Key="DriverItemTemplate" x:DataType="models:PrintDriverInfo">
            <cwuc:SettingsCard>
                <cwuc:SettingsCard.Header>
                    <StackPanel Spacing="4">
                        <TextBlock FontWeight="SemiBold">
                            <Run Text="{x:Bind Name}" />
                        </TextBlock>
                        <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                            <Run Text="{x:Bind InfName}" />
                            <Run Text=" | " />
                            <Run Text="{x:Bind DriverVersion}" />
                            <Run Text=" | " />
                            <Run Text="{x:Bind IsolationMode}" />
                        </TextBlock>
                    </StackPanel>
                </cwuc:SettingsCard.Header>
                <!-- Drivers more button -->
                <Button
                    Style="{StaticResource SubtleButtonStyle}"
                    Tag="{x:Bind}">
                    <Button.Flyout>
                        <MenuFlyout Opening="DriverMenuFlyout_Opening">
                            <MenuFlyoutItem Click="RemoveDriverPackage_Click" Tag="{x:Bind}" Text="Remove Driver Package">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE74D;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutSubItem Text="Set Driver Isolation">
                                <MenuFlyoutItem Click="SetDriverIsolationNone_Click" Tag="{x:Bind}" Text="None" />
                                <MenuFlyoutItem Click="SetDriverIsolationShared_Click" Tag="{x:Bind}" Text="Shared" />
                                <MenuFlyoutItem Click="SetDriverIsolationIsolated_Click" Tag="{x:Bind}" Text="Isolated" />
                                <MenuFlyoutItem Click="SetDriverIsolationDefault_Click" Tag="{x:Bind}" Text="System Default" />
                            </MenuFlyoutSubItem>
                            <MenuFlyoutItem Click="DriverProperties_Click" Tag="{x:Bind}" Text="Properties">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE946;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem Click="DeleteDriver_Click" Tag="{x:Bind}" Text="Delete">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE74D;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </Button.Flyout>
                    <FontIcon FontSize="16" Glyph="&#xE712;" />
                </Button>
            </cwuc:SettingsCard>
        </DataTemplate>

        <DataTemplate x:Key="DeployedPrinterItemTemplate" x:DataType="models:PrinterInfo">
            <cwuc:SettingsCard>
                <cwuc:SettingsCard.Header>
                    <StackPanel Spacing="4">
                        <TextBlock FontWeight="SemiBold">
                            <Run Text="{x:Bind Name}" />
                        </TextBlock>
                        <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                            <Run Text="Server:" />
                            <Run Text="{x:Bind ServerName}" />
                            <LineBreak />
                            <Run Text="Per User GPO:" />
                            <Run Text="{x:Bind PerUserGPO}" />
                            <Run Text=" | " />
                            <Run Text="Per Computer GPO:" />
                            <Run Text="{x:Bind PerComputerGPO}" />
                        </TextBlock>
                    </StackPanel>
                </cwuc:SettingsCard.Header>
                <!-- Deployed printers more button -->
                <Button
                    Style="{StaticResource SubtleButtonStyle}"
                    Tag="{x:Bind}">
                    <Button.Flyout>
                        <MenuFlyout Opening="DeployedPrinterMenuFlyout_Opening">
                            <MenuFlyoutItem Click="DeployPrinter_Click" Tag="{x:Bind}" Text="Deploy with Group Policy">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE902;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </Button.Flyout>
                    <FontIcon FontSize="16" Glyph="&#xE712;" />
                </Button>
            </cwuc:SettingsCard>
        </DataTemplate>
    </Page.Resources>

    <ScrollViewer>
        <StackPanel Padding="24,20,24,24" Spacing="4">

            <!--  Header with Refresh Button  -->
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    x:Name="ServerNameText"
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    FontSize="16" />
                <CommandBar
                    Grid.Column="1"
                    Background="Transparent"
                    DefaultLabelPosition="Right"
                    OverflowButtonVisibility="Collapsed">
                    <AppBarButton
                        x:Name="RefreshButton"
                        Click="RefreshButton_Click"
                        Icon="Refresh"
                        Label="Refresh" />
                    <AppBarSeparator />
                    <AppBarButton Icon="More">
                        <AppBarButton.Flyout>
                            <MenuFlyout>
                                <MenuFlyoutItem Click="OpenPrintMgrLegacy_Click" Text="{x:Bind LocalizedStrings.PrintMgmt_OpenLegacy}">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE8A7;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </AppBarButton.Flyout>
                    </AppBarButton>
                </CommandBar>
            </Grid>

            <!--  Loading Indicator  -->
            <ProgressBar
                x:Name="LoadingBar"
                Margin="0,0,0,8"
                IsIndeterminate="True"
                Visibility="Collapsed" />

            <!--  Printers Section  -->
            <cwuc:SettingsExpander
                x:Name="PrintersExpander"
                IsExpanded="True"
                ItemTemplate="{StaticResource PrinterItemTemplate}"
                ItemsSource="{x:Bind ViewModel.Printers, Mode=OneWay}">
                <cwuc:SettingsExpander.HeaderIcon>
                    <FontIcon Glyph="&#xE749;" />
                </cwuc:SettingsExpander.HeaderIcon>
                <TextBlock
                    x:Name="NoPrintersText"
                    Margin="16,4,0,8"
                    FontStyle="Italic"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Visibility="Collapsed" />
            </cwuc:SettingsExpander>

            <!--  Drivers Section  -->
            <cwuc:SettingsExpander
                x:Name="DriversExpander"
                IsExpanded="True"
                ItemTemplate="{StaticResource DriverItemTemplate}"
                ItemsSource="{x:Bind ViewModel.Drivers, Mode=OneWay}">
                <cwuc:SettingsExpander.HeaderIcon>
                    <FontIcon Glyph="&#xE772;" />
                </cwuc:SettingsExpander.HeaderIcon>
                <TextBlock
                    x:Name="NoDriversText"
                    Margin="16,4,0,8"
                    FontStyle="Italic"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Visibility="Collapsed" />
            </cwuc:SettingsExpander>

            <!--  Deployed Printers Section  -->
            <cwuc:SettingsExpander
                x:Name="DeployedPrintersExpander"
                IsExpanded="True"
                ItemTemplate="{StaticResource DeployedPrinterItemTemplate}"
                ItemsSource="{x:Bind ViewModel.DeployedPrinters, Mode=OneWay}">
                <cwuc:SettingsExpander.HeaderIcon>
                    <FontIcon Glyph="&#xF56D;" />
                </cwuc:SettingsExpander.HeaderIcon>
                <TextBlock
                    x:Name="NoDeployedPrintersText"
                    Margin="16,4,0,8"
                    FontStyle="Italic"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Visibility="Collapsed" />
            </cwuc:SettingsExpander>

            <!--  Modify Print Ports  -->
            <cwuc:SettingsCard x:Name="PortsCard">
                <Button
                    x:Name="PortsButton"
                    MinWidth="120"
                    Click="PortsButton_Click" />
            </cwuc:SettingsCard>

            <!--  View/Edit Print Forms  -->
            <cwuc:SettingsCard x:Name="FormsCard">
                <Button
                    x:Name="FormsButton"
                    MinWidth="120"
                    Click="FormsButton_Click" />
            </cwuc:SettingsCard>

        </StackPanel>
    </ScrollViewer>
</Page>