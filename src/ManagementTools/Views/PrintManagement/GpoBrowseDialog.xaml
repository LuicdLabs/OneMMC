<ContentDialog
    x:Class="ManagementTools.Views.GpoBrowseDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:ManagementTools.Core.Features.PrintManagement.Models.PrintManagement"
    mc:Ignorable="d"
    MinWidth="520"
    IsPrimaryButtonEnabled="{Binding SelectedGpo, Converter={StaticResource NullToBoolConverter}}">

    <Grid RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <InfoBar
            Grid.Row="0"
            IsClosable="True"
            IsOpen="{Binding ErrorMessage, Converter={StaticResource StringToBoolConverter}}"
            Message="{Binding ErrorMessage}"
            Severity="Error" />

        <ProgressRing
            Grid.Row="1"
            HorizontalAlignment="Center"
            IsActive="{Binding IsLoading}"
            Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}" />

        <ListView
            Grid.Row="2"
            ItemsSource="{Binding Gpos}"
            SelectedItem="{Binding SelectedGpo, Mode=TwoWay}">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:GroupPolicyObjectInfo">
                    <StackPanel Margin="0,4">
                        <TextBlock Text="{x:Bind DisplayName}" />
                        <TextBlock
                            Opacity="0.6"
                            Text="{x:Bind Guid}" />
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</ContentDialog>
