<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>OneMMC.Core</RootNamespace>
    <UseWinUI>true</UseWinUI>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <WinUISDKReferences>false</WinUISDKReferences>
    </PropertyGroup>
  <!-- Global usings: available in every .cs file without explicit using directives -->
  <ItemGroup>
    <Using Include="OneMMC.Core.Abstractions.Services" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="Microsoft.Windows.CsWin32" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" />
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <PackageReference Include="Serilog" />
    <PackageReference Include="Serilog.Extensions.Logging" />
    <PackageReference Include="Serilog.Sinks.File" />
    <PackageReference Include="System.Drawing.Common" />
    <PackageReference Include="System.Diagnostics.EventLog" />
    <PackageReference Include="System.ServiceProcess.ServiceController" />
    <!-- AOT-compatible WMI client; replaced System.Management for query/method features per
         doc/NativeAotMigration.md (M2). (Microsoft.Management.Infrastructure was instead replaced by the
         marshal-free IWbem wrapper under Features/SystemManagement/Infrastructure/WF/Wbem — WF Half B.) -->
    <PackageReference Include="WmiLight" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Features\UserSecurity\Services\SecPol\Resources\SecurityOptionsDefinitions.json" />
  </ItemGroup>
  
</Project>
